05d2\u05d3\u05dc \u05d1[[\u05d8\u05d1\u05e8\u05d9\u05d4]] \u05d5\u05dc\u05d5 \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d0\u05d7\u05d9\u05dd. \u05e2\u05d5\u05d3 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea\u05d5 \u05d4\u05d7\u05dc \u05dc\u05e9\u05d9\u05e8 \u05db[[\u05e4\u05d9\u05d5\u05d8|\u05e4\u05d9\u05d9\u05d8\u05df]] \u05d1[[\u05d1\u05d9\u05ea \u05db\u05e0\u05e1\u05ea|\u05d1\u05d9\u05ea \u05d4\u05db\u05e0\u05e1\u05ea]] \"\u05d9\u05e2\u05e7\u05d1 \u05d2\u05d6\" \u05d1\u05d8\u05d1\u05e8\u05d9\u05d4, \u05d4\u05e1\u05de\u05d5\u05da \u05dc\u05d1\u05d9\u05ea \u05d4\u05d5\u05e8\u05d9\u05d5. \u05de\u05d2\u05d9\u05dc 16, \u05d4\u05d7\u05dc \u05dc\u05e2\u05d1\u05d5\u05d3 \u05db[[\u05e1\u05e4\u05e8 (\u05de\u05e7\u05e6\u05d5\u05e2)|\u05e1\u05e4\u05e8]] \u05e2\u05d3 \u05e9\u05d4\u05ea\u05e4\u05e8\u05e1\u05dd \u05db\u05d6\u05de\u05e8{{\u05d4\u05e2\u05e8\u05d4|{{\u05d9\u05d3\u05d9\u05e2\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea|\u05e8\u05d6 \u05e9\u05db\u05e0\u05d9\u05e7|\u05d1\u05dc\u05d9\u05d1\u05d5 \u05d1\u05d5\u05e2\u05e8\u05ea \u05d0\u05e9|6025535|3 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2021}}}}. \u05e4\u05e8\u05e5 \u05d4\u05ea\u05d2\u05d9\u05d9\u05e1 \u05dc[[\u05e6\u05d4\"\u05dc]] \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 [[2001]] \u05dc[[\u05d7\u05d9\u05dc \u05d4\u05d7\u05d9\u05de\u05d5\u05e9]]. \u05db\u05d0\u05e9\u05e8 \u05e2\u05dc\u05d4 \u05dc\u05e9\u05d9\u05e8 \u05d0\u05ea \"[[\u05e9\u05d9\u05e8 \u05dc\u05de\u05e2\u05dc\u05d5\u05ea]]\" \u05d1\u05d8\u05e7\u05e1 [[\u05d9\u05d5\u05dd \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05d7\u05dc\u05dc\u05d9 \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc]] \u05e9\u05e0\u05e2\u05e8\u05da \u05d1\u05d1\u05e1\u05d9\u05e1\u05d5, \u05e7\u05d9\u05d1\u05dc \u05de\u05e9\u05d5\u05d1\u05d9\u05dd \u05d7\u05d9\u05d5\u05d1\u05d9\u05d9\u05dd, \u05d5[[\u05e7\u05e6\u05d9\u05df \u05d4\u05d7\u05d9\u05e0\u05d5\u05da \u05d4\u05e8\u05d0\u05e9\u05d9|\u05e7\u05e6\u05d9\u05df \u05d4\u05d7\u05d9\u05e0\u05d5\u05da]] \u05e1\u05d9\u05d9\u05e2 \u05d1\u05d9\u05d3\u05d5 \u05dc\u05d2\u05e9\u05ea \u05dc\u05d1\u05d7\u05d9\u05e0\u05d5\u05ea \u05d4\u05e7\u05d1\u05dc\u05d4 \u05dc[[\u05dc\u05d4\u05e7\u05d4 \u05e6\u05d1\u05d0\u05d9\u05ea]]. \u05d1\u05d9\u05d5\u05dc\u05d9 [[2002]] \u05e2\u05d1\u05e8 \u05d0\u05ea \u05d1\u05d7\u05d9\u05e0\u05d5\u05ea \u05d4\u05e7\u05d1\u05dc\u05d4 \u05d1\u05d4\u05e6\u05dc\u05d7\u05d4 \u05d5\u05d4\u05ea\u05e7\u05d1\u05dc \u05dc[[\u05e6\u05d5\u05d5\u05ea \u05d4\u05d5\u05d5\u05d9 \u05e4\u05d9\u05e7\u05d5\u05d3 \u05e6\u05e4\u05d5\u05df]], \u05d5\u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05d4\u05d7\u05dc \u05dc\u05e2\u05d1\u05d5\u05d3 \u05e2\u05dc \u05d4\u05e4\u05e7\u05ea [[\u05d0\u05dc\u05d1\u05d5\u05dd \u05de\u05d5\u05d6\u05d9\u05e7\u05dc\u05d9|\u05d0\u05dc\u05d1\u05d5\u05dd]] \u05de\u05e9\u05dc\u05d5.\n\n\u05e4\u05e8\u05e5 \u05d4\u05d7\u05dc \u05dc\u05d4\u05e7\u05dc\u05d9\u05d8 \u05d0\u05ea \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05db\u05d1\u05e8 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea [[2004]]. \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05d9\u05e6\u05d0 \u05dc\u05d1\u05e1\u05d5\u05e3 \u05dc\u05d7\u05e0\u05d5\u05d9\u05d5\u05ea \u05d1\u05d9\u05d5\u05e0\u05d9 [[2005]], \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d7\u05e8\u05d5\u05e8\u05d5 \u05de\u05e6\u05d4\"\u05dc. \u05d0\u05dc\u05d1\u05d5\u05dd \u05d4\u05d1\u05db\u05d5\u05e8\u05d4 \u05e9\u05dc\u05d5 \u05e7\u05e8\u05d5\u05d9 \u05e2\u05dc \u05e9\u05dd \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05e9\u05d9\u05e6\u05d0 \u05de\u05de\u05e0\u05d5 \u05dc[[\u05e8\u05d3\u05d9\u05d5]], \"[[\u05de\u05d1\u05d9\u05d8 \u05d0\u05dc \u05d4\u05de\u05e8\u05d5\u05de\u05d9\u05dd]]\". \u05de\u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05e0\u05de\u05db\u05e8\u05d5 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05de\u05e2\u05dc\u05d4 \u05de-10,000 \u05e2\u05d5\u05ea\u05e7\u05d9\u05dd. \u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e9\u05d9\u05e6\u05d0\u05d5 \u05de\u05ea\u05d5\u05da \u05d0\u05d5\u05ea\u05d5 \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd: \"\u05e9\u05d7\u05d5\u05e8\u05ea \u05e2\u05d9\u05e0\u05d9\u05d9\u05dd\", \"\u05d9\u05dc\u05d3 \u05de\u05d0\u05d5\u05d4\u05d1\", \"\u05d4\u05d0\u05d9\u05e9\u05d4 \u05e9\u05dc\u05d9\" \u05d5\"\u05d3\u05e8\u05da \u05d0\u05e8\u05d5\u05db\u05d4\" (\u05e2\u05d9\u05d1\u05d5\u05d3 \u05de\u05d7\u05d5\u05d3\u05e9 \u05dc\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc [[\u05d2\u05dc\u05d9 \u05e2\u05d8\u05e8\u05d9]]).\n\n\u05e4\u05e8\u05d9\u05e6\u05ea\u05d5 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \u05e4\u05e8\u05e5 \u05d1\u05d0\u05d4 \u05e2\u05dd \u05d4\u05d5\u05e6\u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05d0\u05e9\", \u05d0\u05d5\u05ea\u05d5 \u05db\u05ea\u05d1, \u05d1\u05e1\u05d5\u05e3 \u05e9\u05e0\u05ea [[2006]]. \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d4\u05e6\u05dc\u05d7\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc, \u05d4\u05d5\u05d0 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 [[2007]], \u05d0\u05ea \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e9\u05e0\u05d9, \u05e9\u05e7\u05e8\u05d5\u05d9 \u05e2\u05dc \u05e9\u05dd \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc, \"[[\u05d0\u05e9 (\u05d0\u05dc\u05d1\u05d5\u05dd)|\u05d0\u05e9]]\". \u05e4\u05e8\u05e5 \u05db\u05ea\u05d1 \u05d0\u05ea \u05e8\u05d5\u05d1 \u05d4\u05e9\u05d9\u05e8\u05d9\u05dd \u05d5\u05d4\u05dc\u05d7\u05e0\u05d9\u05dd \u05d1\u05d0\u05dc\u05d1\u05d5\u05dd, \u05db\u05de\u05d5 \u05d2\u05dd \u05d1\u05d9\u05ea\u05e8 \u05d0\u05dc\u05d1\u05d5\u05de\u05d9\u05d5 \u05d4\u05d1\u05d0\u05d9\u05dd. \u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd, \u05e9\u05d9\u05e6\u05d0\u05d5 \u05de\u05ea\u05d5\u05da \u05d0\u05d5\u05ea\u05d5 \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05dc\u05e8\u05d3\u05d9\u05d5 \u05d4\u05dd \"\u05d6\u05d4 \u05d4\u05d6\u05de\u05df\", \"\u05db\u05de\u05d5 \u05d4\u05e9\u05e7\u05d8\", \u05e9\u05e0\u05db\u05ea\u05d1 \u05d1\u05de\u05e9\u05d5\u05ea\u05e3 \u05e2\u05dd [[\u05d3\u05d5\u05d3\u05d5 \u05d0\u05d4\u05e8\u05d5\u05df]], \"\u05d9\u05e9 \u05e8\u05d2\u05e2\u05d9\u05dd\" \u05d5\"\u05d1\u05d7\u05dc\u05d5\u05de\u05d5\u05ea \u05e9\u05dc\u05d9\". \u05e1\u05d9\u05e0\u05d2\u05dc \u05e0\u05d5\u05e1\u05e3 \u05e9\u05d9\u05e6\u05d0 \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05d5\u05dc\u05d0 \u05e0\u05db\u05dc\u05dc \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d0\u05dc\u05d1\u05d5\u05dd \u05d4\u05d5\u05d0 \"\u05d5\u05e8\u05e7 \u05d0\u05d9\u05ea\u05da\", \u05e9\u05d4\u05d5\u05e4\u05d9\u05e2 \u05db\u05d7\u05dc\u05e7 \u05de\u05df \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05d4\u05d1\u05d0 \u05e9\u05dc\u05d5, \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9, \"\u05d0\u05dc\u05d9\u05d9\u05da\".\n\n\u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 [[2008]], \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \"\u05d0\u05dc\u05d9\u05d9\u05da\" \u05d5\"\u05d5\u05d0\u05d5\u05dc\u05d9\", \u05e9\u05d4\u05d2\u05d9\u05e2\u05d5 \u05dc\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05d1\u05de\u05e6\u05e2\u05d3\u05d9 \u05d4\u05e8\u05d3\u05d9\u05d5 \u05d5\u05e0\u05e9\u05d0\u05e8\u05d5 \u05d1\u05e8\u05d0\u05e9 \u05d1\u05de\u05e9\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05d0\u05e8\u05d5\u05db\u05d4. \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4, \u05e4\u05e8\u05e5 \u05d4\u05d7\u05dc \u05d2\u05dd \u05dc\u05db\u05db\u05d1 \u05d1\u05e1\u05d3\u05e8\u05ea \u05d3\u05e8\u05de\u05d4 \u05e9\u05d4\u05d5\u05e4\u05e7\u05d4 \u05dc\u05e1\u05dc\u05d5\u05dc\u05e8, \"\u05e4\u05e8\u05e5 \u05e9\u05dc \u05d0\u05d4\u05d1\u05d4\", \u05dc\u05e6\u05d9\u05d3\u05dd \u05e9\u05dc: [[\u05e9\u05e8\u05d5\u05df \u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8]], [[\u05d3\u05e4\u05e0\u05d4 \u05d0\u05e8\u05de\u05d5\u05e0\u05d9]], [[\u05de\u05d9\u05db\u05dc \u05d2\u05d1\u05e8\u05d9\u05d0\u05dc\u05d5\u05d1]] \u05d5\u05e2\u05d5\u05d3. \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2008 \u05d9\u05e6\u05d0 \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05db\u05dc \u05d1\u05d5\u05e7\u05e8\", \u05d5\u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9 \u05d5\u05d4\u05de\u05dc\u05d0, \"[[\u05d0\u05dc\u05d9\u05d9\u05da]]\", \u05db\u05d0\u05e9\u05e8 \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d4\u05d7\u05d5\u05d3\u05e9 \u05d9\u05e6\u05d0 \u05d2\u05dd \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc, \"\u05e0\u05e9\u05d1\u05e2 \u05dc\u05da\". \u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05e9\u05d9\u05e6\u05d0\u05d5 \u05de\u05ea\u05d5\u05da \u05d0\u05d5\u05ea\u05d5 \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd: \"\u05e8\u05e6\u05d9\u05ea\u05d9 \u05e8\u05e7\", \"\u05d9\u05d5\u05ea\u05e8 \u05de\u05d3\u05d9\", \"\u05d0\u05e0\u05d9 \u05e9\u05dc\u05da\" \u05d5\"\u05d0\u05d9\u05e9\u05d4\". \u05d1\u05d0\u05dc\u05d1\u05d5\u05dd \u05d6\u05d4 \u05e0\u05d9\u05ea\u05df \u05d2\u05dd \u05dc\u05de\u05e6\u05d5\u05d0 \u05d0\u05ea \"\u05e9\u05d9\u05e8 \u05d4\u05de\u05e2\u05dc\u05d5\u05ea\", \u05e9\u05d6\u05db\u05d4 \u05dc\u05dc\u05d7\u05df \u05d5\u05e2\u05d9\u05d1\u05d5\u05d3 \u05de\u05d7\u05d5\u05d3\u05e9. \u05db\u05e2\u05d1\u05d5\u05e8 \u05de\u05e1\u05e4\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d5\u05e6\u05d0\u05ea\u05d5, \u05d4\u05d2\u05d9\u05e2 \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05dc\u05de\u05e2\u05de\u05d3 [[\u05d0\u05dc\u05d1\u05d5\u05dd \u05e4\u05dc\u05d8\u05d9\u05e0\u05d4|\u05e4\u05dc\u05d8\u05d9\u05e0\u05d4]] \u05e2\u05dc \u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05dc\u05de\u05e2\u05dc\u05d4 \u05de-40,000 \u05e2\u05d5\u05ea\u05e7\u05d9\u05dd \u05d1\u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05de\u05db\u05d9\u05e8\u05d4 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc{{\u05d4\u05e2\u05e8\u05d4|{{ynet|[[\u05e8\u05d6 \u05e9\u05db\u05e0\u05d9\u05e7]]|\u05e6\u05e2\u05e7\u05ea\u05d9 \"\u05de\u05d4 \u05e2\u05e9\u05d9\u05ea \u05dc\u05d9\"|4873221|1 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2016}}}}{{\u05d4\u05e2\u05e8\u05d4|{{ynet|[[\u05e8\u05d6 \u05e9\u05db\u05e0\u05d9\u05e7]]|\u05e7\u05d9\u05d1\u05dc\u05ea\u05d9 \u05e4\u05e6\u05e6\u05d4 \u05dc\u05e4\u05e0\u05d9\u05dd|4873699|2 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2016}}}}{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05d0\u05e7\u05d5|\u05d0\u05d1\u05d9 \u05e9\u05d5\u05e9\u05df|\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5, \u05d2\u05e8\u05e1\u05ea \u05d4\u05d0\u05e0\u05e4\u05dc\u05d2\u05d3|5942eb68ecc0221004|music-news/local-taverna|23 \u05d1\u05d9\u05d5\u05e0\u05d9 2009}}}}.\n\n=== \u05db\u05ea\u05d9\u05d1\u05d4 \u05dc\u05d6\u05de\u05e8\u05d5\u05ea \u05d5\u05dc\u05d6\u05de\u05e8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd ===\n\u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05ea 2008, \u05db\u05ea\u05d1 \u05e4\u05e8\u05e5 \u05dc\u05d0\u05dc\u05d1\u05d5\u05de\u05d4 \u05e9\u05dc [[\u05e9\u05e8\u05d9\u05ea \u05d7\u05d3\u05d3]] \"[[\u05de\u05e8\u05d5\u05e5 \u05d4\u05d7\u05d9\u05d9\u05dd (\u05d0\u05dc\u05d1\u05d5\u05dd)|\u05de\u05e8\u05d5\u05e5 \u05d4\u05d7\u05d9\u05d9\u05dd]]\" \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8 \"\u05de\u05d9\u05dc\u05d4 \u05d8\u05d5\u05d1\u05d4\". \u05d6\u05d4\u05d5 \u05d4\u05e9\u05d9\u05e8 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05e9\u05d4\u05d5\u05d0 \u05db\u05ea\u05d1 \u05dc\u05d0\u05de\u05df \u05d0\u05d7\u05e8. \u05e4\u05e8\u05e5 \u05db\u05ea\u05d1 \u05d2\u05dd \u05dc\u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05e9\u05dc [[\u05e9\u05dc\u05d5\u05de\u05d9 \u05e9\u05d1\u05ea]] \"\u05d0\u05e0\u05d9 \u05e9\u05e8 \u05d0\u05dc\u05d9\u05d9\u05da\" \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8 \"\u05de\u05e9\u05ea\u05d2\u05e2 \u05de\u05d0\u05d4\u05d1\u05ea\u05da\". \u05db\u05de\u05d5 \u05db\u05df \u05d2\u05dd \u05d4\u05dc\u05d7\u05d9\u05df \u05dc[[\u05ea\u05de\u05d9\u05e8 \u05d2\u05dc]] \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8 \"\u05db\u05dc \u05d4\u05d1\u05e0\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1\u05d9\" \u05de\u05ea\u05d5\u05da \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \"\u05e2\u05db\u05e9\u05d9\u05d5 \u05d6\u05d4 \u05d1\u05d0\", \u05dc\u05de\u05d9\u05dc\u05d9\u05dd \u05e9\u05dc \u05e9\u05e8\u05d5\u05df \u05d0\u05e1\u05d5\u05dc\u05d9\u05df. \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05ea [[2009]] \u05e4\u05e8\u05e5 \u05d5[[\u05d3\u05d5\u05d3\u05d5 \u05d0\u05d4\u05e8\u05d5\u05df]] \u05db\u05ea\u05d1\u05d5 \u05d5\u05d4\u05dc\u05d7\u05d9\u05e0\u05d5 \u05d9\u05d7\u05d3\u05d9\u05d5 \u05dc[[\u05dc\u05d9\u05d0\u05d5\u05e8 \u05e0\u05e8\u05e7\u05d9\u05e1]] \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8 \"\u05de\u05ea\u05d5\u05e7\u05d4\".\n\n\u05d1\u05d9\u05d5\u05e0\u05d9 2009, \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05e9\u05ea\u05d9\u05d9\u05dd \u05d1\u05dc\u05d9\u05dc\u05d4\", \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05de\u05ea\u05d5\u05da \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9, \u05d0\u05e9\u05e8 \u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05de\u05e6\u05e2\u05d3\u05d9 [[\u05d2\u05dc\u05d2\u05dc\u05e6]] \u05d5[[\u05e8\u05e9\u05ea \u05d2']] \u05d5\u05e0\u05e9\u05d0\u05e8 \u05d1\u05e8\u05d0\u05e9\u05dd \u05d1\u05de\u05e9\u05da \u05de\u05e1\u05e4\u05e8 \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea. \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e9\u05e0\u05d9, \"\u05de\u05d4\u05e9\u05de\u05d9\u05d9\u05dd\". \u05d1\u05d4\u05de\u05e9\u05da \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d1\u05e2\u05e8\u05d1 [[\u05e8\u05d0\u05e9 \u05d4\u05e9\u05e0\u05d4]] \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9, \"\u05d0\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc\u05d9\u05d9\u05da\". \u05d1\u05e8\u05d0\u05e9 \u05d4\u05e9\u05e0\u05d4 \u05e0\u05d1\u05d7\u05e8 \u05e4\u05e8\u05e5 \u05dc\"\u05d6\u05de\u05e8 \u05d4\u05e9\u05e0\u05d4\" \u05e9\u05dc \"[[\u05e8\u05d3\u05d9\u05d5 \u05d0\u05de\u05e6\u05e2 \u05d4\u05d3\u05e8\u05da]]\". \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2009 \u05d4\u05d7\u05dc \u05e4\u05e8\u05e5 \u05dc\u05d4\u05e9\u05ea\u05ea\u05e3 \u05d1\u05e2\u05d5\u05e0\u05d4 \u05d4\u05d7\u05de\u05d9\u05e9\u05d9\u05ea \u05e9\u05dc [[\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05de\u05e6\u05d9\u05d0\u05d5\u05ea|\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05e8\u05d9\u05d0\u05dc\u05d9\u05d8\u05d9]] \"[[\u05e8\u05d5\u05e7\u05d3\u05d9\u05dd \u05e2\u05dd \u05db\u05d5\u05db\u05d1\u05d9\u05dd (\u05e8\u05e9\u05ea)|\u05e8\u05d5\u05e7\u05d3\u05d9\u05dd \u05e2\u05dd \u05db\u05d5\u05db\u05d1\u05d9\u05dd]]\", \u05d4\u05de\u05e9\u05d5\u05d3\u05e8\u05ea \u05d1[[\u05e2\u05e8\u05d5\u05e5 2]]. \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05d2\u05d9\u05e2 \u05e4\u05e8\u05e5 \u05dc\u05e9\u05dc\u05d1 \u05d4\u05d2\u05de\u05e8 \u05d5\u05e1\u05d9\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05e9\u05e0\u05d9. \u05d1-[[16 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8]] 2009 \u05d4\u05d5\u05e4\u05d9\u05e2 \u05e4\u05e8\u05e5 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d1\"[[\u05d4\u05d9\u05db\u05dc \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea (\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1)|\u05d4\u05d9\u05db\u05dc \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea]]\", \u05d1\u05de\u05d5\u05e4\u05e2 \u05de\u05d5\u05e9\u05e7\u05e2 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d9\u05d9\u05dd [[\u05e6\u05d3\u05d9 \u05e6\u05e8\u05e4\u05ea\u05d9]] \u05d5\u05d1\u05d5 \u05d4\u05d5\u05e9\u05e7\u05e2\u05d5 \u05dc\u05d0 \u05e4\u05d7\u05d5\u05ea \u05de-100,000 \u05d3\u05d5\u05dc\u05e8\u05d9\u05dd. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05de\u05d5\u05e4\u05e2 \u05d7\u05e9\u05e3 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9 \u05de\u05ea\u05d5\u05da \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05d7\u05d3\u05e9, \"\u05d0\u05de\u05d0\", \u05d0\u05d5\u05ea\u05d5 \u05d4\u05e7\u05d3\u05d9\u05e9 \u05dc\u05d0\u05de\u05d5 \u05e9\u05d9\u05e9\u05d1\u05d4 \u05d1\u05e7\u05d4\u05dc.\n\n\u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05de\u05e8\u05e5 [[2010]], \u05d1\u05de\u05d4\u05dc\u05da \u05d8\u05e7\u05e1 \"[[\u05de\u05dc\u05db\u05ea \u05d4\u05d9\u05d5\u05e4\u05d9|\u05ea\u05d7\u05e8\u05d5\u05ea \u05de\u05dc\u05db\u05ea \u05d4\u05d9\u05d5\u05e4\u05d9]]\", \u05e9\u05e8 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05d7\u05de\u05d9\u05e9\u05d9 \"\u05d0\u05d9\u05da \u05e9\u05d0\u05ea \u05d9\u05e4\u05d4\", \u05d5\u05dc\u05d0\u05d7\u05e8 \u05db\u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd \u05d9\u05e6\u05d0 \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9 \u05d5\u05d4\u05de\u05dc\u05d0, \"[[\u05de\u05d4\u05e9\u05de\u05d9\u05d9\u05dd]]\". \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9 \u05e9\u05dc \u05e4\u05e8\u05e5 \u05d4\u05d2\u05d9\u05e2 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05e0\u05d9\u05dd 2010 \u05d5-[[2011]] \u05dc\u05de\u05e2\u05de\u05d3 \u05d0\u05dc\u05d1\u05d5\u05dd \u05e4\u05dc\u05d8\u05d9\u05e0\u05d4 \u05db\u05e4\u05d5\u05dc, \u05db\u05e9\u05d4\u05d5\u05d0 \u05de\u05db\u05d9\u05dc \u05d1\u05ea\u05d5\u05db\u05d5 \u05d2\u05dd \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8\u05d9\u05dd \"\u05d0\u05d9\u05df \u05db\u05de\u05d5 \u05d1\u05d1\u05d9\u05ea\", \"\u05e2\u05d3 \u05e9\u05ea\u05e9\u05d5\u05d1\u05d9 \u05d0\u05dc\u05d9\u05d9\", \"\u05de\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05d0\u05d9\u05ea\u05da\" \u05d5-\"\u05ea\u05de\u05d9\u05d3 \u05d9\u05d3\u05e2\u05ea\u05d9\". \u05d1\u05de\u05e8\u05e5 2010 \u05d6\u05db\u05d4 \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d1\"[[\u05e4\u05e8\u05e1 \u05d0\u05e7\u05d5\"\u05dd]]\" \u05d1\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05d9\u05e9\u05d2 \u05d4\u05e9\u05e0\u05d4 \u05d1[[\u05de\u05d5\u05d6\u05d9\u05e7\u05d4]]. \u05d6\u05db\u05d9\u05d9\u05ea\u05d5 \u05d1\u05e4\u05e8\u05e1 \u05e2\"\u05e9 [[\u05e2\u05d5\u05d6\u05d9 \u05d7\u05d9\u05d8\u05de\u05df]] \u05e0\u05d5\u05de\u05e7\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d7\u05d1\u05e8 \u05d4\u05e9\u05d5\u05e4\u05d8\u05d9\u05dd:\n{{\u05e6\u05d9\u05d8\u05d5\u05d8|\u05de\u05e8\u05db\u05d0\u05d5\u05ea=\u05db\u05df|\u05ea\u05d5\u05db\u05df=\u05d1\u05d6\u05db\u05d5\u05ea \u05db\u05ea\u05d9\u05d1\u05ea\u05d5 \u05d4\u05de\u05d9\u05d5\u05d7\u05d3\u05ea \u05d4\u05df \u05db\u05e4\u05d6\u05de\u05d5\u05e0\u05d0\u05d9 \u05d5\u05d4\u05df \u05db\u05de\u05dc\u05d7\u05d9\u05df, \u05e9\u05d1\u05e9\u05d5\u05e0\u05d4 \u05de\u05d4\u05ea\u05d1\u05e0\u05d9\u05d5\u05ea \u05d4\u05de\u05dc\u05d5\u05d3\u05d9\u05d5\u05ea \u05d4\u05d9\u05dd-\u05ea\u05d9\u05db\u05d5\u05e0\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05d1\u05dc\u05d5\u05ea \u05d4\u05e6\u05dc\u05d9\u05d7 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e7\u05d5 \u05de\u05d5\u05d6\u05d9\u05e7\u05dc\u05d9 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05d5... \u05db\u05de\u05d1\u05e6\u05e2 \u05d4\u05d5\u05d0 \u05d4\u05e6\u05dc\u05d9\u05d7 \u05dc\u05d2\u05e2\u05ea \u05d1\u05e8\u05d2\u05e9\u05d5\u05ea\u05d9\u05d4\u05dd \u05e9\u05dc \u05e8\u05d1\u05d1\u05d5\u05ea \u05de\u05d0\u05d6\u05d9\u05e0\u05d9\u05dd... \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea\u05d5 \u05d4\u05e2\u05e0\u05d5\u05d5\u05d4 \u05d5\u05d4\u05db\u05d5\u05d1\u05e9\u05ea \u05d4\u05e4\u05db\u05d5 \u05d0\u05d5\u05ea\u05d5 \u05d4\u05e9\u05e0\u05d4 \u05dc\u05db\u05d5\u05db\u05d1 \u05e8\u05d5\u05e7\u05e1\u05d8\u05d0\u05e8 \u05d0\u05de\u05d9\u05ea\u05d9|\u05de\u05e7\u05d5\u05e8=\u05d7\u05d1\u05e8 \u05e9\u05d5\u05e4\u05d8\u05d9 \u05d5\u05e2\u05d3\u05ea \u05e4\u05e8\u05e1 \u05d0\u05e7\u05d5\"\u05dd, [http://www.1mother.net/index.php/\u05de\u05e9\u05d4%20\u05e4\u05e8\u05e5%20\u05e4\u05e8\u05e1%20\u05de\u05d4\u05e9\u05de\u05d9\u05d9\u05dd/article/170 \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05de\u05e7\u05d1\u05dc \u05d0\u05ea \u05e4\u05e8\u05e1 \u05d0\u05e7\u05d5\"\u05dd, 25 \u05d1\u05de\u05e8\u05e5 2010]}}\n\u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2010, \u05d1\u05de\u05d4\u05dc\u05da [[\u05d9\u05d5\u05dd \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05d7\u05dc\u05dc\u05d9 \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc]], \u05d4\u05e9\u05ea\u05ea\u05e3 \u05e4\u05e8\u05e5 \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \"[[\u05e2\u05d5\u05d3 \u05de\u05e2\u05d8 \u05e0\u05d4\u05e4\u05d5\u05da \u05dc\u05e9\u05d9\u05e8]]\" \u05dc[[\u05d4\u05e0\u05e6\u05d7\u05ea \u05d7\u05dc\u05dc\u05d9 \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc]], \u05d1\u05d5 \u05de\u05d5\u05dc\u05d7\u05e0\u05d9\u05dd \u05d5\u05de\u05d1\u05d5\u05e6\u05e2\u05d9\u05dd \u05e9\u05d9\u05e8\u05d9\u05d4\u05dd \u05e9\u05dc \u05d7\u05dc\u05dc\u05d9 \u05e6\u05d4\"\u05dc, \u05d5\u05d0\u05e9\u05e8 \u05de\u05d5\u05e4\u05e7 \u05d1\u05d7\u05e1\u05d5\u05ea [[\u05d2\u05dc\u05d9 \u05e6\u05d4\"\u05dc]] \u05d5\u05e2\u05e8\u05d5\u05e5 2. \u05e4\u05e8\u05e5 \u05d4\u05dc\u05d7\u05d9\u05df \u05d5\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8 \"\u05d0\u05ea \u05d4\u05d8\u05de\u05d5\u05df \u05d1\u05d9 \u05dc\u05d0 \u05ea\u05d5\u05db\u05dc\u05d9 \u05dc\u05d3\u05e2\u05ea\", \u05dc\u05de\u05d9\u05dc\u05d9\u05dd \u05e9\u05dc [[\u05e8\u05d1-\u05d8\u05d5\u05e8\u05d0\u05d9]] \u05d0\u05dc\u05d5\u05df \u05e9\u05d5\u05e8\u05e7 \u05e9\u05e0\u05d4\u05e8\u05d2 \u05d1[[\u05ea\u05d0\u05d5\u05e0\u05ea \u05d4\u05e8\u05db\u05d1\u05ea \u05d1\u05d1\u05d9\u05ea \u05d9\u05d4\u05d5\u05e9\u05e2]] \u05d1\u05e9\u05e0\u05ea [[2006]]. \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05ea 2010 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05e9\u05e7\u05ea \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9 \u05d4\u05d7\u05d3\u05e9, \u05d9\u05e6\u05d0 \u05e4\u05e8\u05e5 \u05dc[[\u05e1\u05d9\u05d1\u05d5\u05d1 \u05d4\u05d5\u05e4\u05e2\u05d5\u05ea]] \u05d1\u05e8\u05d7\u05d1\u05d9 \u05d4\u05d0\u05e8\u05e5, \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05e2\u05e9\u05e8\u05d5\u05ea \u05e0\u05d2\u05e0\u05d9\u05dd, \u05d0\u05d5\u05e8\u05d7\u05d9\u05dd \u05d5\u05e8\u05e7\u05d3\u05e0\u05d9\u05d5\u05ea. \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\"\u05d4\u05d9\u05db\u05dc \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea\" \u05d1\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1, \u05d4\u05e1\u05d9\u05d1\u05d5\u05d1 \u05db\u05dc\u05dc \u05d2\u05dd \u05d1\u05d9\u05df \u05d4\u05d9\u05ea\u05e8 \u05d7\u05de\u05e9 \u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05e9\u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d5 \u05d1\"[[\u05ea\u05d9\u05d0\u05d8\u05e8\u05d5\u05df \u05e7\u05d9\u05e1\u05e8\u05d9\u05d4|\u05d0\u05de\u05e4\u05d9 \u05e7\u05d9\u05e1\u05e8\u05d9\u05d4]]\" \u05d1\u05de\u05d4\u05dc\u05da \u05e1\u05d5\u05e3 \u05d7\u05d5\u05d3\u05e9 \u05de\u05d0\u05d9 \u05d5\u05d7\u05d5\u05d3\u05e9 \u05d9\u05d5\u05dc\u05d9 \u05d0\u05d5\u05ea\u05d4 \u05d4\u05e9\u05e0\u05d4. \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2010 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05dc\u05e8\u05d3\u05d9\u05d5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05de\u05ea\u05d5\u05da \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05d7\u05de\u05d9\u05e9\u05d9 \"\u05d0\u05d9\u05df \u05db\u05de\u05d5\u05da\", \u05d0\u05d5\u05ea\u05d5 \u05db\u05ea\u05d1 \u05d5\u05d4\u05dc\u05d7\u05d9\u05df \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d2\u05d9\u05dc\u05d9 \u05d6\u05db\u05d0\u05d9, \u05d1\u05d4\u05e4\u05e7\u05ea\u05dd \u05d5\u05d1\u05e2\u05d9\u05d1\u05d5\u05d3\u05dd \u05d4\u05de\u05d5\u05d6\u05d9\u05e7\u05dc\u05d9 \u05e9\u05dc [[\u05d9\u05e2\u05e7\u05d1 \u05dc\u05de\u05d0\u05d9]] \u05d5[[\u05d8\u05dc \u05e9\u05d2\u05d1]]. \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05d5\u05e9\u05de\u05e2 \u05e8\u05d1\u05d5\u05ea \u05d1\u05ea\u05d7\u05e0\u05d5\u05ea \u05d4\u05e8\u05d3\u05d9\u05d5 \u05d5\u05d0\u05e3 \u05e2\u05de\u05d3 \u05d1\u05e8\u05d0\u05e9\u05d9 \u05de\u05e6\u05e2\u05d3\u05d9 \u05d4\u05e4\u05d6\u05de\u05d5\u05e0\u05d9\u05dd \u05e9\u05d1\u05d5\u05e2\u05d5\u05ea \u05e8\u05d1\u05d9\u05dd. \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e9\u05e0\u05d9, \"\u05d0\u05e8\u05d5\u05e5 \u05e2\u05d3 \u05d0\u05dc\u05d9\u05d9\u05da\".\n\n\u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2011 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05dc\u05d0\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9, \"\u05e7\u05d7\u05d9 \u05d0\u05d5\u05ea\u05d9 \u05d0\u05dc\u05d9\u05d9\u05da\"{{\u05d4\u05e2\u05e8\u05d4|{{\u05d7\u05d3\u05e9\u05d5\u05ea 13||\u05d7\u05e6\u05d9 \u05d0\u05d5\u05d6\u05df \u2022 \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \u05e9\u05dc \u05d4\u05e9\u05d1\u05d5\u05e2|item/entertainment/music/news/ntr-770640|5 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2011}}}}. \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2011 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e8\u05d1\u05d9\u05e2\u05d9, \"\u05db\u05de\u05d5 \u05de\u05dc\u05da\" \u05d5\u05d1\u05d9\u05e6\u05e2 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05e1\u05d9\u05d1\u05d5\u05d1 \u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05e8\u05d0\u05e9\u05d5\u05df \u05de\u05e1\u05d5\u05d2\u05d5 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc. \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2011 \u05d7\u05d1\u05e8 \u05e4\u05e8\u05e5 \u05d0\u05dc [[\u05d9\u05e0\u05d9\u05d1 \u05d1\u05df \u05de\u05e9\u05d9\u05d7]] \u05d5\u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05d9\u05ea\u05d5 \u05dc\u05d0\u05d5\u05e8 \u05d0\u05ea \u05d3\u05d5\u05d0\u05d8 \u05d4\u05ea\u05e4\u05d9\u05dc\u05d4 \"\u05d5\u05d0\u05d7\u05e8\u05d9 \u05db\u05db\u05dc\u05d5\u05ea \u05d4\u05db\u05dc\", \u05d0\u05d5\u05ea\u05d5 \u05d2\u05dd \u05db\u05ea\u05d1 \u05d5\u05d4\u05dc\u05d7\u05d9\u05df. \u05d1\u05de\u05d0\u05d9 2011, \u05d9\u05e6\u05d0 \u05e4\u05e8\u05e5 \u05dc\u05e1\u05d9\u05d1\u05d5\u05d1 \u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05de\u05d7\u05d5\u05d3\u05e9, \u05e9\u05e0\u05e7\u05e8\u05d0 \"\u05d0\u05e8\u05d5\u05e5 \u05e2\u05d3 \u05d0\u05dc\u05d9\u05d9\u05da\", \u05e2\u05dc \u05e9\u05dd \u05d0\u05d7\u05d3 \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \u05de\u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05d7\u05de\u05d9\u05e9\u05d9, \u05e9\u05d4\u05d7\u05dc \u05d1\u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05d1\"\u05d0\u05de\u05e4\u05d9 \u05e7\u05d9\u05e1\u05e8\u05d9\u05d4\" \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05e2\u05dd \u05e0\u05d2\u05e0\u05d9\u05dd, \u05d0\u05d5\u05e8\u05d7\u05d9\u05dd \u05d5\u05e8\u05e7\u05d3\u05e0\u05d9\u05d5\u05ea. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \u05e9\u05dc\u05d5 \u05d1\"\u05e7\u05d9\u05e1\u05e8\u05d9\u05d4\", \u05d4\u05d5\u05e6\u05d9\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05e8\u05d7\u05d5\u05e7 \u05de\u05de\u05da\". \u05d1\u05d0\u05de\u05e6\u05e2 \u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2011 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05de\u05e6\u05dc\u05d9\u05d7 \"\u05d0\u05dc\u05e3 \u05e4\u05e2\u05de\u05d9\u05dd\", \u05d5\u05db\u05e2\u05d1\u05d5\u05e8 \u05d7\u05d5\u05d3\u05e9 \u05d0\u05ea \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05d4\u05d7\u05de\u05d9\u05e9\u05d9 \u05d5\u05d4\u05de\u05dc\u05d0 \"[[\u05d6\u05d9\u05e7\u05d5\u05e7\u05d9\u05dd (\u05d0\u05dc\u05d1\u05d5\u05dd)|\u05d6\u05d9\u05e7\u05d5\u05e7\u05d9\u05dd]]\". \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05d6\u05db\u05d4 \u05dc\u05d4\u05e6\u05dc\u05d7\u05d4 \u05de\u05d9\u05d9\u05d3\u05d9\u05ea \u05d1\u05e8\u05e9\u05ea \u05d5\u05dc\u05d0\u05d7\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e1\u05e4\u05d5\u05e8\u05d9\u05dd \u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e2\u05de\u05d3 \u05e4\u05dc\u05d8\u05d9\u05e0\u05d4 \u05db\u05e4\u05d5\u05dc \u05e2\u05dd \u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05dc\u05de\u05e2\u05dc\u05d4 \u05de-80,000 \u05e2\u05d5\u05ea\u05e7\u05d9\u05dd. \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05e9\u05e0\u05ea 2011 \u05e0\u05d1\u05d7\u05e8 \u05e4\u05e8\u05e5 \u05dc\u05d4\u05e9\u05ea\u05ea\u05e3 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4[[\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4]] \"[[\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05dc\u05de\u05d5\u05e1\u05d9\u05e7\u05d4 (\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4)|\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05dc\u05de\u05d5\u05e1\u05d9\u05e7\u05d4]]\" \u05db\u05d7\u05dc\u05e7 \u05de\u05e6\u05d5\u05d5\u05ea \u05d4\u05de\u05d5\u05e8\u05d9\u05dd, \u05dc\u05e6\u05d3\u05dd \u05e9\u05dc \u05d4\u05d6\u05de\u05e8\u05d9\u05dd [[\u05d9\u05d4\u05d5\u05e8\u05dd \u05d2\u05d0\u05d5\u05df]], [[\u05e7\u05e8\u05df \u05e4\u05dc\u05e1]] \u05d5[[\u05de\u05ea\u05d9 \u05db\u05e1\u05e4\u05d9]] \u05d5\u05d1\u05d4\u05e0\u05d7\u05d9\u05d9\u05ea\u05d5 \u05e9\u05dc [[\u05e6\u05d1\u05d9\u05e7\u05d4 \u05d4\u05d3\u05e8]]. \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea, \u05e9\u05e2\u05dc\u05ea\u05d4 \u05dc\u05e9\u05d9\u05d3\u05d5\u05e8 \u05dc\u05e7\u05e8\u05d0\u05ea \u05e1\u05d5\u05e3 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4, \u05e9\u05d5\u05d3\u05e8\u05d4 \u05d1[[\u05e2\u05e8\u05d5\u05e5 2]] \u05d1\u05de\u05e1\u05d2\u05e8\u05ea [[\u05e9\u05d9\u05d3\u05d5\u05e8\u05d9 \u05e7\u05e9\u05ea|\u05d4\u05d6\u05db\u05d9\u05d9\u05e0\u05d9\u05ea \u05e7\u05e9\u05ea]]. \u05e4\u05e8\u05e5 \u05e0\u05d0\u05dc\u05e5 \u05dc\u05d4\u05d7\u05de\u05d9\u05e5 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d9\u05de\u05d9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05e9\u05dc \u05de\u05e1\u05e2 \u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05e9\u05e2\u05e8\u05da \u05d1[[\u05d0\u05e8\u05e6\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea]] \u05dc\u05e7\u05e8\u05d0\u05ea \u05e1\u05d5\u05e3 \u05d7\u05d5\u05d3\u05e9 \u05e0\u05d5\u05d1\u05de\u05d1\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4. \u05d1\u05de\u05d4\u05dc\u05da \u05de\u05e1\u05e2 \u05d4\u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05e9\u05dc\u05d5 \u05d1\u05d0\u05e8\u05e6\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea \u05d4\u05d5\u05e4\u05d9\u05e2 \u05e4\u05e8\u05e5 \u05d1\u05d9\u05df \u05d4\u05d9\u05ea\u05e8 \u05d1\u05e2\u05d9\u05e8 [[\u05dc\u05d5\u05e1 \u05d0\u05e0\u05d2'\u05dc\u05e1]] \u05d1\"\u05d0\u05de\u05e4\u05d9\u05ea\u05d9\u05d0\u05d8\u05e8\u05d5\u05df \u05d2\u05d9\u05d1\u05e1\u05d5\u05df\" \u05de\u05d5\u05dc \u05e7\u05d4\u05dc \u05d1\u05df \u05d9\u05d5\u05ea\u05e8 \u05de-6,000 \u05d0\u05d9\u05e9.\n\n=== \u05de\u05e0\u05d8\u05d5\u05e8 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 ===\n\u05d1\u05e9\u05e0\u05ea [[2012]] \u05d4\u05e6\u05d8\u05e8\u05e3 \u05e4\u05e8\u05e5 \u05d0\u05dc \u05d7\u05d1\u05e8 \u05d4\u05e9\u05d5\u05e4\u05d8\u05d9\u05dd \u05e9\u05dc \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05de\u05e6\u05d9\u05d0\u05d5\u05ea \"[[\u05db\u05d5\u05db\u05d1 \u05e0\u05d5\u05dc\u05d3]]\". \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2012 \u05d1\u05d2\u05de\u05e8 \u05db\u05d5\u05db\u05d1 \u05e0\u05d5\u05dc\u05d3 \u05d7\u05e9\u05e3 \u05e4\u05e8\u05e5 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"[[\u05d0\u05d5\u05dc\u05d9 \u05d4\u05dc\u05d9\u05dc\u05d4]]\", \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05de\u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e9\u05d9\u05e9\u05d9. \u05d1\u05e2\u05e8\u05d1 \u05e8\u05d0\u05e9 \u05d4\u05e9\u05e0\u05d4 2012 \u05d6\u05db\u05d4 \u05e9\u05d9\u05e8\u05d5 \u05e9\u05dc \u05e4\u05e8\u05e5 \"\u05d6\u05d9\u05e7\u05d5\u05e7\u05d9\u05dd\" \u05d1\u05ea\u05d5\u05d0\u05e8 \u05e9\u05d9\u05e8 \u05d4\u05e9\u05e0\u05d4 \u05d1[[\u05de\u05e6\u05e2\u05d3 \u05d4\u05e4\u05d6\u05de\u05d5\u05e0\u05d9\u05dd \u05d4\u05e2\u05d1\u05e8\u05d9 \u05d4\u05e9\u05e0\u05ea\u05d9]] \u05e9\u05dc [[\u05e8\u05e9\u05ea \u05d2]]. \u05d1-[[14 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8]] 2012 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8 \"\u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4\" \u05dc\u05e7\u05e8\u05d0\u05ea \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e9\u05d9\u05e9\u05d9.\n\n\u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 [[2013]] \u05d4\u05d5\u05e6\u05d9\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d0\u05ea \u05d4[[\u05e1\u05d9\u05e0\u05d2\u05dc]] \"\u05d4\u05d8\u05e2\u05dd \u05d4\u05d9\u05e9\u05df\". \u05d1\u05de\u05e8\u05e5 2013 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05d7\u05dc\u05de\u05ea\u05d9\", \u05d0\u05d5\u05ea\u05d5 \u05db\u05ea\u05d1 [[\u05d9\u05d5\u05e1\u05d9 \u05d1\u05df \u05d3\u05d5\u05d3 (\u05e4\u05d6\u05de\u05d5\u05e0\u05d0\u05d9)|\u05d9\u05d5\u05e1\u05d9 \u05d1\u05df \u05d3\u05d5\u05d3]] \u05d5\u05d4\u05dc\u05d7\u05d9\u05df [[\u05e0\u05d3\u05d1 \u05d0\u05e1\u05d5\u05dc\u05d9\u05df]]. \u05d1\u05e9\u05e0\u05ea 2013, \u05d4\u05d3\u05e8\u05d9\u05da \u05d0\u05ea [[\u05d0\u05d2\u05dd \u05d1\u05d5\u05d7\u05d1\u05d5\u05d8]] \u05d1\u05ea \u05d4\u05ea\u05e9\u05e2, \u05e9\u05d6\u05db\u05ea\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \"[[\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05dc\u05de\u05d5\u05e1\u05d9\u05e7\u05d4 (\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4)|\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05dc\u05de\u05d5\u05d6\u05d9\u05e7\u05d4]]\", \u05d4\u05de\u05d7\u05d6\u05d5\u05e8 \u05d4\u05e9\u05e0\u05d9. \u05d1\u05de\u05d0\u05d9 2013 \u05e2\u05d6\u05d1 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \"[[\u05db\u05d5\u05db\u05d1 \u05e0\u05d5\u05dc\u05d3]]\" \u05d5\"\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05dc\u05de\u05d5\u05e1\u05d9\u05e7\u05d4\", \u05d5\u05e2\u05d1\u05e8 \u05dc\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05de\u05ea\u05d7\u05e8\u05d4 \"[[\u05d0\u05e7\u05e1 \u05e4\u05e7\u05d8\u05d5\u05e8 (\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea)|\u05d0\u05e7\u05e1 \u05e4\u05e7\u05d8\u05d5\u05e8]]\". \u05e4\u05e8\u05e5 \u05e9\u05d9\u05de\u05e9 \u05db\u05e9\u05d5\u05e4\u05d8 \u05d5\u05db[[\u05de\u05e0\u05d8\u05d5\u05e8]] \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05e9\u05de\u05e9\u05d5\u05d3\u05e8\u05ea \u05d1[[\u05e2\u05e8\u05d5\u05e5 2]], \u05d2\u05dd \u05d1\u05e2\u05d5\u05e0\u05d4 \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4. \u05d1\u05d9\u05d5\u05e0\u05d9 2013 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d1\u05d9\u05d7\u05d3 \u05e2\u05dd [[\u05dc\u05d9\u05d0\u05d5\u05e8 \u05e0\u05e8\u05e7\u05d9\u05e1]] \u05d0\u05ea \u05d4\u05d3\u05d5\u05d0\u05d8 \u05d4\u05e7\u05e6\u05d1\u05d9 \"\u05de\u05d5\u05dc \u05db\u05dc \u05d4\u05e2\u05d5\u05dc\u05dd\" \u05d0\u05d5\u05ea\u05d5 \u05d2\u05dd \u05db\u05ea\u05d1 \u05d5\u05d4\u05dc\u05d7\u05d9\u05df. \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2013 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e9\u05d9\u05e9\u05d9 \u05d1\u05de\u05e1\u05e4\u05e8 \"[[\u05db\u05dc \u05d4\u05de\u05d9\u05dc\u05d9\u05dd \u05d4\u05e9\u05de\u05d7\u05d5\u05ea]]\", \u05de\u05ea\u05d5\u05db\u05d5 \u05d1\u05dc\u05d8\u05d5 \u05d4\u05d3\u05d5\u05d0\u05d8 \"\u05d9\u05dc\u05d3\u05d4 \u05e7\u05d8\u05e0\u05d4\" \u05e2\u05dd \u05d0\u05d2\u05dd \u05d1\u05d5\u05d7\u05d1\u05d5\u05d8 \u05d5\u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \"\u05db\u05dc \u05d4\u05de\u05d9\u05dc\u05d9\u05dd \u05d4\u05e9\u05de\u05d7\u05d5\u05ea\", \"\u05d0\u05ea \u05e9\u05d0\u05d4\u05d1\u05d4 \u05e0\u05e4\u05e9\u05d9\" \u05d5-\"\u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea\".\n\n=== 2014 \u05d5\u05d0\u05d9\u05dc\u05da ===\n[[\u05e7\u05d5\u05d1\u05e5:119306 jerusalem - expressions of protest and expressing PikiWiki Israel.jpg|\u05de\u05de\u05d5\u05d6\u05e2\u05e8|\u05d4\u05e4\u05d5\u05e1\u05d8\u05e8 \u05e9\u05dc \u05d4\u05ea\u05e6\u05e4\u05d9\u05ea\u05e0\u05d9\u05ea \u05d0\u05d2\u05dd \u05d1\u05e8\u05d2\u05e8 \u05e9\u05d1\u05d4\u05e9\u05e8\u05d0\u05ea\u05d4 \u05e0\u05db\u05ea\u05d1 \u05d4\u05e9\u05d9\u05e8 \"\u05d1\u05d3\u05e8\u05da \u05d0\u05de\u05d5\u05e0\u05d4 \u05d1\u05d7\u05e8\u05ea\u05d9\"]]\n\n\u05d1-[[19 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8]] [[2014]] \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05d2\u05dc \"\u05d0\u05dd \u05d6\u05d0\u05ea \u05de\u05dc\u05d7\u05de\u05d4\", \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05de\u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e9\u05d1\u05d9\u05e2\u05d9. \u05d1-[[\u05d9\u05d5\u05e0\u05d9|24 \u05d1\u05d9\u05d5\u05e0\u05d9]] 2014 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05dc\u05ea\u05d7\u05e0\u05d5\u05ea \u05d4\u05e8\u05d3\u05d9\u05d5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \u05d4\u05e9\u05e0\u05d9 \"\u05ea\u05d4\u05d9\u05d4 \u05de\u05d0\u05d5\u05e9\u05e8\". \u05d1\u05e2\u05e8\u05d1 \u05e8\u05d0\u05e9 \u05d4\u05e9\u05e0\u05d4 2014 \u05d6\u05db\u05d5 \u05e4\u05e8\u05e5 \u05d5\u05d4\u05d9\u05dc\u05d3\u05d4 \u05d0\u05d2\u05dd \u05d1\u05d5\u05d7\u05d1\u05d5\u05d8 \u05e2\u05dd \u05d4\u05e9\u05d9\u05e8 \"\u05d9\u05dc\u05d3\u05d4 \u05e7\u05d8\u05e0\u05d4\" \u05d1\u05ea\u05d5\u05d0\u05e8 \u05d3\u05d5\u05d0\u05d8 \u05d4\u05e9\u05e0\u05d4 \u05dc\u05e9\u05e0\u05ea \u05ea\u05e9\u05e2\"\u05d3 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05e0\u05ea\u05d9 \u05e9\u05dc \u05d0\u05ea\u05e8 [[mako]] \u05d5[[\u05e2\u05e8\u05d5\u05e5 24]].\n\n\u05d1-[[20 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8]] [[2015]] \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"[[\u05d1\u05e8\u05e6\u05dc\u05d5\u05e0\u05d4 (\u05e9\u05d9\u05e8)|\u05d1\u05e8\u05e6\u05dc\u05d5\u05e0\u05d4]]\", \u05d4\u05e9\u05d9\u05e8 \u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05e9\u05de\u05d9\u05e0\u05d9 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05dc [[\u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8]].<ref name=\":0\">{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://mediaforest-group.com/weekly_charts.html|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d4\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05dc \u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8|\u05d0\u05ea\u05e8=[[\u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8]]}}</ref> \u05d1-[[22 \u05d1\u05de\u05e8\u05e5]] \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"[[\u05d2\u05dd \u05d0\u05dd \u05d4\u05e2\u05d5\u05dc\u05dd \u05d9\u05ea\u05d4\u05e4\u05da]]\" \u05e9\u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05e9\u05e0\u05d9 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05dc \u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8.<ref name=\":0\" /> \u05d1-[[19 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc]] \u05e9\u05dc \u05d0\u05d5\u05ea\u05d4 \u05d4\u05e9\u05e0\u05d4 \u05d4\u05e9\u05ea\u05ea\u05e3 \u05e4\u05e8\u05e5 \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05de\u05e9\u05d5\u05ea\u05e3 \u05e9\u05dc \"[[\u05d9\u05d3\u05d9\u05e2\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea]]\" \u05d5\u05e9\u05dc \u05d4\u05de\u05d5\u05d6\u05d9\u05e7\u05d0\u05d9 [[\u05d3\u05d5\u05e8\u05d5\u05df \u05de\u05d3\u05dc\u05d9]] \u05dc\u05d6\u05db\u05e8 [[\u05d7\u05dc\u05dc\u05d9 \u05e6\u05d4\"\u05dc]] \u05e9\u05e0\u05e4\u05dc\u05d5 \u05d1\"[[\u05de\u05d1\u05e6\u05e2 \u05e6\u05d5\u05e7 \u05d0\u05d9\u05ea\u05df]]\", \u05d1\u05de\u05e1\u05d2\u05e8\u05ea\u05d5 \u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05e9\u05d9\u05e8 \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \"\u05d0\u05d7 \u05e9\u05dc\u05d9\" \u05dc\u05de\u05d9\u05dc\u05d9\u05dd \u05d5\u05dc\u05d7\u05df \u05e9\u05dc \u05de\u05d3\u05dc\u05d9. \u05d0\u05ea \u05e7\u05dc\u05d9\u05e4 \u05d4\u05e9\u05d9\u05e8 \u05e6\u05d9\u05dc\u05dd \u05e4\u05e8\u05e5 \u05d1\u05d9\u05d7\u05d3 \u05e2\u05dd \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d4\u05d7\u05dc\u05dc\u05d9\u05dd \u05d1[[\u05e2\u05d5\u05d8\u05e3 \u05e2\u05d6\u05d4]]. \u05d1-[[11 \u05d1\u05de\u05d0\u05d9]] 2015 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e9\u05d1\u05d9\u05e2\u05d9 \u05d1\u05e7\u05e8\u05d9\u05d9\u05e8\u05d4 \"[[\u05e1\u05d9\u05de\u05e0\u05d9 \u05d4\u05d6\u05de\u05df]]\". \u05d1\u05e7\u05d9\u05e5 2015 \u05d9\u05e6\u05d0 \u05e4\u05e8\u05e5 \u05d1\u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05d6\u05de\u05e8 [[\u05e2\u05d5\u05de\u05e8 \u05d0\u05d3\u05dd]] \u05dc\u05de\u05e1\u05e2 \u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05de\u05e9\u05d5\u05ea\u05e3 \u05d1\u05e8\u05d7\u05d1\u05d9 \u05d4\u05d0\u05e8\u05e5 \u05d1\u05e9\u05dd \"\u05de\u05d4\u05e4\u05db\u05d4\" \u05e9\u05d6\u05db\u05d4 \u05dc\u05d4\u05e6\u05dc\u05d7\u05d4 \u05e2\u05e0\u05e7\u05d9\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05de\u05e6\u05d5\u05e4\u05d4. \u05d1\u05de\u05d4\u05dc\u05da \u05de\u05e1\u05e2 \u05d4\u05d4\u05d5\u05e4\u05e2\u05d5\u05ea \u05d4\u05de\u05e9\u05d5\u05ea\u05e3 \u05d4\u05d5\u05e6\u05d9\u05d0\u05d5 \u05e4\u05e8\u05e5 \u05d5\u05d0\u05d3\u05dd \u05d0\u05ea \u05d4\u05d3\u05d5\u05d0\u05d8 \"[[\u05d4\u05d9\u05d0 \u05e8\u05e7 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05e8\u05e7\u05d5\u05d3]]\" \u05e9\u05d4\u05e4\u05da \u05dc\u05d0\u05d7\u05d3 \u05d4\u05e9\u05d9\u05e8\u05d9\u05dd \u05d4\u05de\u05e6\u05dc\u05d9\u05d7\u05d9\u05dd \u05d5\u05d4\u05e4\u05d5\u05e4\u05d5\u05dc\u05e8\u05d9\u05d9\u05dd \u05d1\u05d9\u05d5\u05ea\u05e8 \u05d1\u05d0\u05d5\u05ea\u05d4 \u05ea\u05e7\u05d5\u05e4\u05d4 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc. \u05d1\u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e7\u05dc\u05d9\u05e4 \u05de\u05dc\u05d0 \u05d1\u05d5 \u05e9\u05e8 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8 \"[[\u05de\u05d9\u05e9\u05d4\u05d5 \u05d4\u05d5\u05dc\u05da \u05ea\u05de\u05d9\u05d3 \u05d0\u05d9\u05ea\u05d9]]\" \u05e9\u05dc [[\u05e2\u05e4\u05e8\u05d4 \u05d7\u05d6\u05d4]]{{\u05d4\u05e2\u05e8\u05d4|{{Citation|last=Yoram Swisa Swis Music Group|title=\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 - \u05de\u05d9\u05e9\u05d4\u05d5 \u05d4\u05d5\u05dc\u05da \u05ea\u05de\u05d9\u05d3 \u05d0\u05d9\u05ea\u05d9 - \u05de\u05e0\u05d2\u05d9\u05e0\u05d4 \u05dc\u05de\u05d3\u05d9\u05e0\u05d4 - \u05d9\u05d5\u05e8\u05dd \u05e1\u05d5\u05d5\u05d9\u05e1\u05d4|date=2015-04-23|url=https://www.youtube.com/watch?v=EIaQg27bDMg|accessdate=2018-08-02}}}}.\n\n\u05d1\u05e1\u05d5\u05e3 2016, \u05d4\u05d5\u05d0 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \"\u05db\u05d5\u05e1 \u05e9\u05dc \u05d9\u05d9\u05df\" \u05e9\u05d4\u05e4\u05da \u05dc\u05dc\u05d4\u05d9\u05d8 \u05d2\u05d3\u05d5\u05dc. \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05d1\u05d0\u05d5 \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \"\u05dc\u05d9\u05dc\u05d5\u05ea \u05d0\u05e8\u05d5\u05db\u05d9\u05dd\" \u05d5-\"\u05e2\u05dc \u05de\u05e9\u05db\u05d1\u05d9\", \u05d3\u05d5\u05d0\u05d8 \u05e2\u05dd [[\u05d7\u05e0\u05df \u05d1\u05df \u05d0\u05e8\u05d9]], \u05d5\u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e1\u05d9\u05e0\u05d2\u05dc \u05e0\u05d5\u05e1\u05e3 \u05d1\u05e9\u05dd \"\u05e7\u05e8\u05de\u05dc\u05d4\" \u05e9\u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4-12 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05e0\u05ea\u05d9 \u05e9\u05dc \u05d2\u05dc\u05d2\u05dc\u05e6{{\u05d4\u05e2\u05e8\u05d4|{{\u05d5\u05d5\u05d0\u05dc\u05d4||\u05d4\u05de\u05e6\u05e2\u05d3 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9 \u05d4\u05e9\u05e0\u05ea\u05d9 \u05e9\u05dc \u05d2\u05dc\u05d2\u05dc\u05e6 \u05d5-\u05d5\u05d5\u05d0\u05dc\u05d4! NEWS|3098137|19 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2017}}}} \u05d5\u05dc\u05de\u05e7\u05d5\u05dd \u05d4-7 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05e0\u05ea\u05d9 \u05e9\u05dc \u05e8\u05e9\u05ea \u05d2\u05d9\u05de\u05dc. \u05d1-7 \u05d1\u05d9\u05d5\u05e0\u05d9 2017, \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d0\u05dc\u05d1\u05d5\u05de\u05d5 \u05d4\u05e9\u05de\u05d9\u05e0\u05d9 \"\u05d1\u05d7\u05d5\u05e8 \u05d7\u05d3\u05e9\" \u05e9\u05de\u05db\u05e8 \u05d1\u05ea\u05d5\u05da \u05db\u05d7\u05d5\u05d3\u05e9 20 \u05d0\u05dc\u05e3 \u05e2\u05d5\u05ea\u05e7\u05d9\u05dd \u05d5\u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e2\u05de\u05d3 [[\u05d0\u05dc\u05d1\u05d5\u05dd \u05d6\u05d4\u05d1]]{{\u05d4\u05e2\u05e8\u05d4|{{ynet|[[\u05d2\u05d0\u05d9\u05d4 \u05e7\u05d5\u05e8\u05df]]|\u05e8\u05e7 \u05e8\u05d5\u05e6\u05d4 \u05dc\u05d9\u05e9\u05d5\u05df|4987483|10 \u05d1\u05d9\u05d5\u05dc\u05d9 2017}}}}.\n\n\u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 [[2018]] \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d1\u05d9\u05d7\u05d3 \u05e2\u05dd [[\u05e0\u05e1\u05e8\u05d9\u05df \u05e7\u05d3\u05e8\u05d9]] \u05d0\u05ea \u05d4[[\u05dc\u05d4\u05d9\u05d8]] \"[[\u05d4\u05d9\u05d9\u05e0\u05d5 \u05e9\u05e0\u05d9\u05d9\u05dd]]\", \u05e9\u05d6\u05db\u05d4 \u05dc\u05d4\u05e6\u05dc\u05d7\u05d4 \u05e8\u05d1\u05d4 \u05d1\u05d0\u05e8\u05e5, \u05d5\u05d0\u05e3 \u05e0\u05db\u05dc\u05dc \u05d1\u05d0\u05dc\u05d1\u05d5\u05de\u05d4 \u05d4-3 [[\u05dc\u05d5\u05de\u05d3\u05ea \u05dc\u05dc\u05db\u05ea]]. \u05d1[[\u05d9\u05d5\u05d8\u05d9\u05d5\u05d1]], \u05d6\u05db\u05d4 \u05d4\u05e7\u05dc\u05d9\u05e4 \u05e9\u05dc \u05d4\u05e9\u05d9\u05e8 \u05dc\u05d4\u05e6\u05dc\u05d7\u05d4 \u05d7\u05e1\u05e8\u05ea \u05ea\u05e7\u05d3\u05d9\u05dd \u05d2\u05dd \u05db\u05df, \u05db\u05d0\u05e9\u05e8 \u05e6\u05d1\u05e8 \u05dc\u05de\u05e2\u05dc\u05d4 \u05de-11 \u05de\u05d9\u05dc\u05d9\u05d5\u05df \u05e6\u05e4\u05d9\u05d5\u05ea{{\u05d4\u05e2\u05e8\u05d4|{{Citation|last=\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5|title=\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d5\u05e0\u05e1\u05e8\u05d9\u05df \u05e7\u05d3\u05e8\u05d9 - \u05d4\u05d9\u05d9\u05e0\u05d5 \u05e9\u05e0\u05d9\u05d9\u05dd|date=2018-02-17|url=https://www.youtube.com/watch?v=vsW46vhVX4U|accessdate=2018-09-08}}}}. \u05d1-[[17 \u05d1\u05de\u05d0\u05d9]] 2018, \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05e9\u05dc\u05d5\u05e9\u05d4 \u05d3\u05d5\u05d0\u05d8\u05d9\u05dd \u05e2\u05dd [[\u05d0\u05d9\u05d9\u05dc \u05d2\u05d5\u05dc\u05df]]: \"\u05d4\u05d5\u05dc\u05db\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05d2\u05e2\" \u05d5\"\u05d4\u05de\u05d9\u05dc\u05d9\u05dd \u05d4\u05d7\u05e1\u05e8\u05d5\u05ea\" \u05d5\"\u05db\u05de\u05d4 \u05d9\u05de\u05d9\u05dd\"{{\u05d4\u05e2\u05e8\u05d4|{{\u05d5\u05d5\u05d0\u05dc\u05d4||\u05d4\u05d0\u05d6\u05d9\u05e0\u05d5 \u05dc\u05e9\u05e0\u05d9 \u05d3\u05d5\u05d0\u05d8\u05d9\u05dd \u05e9\u05dc \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d5\u05d0\u05d9\u05d9\u05dc \u05d2\u05d5\u05dc\u05df: \"\u05d4\u05d5\u05dc\u05db\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05d2\u05e2\" \u05d5\"\u05d4\u05de\u05d9\u05dc\u05d9\u05dd \u05d4\u05d7\u05e1\u05e8\u05d5\u05ea\"|3158778|17 \u05d1\u05de\u05d0\u05d9 2018}}}}.\n\n\u05d1-[[25 \u05d1\u05d9\u05d5\u05dc\u05d9]] 2018, \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d5[[\u05d0\u05d9\u05d9\u05dc \u05d2\u05d5\u05dc\u05df]] \u05e9\u05d9\u05ea\u05e4\u05d5 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05e2\u05dc \u05d1\u05de\u05d4 \u05d0\u05d7\u05ea \u05d1\u05de\u05d5\u05e4\u05e2 \u05de\u05d5\u05d6\u05d9\u05e7\u05dc\u05d9 \u05de\u05e9\u05d5\u05ea\u05e3 \u05d1\u05e9\u05dd \"\u05d4\u05d5\u05dc\u05db\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05d2\u05e2\"{{\u05d4\u05e2\u05e8\u05d4|{{\u05d5\u05d5\u05d0\u05dc\u05d4||\u05de\u05e4\u05d2\u05e9 \u05e4\u05e1\u05d2\u05d4: \u05d0\u05d9\u05d9\u05dc \u05d2\u05d5\u05dc\u05df \u05d5\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d9\u05e2\u05e8\u05db\u05d5 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05de\u05d5\u05e4\u05e2 \u05de\u05e9\u05d5\u05ea\u05e3|3165424|12 \u05d1\u05d9\u05d5\u05e0\u05d9 2018}}}}. \u05d1\u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4 \u05d1[[\u05d7\u05e0\u05d5\u05db\u05d4]] \u05e4\u05e8\u05e5 \u05d4\u05d5\u05e4\u05d9\u05e2 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d1\u05de\u05d5\u05e4\u05e2 \"[[\u05e4\u05e1\u05d8\u05d9\u05d2\u05dc|#freestyle \u05e4\u05e1\u05d8\u05d9\u05d2\u05dc]]\". \u05dc\u05e6\u05d3 [[\u05e2\u05d9\u05d3\u05df \u05e8\u05d9\u05d9\u05db\u05dc]], [[\u05e0\u05d5\u05e2\u05d4 \u05e7\u05d9\u05e8\u05dc]] \u05d5[[\u05de\u05e8\u05d2\u05d9 (\u05de\u05d5\u05d6\u05d9\u05e7\u05d0\u05d9)|\u05d9\u05d4\u05d5\u05e0\u05ea\u05df \u05de\u05e8\u05d2\u05d9]].\n\n\u05d1-[[10 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8]] [[2019]] \u05e4\u05d5\u05e8\u05e1\u05dd \u05e9\u05e4\u05e8\u05e5 \u05d5[[\u05d0\u05dc\u05e0\u05d9 \u05e4\u05d5\u05e8\u05d9\u05d9\u05e8\u05d4]] \u05d9\u05d1\u05e6\u05e2\u05d5 \u05d3\u05d5\u05d0\u05d8 \u05d7\u05d3\u05e9 \u05e2\u05dc \u05d1\u05d9\u05de\u05ea \u05e7\u05d9\u05e1\u05e8\u05d9\u05d4{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05d0\u05e7\u05d5||\u05de\u05e9\u05d4 \u05d5\u05d0\u05dc\u05e0\u05d9 \u05d9\u05d1\u05e6\u05e2\u05d5 \u05d3\u05d5\u05d0\u05d8 \u05d7\u05d3\u05e9 \u05d1\u05e7\u05d9\u05e1\u05e8\u05d9\u05d4|90c61885e7a1d61027|music-news/local|10 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2019}}}}. \u05d1\u05d4\u05d5\u05e4\u05e2\u05ea\u05d5 \u05d1\u05e7\u05d9\u05e1\u05e8\u05d9\u05d4 \u05d1-[[18 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8]] \u05e9\u05e8\u05d5 \u05d9\u05d7\u05d3 \u05d1\u05d2\u05e8\u05e1\u05d4 \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea \u05d0\u05ea \u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc \u05e4\u05d5\u05e8\u05d9\u05d9\u05e8\u05d4 \u05e9\u05d9\u05e6\u05d0 \u05db\u05d7\u05d5\u05d3\u05e9\u05d9\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d4\u05d5\u05e4\u05e2\u05d4 \"Loquita\" \u05e9\u05d1\u05de\u05e7\u05d5\u05e8 \u05d4\u05d5\u05d0 \u05d3\u05d5\u05d0\u05d8 \u05e2\u05dd \u05d4\u05d6\u05de\u05e8 \u05d4\u05d9\u05d5\u05d5\u05e0\u05d9 \u05e7\u05dc\u05d9\u05d9\u05d3\u05d9{{\u05d4\u05e2\u05e8\u05d4|{{\u05d9\u05d5\u05e8\u05d5\u05de\u05d9\u05e7\u05e1|\u05d0\u05d1\u05d9 \u05d6\u05d9\u05d9\u05e7\u05e0\u05e8|\u05d0\u05dc\u05e0\u05d9 \u05e4\u05d5\u05e8\u05d9\u05d9\u05e8\u05d4 \u05d5\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d1\u05e9\u05d9\u05e8 \u05d7\u05d3\u05e9|2019/09/19/\u05d0\u05dc\u05e0\u05d9-\u05e4\u05d5\u05e8\u05d9\u05d9\u05e8\u05d4-\u05d5\u05de\u05e9\u05d4-\u05e4\u05e8\u05e5-\u05d1\u05e9\u05d9\u05e8-\u05d7\u05d3\u05e9}}}}. \u05d1[[\u05d7\u05e0\u05d5\u05db\u05d4]] \u05d1\u05d0\u05d5\u05ea\u05d4 \u05e9\u05e0\u05d4 \u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05d5\u05e4\u05e2 \"\u05e4\u05d5\u05e4 \u05d0\u05e4 \u05de\u05d9\u05d5\u05d6\u05d9\u05e7 2\" \u05e2\u05dd [[\u05e0\u05d8\u05e2 \u05d1\u05e8\u05d6\u05d9\u05dc\u05d9]] \u05d5[[\u05e2\u05d5\u05de\u05e8 \u05d0\u05d3\u05dd]].\n\n\u05d1\u05e9\u05e0\u05ea 2020 \u05d7\u05d6\u05e8 \u05dc\u05e6\u05d5\u05d5\u05ea \u05d4\u05de\u05d5\u05e8\u05d9\u05dd \u05e9\u05dc \u05e2\u05d5\u05e0\u05d4 4 \u05e9\u05dc \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05dc\u05de\u05d5\u05d6\u05d9\u05e7\u05d4, \u05d4\u05e4\u05e2\u05dd \u05dc\u05e6\u05d3 \u05e9\u05dc\u05d5\u05e9\u05d4 \u05de\u05d5\u05e8\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd: [[\u05de\u05d9\u05e8\u05d9 \u05de\u05e1\u05d9\u05e7\u05d4]], [[\u05e0\u05d5\u05e2\u05d4 \u05e7\u05d9\u05e8\u05dc]] \u05d5[[\u05d4\u05e8\u05d0\u05dc \u05e1\u05e7\u05e2\u05ea]], \u05d5\u05dc\u05e6\u05d3 \u05d4\u05de\u05e0\u05d4\u05dc \u05d4\u05d7\u05d3\u05e9 \u05e9\u05dc \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 [[\u05e2\u05d9\u05d3\u05d5 \u05e8\u05d5\u05d6\u05e0\u05d1\u05dc\u05d5\u05dd]].\n\n\u05d1-[[3 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8]] [[2022]] \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"[[\u05de\u05d4 \u05e0\u05e9\u05d0\u05e8]]\", \u05e9\u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05e9\u05dc\u05d9\u05e9\u05d9 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05dc [[\u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8]]. \u05d1-14 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05e0\u05d9\u05d2\u05e9\u05ea \u05dc\u05d0\u05d8\". \u05d1-14 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05d3\u05d5\u05df \u05d7\u05d5\u05dc\u05d9\u05d5\". \u05d1-15 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05d0\u05d4\u05d1\u05d4 \u05db\u05d6\u05d0\u05ea\" \u05e2\u05dd [[\u05dc\u05d9\u05d0\u05d5\u05e8 \u05e0\u05e8\u05e7\u05d9\u05e1]]. \u05d1-22 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05de\u05e1\u05dc\u05d5\u05e0\u05d9\u05e7\u05d9 \u05e2\u05d3 \u05dc\u05d9\u05e4\u05d5\" \u05e9\u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4-11 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05dc \u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8.<ref name=\":0\" />\n\n\u05d1-12 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2023 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05e7\u05e8\u05d5\u05d1\u05d9\u05dd\" \u05e2\u05dd [[\u05e9\u05dc\u05d5\u05de\u05d9 \u05e9\u05d1\u05ea]]. \u05d1-10 \u05d1\u05de\u05d0\u05d9 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc\u05d9\u05dd \"\u05d2\u05e2\u05d2\u05d5\u05e2\" \u05d5\"\u05dc\u05d6\u05d5\u05d6\", \u05db\u05e9\u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4-15 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e2\u05d1\u05e8\u05d9 \u05e9\u05dc \u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8. \u05d1-29 \u05d1\u05de\u05d0\u05d9 2023 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \"[[\u05d2\u05e2\u05d2\u05d5\u05e2 (\u05d0\u05dc\u05d1\u05d5\u05dd \u05e9\u05dc \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5)|\u05d2\u05e2\u05d2\u05d5\u05e2]]\". \u05d1-13 \u05d1\u05d9\u05d5\u05dc\u05d9 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05de\u05ea\u05d2\u05e2\u05d2\u05e2\". \u05d1-21 \u05d1\u05d9\u05d5\u05dc\u05d9 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05db\u05e1\u05d9\u05e0\u05d2\u05dc \u05d2\u05e8\u05e1\u05ea \u05db\u05d9\u05e1\u05d5\u05d9 \u05dc\u05e9\u05d9\u05e8 \"[[\u05d0\u05d5\u05dc\u05e1\u05d8\u05d0\u05e8 \u05d5\u05d2\u05d5\u05e4\u05d9\u05d5\u05ea]]\" \u05e9\u05dc [[\u05d0\u05e0\u05d4 \u05d6\u05e7]]. \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 \u05e4\u05d5\u05e8\u05e1\u05dd \u05db\u05d9 [[\u05d0\u05d2\u05dd \u05d1\u05d5\u05d7\u05d1\u05d5\u05d8]] \u05d5\u05e4\u05e8\u05e5 \u05e2\u05d5\u05de\u05d3\u05d9\u05dd \u05d1\u05e4\u05e0\u05d9 \u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd \u05d5\u05e0\u05e4\u05e8\u05d3\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e2\u05e9\u05d5\u05e8 \u05e9\u05dc \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4. \u05d4\u05d4\u05dc\u05d9\u05db\u05d9\u05dd \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05d9\u05dd \u05d4\u05dd \u05d1\u05e9\u05dc \u05d7\u05d9\u05dc\u05d5\u05e7\u05d9 \u05d3\u05e2\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05d4\u05d4\u05d9\u05d1\u05d8\u05d9\u05dd \u05d4\u05db\u05e1\u05e4\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e4\u05e8\u05d9\u05d3\u05d4 \u05d4\u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05e9\u05dc\u05d4\u05dd<ref>{{\u05de\u05d0\u05e7\u05d5|[[\u05d2\u05d9\u05dc \u05de\u05e9\u05e2\u05dc\u05d9]]|\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05d1\u05ea\u05e2\u05e9\u05d9\u05d9\u05ea \u05d4\u05de\u05d5\u05d6\u05d9\u05e7\u05d4 \u05de\u05d2\u05d9\u05d1\u05d9\u05dd \u05dc\u05d4\u05dc\u05d9\u05da \u05d4\u05de\u05e9\u05e4\u05d8\u05d9 \u05e9\u05dc \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d5\u05d0\u05d2\u05dd \u05d1\u05d5\u05d7\u05d1\u05d5\u05d8: \"\u05d4\u05e9\u05e7\u05d9\u05e2 \u05d1\u05d4 \u05db-2 \u05de\u05d9\u05dc\u05d9\u05d5\u05df \u05e9\u05e7\u05dc\"|a289b608e04d981026|music-news/local|8 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2023}}</ref>. \u05d1-19 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05ea \"[[\u05dc\u05e0\u05e6\u05d7 \u05ea\u05d9\u05e9\u05d0\u05e8]]\" \u05dc\u05d6\u05db\u05e8\u05dd \u05d5\u05d4\u05e0\u05e6\u05d7\u05ea\u05dd \u05e9\u05dc \u05d4\u05dc\u05d5\u05d7\u05de\u05d9\u05dd, \u05d5\u05d4\u05dc\u05d5\u05d7\u05de\u05d5\u05ea \u05e9\u05dc \u05e6\u05d4\"\u05dc \u05d5\u05db\u05d5\u05d7\u05d5\u05ea \u05d4\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05e9\u05e0\u05e4\u05dc\u05d5 \u05d1[[\u05de\u05dc\u05d7\u05de\u05ea \u05d7\u05e8\u05d1\u05d5\u05ea \u05d1\u05e8\u05d6\u05dc]]<ref>{{Citation|title=\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 - \u05dc\u05e0\u05e6\u05d7 \u05ea\u05d9\u05e9\u05d0\u05e8|url=https://www.youtube.com/watch?v=F5qAR3AUpuY|accessdate=2023-11-28}}</ref>.\n\n\u05d1-[[5 \u05d1\u05de\u05e8\u05e5]] [[2024]] \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05d0\u05ea \u05de\u05e7\u05d5\u05dd \u05e8\u05d0\u05e9\u05d5\u05df\"<ref>{{\u05e2\u05e8\u05d5\u05e5 7|[[\u05d0\u05e8\u05d9\u05d0\u05dc \u05e4\u05d9\u05d9\u05d2\u05dc\u05d9\u05df]]|\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5, \u05d4\u05e4\u05d9\u05dc \u05d4\u05db\u05d7\u05d5\u05dc \u05d5\u05e0\u05d9\u05e0\u05d8: \u05d6\u05de\u05e8\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05de\u05e9\u05d9\u05db\u05d9\u05dd \u05dc\u05d9\u05e6\u05d5\u05e8 \u05d0\u05ea \u05e4\u05e1\u05e7\u05d5\u05dc \u05d4\u05de\u05dc\u05d7\u05de\u05d4|631799|12 \u05d1\u05de\u05e8\u05e5 2024}}</ref>. \u05d1-[[16 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc]] \u05e4\u05e8\u05e5 \u05d4\u05e9\u05d9\u05e7 \u05e1\u05d9\u05e0\u05d2\u05dc \u05d0\u05d4\u05d1\u05d4 \u05d7\u05d3\u05e9 \u05d1\u05e9\u05dd \"\u05d0\u05d9\u05e4\u05d4 \u05d0\u05ea \u05d4\u05d9\u05d5\u05dd\"<ref>{{\u05de\u05e2\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e0\u05dc\u05d9\u05d9\u05df|\u05e8\u05d5\u05ea\u05d9 \u05d6\u05d5\u05d0\u05e8\u05e5|\"\u05d0\u05d9\u05e4\u05d4 \u05d0\u05ea \u05d4\u05d9\u05d5\u05dd\": \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05de\u05e9\u05d7\u05e8\u05e8 \u05e9\u05d9\u05e8 \u05d0\u05d4\u05d1\u05d4 \u05d7\u05d3\u05e9 \u05e2\u05dc \u05d0\u05d4\u05d1\u05d4 \u05d2\u05d3\u05d5\u05dc\u05d4 \u05d5\u05e4\u05e8\u05d9\u05d3\u05d4|culture/music/Article-1092673|17 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2024}}</ref>. \u05d1-[[12 \u05d1\u05de\u05d0\u05d9]] \u05e4\u05e8\u05e5 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e9\u05d9\u05e8 \u05d1\u05e9\u05dd \"\u05db\u05d5\u05dc\u05dd \u05d0\u05d4\u05d5\u05d1\u05d9\u05dd\" \u05dc\u05db\u05d1\u05d5\u05d3 [[\u05d9\u05d5\u05dd \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05d7\u05dc\u05dc\u05d9 \u05de\u05e2\u05e8\u05db\u05d5\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc]]. \u05d4\u05e9\u05d9\u05e8 \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05ea\u05e4\u05d9\u05dc\u05ea \"[[\u05d0\u05dc \u05de\u05dc\u05d0 \u05e8\u05d7\u05de\u05d9\u05dd]]\"<ref>{{Ynet|2=\"\u05d4\u05de\u05e2\u05d8 \u05e9\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05e9\u05d5\u05ea \u05dc\u05de\u05e2\u05df \u05d4\u05e0\u05d5\u05e4\u05dc\u05d9\u05dd\": \u05d4\u05d2\u05e8\u05e1\u05d4 \u05e9\u05dc \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05dc\"\u05d0\u05dc \u05de\u05dc\u05d0 \u05e8\u05d7\u05de\u05d9\u05dd\"|3=entertainment/article/hjv1rirfa|4=13 \u05d1\u05de\u05d0\u05d9 2024}}</ref>.\n\n\u05d1-4 \u05d1\u05d9\u05d5\u05e0\u05d9 2024, \u05e4\u05e8\u05e5 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05e1\u05d9\u05e0\u05d2\u05dc \u05e9\u05e0\u05d9 \u05de\u05ea\u05d5\u05da \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05de\u05d5\u05d6\u05d9\u05e7\u05dc\u05d9 \u05e9\u05dc\u05d5 \u05d1\u05e9\u05dd \"[[\u05de\u05ea\u05d5\u05e7 \u05de\u05d3\u05d1\u05e9 (\u05de\u05d9\u05e0\u05d9-\u05d0\u05dc\u05d1\u05d5\u05dd)|\u05de\u05ea\u05d5\u05e7 \u05de\u05d3\u05d1\u05e9]]\", \u05d4\u05de\u05e9\u05dc\u05d1 [[\u05de\u05d6\u05de\u05d5\u05e8]]\u05d9\u05dd \u05de\u05e7\u05d5\u05e8\u05d9\u05d9\u05dd \u05e2\u05dd \u05e9\u05d9\u05e8\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd \u05e9\u05d4\u05dc\u05d7\u05d9\u05df \u05e4\u05e8\u05e5. \u05d4\u05e9\u05d9\u05e8 \u05e0\u05e7\u05e8\u05d0 \"\u05d4\u05dc\u05dc\u05d5\u05d9\u05d4\", \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05d9\u05df \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05dc[[\u05d9\u05d5\u05e0\u05ea\u05df \u05e8\u05d6\u05d0\u05dc]]. \u05d4\u05de\u05d8\u05e8\u05d4 \u05d4\u05e2\u05d9\u05e7\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05d9\u05d0 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05d0\u05d7\u05d3\u05d5\u05ea \u05de\u05d5\u05d6\u05d9\u05e7\u05dc\u05d9\u05ea \u05d5\u05d0\u05d9\u05e9\u05d9\u05ea \u05d1\u05d9\u05df \u05d0\u05de\u05e0\u05d9\u05dd \u05de\u05e8\u05e7\u05e2\u05d9\u05dd \u05de\u05d2\u05d5\u05d5\u05e0\u05d9\u05dd, \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05de\u05d5\u05d3\u05dc \u05dc\u05d0\u05d7\u05d3\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05de\u05d0\u05d6\u05d9\u05e0\u05d9\u05dd \u05dc\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8. \u05d4\u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05de\u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05e0\u05ea\u05e8\u05de\u05d5 \u05dc\u05e9\u05d9\u05e7\u05d5\u05dd \u05d7\u05d9\u05d9\u05dc\u05d9\u05dd \u05e4\u05e6\u05d5\u05e2\u05d9\u05dd \u05d5\u05e0\u05e4\u05d2\u05e2\u05d9 \u05d7\u05e8\u05d3\u05d4 \u05de[[\u05de\u05dc\u05d7\u05de\u05ea \u05d7\u05e8\u05d1\u05d5\u05ea \u05d1\u05e8\u05d6\u05dc]]<ref>{{\u05db\u05d9\u05db\u05e8 \u05d4\u05e9\u05d1\u05ea|[[\u05d9\u05d0\u05d9\u05e8 \u05d8\u05d5\u05e7\u05e8]]|\u05d9\u05d5\u05e0\u05ea\u05df \u05e8\u05d6\u05d0\u05dc \u05d5\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d1\u05e1\u05d9\u05e0\u05d2\u05dc \u05d7\u05d3\u05e9: \"\u05d4\u05dc\u05dc\u05d5\u05d9-\u05d4\"|singles-clips/sek09r|4 \u05d1\u05d9\u05d5\u05e0\u05d9 2024}}</ref>. \u05d1\u05d9\u05d5\u05e0\u05d9 2024, \u05d9\u05e6\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05e1\u05d9\u05e0\u05d2\u05dc \u05de\u05e9\u05d5\u05ea\u05e3 \u05d1\u05e9\u05dd \"\u05de\u05d5\u05d3\u05d4 \u05d0\u05e0\u05d9\" \u05e9\u05dc \u05e4\u05e8\u05e5 \u05d5[[\u05de\u05d5\u05e7\u05d9]]. \u05d4\u05e9\u05d9\u05e8 \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05ea\u05e4\u05d9\u05dc\u05ea \u05d4\u05d1\u05d5\u05e7\u05e8 \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9\u05ea \"[[\u05de\u05d5\u05d3\u05d4 \u05d0\u05e0\u05d9]]\". \u05d1\u05d9\u05d5\u05dc\u05d9 2024, \u05d9\u05e6\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d4\u05e9\u05d9\u05e8 \"\u05e2\u05db\u05e9\u05d9\u05d5 \u05de\u05e8\u05d2\u05d9\u05e9 \u05d7\u05d3\u05e9\", \u05e1\u05d9\u05e0\u05d2\u05dc \u05de\u05e9\u05d5\u05ea\u05e3 \u05e9\u05dc \u05e4\u05e8\u05e5 \u05d5[[\u05d0\u05de\u05d9\u05e8 \u05d3\u05d3\u05d5\u05df]], \u05db\u05d7\u05dc\u05e7 \u05de\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05d3\u05d5\u05d0\u05d8\u05d9\u05dd \u05e9\u05dc \u05e4\u05e8\u05e5, \"\u05de\u05ea\u05d5\u05e7 \u05de\u05d3\u05d1\u05e9\". \u05d1\u05d0\u05d5\u05ea\u05d5 \u05d4\u05d7\u05d5\u05d3\u05e9, \u05d9\u05e6\u05d0 \u05dc\u05d0\u05d5\u05e8 \"\u05e2\u05e0\u05e0\u05d9\", \u05e1\u05d9\u05e0\u05d2\u05dc \u05de\u05e9\u05d5\u05ea\u05e3 \u05e9\u05dc \u05e4\u05e8\u05e5 \u05d5\u05d0\u05d7\u05d9\u05d5, \u05e0\u05d9\u05e8 \u05e4\u05e8\u05e5. \u05d1-22 \u05d1\u05d9\u05d5\u05dc\u05d9 \u05d9\u05e6\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8.\n\n\u05d1-8 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2024 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d0\u05ea \u05d4\u05de\u05d9\u05e0\u05d9-\u05d0\u05dc\u05d1\u05d5\u05dd \"[[\u05ea\u05d3\u05dc\u05d9\u05e7\u05d5 \u05d0\u05ea \u05d4\u05d0\u05d5\u05e8]]\" \u05d3\u05e8\u05da \u05d7\u05d1\u05e8\u05ea \u05d4\u05ea\u05e7\u05dc\u05d9\u05d8\u05d9\u05dd [[MP \u05e8\u05e7\u05d5\u05e8\u05d3\u05e1]]. \u05d4\u05d0\u05dc\u05d1\u05d5\u05dd \u05db\u05dc\u05dc \u05d7\u05de\u05d9\u05e9\u05d4 \u05e9\u05d9\u05e8\u05d9\u05dd, \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05d4\u05d3\u05d5\u05d0\u05d8 \"[[\u05ea\u05d3\u05dc\u05d9\u05e7\u05d5 \u05d0\u05ea \u05d4\u05d0\u05d5\u05e8 (\u05e9\u05d9\u05e8)|\u05ea\u05d3\u05dc\u05d9\u05e7\u05d5 \u05d0\u05ea \u05d4\u05d0\u05d5\u05e8]]\" \u05e2\u05dd [[\u05d3\u05e0\u05d4 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05e9\u05d9\u05d5\u05e0\u05dc]]. \u05e9\u05d9\u05ea\u05d5\u05e3 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05d9\u05df \u05e4\u05e8\u05e5 \u05dc\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05e9\u05d9\u05d5\u05e0\u05dc \u05e0\u05d5\u05e6\u05e8 \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05e6\u05e4\u05d9\u05d9\u05d4 \u05e9\u05dc \u05e4\u05e8\u05e5 \u05d1\u05e1\u05d3\u05e8\u05d4 \"[[\u05d3\u05e0\u05d4 \u05e7\u05de\u05d4]]\" \u05d5\u05de\u05e4\u05d2\u05e9 \u05d1\u05d9\u05e0\u05d9\u05d4\u05dd \u05d1\u05e6\u05d9\u05dc\u05d5\u05de\u05d9 \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \"[[MKR \u05d4\u05de\u05d8\u05d1\u05d7 \u05d4\u05de\u05e0\u05e6\u05d7]]\". \u05d4\u05e9\u05d9\u05e8\u05d9\u05dd \u05d1\u05de\u05d9\u05e0\u05d9-\u05d0\u05dc\u05d1\u05d5\u05dd \u05de\u05e9\u05dc\u05d1\u05d9\u05dd \u05e1\u05d2\u05e0\u05d5\u05e0\u05d5\u05ea \u05de\u05d5\u05d6\u05d9\u05e7\u05dc\u05d9\u05d9\u05dd \u05de\u05d2\u05d5\u05d5\u05e0\u05d9\u05dd \u05d5\u05de\u05d1\u05d8\u05d0\u05d9\u05dd \u05ea\u05d7\u05d5\u05e9\u05d5\u05ea \u05e9\u05dc \u05d4\u05ea\u05d7\u05d3\u05e9\u05d5\u05ea, \u05d0\u05d5\u05e4\u05d8\u05d9\u05de\u05d9\u05d5\u05ea \u05d5\u05d0\u05d7\u05d3\u05d5\u05ea<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.instagram.com/noshmim.mizrahit/p/DDlisFeK4y6/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05de\u05e9\u05d9\u05e7 \u05d0\u05ea '\u05ea\u05d3\u05dc\u05d9\u05e7\u05d5 \u05d0\u05ea \u05d4\u05d0\u05d5\u05e8' \u2013 \u05d0\u05dc\u05d1\u05d5\u05dd \u05d9\u05d5\u05e6\u05d0 \u05d3\u05d5\u05e4\u05df \u05e9\u05de\u05d0\u05d9\u05e8 \u05d0\u05ea \u05d4\u05de\u05d5\u05d6\u05d9\u05e7\u05d4 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea \u05d1\u05e9\u05d9\u05ea\u05d5\u05e4\u05d9 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05de\u05e1\u05e7\u05e8\u05e0\u05d9\u05dd!\"|\u05d0\u05ea\u05e8=Instagram|\u05ea\u05d0\u05e8\u05d9\u05da=15 \u05d3\u05e6\u05de\u05d1\u05e8 2024|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2025-02-25}}</ref>. \u05d1-18 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2024, \u05d9\u05e6\u05d0 \u05dc\u05d0\u05d5\u05e8 \"\u05d1\u05d0 \u05dc\u05d9\", \u05e1\u05d9\u05e0\u05d2\u05dc \u05de\u05e9\u05d5\u05ea\u05e3 \u05e9\u05dc \u05e4\u05e8\u05e5 \u05d5[[\u05e9\u05e9\u05d5\u05df \u05d0\u05d9\u05e4\u05e8\u05dd \u05e9\u05d0\u05d5\u05dc\u05d5\u05d1]]<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://yosmusic.com/\u05e9\u05e9\u05d5\u05df-\u05d0\u05d9\u05e4\u05e8\u05dd-\u05e9\u05d0\u05d5\u05dc\u05d5\u05d1-\u05de\u05e9\u05d4-\u05e4\u05e8\u05e5-\u05d1\u05d0-\u05dc\u05d9|\u05db\u05d5\u05ea\u05e8\u05ea=\u05e9\u05e9\u05d5\u05df \u05d0\u05d9\u05e4\u05e8\u05dd \u05e9\u05d0\u05d5\u05dc\u05d5\u05d1 \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u2013 \u05d1\u05d0 \u05dc\u05d9|\u05d0\u05ea\u05e8=\u05d9\u05d5\u05e1\u05de\u05d9\u05d5\u05d6\u05d9\u05e7|\u05ea\u05d0\u05e8\u05d9\u05da=19 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2024}}</ref>.\n\n\u05d1-23 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2025, \u05d9\u05e6\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"\u05d1\u05d3\u05e8\u05da \u05d0\u05de\u05d5\u05e0\u05d4 \u05d1\u05d7\u05e8\u05ea\u05d9\". \u05d4\u05e9\u05d9\u05e8 \u05e0\u05db\u05ea\u05d1 \u05d1\u05d4\u05e9\u05e8\u05d0\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 \"\u05d1\u05d3\u05e8\u05da \u05d0\u05de\u05d5\u05e0\u05d4 \u05d1\u05d7\u05e8\u05ea\u05d9\", \u05e9\u05d4\u05d9\u05d4 \u05d4\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1[[\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4]] \u05e9\u05dc \u05d4\u05ea\u05e6\u05e4\u05d9\u05ea\u05e0\u05d9\u05ea [[\u05d0\u05d2\u05dd \u05d1\u05e8\u05d2\u05e8]], \u05e9\u05e9\u05d5\u05d7\u05e8\u05e8\u05d4 \u05de\u05d4[[\u05d4\u05d7\u05d8\u05d5\u05e4\u05d9\u05dd \u05d1\u05de\u05dc\u05d7\u05de\u05ea \u05d7\u05e8\u05d1\u05d5\u05ea \u05d1\u05e8\u05d6\u05dc|\u05e9\u05d1\u05d9]] \u05dc\u05d0\u05d7\u05e8 \u05ea\u05e7\u05d5\u05e4\u05d4 \u05de\u05de\u05d5\u05e9\u05db\u05ea. \u05e2\u05dd \u05d7\u05d6\u05e8\u05ea\u05d4, \u05db\u05ea\u05d1\u05d4 \u05d1\u05e8\u05d2\u05e8 \u05e2\u05dc \u05dc\u05d5\u05d7 \u05d1\u05de\u05e1\u05d5\u05e7: \"\u05d1\u05d3\u05e8\u05da \u05d0\u05de\u05d5\u05e0\u05d4 \u05d1\u05d7\u05e8\u05ea\u05d9, \u05d5\u05d1\u05d3\u05e8\u05da \u05d0\u05de\u05d5\u05e0\u05d4 \u05e9\u05d1\u05ea\u05d9\", \u05de\u05e9\u05e4\u05d8 \u05e9\u05d4\u05e4\u05da \u05dc\u05e1\u05de\u05dc \u05e9\u05dc \u05ea\u05e7\u05d5\u05d5\u05d4 \u05d5\u05d0\u05de\u05d5\u05e0\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05e8\u05d1\u05d9\u05dd. \u05d4\u05e7\u05dc\u05d9\u05e4 \u05dc\u05e9\u05d9\u05e8 \u05db\u05d5\u05dc\u05dc \u05ea\u05d9\u05e2\u05d5\u05d3 \u05e9\u05dc \u05e8\u05d2\u05e2\u05d9 \u05d4\u05d7\u05d6\u05e8\u05d4 \u05de\u05d4\u05e9\u05d1\u05d9<ref>{{\u05e1\u05e8\u05d5\u05d2\u05d9\u05dd|2=\"\u05d3\u05e8\u05da \u05d0\u05de\u05d5\u05e0\u05d4 \u05d1\u05d7\u05e8\u05ea\u05d9\": \u05d4\u05d9\u05d5\u05e6\u05e8 \u05d4\u05e9\u05e0\u05d9 \u05e9\u05de\u05d5\u05e6\u05d9\u05d0 \u05e9\u05d9\u05e8 \u05d1\u05d4\u05e9\u05e8\u05d0\u05ea \u05d0\u05d2\u05dd \u05d1\u05e8\u05d2\u05e8|3=1097335-\u05d3\u05e8\u05da-\u05d0\u05de\u05d5\u05e0\u05d4-\u05d1\u05d7\u05e8\u05ea\u05d9-\u05d4\u05d9\u05d5\u05e6\u05e8-\u05d4\u05e9\u05e0\u05d9-\u05e9\u05de\u05d5\u05e6\u05d9\u05d0-\u05e9\u05d9\u05e8|4=23 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2025}}</ref>. \u05d4\u05e9\u05d9\u05e8 \u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05be78 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4[[\u05d4\u05d9\u05d8\u05dc\u05d9\u05e1\u05d8]] \u05d5\u05dc\u05de\u05e7\u05d5\u05dd \u05d4-17 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e2\u05d1\u05e8\u05d9 \u05e9\u05dc [[\u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8]]<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://web.archive.org/web/20250304153639/https://hitlist.mako.co.il/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d4\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9: \u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05d9\u05e8\u05d9\u05dd \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9, \u05dc\u05d4\u05d9\u05d8\u05d9\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05d5\u05dc\u05d5\u05e2\u05d6\u05d9\u05d9\u05dd|\u05d0\u05ea\u05e8=[[\u05d4\u05d9\u05d8\u05dc\u05d9\u05e1\u05d8]]|\u05ea\u05d0\u05e8\u05d9\u05da=4 \u05d1\u05de\u05e8\u05e5 2025}}</ref><ref name=\":0\" />. \u05d1[[\u05d9\u05d5\u05dc\u05d9]] [[2025]] \u05d4\u05e9\u05ea\u05ea\u05e3 \u05dc\u05e6\u05d3 \u05d0\u05e9\u05ea\u05d5 \u05d9\u05e8\u05d3\u05df \u05d1[[MKR \u05d4\u05de\u05d8\u05d1\u05d7 \u05d4\u05de\u05e0\u05e6\u05d7: VIP \u05e2\u05d5\u05e0\u05d4 6|\u05e2\u05d5\u05e0\u05ea\u05d4 \u05d4\u05e9\u05d9\u05e9\u05d9\u05ea]] \u05e9\u05dc \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \"[[MKR \u05d4\u05de\u05d8\u05d1\u05d7 \u05d4\u05de\u05e0\u05e6\u05d7|\u05d4\u05de\u05d8\u05d1\u05d7 \u05d4\u05de\u05e0\u05e6\u05d7 VIP]]\", \u05d5\u05d4\u05dd \u05e1\u05d9\u05d9\u05de\u05d5 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05df{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05e8\u05df \u05d1\u05d5\u05e7\u05e8|\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d5\u05d0\u05e9\u05ea\u05d5 \u05d9\u05e8\u05d3\u05df \u05d6\u05db\u05d5 \u05d1\"\u05d4\u05de\u05d8\u05d1\u05d7 \u05d4\u05de\u05e0\u05e6\u05d7\"|entertainment/article/r1eayriulg|17 \u05d1\u05d9\u05d5\u05dc\u05d9 2025}}}}. \u05d1-17 \u05d1\u05d9\u05d5\u05dc\u05d9 2025 \u05d4\u05d5\u05e6\u05d9\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e0\u05d2\u05dc \"[[\u05dc\u05de\u05d5\u05ea \u05de\u05d0\u05d4\u05d1\u05d4]]\" \u05e9\u05d4\u05d2\u05d9\u05e2 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05ea\u05e9\u05d9\u05e2\u05d9 \u05d1\u05de\u05e6\u05e2\u05d3 \u05d4\u05e9\u05d1\u05d5\u05e2\u05d9 \u05e9\u05dc \u05de\u05d3\u05d9\u05d4 \u05e4\u05d5\u05e8\u05e1\u05d8.<ref name=\":0\" />\n\n\u05d1\u05e9\u05e0\u05ea [[2025]] \u05d2\u05d9\u05dc\u05dd \u05d0\u05ea \u05d3\u05de\u05d5\u05ea\u05d5 \u05e9\u05dc \u05d1\u05e0\u05e6\u05d9 ([[\u05d1\u05e6\u05dc\u05d0\u05dc \u05d0\u05dc\u05d5\u05e0\u05d9]]) \u05d1\u05de\u05d7\u05d6\u05de\u05e8 \"\u05e2\u05e4\u05e8\u05d4\" \u05d1[[\u05d4\u05ea\u05d9\u05d0\u05d8\u05e8\u05d5\u05df \u05d4\u05e2\u05d1\u05e8\u05d9|\u05ea\u05d9\u05d0\u05d8\u05e8\u05d5\u05df \u05d4\u05e2\u05d1\u05e8\u05d9]], \u05d4\u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc \u05d7\u05d9\u05d9\u05d4 \u05e9\u05dc [[\u05e2\u05e4\u05e8\u05d4 \u05d7\u05d6\u05d4]].\n\n=== \u05e4\u05e8\u05e9\u05d5\u05ea \u05e4\u05dc\u05d9\u05dc\u05d9\u05d5\u05ea ===\n\u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 [[2010]] \u05e2\u05d5\u05db\u05d1 \u05dc\u05d7\u05e7\u05d9\u05e8\u05d4 \u05d1[[\u05de\u05e9\u05d8\u05e8\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc]] \u05d1\u05d7\u05e9\u05d3 \u05dc[[\u05d4\u05e9\u05ea\u05de\u05d8\u05d5\u05ea \u05de\u05de\u05e1]]. \u05d4\u05d5\u05d0 [[\u05e9\u05d5\u05d7\u05e8\u05e8 \u05d1\u05e2\u05e8\u05d1\u05d5\u05ea]] \u05e2\u05e6\u05de\u05d9\u05ea \u05d5\u05d1\u05d4\u05ea\u05e0\u05e6\u05dc\u05d5\u05ea, \u05d0\u05d5\u05dc\u05dd \u05de\u05e0\u05d4\u05dc\u05d5 \u05d4\u05d0\u05d9\u05e9\u05d9 \u05d0\u05de\u05e0\u05d5\u05df \u05d6\u05e0\u05d3\u05e0\u05d9 \u05e9\u05d4\u05d4 \u05d1\u05d4\u05d0\u05e8\u05db\u05ea \u05de\u05e2\u05e6\u05e8 \u05de\u05e1\u05e4\u05e8 \u05d9\u05de\u05d9\u05dd. \u05d1\u05de\u05d0\u05d9 [[2013]] \u05d4\u05d2\u05d9\u05e9\u05d4 [[\u05e8\u05e9\u05d5\u05ea \u05d4\u05de\u05d9\u05e1\u05d9\u05dd]] \u05dc\u05d1\u05d9\u05ea \u05de\u05e9\u05e4\u05d8 \u05d4\u05e9\u05dc\u05d5\u05dd \u05d1\u05e8\u05de\u05dc\u05d4 [[\u05db\u05ea\u05d1 \u05d0\u05d9\u05e9\u05d5\u05dd]] \u05e0\u05d2\u05d3 \u05e4\u05e8\u05e5 \u05d5\u05d0\u05de\u05e8\u05d2\u05e0\u05d5 \u05d1\u05d2\u05d9\u05df [[\u05d4\u05e2\u05dc\u05de\u05ea \u05de\u05e1]] \u05d1\u05e1\u05d3\u05e8 \u05d2\u05d5\u05d3\u05dc \u05e9\u05dc \u05db\u05de\u05d9\u05dc\u05d9\u05d5\u05df \u05e9\"\u05d7{{\u05d4\u05e2\u05e8\u05d4|{{ynet|[[\u05d0\u05dc\u05d9 \u05e1\u05e0\u05d9\u05d5\u05e8]]|\u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05de\u05d5\u05d0\u05e9\u05dd \u05d1\u05d4\u05e2\u05dc\u05de\u05ea \u05de\u05e1|4382856|22 \u05d1\u05de\u05d0\u05d9 2013}}}}. \u05d1\u05de\u05e8\u05e5 2016, \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea [[\u05d4\u05e1\u05d3\u05e8 \u05d8\u05d9\u05e2\u05d5\u05df]], \u05d4\u05d5\u05d3\u05d4 \u05e4\u05e8\u05e5 \u05d5\u05d4\u05d5\u05e8\u05e9\u05e2{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05d2\u05dc\u05e2\u05d3 \u05de\u05d5\u05e8\u05d2|\u05d4\u05d6\u05de\u05e8 \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05d4\u05d5\u05e8\u05e9\u05e2 \u05d1\u05d4\u05e2\u05dc\u05de\u05ea \u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05d1\u05de\u05d9\u05dc\u05d9\u05d5\u05df \u05e9\u05e7\u05dc|4776825|10 \u05d1\u05de\u05e8\u05e5 2016}}}}, \u05d5\u05d1\u05d4\u05de\u05e9\u05da \u05e0\u05d3\u05d5\u05df \u05dc\u05d0\u05e8\u05d1\u05e2\u05d4 \u05d7\u05d5\u05d3\u05e9\u05d9 [[\u05e2\u05d1\u05d5\u05d3\u05d5\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea]], 8 \u05d7\u05d5\u05d3\u05e9\u05d9 [[\u05de\u05d0\u05e1\u05e8 \u05e2\u05dc \u05ea\u05e0\u05d0\u05d9]] \u05dc\u05de\u05e9\u05da \u05e9\u05dc\u05d5\u05e9 \u05e9\u05e0\u05d9\u05dd, \u05d5[[\u05e7\u05e0\u05e1]] \u05e9\u05dc 60 \u05d0\u05dc\u05e3 \u05e9\"\u05d7{{\u05d4\u05e2\u05e8\u05d4|\u05ea\"\u05e4 (\u05e8\u05de\u05dc\u05d4) 43400-05-13 \u05de\u05d3\u05d9\u05e0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05e0\u05d2\u05d3 \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5, \u05e0\u05d9\u05ea\u05df \u05d1-25 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2016}}.\n\n==\u05d7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd==\n\u05e4\u05e8\u05e5 \u05e0\u05e9\u05d5\u05d9 \u05dc\u05d9\u05e8\u05d3\u05df \u05d2\u05d5\u05d6\u05dc\u05df \u05d5\u05d0\u05d1 \u05dc\u05d0\u05e8\u05d1\u05e2\u05d4, \u05d5\u05de\u05ea\u05d2\u05d5\u05e8\u05e8 \u05d1[[\u05d1\u05d0\u05e8 \u05d9\u05e2\u05e7\u05d1]]{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05d0\u05e7\u05d5|\u05d9\u05e4\u05e2\u05ea \u05d4\u05dc\u05dc\u05d9|\u05d4\u05d7\u05d9\u05d9\u05dd \u05d4\u05d8\u05d5\u05d1\u05d9\u05dd: \u05de\u05e9\u05d4 \u05e4\u05e8\u05e5 \u05e8\u05db\u05e9 \u05d5\u05d9\u05dc\u05d4 \u05e2\u05dd \u05d1\u05e8\u05d9\u05db\u05d4|9158fcc737d7921006|entertainment-celebs/local|28 \u05d1\u05d9\u05d5\u05e0\u05d9 2010}}}}. \u05d4\u05d5\u05d0 \u05d2\u05d9\u05e1\u05d5 \u05e9\u05dc \u05d4\u05db\u05d3\u05d5\u05e8\u05d2\u05dc\u05df [[\u05e9\u05d5\u05d1\u05dc \u05d2\u05d5\u05d6\u05dc\u05df]]. \u05d4\u05d5\u05d0 \u05de\u05e7\u05d9\u05d9