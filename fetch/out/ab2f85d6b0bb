u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05e2\u05d9\u05e7\u05e8\u05d9\u05d9\u05dd \u05d1\u05d9\u05e6\u05d9\u05e8\u05ea\u05d5 \u05d4\u05d9\u05d5 [[\u05e6\u05d9\u05d5\u05e8 \u05e0\u05d5\u05e3|\u05e0\u05d5\u05e3]], \u05d0\u05d2\u05d3\u05d5\u05ea \u05d4[[\u05d1\u05e2\u05e9\"\u05d8]] \u05d5[[\u05d4\u05e9\u05d5\u05d0\u05d4]].{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05e1\u05e4\u05e8 \u05d6\u05d9\u05db\u05e8\u05d5\u05df}}\n\n==\u05e7\u05d5\u05e8\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd==\n\u05e9\u05dc\u05de\u05d4 \u05d1\u05df \u05de\u05e9\u05d4{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05de\u05e6\u05d1\u05d4|{{BillionGraves|\u05e9\u05dc\u05de\u05d4-\u05dc\u05e8\u05e0\u05e8/17636957|\u05d1\u05d9\u05ea \u05d4\u05e7\u05d1\u05e8\u05d5\u05ea \u05e7\u05e8\u05d9\u05d9\u05ea \u05e9\u05d0\u05d5\u05dc|\u05e9\u05dc\u05de\u05d4 \u05dc\u05e8\u05e0\u05e8}}.}} \u05dc\u05e8\u05e0\u05e8 \u05e0\u05d5\u05dc\u05d3 \u05d1[[\u05e7\u05de\u05e0\u05d9\u05e5-\u05e4\u05d5\u05d3\u05d5\u05dc\u05e1\u05e7]], \u05e2\u05d9\u05e8 \u05d1\u05d9\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e4\u05dc\u05da \u05e4\u05d5\u05d3\u05d5\u05dc\u05d9\u05d4 \u05e9\u05dc \u05d4\u05d0\u05d9\u05de\u05e4\u05e8\u05d9\u05d4 \u05d4\u05e8\u05d5\u05e1\u05d9\u05ea (\u05db\u05d9\u05d5\u05dd \u05d1\u05d3\u05e8\u05d5\u05dd-\u05de\u05e2\u05e8\u05d1 [[\u05d0\u05d5\u05e7\u05e8\u05d0\u05d9\u05e0\u05d4]]). \u05db\u05d1\u05e8 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea\u05d5 \u05d4\u05d7\u05dc \u05dc\u05e6\u05d9\u05d9\u05e8 \u05d0\u05d9\u05d5\u05e8\u05d9\u05dd \u05dc[[\u05e1\u05d9\u05e4\u05d5\u05e8\u05d9 \u05d4\u05de\u05e7\u05e8\u05d0]] \u05d5\u05d4\u05e8\u05d0\u05d4 \u05db\u05d9\u05e9\u05e8\u05d5\u05df \u05e0\u05d9\u05db\u05e8. \u05d4[[\u05de\u05e6\u05e0\u05d8]] \u05d4[[\u05d1\u05e1\u05e8\u05d1\u05d9\u05d4|\u05d1\u05e1\u05e8\u05d1\u05d9]] [[\u05e7\u05d5\u05e0\u05e1\u05d8\u05e0\u05d8\u05d9\u05df \u05e7\u05d6\u05d9\u05de\u05d9\u05e8]] {{\u05e8\u05d5|\u041a\u0430\u0437\u0438\u043c\u0438\u0440, \u041a\u043e\u043d\u0441\u0442\u0430\u043d\u0442\u0438\u043d \u0424\u0451\u0434\u043e\u0440\u043e\u0432\u0438\u0447}} \u05dc\u05de\u05d3 \u05e2\u05dc \u05e4\u05d5\u05e2\u05dc\u05d5 \u05e9\u05dc \u05dc\u05e8\u05e0\u05e8 \u05d4\u05e6\u05e2\u05d9\u05e8 \u05d5\u05d4\u05db\u05e0\u05d9\u05e1\u05d5 \u05d1\u05e9\u05e2\u05e8\u05d9 \u05d4\u05d0\u05e7\u05d3\u05de\u05d9\u05d4 \u05dc\u05d0\u05de\u05e0\u05d5\u05ea \u05e9\u05dc \u05e7\u05d9\u05d9\u05d1, \u05e9\u05dd \u05dc\u05de\u05d3 \u05de-[[1907]] \u05d5\u05e2\u05d3 [[1911]]. \u05de\u05e9\u05e0\u05d4 \u05d6\u05d5 \u05e0\u05d0\u05dc\u05e5 \u05dc\u05d4\u05e4\u05e1\u05d9\u05e7 \u05d0\u05ea \u05e2\u05d1\u05d5\u05d3\u05ea\u05d5 \u05d4\u05d0\u05de\u05e0\u05d5\u05ea\u05d9\u05ea \u05e2\u05d3 \u05d0\u05d7\u05e8\u05d9 [[\u05de\u05dc\u05d7\u05de\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4|\u05d4\u05de\u05dc\u05d7\u05de\u05d4]]. \u05d1\u05e9\u05e0\u05ea [[1920]] \u05d4\u05d2\u05d9\u05e2 \u05dc\u05e2\u05d9\u05e8 [[\u05d8\u05e9\u05e8\u05e0\u05d5\u05d1\u05d9\u05e5]], \u05d0\u05d6 \u05d1[[\u05de\u05de\u05dc\u05db\u05ea \u05e8\u05d5\u05de\u05e0\u05d9\u05d4]], \u05e9\u05dd \u05d4\u05db\u05d9\u05e8 \u05d0\u05ea \u05d4\u05e6\u05d9\u05d9\u05e8\u05d9\u05dd [[\u05d0\u05e8\u05ea\u05d5\u05e8 \u05e7\u05d5\u05dc\u05e0\u05d9\u05e7]] \u05d5[[\u05e8\u05d0\u05d5\u05d1\u05df \u05e8\u05d5\u05d1\u05d9\u05df]] \u05d5\u05d7\u05d6\u05e8 \u05dc\u05d9\u05e6\u05d5\u05e8.\n\n\u05d1\u05d4\u05de\u05e9\u05da (\u05d1[[\u05e9\u05e0\u05d5\u05ea \u05d4-20 \u05e9\u05dc \u05d4\u05de\u05d0\u05d4 \u05d4-20|\u05e9\u05e0\u05d5\u05ea \u05d4-20]] \u05d0\u05d5 \u05e8\u05d0\u05e9\u05d9\u05ea [[\u05e9\u05e0\u05d5\u05ea \u05d4-30 \u05e9\u05dc \u05d4\u05de\u05d0\u05d4 \u05d4-20|\u05e9\u05e0\u05d5\u05ea \u05d4-30]]) [[\u05d4\u05d2\u05d9\u05e8\u05d4 \u05dc\u05d0\u05e8\u05e6\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea|\u05d4\u05d9\u05d2\u05e8 \u05dc\u05d0\u05e8\u05e6\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea]] \u05d5\u05d4\u05e9\u05ea\u05e7\u05e2 \u05d1[[\u05e0\u05d9\u05d5 \u05d9\u05d5\u05e8\u05e7]]. \u05d1\u05e2\u05e8\u05d5\u05d1 \u05d9\u05de\u05d9\u05d5 [[\u05e2\u05dc\u05d9\u05d9\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc|\u05e2\u05dc\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc]] \u05e2\u05dd \u05d0\u05e9\u05ea\u05d5 \u05e4\u05d5\u05dc\u05d4, [[\u05d0\u05d7\u05d5\u05ea]] \u05d1\u05de\u05e7\u05e6\u05d5\u05e2\u05d4.{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05de\u05e6\u05d1\u05d4: \u05e4\u05d5\u05dc\u05d4 \u05dc\u05e8\u05e0\u05e8|{{BillionGraves|\u05e4\u05d5\u05dc\u05d4-\u05dc\u05e8\u05e0\u05e8/17636958|\u05d1\u05d9\u05ea \u05d4\u05e7\u05d1\u05e8\u05d5\u05ea \u05e7\u05e8\u05d9\u05d9\u05ea \u05e9\u05d0\u05d5\u05dc|\u05e4\u05d5\u05dc\u05d4 \u05dc\u05e8\u05e0\u05e8}}.}}\n\n\u05e9\u05dc\u05de\u05d4 \u05dc\u05e8\u05e0\u05e8 \u05e0\u05e4\u05d8\u05e8 \u05d1[[\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1]] \u05d1-[[1963]], \u05d1\u05e1\u05d5\u05e3 \u05e9\u05e0\u05d5\u05ea \u05d4\u05e9\u05d1\u05e2\u05d9\u05dd \u05dc\u05d7\u05d9\u05d9\u05d5. \u05e0\u05e7\u05d1\u05e8 \u05d1[[\u05d1\u05d9\u05ea \u05d4\u05e2\u05dc\u05de\u05d9\u05df \u05e7\u05e8\u05d9\u05d9\u05ea \u05e9\u05d0\u05d5\u05dc]].{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05de\u05e6\u05d1\u05d4}}\n\u05dc\u05d0\u05d7\u05e8 \u05de\u05d5\u05ea\u05d5 \u05ea\u05e8\u05de\u05d4 \u05d0\u05dc\u05de\u05e0\u05ea\u05d5 \u05db\u05de\u05d4 \u05de\u05e6\u05d9\u05d5\u05e8\u05d9\u05d5 \u05dc\u05ea\u05e6\u05d5\u05d2\u05ea \u05e7\u05d1\u05e2 \u05d1\u05d1\u05d9\u05ea \"[[\u05d1\u05e0\u05d9 \u05d1\u05e8\u05d9\u05ea]]\" \u05d1\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1.{{\u05d4\u05e2\u05e8\u05d4|{{\u05e2\u05dc \u05d4\u05de\u05e9\u05de\u05e8||\u05d4\u05d5\u05e9\u05d7\u05ea\u05d5 \u05ea\u05de\u05d5\u05e0\u05d5\u05ea|19660724|79}}.}} \u05d4\u05d9\u05d0 \u05e2\u05e6\u05de\u05d4 \u05e0\u05e4\u05d8\u05e8\u05d4 \u05d1\u05e9\u05e0\u05ea [[1966]].{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05de\u05e6\u05d1\u05d4: \u05e4\u05d5\u05dc\u05d4 \u05dc\u05e8\u05e0\u05e8}} \u05e6\u05d9\u05d5\u05e8\u05d9\u05d5 \u05de\u05e6\u05d5\u05d9\u05d9\u05dd \u05e2\u05d5\u05d3 \u05d1[[\u05d1\u05d9\u05ea \u05e6\u05d9\u05d5\u05e0\u05d9 \u05d0\u05de\u05e8\u05d9\u05e7\u05d4]] \u05d1\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1, \u05d1[[\u05d1\u05d9\u05ea \u05e9\u05dc\u05d5\u05dd \u05d0\u05e9]] \u05d1[[\u05d1\u05ea \u05d9\u05dd]], \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 [[\u05d1\u05e6\u05dc\u05d0\u05dc, \u05d0\u05e7\u05d3\u05de\u05d9\u05d4 \u05dc\u05d0\u05de\u05e0\u05d5\u05ea \u05d5\u05e2\u05d9\u05e6\u05d5\u05d1 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05d1\u05e6\u05dc\u05d0\u05dc]] \u05d1[[\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]] \u05d5\u05d1\u05e7\u05d9\u05d1\u05d5\u05e5 [[\u05d1\u05d9\u05ea \u05d6\u05e8\u05e2]].{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05e1\u05e4\u05e8 \u05d6\u05d9\u05db\u05e8\u05d5\u05df}}\n\n==\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd==\n* {{\u05d3\u05d1\u05e8|\u05d0\u05e8\u05d9\u05d4 \u05dc\u05e8\u05e0\u05e8|\u05d4\u05d1\u05e2\u05e9\"\u05d8 \u05d1\u05e6\u05d9\u05d5\u05e8\u05d9 \u05e9\u05dc\u05de\u05d4 \u05dc\u05e8\u05e0\u05e8|19620209|67}}\n* {{\u05e1\u05e4\u05e8 \u05d1\u05d0\u05e8\u05db\u05d9\u05d5\u05df \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8|[[\u05e9\u05d9\u05e2 \u05d8\u05e0\u05e0\u05d1\u05d5\u05d9\u05dd|\u05e9\u05d9\u05e2 \u05d8\u05e2\u05e0\u05e2\u05e0\u05d1\u05d5\u05d9\u05dd]]|\u05e9\u05dc\u05de\u05d4 \u05dc\u05e2\u05e8\u05e0\u05e2\u05e8, \u05d3\u05e2\u05e8 \u05de\u05d0\u05b8\u05dc\u05e2\u05e8 \u05e4\u05bf\u05d5\u05df \u05d7\u05e1\u05d9\u05d3\u05d9\u05e9\u05df \u05e4\u05bf\u05d0\u05b8\u05dc\u05e7\u05dc\u05d0\u05b8\u05e8|nybc207884|'''\u05e9\u05e0\u05d9\u05d8 \u05e4\u05bf\u05d5\u05df \u05de\u05d9\u05b7\u05d9\u05df \u05e4\u05bf\u05e2\u05dc\u05d3: \u05e2\u05e1\u05d9\u05d9\u05e2\u05df, \u05d3\u05e2\u05e8\u05e6\u05d9\u05d9\u05dc\u05d5\u05e0\u05d2\u05e2\u05df, \u05de\u05d9\u05e0\u05d9\u05d0\u05b7\u05d8\u05d5\u05e8\u05df''', \u05e0\u05d9\u05d5 \u05d9\u05d5\u05e8\u05e7: \u05e9. \u05d8\u05e2\u05e0\u05e2\u05e0\u05d1\u05d5\u05d9\u05dd \u05d1\u05d5\u05da-\u05e7\u05d0\u05b8\u05de\u05d9\u05d8\u05e2\u05d8, 1949, \u05e2\u05de' 379\u2013382|\u05e2\u05de\u05d5\u05d3=382}} (\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05e9\u05d4\u05ea\u05e4\u05e8\u05e1\u05de\u05d4 \u05d1\u05de\u05e7\u05d5\u05e8 \u05d1-6 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 1947) {{\u05d9\u05d9\u05d3\u05d9\u05e9}}\n* {{\u05dc\u05d9\u05d8\u05e2\u05e8\u05d0\u05e8\u05d9\u05e9\u05e2 \u05d1\u05dc\u05e2\u05d8\u05e2\u05e8|\u05d7\u05d9\u05d9\u05dd \u05d2\u05e2\u05dc\u05e2\u05e8|\u05e7\u05d5\u05e0\u05e1\u05d8\u05d0\u05d5\u05d9\u05e1\u05e9\u05d8\u05e2\u05dc\u05d5\u05e0\u05d2 \u05e4\u05d5\u05df \u05e9\u05dc\u05de\u05d4 \u05dc\u05e2\u05e8\u05e0\u05e2\u05e8|19250619|9}} {{\u05d9\u05d9\u05d3\u05d9\u05e9}}\n\n\u05de\u05d9\u05e6\u05d9\u05e8\u05d5\u05ea\u05d9\u05d5:\n* \"\u05d0\u05d5\u05e8 \u05d1\u05e6\u05d5\u05e7\u05d9 \u05d4\u05d7\u05d5\u05e3\", \"\u05e4\u05ea\u05d7\u05d5 \u05e9\u05e2\u05e8\u05d9 \u05d2\u05df \u05e2\u05d3\u05df\" (\u05d4\u05d1\u05e2\u05e9\"\u05d8 \u05ea\u05d5\u05d1\u05e2 \u05d0\u05ea \u05e4\u05ea\u05d9\u05d7\u05ea \u05e9\u05e2\u05e8\u05d9 \u05d2\u05df \u05d4\u05e2\u05d3\u05df \u05dc\u05e7\u05d5\u05e8\u05d1\u05e0\u05d5\u05ea \u05d4\u05e9\u05d5\u05d0\u05d4), \"\u05e9\u05ea\u05d9 \u05d0\u05de\u05d4\u05d5\u05ea\" (\u05d0\u05dd \u05e0\u05d5\u05e6\u05e8\u05d9\u05d9\u05d4 \u05d5\u05d0\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05d9\u05d4), \u05d1\u05ea\u05d5\u05da: \u05de\u05e9\u05d4 \u05d6\u05d9\u05dc\u05d1\u05e8\u05de\u05df-\u05e1\u05d9\u05dc\u05d5\u05df \u05d5\u05d9\u05e2\u05e7\u05d1 \u05d1\u05e8\u05d2\u05e8-\u05ea\u05de\u05d9\u05e8 (\u05e2\u05d5\u05e8\u05db\u05d9\u05dd), '''\u05e7\u05d4\u05d9\u05dc\u05ea \u05dc\u05d9\u05e4\u05e7\u05e0\u05d9: \u05e1\u05e4\u05e8 \u05d6\u05d9\u05db\u05e8\u05d5\u05df''', \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1: \u05d0\u05e8\u05d2\u05d5\u05df \u05d9\u05d5\u05e6\u05d0\u05d9 \u05dc\u05d9\u05e4\u05e7\u05e0\u05d9 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc, \u05ea\u05e9\u05db\"\u05d2 1963, \u05e2\u05de' 214\u2013216 ({{\u05e1\u05e4\u05e8\u05d9 \u05d9\u05d6\u05db\u05d5\u05e8||\u05dc\u05d9\u05e4\u05e7\u05e0\u05d9|2936}}, \u05ea\u05de\u05d5\u05e0\u05d4 220\u2013222)\n\n==\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd==\n{{\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd}}\n\n{{\u05de\u05d9\u05d5\u05df \u05e8\u05d2\u05d9\u05dc:\u05dc\u05e8\u05e0\u05e8, \u05e9\u05dc\u05de\u05d4}}\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e6\u05d9\u05d9\u05e8\u05d9\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05d0\u05d5\u05e7\u05e8\u05d0\u05d9\u05e0\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05de\u05e4\u05d5\u05d3\u05d5\u05dc\u05d9\u05d4]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e6\u05d9\u05d9\u05e8\u05d9\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05e8\u05d5\u05de\u05e0\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e6\u05d9\u05d9\u05e8\u05d9\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05d0\u05de\u05e8\u05d9\u05e7\u05d0\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05de\u05d4\u05d2\u05e8\u05d9\u05dd \u05de\u05e8\u05d5\u05de\u05e0\u05d9\u05d4 \u05dc\u05d0\u05e8\u05e6\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e2\u05d5\u05dc\u05d9\u05dd \u05d1\u05e9\u05e0\u05d5\u05ea \u05d4-1960]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05d0\u05d9\u05e9\u05d9\u05dd \u05d4\u05e7\u05d1\u05d5\u05e8\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea \u05d4\u05e7\u05d1\u05e8\u05d5\u05ea \u05e7\u05e8\u05d9\u05d9\u05ea \u05e9\u05d0\u05d5\u05dc]]"}}}]}}}}