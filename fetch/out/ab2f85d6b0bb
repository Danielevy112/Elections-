05d4|\u05e9\u05dd=\u05e4\u05d7\u05d3\u05df \u05de\u05d4\u05d0\u05de\u05ea|{{\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d5\u05dd||\u05e0\u05d5\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df \u05e2\u05dc \u05e0\u05ea\u05e0\u05d9\u05d4\u05d5: \"\u05de\u05ea\u05e0\u05d4\u05d2 \u05db\u05de\u05d5 \u05e4\u05d7\u05d3\u05df \u05e9\u05de\u05e4\u05d7\u05d3 \u05de\u05d4\u05d0\u05de\u05ea\"|news/local/article/17558526|17 \u05d1\u05de\u05e8\u05e5 2025}}}}\n\n\u05d1-[[18 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8]] [[2025]] \u05d4\u05e6\u05d8\u05e8\u05e3 \u05dc\u05de\u05e4\u05dc\u05d2\u05ea [[\u05d9\u05e9 \u05e2\u05ea\u05d9\u05d3]]{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05e8\u05d5\u05e2\u05d9 \u05e8\u05d5\u05d1\u05d9\u05e0\u05e9\u05d8\u05d9\u05d9\u05df, \u05de\u05d5\u05e8\u05df \u05d0\u05d6\u05d5\u05dc\u05d0\u05d9|\u05d1\u05e0\u05d8 \u05d5\u05e8\u05d0\u05e9\u05d9 \u05d4\u05d0\u05d5\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d4 \u05d9\u05e4\u05d2\u05d9\u05e0\u05d5 \u05e0\u05d2\u05d3 \u05d4\u05de\u05de\u05e9\u05dc\u05d4; \u05e0\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df \u05de\u05e6\u05d8\u05e8\u05e3 \u05dc\u05d9\u05e9 \u05e2\u05ea\u05d9\u05d3|news/article/bkoclz5g11g|18 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2025}}}}, \u05d5\u05d4\u05d5\u05e6\u05d1 \u05d1\u05de\u05e7\u05d5\u05dd 6 \u05d1\u05e8\u05e9\u05d9\u05de\u05ea [[\u05d1\u05d9\u05d7\u05d3 (\u05e8\u05e9\u05d9\u05de\u05d4)]] \u05dc\u05db\u05e0\u05e1\u05ea \u05d4-26.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.gov.il/he/pages/beyahad_list1|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d1\u05d9\u05d7\u05d3 \u05d1\u05e8\u05d0\u05e9\u05d5\u05ea \u05e0\u05e4\u05ea\u05dc\u05d9 \u05d1\u05e0\u05d8|\u05d0\u05ea\u05e8=[[\u05d5\u05e2\u05d3\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9\u05ea \u05dc\u05db\u05e0\u05e1\u05ea]]|\u05ea\u05d0\u05e8\u05d9\u05da=29 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2026|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2026-09-29}}</ref>\n\n== \u05d7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd ==\n\u05ea\u05d9\u05d1\u05d5\u05df \u05d4\u05d5\u05d0 \u05d1\u05e2\u05dc [[\u05ea\u05d5\u05d0\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df]] \u05d1\u05d4\u05e6\u05d8\u05d9\u05d9\u05e0\u05d5\u05ea \u05d1[[\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4]] \u05de[[\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05d7\u05d9\u05e4\u05d4]] \u05d5\u05d1\u05e2\u05dc \u05ea\u05d5\u05d0\u05e8 \u05e9\u05e0\u05d9 \u05d1[[\u05de\u05d9\u05e0\u05d4\u05dc \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9]] \u05de[[\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05d4\u05e8\u05d5\u05d5\u05d0\u05e8\u05d3]], \u05e9\u05d1\u05d4 \u05dc\u05de\u05d3 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05ea\u05d5\u05db\u05e0\u05d9\u05ea [[\u05e7\u05e8\u05df \u05d5\u05e7\u05e1\u05e0\u05e8]]. \u05d4\u05d5\u05d0 \u05d1\u05d5\u05d2\u05e8 \u05d1\u05d4\u05e6\u05d8\u05d9\u05d9\u05e0\u05d5\u05ea \u05e9\u05dc \u05e7\u05d5\u05e8\u05e1 \u05de\u05e4\u05e7\u05d3\u05d9 \u05e4\u05dc\u05d5\u05d2\u05d5\u05ea, \u05d5\u05d1\u05d5\u05d2\u05e8 [[\u05d4\u05de\u05db\u05dc\u05dc\u05d4 \u05d4\u05d1\u05d9\u05df-\u05d6\u05e8\u05d5\u05e2\u05d9\u05ea \u05dc\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d5\u05dc\u05de\u05d8\u05d4]].\n\n\u05ea\u05d9\u05d1\u05d5\u05df, \u05d4\u05de\u05ea\u05d2\u05d5\u05e8\u05e8 \u05d1[[\u05e6\u05e4\u05d5\u05df \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1]], \u05e0\u05e9\u05d5\u05d9 \u05dc\u05e1\u05d5\u05e4\u05e8\u05ea \u05d3\"\u05e8 [[\u05d2\u05dc\u05d9 \u05de\u05d9\u05e8-\u05ea\u05d9\u05d1\u05d5\u05df]], \u05d4\u05e2\u05d5\u05e1\u05e7\u05ea \u05d1\u05d7\u05d9\u05e0\u05d5\u05da \u05d5\u05d1\u05d7\u05e7\u05e8 \u05d4\u05e9\u05d5\u05d0\u05d4{{\u05d4\u05e2\u05e8\u05d4|[http://www.shiller.org.il/viewpage.asp?pagesCatID=18865&siteName=shiller \u05d2\u05dc\u05d9 \u05de\u05d9\u05e8-\u05ea\u05d9\u05d1\u05d5\u05df / \u05e9\u05d9\u05dc\u05e8 - \u05e0\u05d8]}}. \u05d4\u05d5\u05d0 \u05d0\u05d1 \u05dc\u05e9\u05e0\u05d9\u05d9\u05dd. \u05d1\u05e0\u05d5, [[\u05d0\u05de\u05d9\u05e8 \u05ea\u05d9\u05d1\u05d5\u05df]], \u05d4\u05d5\u05d0 [[\u05e2\u05d9\u05ea\u05d5\u05e0\u05d0\u05d9]] \u05d5\u05d1\u05e0\u05d5 \u05d4\u05e9\u05e0\u05d9, \u05d0\u05d5\u05e8\u05d9 \u05ea\u05d9\u05d1\u05d5\u05df, \u05d4\u05d5\u05d0 [[\u05e8\u05d5\u05e4\u05d0]]<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://web.archive.org/web/20250204083818/https://knowmore.co.il/doctors/\u05d0\u05d5\u05e8\u05d9-\u05e0\u05ea\u05df-\u05ea\u05d9\u05d1\u05d5\u05df/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d0\u05d5\u05e8\u05d9 \u05e0\u05ea\u05df \u05ea\u05d9\u05d1\u05d5\u05df - \u05e4\u05d5\u05e8\u05d8\u05dc \u05d4\u05e8\u05d5\u05e4\u05d0\u05d9\u05dd \u05e9\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc|\u05d0\u05ea\u05e8=web.archive.org|\u05ea\u05d0\u05e8\u05d9\u05da=2025-02-04|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2025-02-04}}</ref>.\n\n==\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd==\n{{\u05de\u05d9\u05d6\u05de\u05d9\u05dd|\u05d5\u05d9\u05e7\u05d9\u05e6\u05d9\u05d8\u05d5\u05d8=\u05e0\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df|\u05d5\u05d9\u05e7\u05d9\u05e9\u05d9\u05ea\u05d5\u05e3=Category:Noam Tibon}}\n* {{\u05d3\u05d5\u05d1\u05e8 \u05e6\u05d4\"\u05dc||\u05de\u05e4\u05e7\u05d3 \u05d4\u05d2\u05d9\u05e1 \u05d4\u05e6\u05e4\u05d5\u05e0\u05d9 \u2013 \u05d4\u05d0\u05dc\u05d5\u05e3 \u05e0\u05d5\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df|1414-17441|29 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2012}}\n* [[\u05d0\u05d1\u05d9\u05d7\u05d9 \u05d1\u05e7\u05e8]], [http://www.fresh.co.il/vBulletin/showthread.php?t=435896&highlight=%EE%EC%E7%EE%E4+%EC%EC%E0+%E0%E5%FA#post3867187 \"\u05d3\u05e8\u05da \u05e0\u05d5\u05e2\u05dd\"], [[\u05d4\u05d0\u05e8\u05e5]], 5 \u05d1\u05de\u05d0\u05d9 2000, \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05e2\u05dc\u05d4 \u05d1\u05d0\u05ea\u05e8 [[\u05e4\u05e8\u05e9 (\u05d0\u05ea\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05