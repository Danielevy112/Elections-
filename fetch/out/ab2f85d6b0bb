5dc\u05d3\u05d9\u05de\u05d9\u05e8 \u05d1\u05dc\u05d9\u05d0\u05e7]] \u05d0\u05d5\u05d3\u05d5\u05ea \u05ea\u05e7\u05e6\u05d5\u05d1 \u05ea\u05e8\u05d2\u05d5\u05dd \u05d0\u05ea\u05e8 [[\u05db\u05dc \u05d6\u05db\u05d5\u05ea]] \u05dc\u05e8\u05d5\u05e1\u05d9\u05ea;<ref>{{\u05de\u05e2\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e0\u05dc\u05d9\u05d9\u05df|[[\u05d0\u05e0\u05d4 \u05d1\u05e8\u05e1\u05e7\u05d9]]|\u05de\u05e0\u05d2\u05d9\u05e9\u05d9\u05dd \u05d0\u05ea \u05d4\u05de\u05d9\u05d3\u05e2: \u05d0\u05ea\u05e8 \"\u05db\u05dc \u05d6\u05db\u05d5\u05ea\" \u05d9\u05ea\u05d5\u05e8\u05d2\u05dd \u05dc\u05e8\u05d5\u05e1\u05d9\u05ea|news/israel/Article-880485|28 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2021}}</ref> \u05e2\u05dd [[\u05e9\u05e8 \u05d4\u05d0\u05d5\u05e6\u05e8]] [[\u05d1\u05e6\u05dc\u05d0\u05dc \u05e1\u05de\u05d5\u05d8\u05e8\u05d9\u05e5']], [[\u05e9\u05e8 \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d5\u05d4\u05e7\u05dc\u05d9\u05d8\u05d4]] [[\u05d0\u05d5\u05e4\u05d9\u05e8 \u05e1\u05d5\u05e4\u05e8]] \u05d5[[\u05e9\u05e8 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da]] [[\u05d9\u05d5\u05d0\u05d1 \u05e7\u05d9\u05e9]] \u05d0\u05d5\u05d3\u05d5\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05d1\u05d4\u05e2\u05e1\u05e7\u05ea \u05de\u05d5\u05e8\u05d9 \u05d4\u05d0\u05d5\u05dc\u05e4\u05e0\u05d9\u05dd, \u05db\u05da \u05e9\u05d9\u05db\u05dc\u05dc\u05d5 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05e8\u05e4\u05d5\u05e8\u05de\u05ea [[\u05d0\u05d5\u05e4\u05e7 \u05d7\u05d3\u05e9]];<ref>{{\u05de\u05e2\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e0\u05dc\u05d9\u05d9\u05df|\u05d9\u05d5\u05d1\u05dc \u05d1\u05d2\u05e0\u05d5|\u05de\u05e9\u05d1\u05e8 \u05de\u05d5\u05e8\u05d9 \u05d4\u05d0\u05d5\u05dc\u05e4\u05e0\u05d9\u05dd \u05dc\u05d0 \u05e0\u05e4\u05ea\u05e8 \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc \u05d4\u05e1\u05db\u05dd \u05d4\u05e9\u05db\u05e8|news/israel/Article-1028463|8 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2023}}</ref> \u05e2\u05dd [[\u05de\u05e9\u05e8\u05d3 \u05d4\u05de\u05d5\u05e8\u05e9\u05ea|\u05d4\u05e9\u05e8 \u05dc\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05de\u05d5\u05e8\u05e9\u05ea]] [[\u05e2\u05de\u05d9\u05d7\u05d9 \u05d0\u05dc\u05d9\u05d4\u05d5]] \u05d1\u05e2\u05e0\u05d9\u05d9\u05df \u05d4\u05d7\u05dc\u05d8\u05ea \u05de\u05de\u05e9\u05dc\u05d4 \u05dc\u05d4\u05e7\u05de\u05ea \u05de\u05e8\u05db\u05d6 \u05de\u05d5\u05e8\u05e9\u05ea \u05dc\u05d9\u05d4\u05d3\u05d5\u05ea \u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea;<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://ozma-yeudit.co.il/\u05d0\u05d5\u05e9\u05e8-\u05db\u05e2\u05ea-\u05d1\u05d9\u05e9\u05d9\u05d1\u05ea-\u05d4\u05de\u05de\u05e9\u05dc\u05d4-27-\u05de\u05d9\u05dc\u05d9\u05d5\u05df-\u20aa-\u05dc\u05d8\u05d5\u05d1\u05ea/|\u05d4\u05db\u05d5\u05ea\u05d1=kobi8201|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d0\u05d5\u05e9\u05e8 \u05db\u05e2\u05ea \u05d1\u05d9\u05e9\u05d9\u05d1\u05ea \u05d4\u05de\u05de\u05e9\u05dc\u05d4: 27 \u05de\u05d9\u05dc\u05d9\u05d5\u05df \u20aa \u05dc\u05d8\u05d5\u05d1\u05ea \u05de\u05e8\u05db\u05d6 \u05de\u05d5\u05e8\u05e9\u05ea \u05d9\u05d4\u05d3\u05d5\u05ea \u05d1\u05e8\u05d9\u05d4\"\u05de|\u05d0\u05ea\u05e8=\u05e2\u05d5\u05e6\u05de\u05d4 \u05d9\u05d4\u05d5\u05d3\u05d9\u05ea|\u05ea\u05d0\u05e8\u05d9\u05da=2024-05-27|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2025-03-03}}</ref> \u05e2\u05dd \u05e9\u05e8 \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea [[\u05d0\u05d5\u05e8\u05d9\u05d0\u05dc \u05d1\u05d5\u05e1\u05d5|\u05d0\u05e8\u05d9\u05d0\u05dc \u05de\u05e0\u05d7\u05dd \u05d1\u05d5\u05e1\u05d5]], \u05d5\u05e9\u05e8 \u05d4\u05e7\u05dc\u05d9\u05d8\u05d4 \u05d0\u05d5\u05e4\u05d9\u05e8 \u05e1\u05d5\u05e4\u05e8 \u05d1\u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05e7\u05dc\u05d5\u05ea \u05d1\u05e7\u05dc\u05d9\u05d8\u05ea \u05e8\u05d5\u05e4\u05d0\u05d9\u05dd-\u05e2\u05d5\u05dc\u05d9\u05dd.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://main.knesset.gov.il/news/pressreleases/pages/press20012025g.aspx|\u05d4\u05db\u05d5\u05ea\u05d1=\u05d0\u05ea\u05e8 \u05d4\u05db\u05e0\u05e1\u05ea|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d4\u05d5\u05d3\u05e2\u05ea \u05d4\u05db\u05e0\u05e1\u05ea, \u05d5\u05e2\u05d3\u05ea \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05d0\u05d9\u05e9\u05e8\u05d4 \u05d4\u05e7\u05dc\u05d5\u05ea \u05e9\u05d9\u05d0\u05e4\u05e9\u05e8\u05d5 \u05e7\u05dc\u05d9\u05d8\u05ea \u05db-600 \u05e8\u05d5\u05e4\u05d0\u05d9\u05dd-\u05e2\u05d5\u05dc\u05d9\u05dd \u05d1\u05e9\u05e0\u05d4|\u05d0\u05ea\u05e8=Knesset.gov.il|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2025-03-03}}</ref>\n\n\u05e8\u05d9\u05e3 \u05d4\u05d9\u05d5\u05d5\u05ea\u05d4 \u05d0\u05ea \u05d0\u05d7\u05d3 \u05d4\u05e7\u05d5\u05dc\u05d5\u05ea \u05d4\u05d1\u05d5\u05dc\u05d8\u05d9\u05dd \u05e9\u05dc \u05e7\u05d4\u05d9\u05dc\u05ea \u05d3\u05d5\u05d1\u05e8\u05d9 \u05d4\u05e8\u05d5\u05e1\u05d9\u05ea \u05d1[[\u05d9\u05e9\u05e8\u05d0\u05dc]] \u05d1\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05e0\u05d2\u05d3 \u05d4[[\u05de\u05d5\u05e0\u05d5\u05e4\u05d5\u05dc]] \u05e9\u05dc [[\u05d4\u05e8\u05d1\u05e0\u05d5\u05ea \u05d4\u05e8\u05d0\u05e9\u05d9\u05ea \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc|\u05de\u05d5\u05e1\u05d3 \u05d4\u05e8\u05d1\u05e0\u05d5\u05ea]] \u05e2\u05dc \u05d7\u05d9\u05d9 \u05d4\u05d3\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc.<ref>{{ynet|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05d9\u05d3\u05e2\u05ea\u05d9 \u05de\u05d4 \"\u05d9\u05d4\u05d5\u05d3\u05d9\u05d5\u05ea \u05db\u05de\u05d5\u05e0\u05d9\" \u05e2\u05d5\u05d1\u05e8\u05d5\u05ea \u05d1\u05e8\u05d1\u05e0\u05d5\u05ea. \u05dc\u05d0 \u05d4\u05e1\u05db\u05de\u05ea\u05d9 \u05dc\u05e2\u05d1\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d4\u05e9\u05e4\u05dc\u05d4|judaism/article/byv4dnd3xl|19 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2025}}</ref><ref>{{ynet|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05e1\u05d5\u05d7\u05e8\u05d9\u05dd \u05d1\u05e0\u05d5, \u05de\u05e2\u05dc \u05d4\u05e8\u05d0\u05e9 \u05e9\u05dc\u05e0\u05d5|news/article/rkloyujl11g|10 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2025}}</ref> \u05d1\u05ea\u05d5\u05da \u05db\u05da \u05e8\u05d9\u05e3 \u05e4\u05e2\u05dc\u05d4 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d0\u05ea \u05e7\u05d5\u05dc\u05dd \u05e9\u05dc \u05de\u05d9 \u05e9\u05e2\u05d5\u05d1\u05e8\u05d9\u05dd [[\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d9\u05d4\u05d3\u05d5\u05ea|\u05d1\u05d9\u05e8\u05d5\u05e8\u05d9 \u05d9\u05d4\u05d3\u05d5\u05ea]] \u05d1\u05d1\u05d5\u05d0\u05dd \u05dc\u05d4\u05ea\u05d7\u05ea\u05df \u05d1[[\u05d9\u05e9\u05e8\u05d0\u05dc]] \u05d5\u05dc\u05e4\u05ea\u05d9\u05d7\u05ea \u05e9\u05e2\u05e8\u05d9 \u05d4[[\u05d2\u05d9\u05d5\u05e8]] \u05dc\u05d9\u05d4\u05d3\u05d5\u05ea [[\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea]] \u05d4\u05de\u05e2\u05d5\u05e0\u05d9\u05d9\u05e0\u05d9\u05dd \u05d1\u05d2\u05d9\u05d5\u05e8.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://jppi.org.il/he/\u05de\u05e0\u05db\u05dc\u05d9\u05ea-\u05e2\u05de\u05d5\u05ea\u05ea-\u05dc\u05d5\u05d1\u05d9-\u05d4\u05de\u05d9\u05dc\u05d9\u05d5\u05df-\u05d0\u05dc\u05e7\u05e1-\u05e8\u05d9\u05e3-45-\u05de/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05de\u05e0\u05db\"\u05dc\u05d9\u05ea \u05e2\u05de\u05d5\u05ea\u05ea '\u05dc\u05d5\u05d1\u05d9 \u05d4\u05de\u05d9\u05dc\u05d9\u05d5\u05df' \u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3: \"45% \u05de\u05d4\u05e2\u05d5\u05dc\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05e8\u05d5\u05e6\u05d9\u05dd \u05dc\u05d4\u05ea\u05d2\u05d9\u05d9\u05e8\"|\u05d0\u05ea\u05e8=JPPI|\u05ea\u05d0\u05e8\u05d9\u05da=20 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2023}}</ref> \u05db\u05de\u05d5 \u05db\u05df \u05d3\u05e8\u05e9\u05d4 \u05d9\u05d7\u05e1 \u05de\u05db\u05d1\u05d3 \u05de\u05e6\u05d3 \u05d4\u05de\u05de\u05e1\u05d3 \u05d4\u05d3\u05ea\u05d9 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05dc\u05e4\u05d9 \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05de\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://jppi.org.il/en/\u05d0\u05dc\u05e7\u05e1-\u05e8\u05d9\u05e3-\u05de\u05d3\u05d9\u05e0\u05d4-\u05d9\u05d4\u05d5\u05d3\u05d9\u05ea-\u05d4\u05d9\u05d0-\u05de\u05d3\u05d9\u05e0\u05d4-\u05d4\u05de\u05ea\u05e0\u05d4\u05d2/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3: \u05de\u05d3\u05d9\u05e0\u05d4 \u05d9\u05d4\u05d5\u05d3\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05d4\u05de\u05ea\u05e0\u05d4\u05d2\u05ea \u05e9\u05de\u05db\u05d1\u05d3\u05ea \u05d0\u05ea \u05db\u05dc \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9\u05dd|\u05d0\u05ea\u05e8=JPPI|\u05ea\u05d0\u05e8\u05d9\u05da=11 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2024}}</ref> \u05d5\u05d4\u05e4\u05e0\u05ea\u05d4 \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05e2\u05dc \u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea [[\u05de\u05e9\u05e8\u05d3 \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d5\u05d4\u05e7\u05dc\u05d9\u05d8\u05d4]] \u05d5\u05d4\u05e9\u05e8 \u05d4\u05e2\u05d5\u05de\u05d3 \u05d1\u05e8\u05d0\u05e9\u05d5 [[\u05d0\u05d5\u05e4\u05d9\u05e8 \u05e1\u05d5\u05e4\u05e8]], \u05d1\u05d8\u05e2\u05e0\u05d4 \u05db\u05d9 \"\u05d4\u05e4\u05e0\u05d5 \u05db\u05e1\u05e3 \u05dc\u05d2\u05d5\u05e4\u05d9\u05dd \u05e9\u05d0\u05d9\u05df \u05dc\u05d4\u05dd \u05e7\u05e9\u05e8 \u05dc\u05e2\u05dc\u05d9\u05d9\u05d4\", \u05db\u05d0\u05e9\u05e8 \u05e8\u05d5\u05d1 \u05db\u05e1\u05e4\u05d9 \u05d4\u05ea\u05de\u05d9\u05db\u05d4 \u05d4\u05d5\u05e4\u05e0\u05d5 \u05dc\u05d2\u05d5\u05e4\u05d9\u05dd [[\u05d9\u05d4\u05d3\u05d5\u05ea \u05d7\u05e8\u05d3\u05d9\u05ea|\u05d7\u05e8\u05d3\u05d9\u05d9\u05dd]] \u05d5\u05d3\u05ea\u05d9\u05d9\u05dd.{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05e4\u05d5\u05e0\u05d9}}<ref>{{\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d5\u05dd|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05e9\u05e8 \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05e9\u05db\u05d7 \u05de\u05d0\u05d9\u05e4\u05d4 \u05d1\u05d0\u05e0\u05d5|opinions/article/19122464|28 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2025}}</ref><ref>{{ynet|\u05d0\u05d9\u05ea\u05de\u05e8 \u05d0\u05d9\u05d9\u05db\u05e0\u05e8|\u05e8\u05d5\u05d1 \u05d4\u05ea\u05de\u05d9\u05db\u05d5\u05ea \u05e9\u05dc \u05de\u05e9\u05e8\u05d3 \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d5\u05d4\u05e7\u05dc\u05d9\u05d8\u05d4 - \u05dc\u05d2\u05d5\u05e4\u05d9\u05dd \u05d7\u05e8\u05d3\u05d9\u05d9\u05dd \u05d5\u05d3\u05ea\u05d9\u05d9\u05dd|judaism/article/sjc5emui11e|28 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2026}}</ref>\n\n\u05db\u05de\u05d5 \u05db\u05df, \u05e8\u05d9\u05e3 \u05e4\u05e2\u05dc\u05d4 \u05dc\u05d4\u05e2\u05dc\u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05e2\u05d5\u05ea [[\u05e0\u05d9\u05e6\u05d5\u05dc\u05d9 \u05d4\u05e9\u05d5\u05d0\u05d4|\u05dc\u05e0\u05d9\u05e6\u05d5\u05dc\u05d9 \u05e9\u05d5\u05d0\u05d4]] \u05e2\u05e0\u05d9\u05d9\u05dd \u05d4\u05d7\u05d9\u05d9\u05dd \u05d1[[\u05d9\u05e9\u05e8\u05d0\u05dc]], \u05d1\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05dc\u05dc\u05d7\u05d5\u05e5 \u05e2\u05dc \u05d4\u05de\u05de\u05e9\u05dc\u05d4 \u05dc\u05d4\u05d5\u05e6\u05d9\u05d0 \u05d0\u05d5\u05ea\u05dd \u05de\u05e8\u05e3 \u05d4\u05e2\u05d5\u05e0\u05d9, \u05db\u05d0\u05e9\u05e8 86% \u05de\u05ea\u05d5\u05db\u05dd \u05d3\u05d5\u05d1\u05e8\u05d9 [[\u05e8\u05d5\u05e1\u05d9\u05ea]].<ref>{{ynet|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05d4\u05e0\u05d9\u05e6\u05d7\u05d5\u05df \u05e9\u05dc \u05d3\u05d5\u05d3\u05d4 \u05de\u05d0\u05e9\u05d4, \u05d4\u05de\u05d7\u05d3\u05dc \u05e9\u05dc \u05de\u05d3\u05d9\u05e0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc|news/article/rya0d0078be|27 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2026}}</ref>\n\n\u05d4\u05d7\u05dc \u05de\u05e9\u05e0\u05ea [[2025]] \u05e4\u05d5\u05e2\u05dc\u05ea \u05e8\u05d9\u05e3 \u05e0\u05d2\u05d3 [[\u05e2\u05d5\u05e7\u05e5 (\u05e4\u05e9\u05e2)|\u05e2\u05d5\u05e7\u05e6\u05d9]] \u05e7\u05e9\u05d9\u05e9\u05d9\u05dd, \u05db\u05d0\u05e9\u05e8 \u05e8\u05d5\u05d1 \u05d4\u05e0\u05e4\u05d2\u05e2\u05d9\u05dd \u05d4\u05e7\u05e9\u05d9\u05e9\u05d9\u05dd \u05d4\u05dd \u05d1\u05e7\u05e8\u05d1 \u05d3\u05d5\u05d1\u05e8\u05d9 \u05d4[[\u05e8\u05d5\u05e1\u05d9\u05ea]] \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc. \u05e8\u05d9\u05e3 \u05e4\u05d5\u05e2\u05dc\u05ea \u05dc\u05d4\u05e2\u05dc\u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05e2\u05d5\u05ea \u05dc\u05ea\u05d5\u05e4\u05e2\u05d4 \u05d5\u05e7\u05d5\u05e8\u05d0\u05ea \u05dc\u05de\u05e9\u05d8\u05e8\u05d4 \u05dc\u05d8\u05e4\u05dc \u05d1\u05de\u05e7\u05e8\u05d9 \u05d4\u05e2\u05d5\u05e7\u05e5 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05e9\u05d9\u05d8\u05ea\u05d9\u05ea \u05d5\u05de\u05e2\u05de\u05d9\u05e7\u05d4 \u05d9\u05d5\u05ea\u05e8, \u05d6\u05d0\u05ea \u05d1\u05e0\u05d5\u05e1\u05e3 \u05dc\u05d4\u05e7\u05e6\u05d0\u05ea \u05de\u05e9\u05d0\u05d1\u05d9\u05dd \u05de\u05de\u05e9\u05dc\u05ea\u05d9\u05d9\u05dd \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e0\u05d5\u05e9\u05d0.<ref>{{\u05d7\u05d3\u05e9\u05d5\u05ea 13||\"\u05d0\u05d9\u05d9\u05de\u05d5 \u05e2\u05dc \u05e1\u05d1\u05ea\u05d0 \u05e9\u05dc\u05d9: '\u05d0\u05dd \u05dc\u05d0 \u05ea\u05d9\u05ea\u05e0\u05d9 \u05d0\u05ea \u05d4\u05db\u05e1\u05e3, \u05d0\u05e0\u05d7\u05e0\u05d5 \u05e0\u05d2\u05d9\u05e2 \u05d0\u05dc\u05d9\u05d9\u05da\"|item/vod/news/todays-talk/clips/jzyci-905031493|17 \u05d1\u05de\u05e8\u05e5 2026}}</ref>\n\n\u05e8\u05d9\u05e3 \u05e4\u05e2\u05dc\u05d4 \u05dc\u05e7\u05d3\u05dd \u05d4\u05d2\u05e9\u05ea [[\u05d4\u05e6\u05e2\u05ea \u05d7\u05d5\u05e7]] \u05e9\u05dc \u05d7\u05d1\u05e8\u05d9 \u05d4\u05db\u05e0\u05e1\u05ea [[\u05d6\u05d0\u05d1 \u05d0\u05dc\u05e7\u05d9\u05df]] \u05d5[[\u05de\u05e9\u05d4 \u05e1\u05e2\u05d3\u05d4]] \u05dc\u05e7\u05d1\u05d5\u05e8\u05ea \u05d7\u05dc\u05dc\u05d9 [[\u05e0\u05e4\u05d2\u05e2 \u05e4\u05e2\u05d5\u05dc\u05ea \u05d0\u05d9\u05d1\u05d4|\u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d0\u05d9\u05d1\u05d4]], \u05db\u05e4\u05d9 \u05e9\u05de\u05e7\u05d5\u05d1\u05dc \u05db\u05d9\u05d5\u05dd \u05d1\u05e4\u05e9\u05e8\u05d4 \u05d4\u05d4\u05dc\u05db\u05ea\u05d9\u05ea [[\u05e6\u05d1\u05d0 \u05d4\u05d2\u05e0\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc|\u05d1\u05e6\u05d4\"\u05dc]].<ref>{{ynet|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05e7\u05d1\u05d5\u05e8\u05d4 \u05d1\u05db\u05d1\u05d5\u05d3 \u05dc\u05db\u05dc \u05e0\u05e4\u05d2\u05e2\u05d9 \u05d4\u05d8\u05e8\u05d5\u05e8|news/article/hkyar11jvex|27 \u05d1\u05d9\u05d5\u05e0\u05d9 2025}}</ref>\n\n\u05e8\u05d9\u05e3 \u05db\u05d9\u05d4\u05e0\u05d4 \u05e2\u05d3 \u05d9\u05d5\u05dc\u05d9 2026 \u05db\u05de\u05e0\u05db\"\u05dc \u05d4\u05e2\u05de\u05d5\u05ea\u05d4, \u05e2\u05ea \u05db\u05e0\u05d9\u05e1\u05ea\u05d4 \u05dc\u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05e7\u05d4.\n\n=== \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05e0\u05d5\u05e1\u05e4\u05ea ===\n\u05d1\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea\u05d4 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05e2\u05e1\u05e7\u05d4 \u05e8\u05d9\u05e3 \u05d2\u05dd \u05d1\u05d4\u05d5\u05e0\u05d0\u05d5\u05ea \u05db\u05dc\u05db\u05dc\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05e4\u05e0\u05d5\u05ea \u05dc\u05e7\u05e9\u05d9\u05e9\u05d9\u05dd \u05d3\u05d5\u05d1\u05e8\u05d9 \u05e8\u05d5\u05e1\u05d9\u05ea \u05d5\u05d1\u05de\u05e2\u05de\u05d3\u05dd \u05e9\u05dc \u05e2\u05d5\u05dc\u05d9\u05dd \u05de\u05d5\u05dc \u05de\u05d5\u05e1\u05d3\u05d5\u05ea \u05d4\u05d3\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc. \u05d1\u05d8\u05d5\u05e8\u05d9 \u05d3\u05e2\u05d4 \u05e7\u05e8\u05d0\u05d4 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d4\u05e7\u05d1\u05d5\u05e8\u05d4 \u05e9\u05dc \u05de\u05d9 \u05e9\u05d0\u05d9\u05e0\u05dd \u05de\u05d5\u05db\u05e8\u05d9\u05dd \u05db\u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05e2\u05dc \u05e4\u05d9 \u05d4\u05d4\u05dc\u05db\u05d4,{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05e7\u05d1\u05d5\u05e8\u05d4 \u05d1\u05db\u05d1\u05d5\u05d3 \u05dc\u05db\u05dc \u05e0