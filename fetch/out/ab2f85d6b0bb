Lookup.taf?G=1118&SM=&_ID=76524&_function=details&did=1118}}</ref><ref>{{\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d5\u05dd|\u05e2\u05d9\u05d3\u05df \u05d0\u05d1\u05e0\u05d9|\u05d2\u05e8\u05e2\u05d9\u05e0\u05d9 \u05d4\u05d4\u05ea\u05d9\u05d9\u05e9\u05d1\u05d5\u05ea \u05de\u05d2\u05d9\u05e2\u05d9\u05dd \u05dc\u05d2\u05d1\u05d5\u05dc \u05d4\u05e6\u05e4\u05d5\u05df: \"\u05d4\u05d1\u05d9\u05e7\u05d5\u05e9 \u05e2\u05d5\u05dc\u05d4 \u05e2\u05dc \u05d4\u05d4\u05d9\u05e6\u05e2\"|news/local/article/18297201|28 \u05d1\u05d9\u05d5\u05e0\u05d9 2025}}</ref>\n\n\u05d0\u05d5\u05d7\u05e0\u05d4 \u05d7\u05d1\u05e8\u05d4 \u05d1\u05d5\u05d5\u05e2\u05d3 \u05d4\u05de\u05e0\u05d4\u05dc \u05e9\u05dc \u05f4255 - \u05d0\u05e8\u05d2\u05d5\u05df \u05d4\u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d5\u05d4\u05d7\u05d8\u05d5\u05e4\u05d9\u05dd\u05f4.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://hostages255.org/#team|\u05d4\u05db\u05d5\u05ea\u05d1=orenba|\u05db\u05d5\u05ea\u05e8\u05ea=255 \u2013 \u05d0\u05e8\u05d2\u05d5\u05df \u05d4\u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d5\u05d4\u05d7\u05d8\u05d5\u05e4\u05d9\u05dd|\u05ea\u05d0\u05e8\u05d9\u05da=28 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2025}}</ref>\n\n== \u05de\u05d5\u05e2\u05de\u05d3\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea ==\n\u05d1\u05e9\u05e0\u05ea 2026 \u05d4\u05d5\u05d3\u05d9\u05e2\u05d4 \u05e2\u05dc \u05d4\u05e6\u05d8\u05e8\u05e4\u05d5\u05ea\u05d4 \u05dc\u05de\u05e4\u05dc\u05d2\u05ea \"[[\u05d9\u05e9\u05e8!|\u05d9\u05e9\u05e8! \u05e2\u05dd \u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8]]\".{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05d9\u05d5\u05d1\u05dc \u05e7\u05e8\u05e0\u05d9|\u05e8\u05d0\u05e9 \u05de\u05d5\u05e2\u05e6\u05ea \u05d9\u05e8\u05d5\u05d7\u05dd \u05dc\u05e9\u05e2\u05d1\u05e8 \u05d8\u05dc \u05d0\u05d5\u05d7\u05e0\u05d4 \u05d7\u05db\u05de\u05d5\u05df \u05d5\u05d0\u05dc\"\u05de \u05d1\u05de\u05d9\u05dc' \u05e0\u05d9\u05e8 \u05d7\u05d2'\u05d1\u05d9 \u05de\u05e6\u05d8\u05e8\u05e4\u05d9\u05dd \u05dc\u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8|news/article/hjibofw00mx|30 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2026}}}} \u05d0\u05d5\u05d7\u05e0\u05d4 \u05d4\u05d5\u05e6\u05d1\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4-19 \u05d1\u05e8\u05e9\u05d9\u05de\u05ea \"\u05d9\u05e9\u05e8! \u05e2\u05dd \u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8\" \u05dc\u05db\u05e0\u05e1\u05ea \u05d4\u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05e9, \u05e9\u05d4\u05d5\u05d2\u05e9\u05d4 \u05d1\u05be7 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2026.{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05d0\u05e7\u05d5||\u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8 \u05d1\u05d4\u05e6\u05d2\u05ea \u05e8\u05e9\u05d9\u05de\u05ea \"\u05d9\u05e9\u05e8\": \"\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05de\u05de\u05e9\u05dc\u05d4 - \u05dc\u05d9\u05d9\u05e6\u05e8 \u05db\u05d0\u05d5\u05e1 \u05e9\u05d9\u05d1\u05d9\u05d0 \u05dc\u05e2\u05d5\u05d3 \u05d5\u05e2\u05d5\u05d3 \u05e1\u05d1\u05d1\u05d9 \u05d1\u05d7\u05d9\u05e8\u05d5\u05ea\"|896792932bb70a1027|news-politics/2026_q3|7 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2026}}}}\n\n== \u05e4\u05e8\u05e1\u05d9\u05dd \u05d5\u05d4\u05d5\u05e7\u05e8\u05d4 ==\n\u05d1\u05e9\u05e0\u05ea 2019 \u05d4\u05d5\u05e2\u05e0\u05e7 \u05dc\u05d0\u05d5\u05d7\u05e0\u05d4 [[\u05d0\u05d5\u05ea \u05d1\u05df-\u05d2\u05d5\u05e8\u05d9\u05d5\u05df]] \u05e2\u05dc \u05e2\u05e9\u05d9\u05d9\u05d4 \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea \u05d5\u05de\u05e0\u05d4\u05d9\u05d2\u05d5\u05ea \u05e6\u05e2\u05d9\u05e8\u05d4.{{\u05d4\u05e2\u05e8\u05d4|[https://in.bgu.ac.il/pages/news/bgday2019-awards.aspx \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05d1\u05df-\u05d2\u05d5\u05e8\u05d9\u05d5\u05df \u05d1\u05e0\u05d2\u05d1 \u05ea\u05e2\u05e0\u05d9\u05e7 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d0\u05ea '\u05d0\u05d5\u05ea \u05d1\u05df-\u05d2\u05d5\u05e8\u05d9\u05d5\u05df' \u05dc\u05e8\u05d2\u05dc \u05d7\u05d2\u05d9\u05d2\u05d5\u05ea \u05d4\u05d9\u05d5\u05d1\u05dc \u05dc\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4] \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05d1\u05df-\u05d2\u05d5\u05e8\u05d9\u05d5\u05df, 20 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2019}}\n\n== \u05d7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd ==\n\u05d1\u05d2\u05d9\u05dc 38, \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05ea\u05d1\u05e9\u05e8\u05d4 \u05d0\u05d5\u05d7\u05e0\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05d5\u05e4\u05d0\u05d9\u05d4 \u05db\u05d9 \u05d4\u05d9\u05d0 \u05e1\u05d5\u05d1\u05dc\u05ea \u05de\u05ea\u05d5\u05e4\u05e2\u05ea [[\u05d0\u05d9-\u05e1\u05e4\u05d9\u05e7\u05d4 \u05e9\u05d7\u05dc\u05ea\u05d9\u05ea \u05de\u05d5\u05e7\u05d3\u05de\u05ea]], \u05d5\u05db\u05d9 \u05d0\u05dd \u05dc\u05d0 \u05ea\u05d4\u05e8\u05d4 \u05d1\u05de\u05d4\u05e8\u05d4 \u05d4\u05d9\u05d0 \u05e2\u05dc\u05d5\u05dc\u05d4 \u05dc\u05d0\u05d1\u05d3 \u05d0\u05ea \u05e4\u05d5\u05e8\u05d9\u05d5\u05ea\u05d4, \u05d1\u05d9\u05e6\u05e2\u05d4 \u05d0\u05d5\u05d7\u05e0\u05d4 [[\u05d8\u05d9\u05e4\u05d5\u05dc\u05d9 \u05e4\u05d5\u05e8\u05d9\u05d5\u05ea]] \u05e7\u05e9\u05d9\u05dd,{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05ea\u05d7\u05d9\u05d4 \u05d1\u05e8\u05e7|\u05d8\u05dc \u05d0\u05d5\u05d7\u05e0\u05d4, \u05e8\u05d0\u05e9\u05ea \u05d4\u05e2\u05d9\u05e8 \u05d9\u05e8\u05d5\u05d7\u05dd: \"\u05db\u05dc \u05d4\u05d7\u05d9\u05d9\u05dd \u05de\u05dc\u05d7\u05de\u05d5\u05ea - \u05e2\u05dc \u05d4\u05e6\u05d3\u05e7, \u05e2\u05dc \u05d4\u05d6\u05d5\u05d2\u05d9\u05d5\u05ea \u05d5\u05e2\u05dc \u05d4\u05e4\u05d5\u05e8\u05d9\u05d5\u05ea\"|59062410|30 \u05d1\u05de\u05e8\u05e5 2021}}}} \u05d5\u05d6\u05db\u05ea\u05d4 \u05dc\u05d4\u05e8\u05d5\u05ea \u05d5\u05dc\u05dc\u05d3\u05ea \u05d1\u05ea. \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2022 \u05e0\u05d9\u05e9\u05d0\u05d4 \u05d0\u05d5\u05d7\u05e0\u05d4 \u05dc\u05d1\u05df \u05d6\u05d5\u05d2\u05d4, \u05e6\u05d7\u05d9 \u05d7\u05db\u05de\u05d5\u05df, \u05d0\u05d5\u05ea\u05d5 \u05d4\u05db\u05d9\u05e8\u05d4 \u05d1\u05de\u05d4\u