u05e2\u05d1\u05d3\u05d4 \u05db\u05d9\u05d5\u05e6\u05e8\u05ea \u05d5\u05ea\u05e1\u05e8\u05d9\u05d8\u05d0\u05d9\u05ea \u05d9\u05d7\u05d3 \u05e2\u05dd \u05e8\u05e2\u05d9\u05d4 \u05e9\u05d5\u05e1\u05d8\u05e8 \u05d5\u05e8\u05d5\u05de\u05df \u05e9\u05d5\u05de\u05e0\u05d5\u05d1 \u05e2\u05dc \u05e1\u05d9\u05e4\u05d5\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05d4\u05d2\u05d3\u05d5\u05dc\u05d4 \u05de\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea \u05d1\u05e9\u05e0\u05d5\u05ea \u05d4-90, \u05d3\u05e8\u05da \u05e2\u05d9\u05e0\u05d9\u05d4\u05dd \u05e9\u05dc \"\u05d3\u05d5\u05e8 \u05d0\u05d7\u05d3 \u05d5\u05d7\u05e6\u05d9\", \u05d0\u05dc\u05d5 \u05e9\u05e0\u05d5\u05dc\u05d3\u05d5 \u05e9\u05dd, \u05e2\u05dc\u05d5 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05d4\u05d9\u05d5\u05ea\u05dd \u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05d1\u05e0\u05d9 \u05e0\u05d5\u05e2\u05e8, \u05d5\u05d7\u05d5\u05d5 \u05d0\u05ea \u05e7\u05e9\u05d9\u05d9 \u05d4\u05e7\u05dc\u05d9\u05d8\u05d4 \u05e9\u05dc\u05d4\u05dd \u05d5\u05e9\u05dc \u05de\u05e9\u05e4\u05d7\u05ea\u05dd. \u05dc\u05d0\u05d7\u05e8 30 \u05e9\u05e0\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc, \u05d5\u05db\u05e9\u05d4\u05dd \u05db\u05d1\u05e8 \u05d1\u05d5\u05d2\u05e8\u05d9\u05dd, \u05de\u05ea\u05de\u05d5\u05d3\u05d3\u05d9\u05dd \u05d1\u05e0\u05d9 \u05d4\u05d3\u05d5\u05e8 \u05d4\u05d6\u05d4 \u05e2\u05dd \u05e9\u05d0\u05dc\u05ea \u05d4\u05d6\u05d4\u05d5\u05ea \u05d5\u05d4\u05e9\u05d9\u05d9\u05db\u05d5\u05ea \u05e9\u05dc\u05d4\u05dd \u05d1\u05d0\u05e8\u05e5 \u05db\u05d9\u05d5\u05dd, \u05de\u05d3\u05d1\u05e8\u05d9\u05dd \u05e2\u05dc \u05d4\u05d0\u05e4\u05dc\u05d9\u05d4, \u05d4\u05d2\u05d6\u05e2\u05e0\u05d5\u05ea \u05d5\u05d4\u05d4\u05ea\u05e0\u05e9\u05d0\u05d5\u05ea \u05e9\u05d7\u05d5\u05d5, \u05d4\u05d5\u05d5\u05d9\u05ea\u05d5\u05e8\u05d9\u05dd \u05e9\u05d4\u05dd \u05d5\u05d4\u05d5\u05e8\u05d9\u05d4\u05dd \u05e0\u05d3\u05e8\u05e9\u05d5 \u05dc\u05e2\u05e9\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05d9\u05e7\u05dc\u05d8, \u05d5\u05ea\u05d5\u05d4\u05d9\u05dd \u05d4\u05d0\u05dd \u05d1\u05e1\u05d5\u05e4\u05d5 \u05e9\u05dc \u05d3\u05d1\u05e8 \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05e9\u05dc\u05d9\u05d5\u05d5\u05d4 \u05d0\u05ea \u05d7\u05d9\u05d9\u05d4\u05dd \u05d4\u05d9\u05d4 \u05db\u05d3\u05d0\u05d9. \u05e8\u05d9\u05e3 \u05d2\u05dd \u05de\u05e9\u05ea\u05ea\u05e4\u05ea \u05d1\u05e1\u05d3\u05e8\u05d4 \u05db\u05d0\u05d7\u05ea \u05d4\u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d0\u05de\u05d4, \u05de\u05d9\u05e8\u05d4, \u05d1\u05e4\u05e8\u05e7\u05d9\u05dd 2 \u05d5-3.\n\n== \u05db\u05ea\u05d9\u05d1\u05d4 ==\n\u05d1\u05e9\u05e0\u05ea [[2018]] \u05e8\u05d0\u05d4 \u05d0\u05d5\u05e8 \u05d1[[\u05d4\u05d5\u05e6\u05d0\u05ea \u05e4\u05e8\u05d3\u05e1]] (\u05d1\u05e2\u05e8\u05d9\u05db\u05ea [[\u05d9\u05e2\u05dc \u05d2\u05dc\u05d5\u05d1\u05e8\u05de\u05df]]) \u05e1\u05e4\u05e8 \u05e9\u05d9\u05e8\u05d9\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05e9\u05dc \u05e8\u05d9\u05e3, \"[[\u05d8\u05e4\u05e9\u05d5\u05e0\u05ea \u05de\u05e9\u05d8\u05e8\u05d9\u05dd]]\", \u05d4\u05de\u05e1\u05db\u05dd \u05d1\u05d7\u05de\u05d9\u05e9\u05d9\u05dd \u05e9\u05d9\u05e8\u05d9\u05dd \u05d0\u05ea \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05d4\u05d2\u05d9\u05e8\u05d4 \u05e9\u05dc\u05d4 \u05de\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc. \u05d4\u05e1\u05e4\u05e8 \u05d6\u05db\u05d4 \u05d1\u05e4\u05e8\u05e1 \u05e1\u05e4\u05e8 \u05d4\u05d1\u05d9\u05db\u05d5\u05e8\u05d9\u05dd \u05e9\u05dc [[\u05de\u05e8\u05db\u05d6 \u05d4\u05e1\u05e4\u05e8 \u05d5\u05d4\u05e1\u05e4\u05e8\u05d9\u05d5\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc]] \u05d5\u05d1[[\u05e4\u05e8\u05e1 \u05e9\u05e8\u05ea \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea\u05d9\u05ea|\u05e4\u05e8\u05e1 \u05e9\u05e8\u05ea \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05dc\u05de\u05e9\u05d5\u05e8\u05e8\u05d9\u05dd \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea \u05d3\u05e8\u05db\u05dd]] \u05dc\u05e9\u05e0\u05ea \u05ea\u05e9\u05e2\"\u05d7 \u05d5\u05e8\u05d9\u05e3 \u05d6\u05db\u05ea\u05d4 \u05d1[[\u05e4\u05e8\u05e1 \u05de\u05ea\u05e0\u05d0\u05dc]] \u05dc\u05de\u05e9\u05d5\u05e8\u05e8\u05ea \u05de\u05d1\u05d8\u05d9\u05d7\u05d4. \u05e8\u05d9\u05e3 \u05de\u05d3\u05d1\u05e8\u05ea \u05d1\u05e9\u05d9\u05e8\u05d9\u05d4 \u05e2\u05dc \u05d4\u05d9\u05dc\u05d3\u05d5\u05ea \u05e9\u05dc\u05d4: \u05e2\u05dc \u05d9\u05d1\u05d2\u05e0\u05d9, \u05d4\u05d9\u05dc\u05d3 \u05d4\u05e8\u05d5\u05e1\u05d9 \u05d4\u05d7\u05d3\u05e9 \u05d1\u05d2\u05df, \u05e2\u05dc \u05d0\u05de\u05d0 \u05e9\u05dc\u05d4 \u05e2\u05d5\u05d1\u05d3\u05ea \u05d4\u05e7\u05d1\u05dc\u05df, \u05d5\u05e2\u05d5\u05d3.{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05e7\u05d5\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df||\u05d1\u05d9\u05db\u05d5\u05e8\u05d9\u05dd \u05d0\u05d9\u05ea\u05e0\u05d5: \u05e4\u05d9\u05e1\u05ea \u05e8\u05d2\u05e9, \u05d8\u05d9\u05e4\u05ea \u05e1\u05d1\u05dc|culture/146877|17 \u05d1\u05d9\u05d5\u05e0\u05d9 2019}}}}\n\n\u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2024 \u05e4\u05e8\u05e1\u05de\u05d4 \u05e8\u05d9\u05e3 \u05d0\u05ea \u05e1\u05e4\u05e8 \u05e9\u05d9\u05e8\u05d9\u05d4 \u05d4\u05e9\u05e0\u05d9, \"\u05d1\u05e2\u05d9\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4\". \u05d4\u05e1\u05e4\u05e8 \u05de\u05ea\u05d7\u05e7\u05d4 \u05d0\u05d7\u05e8 \u05d7\u05d5\u05d5\u05d9\u05d9\u05ea \u05d4\u05dc\u05d9\u05d3\u05d4 \u05d5\u05d4\u05d4\u05e4\u05d9\u05db\u05d4 \u05dc\u05d0\u05dd, \u05de\u05ea\u05de\u05d5\u05d3\u05d3 \u05e2\u05dd \u05d0\u05d5\u05d1\u05d3\u05df \u05d1[[\u05d4\u05ea\u05d0\u05d1\u05d3\u05d5\u05ea]] \u05d1\u05ea\u05d5\u05da \u05d4\u05de\u05e9\u05e4\u05d7\u05d4, \u05d5\u05d7\u05d5\u05d6\u05e8 \u05d0\u05dc \u05d8\u05e8\u05d0\u05d5\u05de\u05ea \u05d4\u05d4\u05d2\u05d9\u05e8\u05d4 \u05d4\u05de\u05ea\u05de\u05e9\u05db\u05ea \u05d5\u05d6\u05d4\u05d5\u05ea \u05d3\u05d5-\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.hebrew-writers.org/\u05d1\u05e2\u05d9\u05e8-\u05d4\u05dc\u05d9\u05d3\u05d4-\u05e1\u05e4\u05e8-\u05e9\u05d9\u05e8\u05d4-\u05de\u05d0\u05ea-\u05d0\u05dc\u05e7\u05e1-\u05e8\u05d9\u05e3?|\u05db\u05d5\u05ea\u05e8\u05ea=\"\u05d1\u05e2\u05d9\u05e8 \u05d4\u05dc\u05d9\u05d3\u05d4\" \u05e1\u05e4\u05e8 \u05e9\u05d9\u05e8\u05d4 \u05de\u05d0\u05ea \u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05d0\u05ea\u05e8=www.hebrew-writers.org|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2025-10-05}}</ref>\n\n\u05d1\u05e9\u05e0\u05ea 2025 \u05e4\u05e8\u05e1\u05de\u05d4 \u05e8\u05d9\u05e3 \u05d0\u05ea \u05e1\u05e4\u05e8 \u05d4\u05e2\u05d9\u05d5\u05df \"[[\u05d9\u05d5\u05ea\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d9 \u05de\u05de\u05da]]\" (\u05d4\u05d5\u05e6\u05d0\u05ea [[\u05e1\u05dc\u05e2 \u05de\u05d0\u05d9\u05e8]]), \u05d4\u05e2\u05d5\u05e1\u05e7 \u05d1\u05de\u05e2\u05de\u05d3\u05dd \u05e9\u05dc \u05e2\u05d5\u05dc\u05d9 \u05d1\u05e8\u05d9\u05ea\u05be\u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea \u05dc\u05e9\u05e2\u05d1\u05e8 \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d1\u05de\u05e4\u05d2\u05e9 \u05e9\u05dc\u05d4\u05dd \u05e2\u05dd \u05d4\u05de\u05de\u05e1\u05d3 \u05d4\u05d3\u05ea\u05d9 \u05d5\u05d4\u05d0\u05d6\u05e8\u05d7\u05d9. \u05e8\u05d9\u05e3 \u05d4\u05d2\u05d3\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e4\u05d5\u05e8 \u05db\u05e2\u05d5\u05e1\u05e7 \u05d1-\u201c1.3 \u05de\u05d9\u05dc\u05d9\u05d5\u05df \u05e2\u05d5\u05dc\u05d9\u05dd\u2026 \u05e9\u05d1\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea \u05d7\u05e9\u05d3\u05d5 \u05d1\u05d4\u05dd \u05e9\u05d4\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd, \u05d5\u05d0\u05d9\u05dc\u05d5 \u05db\u05d0\u05df \u05d7\u05d5\u05e9\u05d3\u05d9\u05dd \u05d1\u05d7\u05dc\u05e7\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd\u201c.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://sellameir.com/products/\u05d9\u05d5\u05ea\u05e8-\u05d9\u05d4\u05d5\u05d3\u05d9-\u05de\u05de\u05da|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d9\u05d5\u05ea\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d9 \u05de\u05de\u05da|\u05d0\u05ea\u05e8=\u05e1\u05dc\u05e2 \u05de\u05d0\u05d9\u05e8|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2025-10-05}}</ref>{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05e4\u05d5\u05e0\u05d9|{{\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d5\u05dd|\u05e8\u05df \u05e4\u05d5\u05e0\u05d9|\"\u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05e9\u05dc\u05e0\u05d5 \u05d0\u05d5\u05d4\u05d1\u05ea \u05e2\u05dc\u05d9\u05d9\u05d4, \u05d4\u05d9\u05d0 \u05e8\u05e7 \u05dc\u05d0 \u05d0\u05d5\u05d4\u05d1\u05ea \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05e2\u05d5\u05dc\u05d9\u05dd \u05dc\u05d4\u05d9\u05e7\u05dc\u05d8\"|magazine/hashavua/article/18915898|25 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2025}}}}\n\n\u05db\u05d7\u05dc\u05e7 \u05de\u05db\u05ea\u05d9\u05d1\u05ea \u05d4\u05e1\u05e4\u05e8 \u05e8\u05d9\u05e3 \u05e8\u05d0\u05d9\u05d9\u05e0\u05d4 \u05d1\u05d9\u05df \u05d4\u05d9\u05ea\u05e8 \u05d0\u05ea \u05e8\u05d0\u05e9 [[\u05d4\u05de\u05d5\u05e1\u05d3 \u05dc\u05de\u05d5\u05d3\u05d9\u05e2\u05d9\u05df \u05d5\u05dc\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05de\u05d9\u05d5\u05d7\u05d3\u05d9\u05dd|\u05d4\u05de\u05d5\u05e1\u05d3]] [[\u05e8\u05d5\u05de\u05df \u05d2\u05d5\u05e4\u05de\u05df]], \u05d0\u05e9\u05e8 \u05e9\u05d9\u05ea\u05e3 \u05d0\u05ea \u05e1\u05d9\u05e4\u05d5\u05e8\u05d5 \u05d4\u05d0\u05d9\u05e9\u05d9.<ref>{{\u05de\u05e2\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e0\u05dc\u05d9\u05d9\u05df|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05d4\u05e1\u05d9\u05e4\u05d5\u05e8 \u05d4\u05d1\u05dc\u05ea\u05d9 \u05d9\u05d0\u05de\u05df \u05e9\u05dc \u05e8\u05d0\u05e9 \u05d4\u05de\u05d5\u05e1\u05d3: \u05d4\u05d1\u05d9\u05d8 \u05d1\u05e8\u05d7\u05de\u05d9\u05dd \u05d1\u05d9\u05d4\u05d5\u05d3\u05d9\u05dd - \u05de\u05d9\u05e2\u05d5\u05d8 \u05e9\u05e0\u05d5\u05d0 \u05d5\u05de\u05d5\u05e9\u05e4\u05dc \u05d5\u05d0\u05d6 \u05e0\u05d7\u05e9\u05e3 \u05d4\u05e1\u05d5\u05d3|news/politics/article-1263687|20 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2025}}</ref>\n\n== \u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8\u05d9\u05dd ==\n\u05d1\u05e9\u05e0\u05ea 2025, \u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05dc\u05d4\u05d5\u05e6\u05d0\u05ea \u05e1\u05e4\u05e8\u05d4, \u05d4\u05e9\u05d9\u05e7\u05d4 \u05d9\u05d7\u05d3 \u05e2\u05dd \u05de\u05e8\u05d3\u05db\u05d9 \u05d0\u05e1\u05e7\u05d9\u05df \u05d0\u05ea \u05d4[[\u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8]] \"\u05d9\u05d5\u05ea\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d9 \u05de\u05de\u05da\", \u05d4\u05e2\u05d5\u05e1\u05e7 \u05d1\u05d0\u05ea\u05d2\u05e8\u05d9\u05dd \u05e9\u05dc \u05d9\u05d5\u05e6\u05d0\u05d9 [[\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea]] \u05d1\u05de\u05d3\u05d9\u05e0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05d5\u05d1\u05e4\u05e8\u05d8 \u05d0\u05dc \u05de\u05d5\u05dc \u05d4\u05de\u05de\u05e1\u05d3 \u05d4\u05d3\u05ea\u05d9.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://103fm.maariv.co.il/programs/program.aspx?c41t4nzVQ=KEK|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d9\u05d5\u05ea\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d9 \u05de\u05de\u05da|\u05d0\u05ea\u05e8=\u05e8\u05d3\u05d9\u05d5 103fm}}</ref>\n\n\u05d1\u05d4\u05de\u05e9\u05da \u05e9\u05e0\u05ea 2025 \u05d4\u05e9\u05d9\u05e7\u05d4 \u05d2\u05dd \u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8 \u05e2\u05e6\u05de\u05d0\u05d9 \u05d1\u05e9\u05dd \"\u05ea\u05e9\u05e2\u05d9\u05dd \u05d5\u05ea\u05e9\u05e2 \u05d6\u05d4 \u05dc\u05d0 \u05de\u05d0\u05d4\", \u05d1\u05d5 \u05d4\u05d9\u05d0 \u05d0\u05d9\u05e8\u05d7\u05d4 \u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05e6\u05d9\u05d1\u05d5\u05e8 \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05d5\u05ea \u05e9\u05e2\u05dc\u05d5 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05d1\u05e8\u0