u05d9\u05dd \u05e2\u05dd \u05de\u05d9\u05d9\u05e1\u05d3\u05d9 \u05d4\u05e7\u05d9\u05d1\u05d5\u05e5, \u05e0\u05d9\u05e9\u05d0\u05d5 \u05d1-[[1952]]{{\u05d4\u05e2\u05e8\u05d4|{{\u05d3\u05d1\u05e8||\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e2\u05dc \u05d4\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05dd|19520605|77.4}}}}. \u05d0\u05d9\u05de\u05d5, \u05e2\u05dc\u05d9\u05d6\u05d4 \u05ea\u05d9\u05d1\u05d5\u05df \u05dc\u05d1\u05d9\u05ea \u05e7\u05e8\u05b7\u05e4\u05b0\u05d8, \u05d4\u05d9\u05d0 \u05d1\u05ea\u05dd \u05e9\u05dc \u05d0\u05b6\u05e8\u05e0\u05b8\u05d4 \u05e7\u05e8\u05e4\u05d8 \u05dc\u05d1\u05d9\u05ea \u05d4\u05dc\u05d4 (\u05d0\u05d7\u05d5\u05ea\u05d4 \u05e9\u05dc \u05d4\u05de\u05d7\u05e0\u05db\u05ea [[\u05d8\u05d5\u05e0\u05d9 \u05d4\u05dc\u05d4]]) \u05d5\u05d4\u05e1\u05d5\u05e4\u05e8 \u05d4[[\u05e1\u05e4\u05e8\u05d5\u05ea \u05d2\u05e8\u05de\u05e0\u05d9\u05ea|\u05d2\u05e8\u05de\u05e0\u05d9]]-\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9 [[\u05d5\u05e8\u05e0\u05e8 \u05e7\u05e8\u05d0\u05e4\u05d8]]. \u05d0\u05d1\u05d9\u05d5, [[\u05d9\u05d5\u05d0\u05d1 \u05ea\u05d9\u05d1\u05d5\u05df]] (\u05e4\u05e4\u05e8\u05de\u05df), \u05db\u05d9\u05d4\u05df \u05db\u05e8\u05d0\u05e9 [[\u05de\u05d5\u05e2\u05e6\u05d4 \u05d0\u05d6\u05d5\u05e8\u05d9\u05ea \u05d2\u05d9\u05d6\u05d5]] \u05d5\u05d0\u05d7\u05e8-\u05db\u05da \u05db\u05e1\u05d2\u05df \u05e8\u05d0\u05e9 [[\u05de\u05d5\u05e2\u05e6\u05d4 \u05d0\u05d6\u05d5\u05e8\u05d9\u05ea \u05de\u05d8\u05d4 \u05d9\u05d4\u05d5\u05d3\u05d4]], \u05d5\u05d4\u05d5\u05d0 \u05d1\u05e0\u05dd \u05e9\u05dc \u05d3\"\u05e8 \u05e2\u05de\u05e0\u05d5\u05d0\u05dc \u05e4\u05e4\u05e8\u05de\u05df, \u05de\u05de\u05d9\u05d9\u05e1\u05d3\u05d9 [[\u05d4\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4 \u05d4\u05dc\u05d0\u05d5\u05de\u05d9\u05ea]], \u05d5\u05d3\"\u05e8 \u05d9\u05d5\u05b9\u05dc\u05b8\u05df \u05d0\u05b6\u05d3\u05dc\u05d9\u05e5-\u05e4\u05b6\u05e4\u05b6\u05e8\u05de\u05df (Edlitz-Pfefferman), [[\u05de\u05e8\u05e6\u05d4]] \u05dc[[\u05db\u05d9\u05de\u05d9\u05d4 \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05ea]] \u05d1[[\u05d4\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]], \u05de\u05d4\u05de\u05e8\u05e6\u05d5\u05ea \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d5\u05ea \u05dc\u05db\u05d9\u05de\u05d9\u05d4 \u05d1\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4 \u05d6\u05d5.\n\n\u05ea\u05d9\u05d1\u05d5\u05df \u05dc\u05de\u05d3 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d4\u05d0\u05d6\u05d5\u05e8\u05d9 \u05d1\u05e7\u05d9\u05d1\u05d5\u05e5 [[\u05d2\u05d1\u05e2\u05ea \u05d1\u05e8\u05e0\u05e8]] \u05d5\u05e2\u05e9\u05d4 [[\u05e9\u05e0\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea]] \u05d1[[\u05e2\u05e8\u05d3]] \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05ea\u05e0\u05d5\u05e2\u05ea [[\u05d4\u05e0\u05d5\u05e2\u05e8 \u05d4\u05e2\u05d5\u05d1\u05d3 \u05d5\u05d4\u05dc\u05d5\u05de\u05d3]].\n\n== \u05e7\u05e8\u05d9\u05d9\u05e8\u05d4 \u05e6\u05d1\u05d0\u05d9\u05ea ==\n[[\u05e7\u05d5\u05d1\u05e5:Noam Tibon Graffiti.jpg|\u05de\u05de\u05d5\u05d6\u05e2\u05e8|\u05d2\u05e8\u05e4\u05d9\u05d8\u05d9 \u05e9\u05dc \u05e0\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df \u05d1[[\u05e7\u05e8\u05d9\u05d9\u05ea \u05d4\u05de\u05dc\u05d0\u05db\u05d4]] \u05d1\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1, \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05e4\u05e2\u05d5\u05dc\u05ea\u05d5 \u05d1\u05d6\u05de\u05df [[\u05d8\u05d1\u05d7 \u05e9\u05d1\u05e2\u05d4 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8]] \u05dc\u05d4\u05e6\u05dc\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd. \u05d4\u05d2\u05e8\u05e4\u05d9\u05d8\u05d9 \u05e9\u05d5\u05d0\u05d1 \u05d4\u05e9\u05e8\u05d0\u05d4 \u05de\u05d3\u05de\u05d5\u05ea\u05d5 \u05e9\u05dc [[\u05e4\u05dc\u05d0\u05e9 (\u05e7\u05d5\u05de\u05d9\u05e7\u05e1)|\u05d4\u05e4\u05dc\u05d0\u05e9]].]]\n\n\u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 [[1981]] [[\u05d2\u05d9\u05d5\u05e1 \u05dc\u05e6\u05d4\"\u05dc|\u05d4\u05ea\u05d2\u05d9\u05d9\u05e1 \u05dc\u05e6\u05d4\"\u05dc]] \u05d5\u05e9\u05d9\u05e8\u05ea \u05d1[[\u05e1\u05d9\u05d9\u05e8\u05ea \u05de\u05d8\u05db\"\u05dc]]. \u05dc\u05d0\u05d7\u05e8 \u05d8\u05d9\u05e8\u05d5\u05e0\u05d5\u05ea [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd|\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd]] \u05e2\u05d1\u05e8 [[\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05db\u05e9\u05e8\u05d4]] \u05db[[\u05dc\u05d5\u05d7\u05dd]] \u05d1\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d5\u05db\u05df \u05d4\u05db\u05e9\u05e8\u05d4 \u05db[[\u05db\u05d9\u05ea\u05d4 (\u05e6\u05d1\u05d0)|\u05de\u05e4\u05e7\u05d3 \u05db\u05d9\u05ea\u05d4]]. \u05dc\u05d7\u05dd \u05d1[[\u05de\u05dc\u05d7\u05de\u05ea \u05dc\u05d1\u05e0\u05d5\u05df \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4]], \u05e9\u05d1\u05d4 \u05dc\u05e7\u05d7\u05d4 \u05e1\u05d9\u05d9\u05e8\u05ea \u05de\u05d8\u05db\"\u05dc \u05d7\u05dc\u05e7 \u05e4\u05e2\u05d9\u05dc \u05db\u05d9\u05d7\u05d9\u05d3\u05ea [[\u05d7\u05d9\u05dc \u05e8\u05d2\u05dc\u05d9\u05dd|\u05d7\u05d9\"\u05e8]]{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05d1\u05e7\u05e8|[[\u05d0\u05d1\u05d9\u05d7\u05d9 \u05d1\u05e7\u05e8]], \"\u05d3\u05e8\u05da \u05e0\u05d5\u05e2\u05dd\", [[\u05d4\u05d0\u05e8\u05e5]], 5 \u05d1\u05de\u05d0\u05d9 2000, \"\u05e8\u05e7 \u05db\u05e9\u05d4\u05d2\u05e2\u05ea\u05d9 \u05dc\u05e4\u05d5\"\u05dd \u05d4\u05ea\u05d1\u05e8\u05e8 \u05dc\u05d9 \u05e9\u05d1\u05e9\u05dc\u05d5\u05dd \u05d4\u05d2\u05dc\u05d9\u05dc \u05d4\u05d9\u05d9\u05e0\u05d5 \u05d1\u05de\u05d5\u05e7\u05d3 \u05d4\u05e2\u05e9\u05d9\u05d9\u05d4. \u05db\u05d7\u05d9\u05d9\u05dc \u05d6\u05d4 \u05dc\u05d0 \u05de\u05de\u05e9 \u05e2\u05e0\u05d9\u05d9\u05df \u05d0\u05d5\u05ea\u05d9. \u05dc\u05d7\u05de\u05e0\u05d5 \u05e0\u05d2\u05d3 \u05d4\u05e7\u05d5\u05de\u05e0\u05d3\u05d5 \u05d4\u05e1\u05d5\u05e8\u05d9 \u05d1'\u05de\u05d9\u05d5\u05e2\u05e8\u05ea', \u05d4\u05d9\u05d9\u05e0\u05d5 \u05d1\u05e2\u05d9\u05df \u05d0-\u05ea\u05d9\u05e0\u05d4, \u05d1\u05e4\u05e8\u05d9\u05e6\u05d4 \u05dc\u05d1\u05d9\u05d9\u05e8\u05d5\u05ea\".}}, \u05de\u05d5\u05e0\u05d4 \u05db[[\u05de\u05e9\"\u05e7]] \u05dc\u05de\u05e4\u05e7\u05d3 \u05e6\u05d5\u05d5\u05ea \u05d1\u05d9\u05d7\u05d9\u05d3\u05d4, \u05d5\u05d4\u05e9\u05ea\u05d7\u05e8\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc \u05de\u05e1\u05e4\u05e8 \u05e9\u05e0\u05d9\u05dd.\n\n\u05dc\u05d0\u05d7\u05e8 \u05de\u05d9\u05e0\u05d5\u05d9\u05d5 \u05e9\u05dc [[\u05de\u05e9\u05d4 \u05d9\u05e2\u05dc\u05d5\u05df]] \u05dc\u05de\u05e4\u05e7\u05d3 \u05e1\u05d9\u05d9\u05e8\u05ea \u05de\u05d8\u05db\"\u05dc, \u05d1-[[1987]] \u05d7\u05d6\u05e8 \u05ea\u05d9\u05d1\u05d5\u05df \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05e6\u05d1\u05d0\u05d9 \u05d5\u05dc\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05e4\u05e7\u05d3 \u05e6\u05d5\u05d5\u05ea \u05d1\u05d9\u05d7\u05d9\u05d3\u05d4. \u05d4\u05d5\u05d0 \u05d4\u05d9\u05d4 \u05d0\u05de\u05d5\u05e8 \u05dc\u05e6\u05d0\u05ea \u05dc[[\u05e7\u05d5\u05e8\u05e1 \u05e7\u05e6\u05d9\u05e0\u05d9\u05dd \u05d1\u05e6\u05d4\"\u05dc|\u05e7\u05d5\u05e8\u05e1 \u05e7\u05e6\u05d9\u05e0\u05d9\u05dd]], \u05d0\u05d5\u05dc\u05dd \u05e2\u05e7\u05d1 \u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea\u05d5 \u05d1\u05de\u05d1\u05e6\u05e2 \u05de\u05d9\u05d5\u05d7\u05d3 \u05e9\u05dc \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05d1\u05d5\u05d8\u05dc\u05d4 \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d6\u05d5, \u05d5\u05d1\u05e1\u05d9\u05d5\u05dd \u05d4\u05de\u05d1\u05e6\u05e2 \u05d4\u05d5\u05e2\u05e0\u05e7\u05d5 \u05dc\u05d5 \u05d3\u05e8\u05d2\u05d5\u05ea \u05d4\u05e7\u05e6\u05d5\u05e0\u05d4{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05d1\u05e7\u05e8}}. \u05ea\u05d9\u05d1\u05d5\u05df \u05e9\u05d9\u05e8\u05ea \u05d1\u05d9\u05d7\u05d9\u05d3\u05d4 \u05e2\u05d3 [[1989]] \u05d5\u05d4\u05ea\u05e7\u05d3\u05dd \u05e2\u05d3 \u05dc\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05e4\u05e7\u05d3 \u05d4\u05e4\u05dc\u05d2\u05d4 \u05d4\u05d9\u05d9\u05e2\u05d5\u05d3\u05d9\u05ea \u05e9\u05dc \u05d4\u05e1\u05d9\u05d9\u05e8\u05ea.\n\n\u05d1-1989 \u05e2\u05d1\u05e8 \u05dc[[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd]], \u05e9\u05dd \u05e9\u05d9\u05e8\u05ea \u05db\u05e1\u05d2\u05e0\u05d5 \u05e9\u05dc \u05de\u05e4\u05e7\u05d3 [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd#\u05d2\u05d3\u05d5\u05d3 890 (\u05d0\u05e4\u05e2\u05d4)|\u05d2\u05d3\u05d5\u05d3 890 \u05e9\u05dc \u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd]], [[\u05d2\u05d3\u05d9 \u05e9\u05de\u05e0\u05d9]], \u05d5\u05de\u05d9\u05dc\u05d0 \u05d0\u05ea \u05de\u05e7\u05d5\u05de\u05d5 \u05d1\u05de\u05e9\u05da \u05de\u05e1\u05e4\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e9\u05de\u05e0\u05d9 \u05e0\u05e4\u05e6\u05e2 \u05d1[[\u05ea\u05d0\u05d5\u05e0\u05ea \u05d3\u05e8\u05db\u05d9\u05dd]]. \u05d1-[[1993]] \u05de\u05d5\u05e0\u05d4 \u05dc[[\u05de\u05d2\"\u05d3|\u05de\u05e4\u05e7\u05d3]] [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd#\u05d2\u05d3\u05d5\u05d3 202 (\u05e6\u05e4\u05e2)|\u05d2\u05d3\u05d5\u05d3 202 \u05e9\u05dc \u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd]], \u05d5\u05d4\u05d5\u05d1\u05d9\u05dc \u05d0\u05d5\u05ea\u05d5 \u05d1[[\u05d4\u05dc\u05d7\u05d9\u05de\u05d4 \u05d1\u05d3\u05e8\u05d5\u05dd \u05dc\u05d1\u05e0\u05d5\u05df (1985\u20132000)|\u05dc\u05d7\u05d9\u05de\u05d4 \u05d1\u05d3\u05e8\u05d5\u05dd \u05dc\u05d1\u05e0\u05d5\u05df]]. \u05d1-[[1995]] \u05e2\u05d1\u05e8 \u05dc\u05d4\u05d3\u05e8\u05d9\u05da \u05d1[[\u05d4\u05de\u05db\u05dc\u05dc\u05d4 \u05d4\u05d1\u05d9\u05df-\u05d6\u05e8\u05d5\u05e2\u05d9\u05ea \u05dc\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d5\u05dc\u05de\u05d8\u05d4|\u05de\u05db\u05dc\u05dc\u05d4 \u05d4\u05d1\u05d9\u05df-\u05d6\u05e8\u05d5\u05e2\u05d9\u05ea \u05dc\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d5\u05dc\u05de\u05d8\u05d4]] \u05d0\u05da \u05dc\u05d0\u05d7\u05e8 \u05de\u05e1\u05e4\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e0\u05e7\u05e8\u05d0 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d5\u05dc\u05e4\u05e7\u05d3 \u05e2\u05dc \u05d2\u05d3\u05d5\u05d3 202 \u05dc\u05d0\u05d7\u05e8 \u05e4\u05e6\u05d9\u05e2\u05ea\u05d5 \u05e9\u05dc [[\u05d7\u05d2\u05d9 \u05de\u05e8\u05d3\u05db\u05d9]] \u05d1\u05e7\u05e8\u05d1 \u05d1[[\u05dc\u05d1\u05e0\u05d5\u05df]]. \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3\u05d5 \u05d4\u05d1\u05d0 \u05de\u05d5\u05e0\u05d4 \u05dc\u05e1\u05d2\u05df \u05de\u05e4\u05e7\u05d3 \u05d4\u05d7\u05d8\u05d9\u05d1\u05d4{{\u05d4\u05e2\u05e8\u05d4|{{nrg|\u05e2\u05e4\u05e8 \u05e9\u05dc\u05d7|\u05d9\u05d4\u05d9\u05d4 \u05d1\u05e1\u05d3\u05e8, \u05d1\u05e0\u05d9|319/138|23 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2011|1|2}}}}.\n\n=== \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9 \u05d0\u05dc\u05d5\u05e3\u05be\u05de\u05e9\u05e0\u05d4 ===\n\u05dc\u05d0\u05d7\u05e8 \u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05e6\u05d1\u05d0\u05d9\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05dc\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d5\u05de\u05d8\u05d4 \u05e9\u05dc [[\u05d7\u05d9\u05dc \u05d4\u05e0\u05d7\u05ea\u05d9\u05dd \u05e9\u05dc \u05d0\u05e8\u05e6\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea|\u05d7\u05d9\u05dc \u05d4\u05e0\u05d7\u05ea\u05d9\u05dd \u05d4\u05d0\u05de\u05e8\u05d9\u05e7\u05e0\u05d9]] \u05d1[[\u05d1\u05e1\u05d9\u05e1 \u05e7\u05d5\u05d5\u05e0\u05d8\u05d9\u05e7\u05d5]] \u05e9\u05d1[[\u05d5\u05d9\u05e8\u05d2'\u05d9\u05e0\u05d9\u05d4|\u05d5\u05d5\u05d9\u05e8\u05d2'\u05d9\u05e0\u05d9\u05d4]], \u05d0\u05d5\u05ea\u05dd \u05e1\u05d9\u05d9\u05dd \u05d1\u05d4\u05e6\u05d8\u05d9\u05d9\u05e0\u05d5\u05ea, \u05e7\u05d5\u05d3\u05dd \u05d1-[[1997]] \u05dc\u05d3\u05e8\u05d2\u05ea \u05d0\u05dc\u05d5\u05e3-\u05de\u05e9\u05e0\u05d4 \u05d5\u05de\u05d5\u05e0\u05d4 \u05dc\u05de\u05e4\u05e7\u05d3 [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05e2\u05e6\u05d9\u05d5\u05df]].\n\n\u05d1-[[1999]] \u05de\u05d5\u05e0\u05d4 \u05dc\u05de\u05e4\u05e7\u05d3 [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d9\u05d4\u05d5\u05d3\u05d4]], \u05d4\u05d0\u05d7\u05e8\u05d0\u05d9\u05ea \u05e2\u05dc \u05d2\u05d6\u05e8\u05ea [[\u05d7\u05d1\u05e8\u05d5\u05df]], \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05d5 \u05e9\u05d9\u05de\u05e9 \u05e2\u05d3 [[2001]]. \u05d1\u05e2\u05ea \u05e9\u05db\u05d9\u05d4\u05df \u05db\u05de\u05d7\"\u05d8 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d4\u05ea\u05e4\u05e8\u05e1\u05dd \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05db\u05d9 \u05de\u05ea\u05d7 \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05e2\u05dc [[\u05d4\u05e1\u05db\u05dd \u05d7\u05d1\u05e8\u05d5\u05df]]{{\u05d4\u05e2\u05e8\u05d4|{{ynet|[[\u05d0\u05d1\u05d9\u05e9\u05d9 \u05d1\u05df \u05d7\u05d9\u05d9\u05dd]]|\u05de\u05d7\"\u05d8 \u05d7\u05d1\u05e8\u05d5\u05df: \u05d4\u05e1\u05db\u05dd \u05d7\u05d1\u05e8\u05d5\u05df \u05d4\u05d5\u05d0 \u05d4\u05e1\u05db\u05dd \u05de\u05d7\u05d5\u05e8\u05d1\u05df|644048|3 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2001}}}}, \u05d5\u05d4\u05d5\u05d0 \u05e7\u05d9\u05d1\u05dc \u05e2\u05dc \u05db\u05da \u05d4\u05e2\u05e8\u05d4 \u05de\u05de\u05e4\u05e7\u05d3 [[\u05d0\u05d5\u05d2\u05d3\u05ea \u05d0\u05d6\u05d5\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05e9\u05d5\u05de\u05e8\u05d5\u05df]], \u05ea\u05d0\"\u05dc [[\u05d1\u05e0\u05d9 \u05d2\u05e0\u05e5]]{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05e4\u05dc\u05d9\u05e7\u05e1 \u05e4\u05e8\u05d9\u05e9|\u05ea\u05d0\"\u05dc \u05d2\u05e0\u05e5 \u05dc\u05ea\u05d9\u05d1\u05d5\u05df: \u05d0\u05de\u05e8\u05ea \u05d3\u05d1\u05e8\u05d9\u05dd \u05e9\u05d0\u05d9\u05e0\u05dd \u05d1\u05e1\u05de\u05db\u05d5\u05ea\u05da|645068|3 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2001}}}}. \u05ea\u05d9\u05d1\u05d5\u05df, \u05db\u05de\u05e4\u05e7\u05d3 \u05d4\u05d7\u05d8\u05d9\u05d1\u05d4 \u05d4\u05de\u05e8\u05d7\u05d1\u05d9\u05ea, \u05d9\u05d7\u05d3 \u05e2\u05dd \u05e7\u05d1\u05d5\u05e6\u05ea \u05de\u05e4\u05e7\u05d3\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05de\u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d4\u05e9\u05d3\u05d4 \u05d5\u05d1\u05d4\u05dd \u05de\u05d7\"\u05d8 [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d4\u05e0\u05d7\"\u05dc|\u05d4\u05e0\u05d7\"\u05dc]] ([[\u05d9\u05d0\u05d9\u05e8 \u05d2\u05d5\u05dc\u05df]]), \u05de\u05d7\"\u05d8 [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d2\u05d5\u05dc\u05e0\u05d9|\u05d2\u05d5\u05dc\u05e0\u05d9]] ([[\u05de\u05e9\u05d4 \u05ea\u05de\u05d9\u05e8]]), \u05de\u05d7\"\u05d8 [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd|\u05d4\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd]] ([[\u05d0\u05d1\u05d9\u05d1 \u05db\u05d5\u05db\u05d1\u05d9]]), \u05d5\u05e7\u05e6\u05d9\u05df \u05d4\u05d0\u05d2\"\u05dd \u05e9\u05dc \u05e4\u05d9\u05e7\u05d5\u05d3 \u05d4\u05de\u05e8\u05db\u05d6 ([[\u05d2\u05dc \u05d4\u05d9\u05e8\u05e9]]), \u05d4\u05d9\u05d4 \u05de\u05d4\u05d3\u05d5\u05d7\u05e4\u05d9\u05dd \u05dc\u05e4\u05e2\u05d5\u05dc \u05db\u05e0\u05d2\u05d3 \u05de\u05e7\u05d5\u05e8\u05d5\u05ea [[\u05d8\u05e8\u05d5\u05e8 \u05e4\u05dc\u05e1\u05d8\u05d9\u05e0\u05d9|\u05d4\u05d8\u05e8\u05d5\u05e8 \u05d4\u05e4\u05dc\u05e1\u05d8\u05d9\u05e0\u05d9]] \u05d1\u05e7\u05e1\u05d1\u05d5\u05ea \u05d5\u05d1\u05de\u05d7\u05e0\u05d5\u05ea \u05d4\u05e4\u05dc\u05d9\u05d8\u05d9\u05dd \u05d1\u05de\u05d4\u05dc\u05da [[\u05d4\u05d0\u05d9\u05e0\u05ea\u05d9\u05e4\u05d0\u05d3\u05d4 \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4]] \u05dc\u05de\u05e8\u05d5\u05ea \u05d4\u05d9\u05d5\u05ea\u05dd \u05de\u05e8\u05d7\u05d1\u05d9\u05dd \u05d0\u05d5\u05e8\u05d1\u05e0\u05d9\u05d9\u05dd \u05e6\u05e4\u05d5\u05e4\u05d9\u05dd \u05d5\u05de\u05e1\u05d5\u05d1\u05db\u05d9\u05dd \u05dc\u05dc\u05d7\u05d9\u05de\u05d4, \u05d5\u05e2\u05dc \u05d0\u05e3 \u05d4\u05d9\u05e1\u05d5\u05e1\u05d9 \u05d4\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d4\u05d1\u05db\u05d9\u05e8 \u05e9\u05dc \u05e6\u05d4\"\u05dc{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05e2\u05de\u05d5\u05e1 \u05d4\u05e8\u05d0\u05dc|\u05d9\u05d0\u05d9\u05e8 \u05d2\u05d5\u05dc\u05df, \u05d0\u05dc\u05d5\u05e3 \u05e4\u05d9\u05e7\u05d5\u05d3 \u05d4\u05e2\u05d5\u05e8\u05e3, \u05d7\u05d5\u05e9\u05e3 \u05e9\u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05e6\u05d5\u05d9\u05d4 \u05d1\u05d4\u05d9\u05e2\u05e8\u05db\u05d5\u05ea \u05dc\u05de\u05d2\u05e0\u05e0\u05d4 \u05e8\u05d1\u05ea\u05d9 \u05dc\u05e7\u05e8\u05d0\u05ea \u05e9\u05e0\u05ea 2010|1.1285551|16 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2009}}}}. \n\n\u05d1\u05d9\u05df \u05d9\u05d5\u05dc\u05d9 [[2002]] \u05dc\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 [[2004]] \u05e9\u05d9\u05e8\u05ea \u05db\u05de\u05e4\u05e7\u05d3 [[\u05d7\u05d8\u05d9\u05d1\u05ea \u05d4\u05e0\u05d7\"\u05dc]].\n\n=== \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9 \u05ea\u05ea\u05be\u05d0\u05dc\u05d5\u05e3 ===\n\u05dc\u05d0\u05d7\u05e8 \u05e9\u05e7\u05d5\u05d3\u05dd \u05dc\u05d3\u05e8\u05d2\u05ea \u05ea\u05ea-\u05d0\u05dc\u05d5\u05e3 \u05e9\u05d9\u05e8\u05ea \u05d1\u05e9\u05e0\u05d9\u05dd 2004\u2013[[2006]] \u05db\u05e8\u05d0\u05e9 \u05d7\u05d8\u05d9\u05d1\u05ea \u05db\u05d5\u05d7 \u05d4\u05d0\u05d3\u05dd \u05d1[[\u05d6\u05e8\u05d5\u05e2 \u05d4\u05d9\u05d1\u05e9\u05d4]].\n\n\u05d1\u05ea\u05e4\u05e7\u05d9\u05d3\u05d5 \u05d4\u05d1\u05d0 \u05de\u05d5\u05e0\u05d4 \u05dc[[\u05e7\u05e6\u05d9\u05df \u05d7\u05d9\"\u05e8 \u05d5\u05e6\u05e0\u05d7\u05e0\u05d9\u05dd \u05e8\u05d0\u05e9\u05d9]] \u05d1\u05e9\u05e0\u05d9\u05dd 2006\u2013[[2007]].\n\n\u05d1\u05d9\u05d5\u05dc\u05d9 2007 \u05de\u05d5\u05e0\u05d4 \u05dc\u05de\u05e4\u05e7\u05d3 [[\u05d0\u05d5\u05d2\u05d3\u05ea \u05d0\u05d6\u05d5\u05e8 \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05e9\u05d5\u05de\u05e8\u05d5\u05df]] \u05d5\u05e2\u05de\u05d3 \u05d1\u05e8\u05d0\u05e9\u05d4 \u05e2\u05d3 \u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 [[2009]]. \u05ea\u05e7\u05d5\u05e4\u05ea \u05db\u05d4\u05d5\u05e0\u05ea\u05d5 \u05db\u05de\u05e4\u05e7\u05d3 \u05d0\u05d5\u05d2\u05d3\u05ea \u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05e9\u05d5\u05de\u05e8\u05d5\u05df \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d4\u05e9\u05e7\u05d8\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05de\u05d0\u05d6 \u05e4\u05e8\u05d5\u05e5 [[\u05d4\u05d0\u05d9\u05e0\u05ea\u05d9\u05e4\u05d0\u05d3\u05d4 \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4]], \u05d5\u05d1\u05de\u05d4\u05dc\u05db\u05d4 \u05d1\u05d5\u05e6\u05e2 [[\u05e4\u05d9\u05d2\u05d5\u05e2]] \u05d0\u05d7\u05d3 \u05d1\u05ea\u05d7\u05d5\u05de\u05d9 [[\u05d4\u05e7\u05d5 \u05d4\u05d9\u05e8\u05d5\u05e7]] \u05e9\u05de\u05e7\u05d5\u05e8\u05d5 \u05d1\u05d9\u05d5\"\u05e9, \u05d5\u05e0\u05d4\u05e8\u05d2\u05d5 11 \u05d7\u05d9\u05d9\u05dc\u05d9\u05dd \u05d5\u05d0\u05d6\u05e8\u05d7\u05d9\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05d4\u05d8\u05e8\u05d5\u05e8 \u05d4\u05e4\u05dc\u05e1\u05d8\u05d9\u05e0\u05d9. \u05d1\u05ea\u05e7\u05d5\u05e4\u05ea \u05db\u05d4\u05d5\u05e0\u05ea\u05d5 \u05d7\u05dc \u05e9\u05d9\u05e4\u05d5\u05e8 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05d1\u05e7\u05e9\u05e8\u05d9\u05dd \u05d1\u05d9\u05df \u05e6\u05d4\"\u05dc \u05dc[[\u05d4\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d4\u05de\u05e1\u05db\u05dc (\u05d4\u05e8\u05e9\u05d5\u05ea \u05d4\u05e4\u05dc\u05e1\u05d8\u05d9\u05e0\u05d9\u05ea)|\u05de\u05e0\u05d2\u05e0\u05d5\u05e0\u05d9 \u05d4\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05d4\u05de\u05e1\u05db\u05dc \u05e9\u05dc \u05d4\u05e8\u05e9\u05d5\u05ea \u05d4\u05e4\u05dc\u05e1\u05d8\u05d9\u05e0\u05d9\u05ea]] \u05d1[[\u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05e9\u05d5\u05de\u05e8\u05d5\u05df|\u05d2\u05d3\u05d4 \u05d4\u05de\u05e2\u05e8\u05d1\u05d9\u05ea]], \u05d5\u05d4\u05d5\u05e1\u05e8\u05d5 \u05e8\u05d1\u05d9\u05dd \u05de\u05d4[[\u05de\u05d7\u05e1\u05d5\u05dd (\u05e6\u05d4\"\u05dc)|\u05de\u05d7\u05e1\u05d5\u05de\u05d9\u05dd]] \u05d1\u05d2\u05d3\u05d4{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05e2\u05de\u05d5\u05e1 \u05d4\u05e8\u05d0\u05dc|\u05d4\u05de\u05d4\u05e4\u05db\u05d4 \u05d4\u05e9\u05e7\u05d8\u05d4 \u05d1\u05d2\u05d3\u05d4: \u05d9\u05d5\u05ea\u05e8 \u05ea\u05d9\u05d0\u05d5\u05dd \u05e2\u05dd \u05d4\u05e8\u05e9\u05d5\u05ea, \u05e4\u05d7\u05d5\u05ea \u05d4\u05e8\u05d5\u05d2\u05d9\u05dd \u05e4\u05dc\u05e1\u05d8\u05d9\u05e0\u05d9\u05dd|1.1279175|4 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2009}}}}. \u05db\u05de\u05d5 \u05e7\u05d5\u05d3\u05de\u05d9\u05d5 \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3, \u05d2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df \u05e0\u05d3\u05e8\u05e9 \u05dc\u05e1\u05d5\u05d2\u05d9\u05d9\u05ea \u05e4\u05d9\u05e0\u05d5\u05d9 \u05d4[[\u05de\u05d0\u05d7\u05d6\u05d9\u05dd]] \u05d1\u05d9\u05d4\u05d5\u05d3\u05d4 \u05d5\u05e9\u05d5\u05de\u05e8\u05d5\u05df. \u05db\u05ea\u05d5\u05e6\u05d0\u05d4 \u05de\u05db\u05da, \u05d4\u05d7\u05dc\u05d5 \u05e4\u05e2\u05d9\u05dc\u05d9 \u05d9\u05de\u05d9\u05df \u05dc\u05d4\u05e4\u05d2\u05d9\u05df \u05d1\u05d0\u05d5\u05e4\u05df \u05e7\u05d1\u05d5\u05e2 \u05de\u05d5\u05dc \u05d1\u05d9\u05ea\u05d5 \u05d1[[\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1-\u05d9\u05e4\u05d5|\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1]]. \u05de\u05d7\u05d0\u05d4 \u05d6\u05d5 \u05dc\u05d0 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05de\u05e7\u05d5\u05d1\u05dc\u05ea \u05e2\u05dc \u05db\u05dc \u05d0\u05e0\u05e9\u05d9 \u05d4\u05d9\u05de\u05d9\u05df. [[\u05e4\u05e0\u05d7\u05e1 \u05d5\u05dc\u05e8\u05e9\u05d8\u05d9\u05d9\u05df]], \u05de\u05e0\u05db\"\u05dc [[\u05de\u05d5\u05e2\u05e6\u05ea \u05d9\u05e9\"\u05e2]], \u05d0\u05de\u05e8 \u05db\u05d9 \"\u05d4\u05d4\u05ea\u05d9\u05d9\u05e9\u05d1\u05d5\u05ea \u05e6\u05e8\u05d9\u05db\u05d4 \u05dc\u05d4\u05db\u05d9\u05e8 \u05ea\u05d5\u05d3\u05d4 \u05dc\u05ea\u05d9\u05d1\u05d5\u05df \u05e2\u05dc \u05d4\u05de\u05e2\u05e9\u05d9\u05dd \u05e9\u05d4\u05d5\u05d0 \u05e2\u05d5\u05e9\u05d4 \u05dc\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05e2\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc\".{{\u05de\u05e7\u05d5\u05e8}}.\n\n\u05d1\u05e9\u05e0\u05d9\u05dd 2009\u2013[[2011]] \u05e4\u05d9\u05e7\u05d3 \u05e2\u05dc [[\u05d4\u05de\u05db\u05dc\u05dc\u05d4 \u05d4\u05d1\u05d9\u05df-\u05d6\u05e8\u05d5\u05e2\u05d9\u05ea \u05dc\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d5\u05dc\u05de\u05d8\u05d4]].\n\n=== \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9 \u05d0\u05dc\u05d5\u05e3 ===\n\u05d1-[[19 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8]] [[2012]] \u05d4\u05d5\u05e2\u05e0\u05e7\u05d4 \u05dc\u05d5 \u05d3\u05e8\u05d2\u05ea \u05d0\u05dc\u05d5\u05e3, \u05d5\u05d4\u05d5\u05d0 \u05de\u05d5\u05e0\u05d4 \u05dc\u05de\u05e4\u05e7\u05d3 [[\u05d4\u05d2\u05d9\u05e1 \u05d4\u05e6\u05e4\u05d5\u05e0\u05d9]] \u05e9\u05dc \u05e6\u05d4\"\u05dc{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05e8\u05d5\u05df \u05d1\u05df \u05d9\u05e9\u05d9|\u05d4\u05d9\u05d9-\u05d8\u05e0\u05e7: \u05e2\u05dd \u05d4\u05e9\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05ea\u05d7\u05d3\u05e9 \u05e9\u05d9\u05d9\u05dc\u05d7\u05dd \u05d1\u05d7\u05d9\u05d6\u05d1\u05d0\u05dc\u05dc\u05d4|4350863|1 \u05d1\u05de\u05e8\u05e5 2013}}}}.\n\n\u05d1\u05de\u05d4\u05dc\u05da [[\u05de\u05d1\u05e6\u05e2 \u05e6\u05d5\u05e7 \u05d0\u05d9\u05ea\u05df]] \u05de\u05d9\u05e0\u05d4 \u05d4\u05e8\u05de\u05d8\u05db\"\u05dc \u05d1\u05e0\u05d9 \u05d2\u05e0\u05e5 \u05d0\u05ea \u05ea\u05d9\u05d1\u05d5\u05df \u05dc\u05d0\u05d7\u05e8\u05d0\u05d9 \u05e2\u05dc \u05d4\u05ea\u05d7\u05e7\u05d9\u05e8\u05d9\u05dd \u05e9\u05dc \u05e6\u05d4\"\u05dc \u05d1\u05e0\u05d5\u05d2\u05e2 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e8\u05d2\u05d9\u05e9\u05d9\u05dd \u05d4\u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05e4\u05d2\u05d9\u05e2\u05d4 \u05d1\u05d0\u05d6\u05e8\u05d7\u05d9\u05dd \u05d1\u05dc\u05ea\u05d9-\u05de\u05e2\u05d5\u05e8\u05d1\u05d9\u05dd \u05d1\u05e2\u05d6\u05d4{{\u05d4\u05e2\u05e8\u05d4|1={{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05d4\u05db\u05d5\u05ea\u05d1 = \u05d0\u05d1\u05d9 \u05d1\u05e0\u05d9\u05d4\u05d5|\u05db\u05ea\u05d5\u05d1\u05ea = https://web.archive.org/web/20140908042708/http://www.maariv.co.il/news/new.aspx?pn6Vq=EE&0r9VQ=GEMLE|\u05db\u05d5\u05ea\u05e8\u05ea = \u05de\u05d4 \u05de\u05e9\u05e8\u05ea\u05d9\u05dd \u05d4\u05ea\u05d7\u05e7\u05d9\u05e8\u05d9\u05dd \u05d4\u05e4\u05e0\u05d9\u05dd-\u05e6\u05d4\"\u05dc\u05d9\u05d9\u05dd}} (\u05de\u05d0\u05d5\u05e8\u05db\u05d1 \u05d1[[\u05d0\u05e8\u05db\u05d9\u05d5\u05df \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8]])}}. \u05ea\u05d9\u05d1\u05d5\u05df \u05e4\u05e8\u05e9 \u05de\u05e6\u05d4\"\u05dc \u05d1\u05e9\u05e0\u05ea [[2015]].\n\n== \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d6\u05e8\u05d7\u05d9\u05ea ==\n[[\u05e7\u05d5\u05d1\u05e5:OR55427-051 \u05d4\u05d1\u05d9\u05de\u05d4 0725-24 \u05d3\u05d9 \u05dc\u05de\u05dc\u05d7\u05de\u05d4.jpg|\u05de\u05de\u05d5\u05d6\u05e2\u05e8|\u05d0\u05dc\u05d5\u05e3 \u05d1\u05de\u05d9\u05dc\u05f3 \u05e0\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df \u05de\u05e0\u05d7\u05d4 \u05d4\u05e4\u05d2\u05e0\u05d4 \u05dc\u05de\u05e2\u05df \u05e2\u05e6\u05d9\u05e8\u05ea \u05d4\u05de\u05dc\u05d7\u05de\u05d4 \u05d1\u05e2\u05d6\u05d4, \u05d1\u05db\u05d9\u05db\u05e8 \u05d4\u05d1\u05d9\u05de\u05d4 \u05d1\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1, 24 \u05d1\u05d9\u05d5\u05dc\u05d9 2025]]\n\n\u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 [[2016]] \u05de\u05d5\u05e0\u05d4 \u05dc\u05d9\u05d5\u05e9\u05d1 \u05e8\u05d0\u05e9 \"\u05e2\u05d9\u05e8 \u05e2\u05d5\u05dc\u05dd \u05d5\u05ea\u05d9\u05d9\u05e8\u05d5\u05ea\" \u05d1[[\u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1-\u05d9\u05e4\u05d5]] \u05d1\u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea{{\u05d4\u05e2\u05e8\u05d4|{{Time Out \u05d9\u05e9\u05e8\u05d0\u05dc||\u05ea\u05d9\u05d9\u05e8, \u05e9\u05e4\u05e8 \u05d4\u05d5\u05e4\u05e2\u05ea\u05da: \u05d0\u05dc\u05d5\u05e3 \u05d1\u05de\u05d9\u05dc \u05de\u05d5\u05e0\u05d4 \u05dc\u05d9\u05d5\"\u05e8 \"\u05e2\u05d9\u05e8 \u05e2\u05d5\u05dc\u05dd \u05d5\u05ea\u05d9\u05d9\u05e8\u05d5\u05ea\"|\u05ea\u05d9\u05d9\u05e8-\u05e9\u05e4\u05e8-\u05d4\u05d5\u05e4\u05e2\u05ea\u05da-\u05d0\u05dc\u05d5\u05e3-\u05d1\u05de\u05d9\u05dc-\u05de\u05d5\u05e0\u05d4-\u05dc\u05d9\u05d5\u05e8-\u05e2\u05d9|17 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2016}}}}. \u05db\u05de\u05d5 \u05db\u05df, \u05d4\u05d7\u05dc \u05de\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2015 \u05d5\u05e2\u05d3 \u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2024 \u05db\u05d9\u05d4\u05df \u05db\u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05d1[[\u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df]] \u05d7\u05d1\u05e8\u05ea \u05d4\u05d1\u05e0\u05d9\u05d9\u05d4 \u05d5\u05d9\u05dc\u05d0\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05e9\u05d9\u05d5\u05e0\u05dc \u05d1\u05e2\"\u05de{{\u05d4\u05e2\u05e8\u05d4|[https://maya.tase.co.il/reports/details/1609973 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05e2\u05dc \u05e1\u05d9\u05d5\u05dd \u05db\u05d4\u05d5\u05e0\u05d4 \u05db\u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8], \u05d1\u05d0\u05ea\u05e8 [[\u05d4\u05d1\u05d5\u05e8\u05e1\u05d4 \u05dc\u05e0\u05d9\u05d9\u05e8\u05d5\u05ea \u05e2\u05e8\u05da \u05d1\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1]], 9 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2024.}}. \u05e2\u05d3 \u05d3\u05e6\u05de\u05d1\u05e8 2020 \u05db\u05d9\u05d4\u05df \u05d2\u05dd \u05db\u05de\u05e0\u05db\"\u05dc \u05d7\u05d1\u05e8\u05ea \u05d8\u05e8\u05d9\u05d9\u05e1\u05e0\u05e1 \u05de\u05e2\u05e8\u05db\u05d5\u05ea.\n\n\u05dc\u05e7\u05e8\u05d0\u05ea [[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4-21]] \u05d4\u05d1\u05d9\u05e2 \u05ea\u05d9\u05d1\u05d5\u05df \u05d0\u05ea \u05ea\u05de\u05d9\u05db\u05ea\u05d5 \u05d1\u05e8\u05e9\u05d9\u05de\u05ea [[\u05de\u05e4\u05dc\u05d2\u05ea \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea|\u05de\u05e4\u05dc\u05d2\u05ea \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4]] \u05d5\u05d1\u05e2\u05d5\u05de\u05d3 \u05d1\u05e8\u05d0\u05e9\u05d4, [[\u05d0\u05d1\u05d9 \u05d2\u05d1\u05d0\u05d9]].\n\n\u05d1\u05e9\u05e0\u05ea [[2022]] \u05e2\u05de\u05d3 \u05d1\u05e8\u05d0\u05e9\u05d5\u05ea \u05d5\u05e2\u05d3\u05ea \u05d4\u05de\u05d5\u05de\u05d7\u05d9\u05dd \u05dc\u05d1\u05d3\u05d9\u05e7\u05ea \u05ea\u05e7\u05e8\u05d9\u05ea \u05d4[[\u05d0\u05e9 \u05db\u05d5\u05d7\u05d5\u05ea\u05d9\u05e0\u05d5|\u05d9\u05e8\u05d9 \u05d4\u05d3\u05d5-\u05e6\u05d3\u05d3\u05d9]] \u05d1\u05d4 \u05e0\u05d4\u05e8\u05d2\u05d5 \u05e9\u05e0\u05d9 \u05de\u05e4\u05e7\u05d3\u05d9\u05dd \u05d1[[\u05d9\u05d7\u05d9\u05d3\u05ea \u05d0\u05d2\u05d5\u05d6]]{{\u05d4\u05e2\u05e8\u05d4|{{\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d5\u05dd|[[\u05dc\u05d9\u05dc\u05da \u05e9\u05d5\u05d1\u05dc]], [[\u05e9\u05dc\u05d5\u05de\u05d9 \u05d3\u05d9\u05d0\u05d6]]|\u05d4\u05e7\u05e6\u05d9\u05df \u05e9\u05d9\u05e8\u05d4 \u05d1\u05e9\u05d5\u05d2\u05d2 \u05d1\u05e9\u05e0\u05d9 \u05d4\u05de\u05e4\u05e7\u05d3\u05d9\u05dd \u05de\u05d0\u05d2\u05d5\u05d6 \u05d9\u05d9\u05d7\u05e7\u05e8 \u05d1\u05de\u05e6\"\u05d7 \u05d1\u05d9\u05d5\u05dd \u05e8\u05d0\u05e9\u05d5\u05df|military-life/world-news-military-life/article/7031347|14 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2022}}}}.\n\n=== \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05e6\u05dc\u05d4 \u05d1\u05d8\u05d1\u05d7 \u05e9\u05d1\u05e2\u05d4 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 ===\n\u05d1[[\u05d8\u05d1\u05d7 \u05e9\u05d1\u05e2\u05d4 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8]] \u05d7\u05d3\u05e8\u05d5 \u05de\u05d7\u05d1\u05dc\u05d9\u05dd \u05d2\u05dd \u05dc\u05e7\u05d9\u05d1\u05d5\u05e5 [[\u05e0\u05d7\u05dc \u05e2\u05d5\u05d6]], \u05e9\u05d1\u05d5 \u05de\u05ea\u05d2\u05d5\u05e8\u05e8\u05d9\u05dd \u05d1\u05e0\u05d5 [[\u05d0\u05de\u05d9\u05e8 \u05ea\u05d9\u05d1\u05d5\u05df]] \u05d5\u05de\u05e9\u05e4\u05d7\u05ea\u05d5, \u05d5[[\u05d4\u05d8\u05d1\u05d7 \u05d1\u05e0\u05d7\u05dc \u05e2\u05d5\u05d6|\u05d8\u05d1\u05d7\u05d5]] \u05d1\u05ea\u05d5\u05e9\u05d1\u05d9\u05d5. \u05e0\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5\u05df \u05d4\u05d2\u05d9\u05e2 \u05de\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1, \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d0\u05e9\u05ea\u05d5 [[\u05d2\u05dc\u05d9 \u05de\u05d9\u05e8-\u05ea\u05d9\u05d1\u05d5\u05df|\u05d2\u05dc\u05d9]], \u05db\u05d3\u05d9 \u05dc\u05d7\u05dc\u05e5 \u05d0\u05ea \u05d1\u05e0\u05d5 \u05d5\u05de\u05e9\u05e4\u05d7\u05ea\u05d5. \u05d1\u05d4\u05de\u05e9\u05da \u05e4\u05d2\u05e9 \u05d1[[\u05d9\u05e9\u05e8\u05d0\u05dc \u05d6\u05d9\u05d5]], \u05d5\u05d4\u05dd \u05d4\u05e6\u05d8\u05e8\u05e4\u05d5 \u05dc\u05db\u05d5\u05d7 \u05e9\u05dc [[\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d2\u05dc\u05df]]{{\u05d4\u05e2\u05e8\u05d4|\u05d2\u05dc \u05e4\u05e8\u05dc, [https://galperel.wordpress.com/2024/03/23/\u05e1\u05e4\u05e8-\u05dc\u05d0-\u05e8\u05d0\u05d5\u05d9-\u05dc\u05e7\u05e8\u05d9\u05d0\u05d4-\u05de\u05d0\u05ea-\u05d2\u05dc-\u05e4\u05e8\u05dc/ \u05e1\u05e4\u05e8 \u05dc\u05d0 \u05e8\u05d0\u05d5\u05d9 \u05dc\u05e7\u05e8\u05d9\u05d0\u05d4], \u05d4\u05d1\u05dc\u05d5\u05d2 '''\u05e2\u05dc \u05d4\u05db\u05d5\u05d5\u05e0\u05ea''', {{\u05db}} 23 \u05d1\u05de\u05e8\u05e5 [[2024]].}}. \u05d1\u05d9\u05d7\u05d3 \u05d4\u05e6\u05dc\u05d9\u05d7\u05d5 \u05dc\u05d7\u05dc\u05e5 \u05ea\u05d5\u05e9\u05d1\u05d9\u05dd \u05de\u05d4\u05e7\u05d9\u05d1\u05d5\u05e5 \u05d5\u05d1\u05d4\u05dd \u05d0\u05ea \u05d1\u05e0\u05d9 \u05de\u05e9\u05e4\u05d7\u05ea\u05d5 \u05e9\u05dc \u05ea\u05d9\u05d1\u05d5\u05df{{\u05d4\u05e2\u05e8\u05d4|{{ynet||\u05d4\u05d0\u05dc\u05d5\u05e3 \u05d1\u05de\u05d9\u05dc' \u05d7\u05d9\u05dc\u05e5 \u05d0\u05ea \u05d1\u05e0\u05d5 \u05d5\u05e0\u05db\u05d3\u05d5\u05ea\u05d9\u05d5: \"\u05d4\u05e8\u05d2\u05e0\u05d5 \u05de\u05d7\u05d1\u05dc\u05d9\u05dd, \u05d7\u05d9\u05dc\u05e6\u05e0\u05d5 \u05e4\u05e6\u05d5\u05e2\u05d9\u05dd. \u05e2\u05db\u05e9\u05d9\u05d5 \u05e6\u05e8\u05d9\u05da \u05dc\u05e0\u05e6\u05d7\"|news/article/bkp6rs1bt|8 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2023}};{{\u05e9}}{{\u05d4\u05d0\u05e8\u05e5|\u05d0\u05de\u05d9\u05e8 \u05ea\u05d9\u05d1\u05d5\u05df|\u05d4\u05d9\u05d9\u05e0\u05d5 \u05e0\u05e6\u05d5\u05e8\u05d9\u05dd \u05e9\u05e2\u05d5\u05ea. \u05d0\u05d1\u05d0 \u05e9\u05dc\u05d9, \u05d1\u05df 62, \u05e0\u05dc\u05d7\u05dd \u05d1\u05de\u05d7\u05d1\u05dc\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d7\u05dc\u05e5 \u05d0\u05d5\u05ea\u05e0\u05d5. \u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05e0\u05db\u05e9\u05dc\u05d4|0000018b-102c-d2fb-a3df-d1adf6030000|8 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2023}}}}{{\u05d4\u05e2\u05e8\u05d4|{{\u05e2\u05e8\u05d5\u05e57||\u05d4\u05d0\u05dc\u05d5\u05e3 \u05d1\u05de\u05d9\u05dc' \u05e0\u05d5\u05e2\u05dd \u05ea\u05d9\u05d1\u05d5