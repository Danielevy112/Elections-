05d5\u05e7\u05e8\u05d0\u05d9\u05e0\u05d4]]. \u05d1\u05e9\u05e0\u05ea [[1991]] \u05e2\u05dc\u05ea\u05d4 \u05e2\u05dd \u05de\u05e9\u05e4\u05d7\u05ea\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc.{{\u05d4\u05e2\u05e8\u05d4|\u05e8\u05d9\u05e3 \u05de\u05e7\u05e4\u05d9\u05d3\u05d4 \u05dc\u05d3\u05d1\u05e8 \u05e2\u05dc \u05de\u05e2\u05d1\u05e8 \u05de\u05e9\u05e4\u05d7\u05ea\u05d4 \u05de\u05d0\u05d5\u05e7\u05e8\u05d0\u05d9\u05e0\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05de\u05d5\u05e0\u05d7 \"\u05d4\u05d2\u05d9\u05e8\u05d4\" \u05d5\u05dc\u05d0 \"\u05e2\u05dc\u05d9\u05d9\u05d4\"}}\n\n\u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05d4\u05ea\u05de\u05e7\u05de\u05d4 \u05d1[[\u05e0\u05ea\u05e0\u05d9\u05d4]] \u05d5\u05d4\u05d5\u05e8\u05d9\u05d4, \u05e9\u05d4\u05d9\u05d5 \u05d1\u05e2\u05dc\u05d9 \u05de\u05e7\u05e6\u05d5\u05e2\u05d5\u05ea \u05d8\u05db\u05e0\u05d9\u05d9\u05dd \u05d4\u05d5\u05e2\u05e1\u05e7\u05d5 \u05db[[\u05e2\u05d5\u05d1\u05d3\u05d9 \u05e7\u05d1\u05dc\u05df]]: \u05d0\u05de\u05d4 \u05e2\u05d1\u05d3\u05d4 \u05db\u05e2\u05d5\u05d1\u05d3\u05ea \u05e0\u05d9\u05e7\u05d9\u05d5\u05df \u05d5\u05d0\u05d1\u05d9\u05d4 \u05d1\u05d7\u05e9\u05de\u05dc.\n\n\u05dc\u05d3\u05d1\u05e8\u05d9\u05d4 \u05d4\u05d9\u05d0 \u05d4\u05d5\u05e9\u05e4\u05e2\u05d4 \u05e8\u05d1\u05d5\u05ea \u05de\u05ea\u05e7\u05d5\u05e4\u05ea \u05d9\u05dc\u05d3\u05d5\u05ea\u05d4 \u05d5\u05d1\u05de\u05e9\u05da \u05e9\u05e0\u05d9\u05dd \u05d4\u05ea\u05d1\u05d9\u05d9\u05e9\u05d4 \u05d1\u05e9\u05d5\u05e8\u05e9\u05d9\u05dd \u05d4\u05e8\u05d5\u05e1\u05d9\u05d9\u05dd \u05e9\u05dc\u05d4, \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05d1\u05d9\u05dc\u05d3\u05d5\u05ea\u05d4 \u05d4\u05e8\u05d1\u05d5 \u05dc\u05e6\u05d7\u05d5\u05e7 \u05e2\u05dc\u05d9\u05d4, \u05d5\u05d4\u05d9\u05d0 \u05e0\u05d9\u05e1\u05ea\u05d4 \u05dc\u05d4\u05d9\u05d5\u05ea \"\u05e8\u05e7 \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea\". \u05dc\u05d3\u05d1\u05e8\u05d9\u05d4, \u05d4\u05de\u05d7\u05de\u05d0\u05d4 \u05e9\u05d4\u05db\u05d9 \u05d0\u05d4\u05d1\u05d4 \u05dc\u05e7\u05d1\u05dc \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea\u05d4 \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05db\u05da \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d4\u05de\u05e9\u05e4\u05d8: \"\u05d0\u05ea \u05e8\u05d5\u05e1\u05d9\u05d9\u05d4? \u05d0\u05ea \u05dc\u05d0 \u05e0\u05e8\u05d0\u05d9\u05ea\".<ref>{{ynet|\u05e2\u05e0\u05ea \u05dc\u05d1\u05be\u05d0\u05d3\u05dc\u05e8|\"\u05d4\u05de\u05d7\u05de\u05d0\u05d4 \u05d4\u05db\u05d9 \u05d8\u05d5\u05d1\u05d4 \u05e9\u05e7\u05d9\u05d1\u05dc\u05ea\u05d9 \u05d4\u05d9\u05d9\u05ea\u05d4 '\u05d0\u05ea \u05dc\u05d0 \u05e0\u05e8\u05d0\u05d9\u05ea \u05e8\u05d5\u05e1\u05d9\u05d9\u05d4'\"|parents/article/yokra14068108|17 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2024}}</ref>\n\n\u05e8\u05d9\u05e3 \u05dc\u05de\u05d3\u05d4 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05d8\u05e9\u05e8\u05e0\u05d9\u05d7\u05d5\u05d1\u05e1\u05e7\u05d9, \u05d4\u05ea\u05e0\u05d3\u05d1\u05d4 \u05d1\u05de\u05d5\u05e2\u05e6\u05ea \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05d5\u05d1[[\u05de\u05d3\"\u05d0]], \u05d4\u05e9\u05ea\u05ea\u05e4\u05d4 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05de\u05e0\u05d4\u05d9\u05d2\u05d5\u05ea \"[[\u05e2\u05de\u05d9\u05ea\u05d9 \u05d1\u05e8\u05d5\u05e0\u05e4\u05de\u05df]]\", \u05de\u05d8\u05e2\u05de\u05d4 \u05d2\u05dd \u05e2\u05e9\u05ea\u05d4 [[\u05e9\u05e0\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea]] \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4, \u05d5\u05e9\u05d9\u05e8\u05ea\u05d4 \u05db\u05e7\u05e6\u05d9\u05e0\u05d4 \u05d1[[\u05d7\u05d9\u05dc \u05d4\u05de\u05d5\u05d3\u05d9\u05e2\u05d9\u05df]]. \u05de\u05d2\u05d3\u05d9\u05e8\u05d4 \u05d0\u05ea \u05e2\u05e6\u05de\u05d4 \u05db\u05de\u05d9 \u05e9\u05e2\u05e9\u05ea\u05d4 \"\u05db\u05dc \u05e9\u05d1\u05d9\u05db\u05d5\u05dc\u05ea\u05d4 \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea\u05d4 \u05dc\u05d4\u05d9\u05d8\u05de\u05e2 \u05d1\u05ea\u05e8\u05d1\u05d5\u05ea \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea \u05d4\"[[\u05e6\u05d1\u05e8 (\u05db\u05d9\u05e0\u05d5\u05d9)|\u05e6\u05d1\u05e8\u05d9\u05ea]]\"\".\n\n\u05dc\u05d0\u05d7\u05e8 \u05e9\u05d7\u05e8\u05d5\u05e8\u05d4 \u05dc\u05de\u05d3\u05d4 \u05dc\u05ea\u05d5\u05d0\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1[[\u05de\u05d3\u05e2 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4]] \u05d5[[\u05de\u05e0\u05d4\u05dc \u05e2\u05e1\u05e7\u05d9\u05dd]] \u05d5\u05ea\u05d5\u05d0\u05e8 \u05e9\u05e0\u05d9 \u05d1[[\u05de\u05d9\u05e0\u05d4\u05dc \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9]] \u05d1[[\u05d4\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]] \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05ea\u05d5\u05db\u05e0\u05d9\u05ea [[\u05e6\u05d5\u05e2\u05e8\u05d9\u05dd \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05d3\u05d9\u05e0\u05d4]], \u05d1\u05de\u05e1\u05d2\u05e8\u05ea\u05d5 \u05db\u05ea\u05d1\u05d4 \u05ea\u05d6\u05d4 \u05d1\u05e0\u05d5\u05e9\u05d0 \u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05e2\u05d1\u05d5\u05d3\u05d4 \u05dc\u05de\u05e9\u05e4\u05d7\u05d4 \u05d1\u05e7\u05e8\u05d1 \u05e0\u05e9\u05d9\u05dd \u05d1\u05db\u05d9\u05e8\u05d5\u05ea \u05d1\u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05d3\u05d9\u05e0\u05d4.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://public-policy.huji.ac.il/sites/default/files/public-policy/files/alex_riff_thesis.pdf|\u05db\u05d5\u05ea\u05e8\u05ea=\"Women Can Have It All\" - \u05de\u05e7\u05e8\u05d9 \u05d4\u05e6\u05dc\u05d7\u05d4 \u05d1\u05e9\u05d9\u05dc\u05d5\u05d1 \u05d1\u05d9\u05df \u05e2\u05d1\u05d5\u05d3\u05d4 \u05dc\u05de\u05e9\u05e4\u05d7\u05d4 \u05d1\u05e7\u05e8\u05d1 \u05e0\u05e9\u05d9\u05dd \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05d1\u05db\u05d9\u05e8\u05d9\u05dd \u05d1\u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05d3\u05d9\u05e0\u05d4|\u05d0\u05ea\u05e8=public-policy.huji.ac.il|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2024-01-05}}</ref> \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05e2\u05d1\u05d3\u05d4 \u05d1[[\u05de\u05e9\u05e8\u05d3 \u05d4\u05db\u05dc\u05db\u05dc\u05d4]] \u05db\u05d9\u05d5\u05e2\u05e6\u05ea \u05d1\u05db\u05d9\u05e8\u05d4 \u05dc\u05de\u05de\u05d5\u05e0\u05d4 \u05e2\u05dc \u05d4\u05ea\u05e2\u05e1\u05d5\u05e7\u05d4, \u05de\u05d9\u05db\u05dc \u05e6\u05d5\u05e7, \u05d1\u05ea\u05d7\u05d5\u05dd \u05ea\u05e2\u05e1\u05d5\u05e7\u05ea \u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d5\u05ea \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9\u05d5\u05ea.<ref>{{ynet|\u05d0\u05e0\u05d4 \u05d6\u05d8\u05e8\u05d1\u05e8\u05d2|\"\u05db\u05d5\u05e2\u05e1\u05ea \u05e2\u05dc \u05e2\u05e6\u05de\u05d9 \u05d5\u05e2\u05dc \u05d4\u05e9\u05db\u05e0\u05d9\u05dd \u05d4\u05ea\u05d9\u05de\u05e0\u05d9\u05dd \u05e9\u05d4\u05ea\u05e0\u05e9\u05d0\u05d5 \u05e2\u05dc\u05d9\u05d9\"|5430225|21 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2018}}</ref>\n\n\u05e8\u05d9\u05e3 \u05d4\u05d9\u05d0 \u05d1\u05d5\u05d2\u05e8\u05ea [[\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05e1\u05dd \u05e9\u05e4\u05d9\u05d2\u05dc \u05dc\u05e7\u05d5\u05dc\u05e0\u05d5\u05e2 \u05d5\u05dc\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4]] \u05d1\u05de\u05d2\u05de\u05ea \u05ea\u05e1\u05e8\u05d9\u05d8\u05d0\u05d5\u05ea \u05d5\u05d1\u05d5\u05d2\u05e8\u05ea [[\u05de\u05db\u05d5\u05df \u05de\u05e0\u05d3\u05dc \u05dc\u05de\u05e0\u05d4\u05d9\u05d2\u05d5\u05ea|\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05de\u05e0\u05d3\u05dc \u05dc\u05de\u05e0\u05d4\u05d9\u05d2\u05d5\u05ea]] \u05d1\u05ea\u05e8\u05d1\u05d5\u05ea \u05d9\u05d4\u05d5\u05d3\u05d9\u05ea, [[\u05ea\u05d5\u05db\u05e0\u05d9\u05ea 120 \u2013 \u05e2\u05ea\u05d5\u05d3\u05d4 \u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea \u05e8\u05d1 \u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea]] \u05dc\u05e9\u05d5\u05ea\u05e4\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05e9\u05dc [[\u05de\u05db\u05d5\u05df \u05e9\u05d7\u05e8\u05d9\u05ea]], \u05d5\u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05e9\u05d9\u05e8\u05d4 \u05e9\u05dc [[\u05d4\u05dc\u05d9\u05e7\u05d5\u05df (\u05e2\u05de\u05d5\u05ea\u05d4)|\u05d4\u05dc\u05d9\u05e7\u05d5\u05df]].\n\n\u05d1\u05d2\u05d9\u05dc 25 \u05d4\u05d7\u05dc\u05d4 \u05dc\u05d4\u05ea\u05e2\u05e0\u05d9\u05d9\u05df \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05d1\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e9\u05dc \u05de\u05e9\u05e4\u05d7\u05ea\u05d4 \u05d5\u05de\u05d5\u05e8\u05e9\u05ea\u05d4 \u05d5\u05d7\u05d3\u05dc\u05d4 \u05dc\u05d4\u05ea\u05d1\u05d9\u05d9\u05e9 \u05d1\u05e9\u05e4\u05d4 \u05d5\u05d1\u05ea\u05e8\u05d1\u05d5\u05ea \u05d4\u05d5\u05e8\u05d9\u05d4 \u05d5\u05d7\u05d1\u05e8\u05d9\u05d4\u05dd. \u05d4\u05d9\u05d0 \u05de\u05e8\u05d1\u05d4 \u05dc\u05d4\u05ea\u05e8\u05d0\u05d9\u05d9\u05df \u05d5\u05dc\u05d4\u05e2\u05d1\u05d9\u05e8 \u05d4\u05e8\u05e6\u05d0\u05d5\u05ea \u05e2\u05dc \u05e1\u05d5\u05d2\u05d9\u05d5\u05ea \u05d4\u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d5\u05ea \u05dc\u05d3\u05d5\u05d1\u05e8\u05d9 \u05e8\u05d5\u05e1\u05d9\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc.{{\u05d4\u05e2\u05e8\u05d4|{{\u05d2\u05dc\u05d5\u05d1\u05e1|\u05d0\u05e0\u05d3\u05e8\u05d4 \u05d8\u05d1\u05e7\u05d5\u05e3|\"\u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df \u05d4\u05e8\u05d5\u05e1\u05d9 \u05de\u05d1\u05d9\u05da \u05d0\u05d5\u05ea\u05e0\u05d5 - \u05d0\u05e0\u05d7\u05e0\u05d5 \u05d7\u05d9\u05d4 \u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea \u05d7\u05d3\u05e9\u05d4\"|1001300629|14 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2019}}}} \u05d1\u05e9\u05e0\u05ea 2018 \u05d4\u05e2\u05d9\u05ea\u05d5\u05df [[\u05dc\u05d9\u05d9\u05d3\u05d9 \u05d2\u05dc\u05d5\u05d1\u05e1]] \u05d1\u05d7\u05e8 \u05d1\u05d4 \u05dc\u05d0\u05d7\u05ea \u05de\u05e2\u05e9\u05e8\u05d9\u05dd \u05d4\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05e1\u05d8\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=http://www.globes.co.il/news/home.aspx?fid=9870|\u05db\u05d5\u05ea\u05e8\u05ea=\u05dc\u05d9\u05d9\u05d3\u05d9 \u05d2\u05dc\u05d5\u05d1\u05e1 \u05de\u05e6\u05d9\u05d2: 20 \u05d4\u05d0\u05e7\u05d8\u05d9\u05d1\u05d9\u05e1\u05d8\u05d9\u05d5\u05ea \u05d4\u05de\u05e9\u05e4\u05d9\u05e2\u05d5\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc 2018 - \u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3|\u05d0\u05ea\u05e8=\u05d2\u05dc\u05d5\u05d1\u05e1|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2020-06-14}}</ref> \u05d1\u05e9\u05e0\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4 \u05d4\u05e7\u05d9\u05de\u05d4 \u05de\u05e1\u05e4\u05e8 \u05d9\u05d5\u05d6\u05de\u05d5\u05ea, \u05d1\u05d9\u05d7\u05d3 \u05e2\u05dd \u05e9\u05d5\u05ea\u05e4\u05d9\u05dd, \u05d4\u05e4\u05d5\u05e2\u05dc\u05d5\u05ea \u05dc\u05de\u05e2\u05df \u05d4\u05db\u05e8\u05d4 \u05d5\u05e7\u05d9\u05d3\u05d5\u05dd \u05d4\u05de\u05d5\u05e8\u05e9\u05ea \u05e9\u05dc \u05e2\u05d5\u05dc\u05d9 \u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea.\n\n\u05d1\u05e9\u05e0\u05ea 2022, \u05d1\u05e9\u05dc \u05e4\u05d5\u05e2\u05dc\u05d4 \u05dc\u05de\u05e2\u05df \u05e7\u05dc\u05d9\u05d8\u05ea \u05e2\u05dc\u05d9\u05d9\u05ea \u05d9\u05d4\u05d3\u05d5\u05ea \u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea, \u05d6\u05db\u05ea\u05d4 \u05e8\u05d9\u05e3 \u05d1\u05e6\u05d9\u05d5\u05df \u05de\u05d9\u05d5\u05d7\u05d3 \u05d1\u05e4\u05e8\u05e1 [[\u05d9\u05d5\u05e1\u05d9 \u05d4\u05e8\u05d0\u05dc]] \u05dc\u05d4\u05e2\u05e4\u05dc\u05d4, \u05e2\u05dc\u05d9\u05d4 \u05d5\u05e7\u05dc\u05d9\u05d8\u05d4.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://palmach.org.il/conferences/yosi-harel-2022/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05e4\u05e8\u05e1 \u05d9\u05d5\u05e1\u05d9 \u05d4\u05e8\u05d0\u05dc 2022|\u05d0\u05ea\u05e8=\u05e2\u05de\u05d5\u05ea\u05ea \u05d3\u05d5\u05e8 \u05d4\u05e4\u05dc\u05de\"\u05d7|\u05ea\u05d0\u05e8\u05d9\u05da=2022}}</ref>\n\n\u05d1\u05de\u05d0\u05d9 [[2023]] \u05d4\u05e9\u05ea\u05ea\u05e4\u05d4 \u05d1[[\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4|\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4]] \u05d4[[\u05ea\u05d9\u05e2\u05d5\u05d3\u05d9]]\u05ea \"[[\u05de\u05d3\u05d5\u05e8\u05d5\u05ea \u05d4\u05e9\u05d1\u05d8\u05d9\u05dd]]\" \u05e9\u05dc [[\u05db\u05d0\u05df 11]].<ref>{{\u05d9\u05d5\u05d8\u05d9\u05d5\u05d1|uus6Ualgm2I|\u05e9\u05dd=\u05e1\u05d3\u05e8\u05d4 \u05ea\u05d9\u05e2\u05d5\u05d3\u05d9\u05ea \u05d7\u05d3\u05e9\u05d4 \ud83d\udcfd\ufe0f \u05de\u05d3\u05d5\u05e8\u05d5\u05ea \u05d4\u05e9\u05d1\u05d8\u05d9\u05dd {{!}} \u05e4\u05e8\u05e7 1 - \u05d4\u05e1\u05d3\u05e8 \u05d9\u05d7\u05d6\u05d5\u05e8 \u05e2\u05dc \u05db\u05e0\u05d5: \u05e9\u05e0\u05d9\u05dd 1993 \u05e2\u05d3 2000|\u05d0\u05d5\u05e8\u05da=54:42|\u05e2\u05e8\u05d5\u05e5=\u05db\u05d0\u05df 11 - \u05ea\u05d0\u05d2\u05d9\u05d3 \u05d4\u05e9\u05d9\u05d3\u05d5\u05e8 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9}}</ref>\n\n\u05d1\u05de\u05d0\u05d9 2026 \u05d4\u05e9\u05ea\u05ea\u05e4\u05d4 [[\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4|\u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4]] \"\u05dc\u05d0 \u05de\u05d4 \u05e9\u05d7\u05e9\u05d1\u05ea\u05dd\" \u05d1\u05d4\u05e0\u05d7\u05d9\u05d9\u05ea\u05d5 \u05e9\u05dc [[\u05e2\u05d9\u05d3\u05df \u05e2\u05de\u05d3\u05d9]] [[\u05e7\u05e9\u05ea 12|\u05d1\u05e2\u05e8\u05d5\u05e5 12]].\n\n\u05d1\u05d9\u05d5\u05dc\u05d9 2026, \u05dc\u05e7\u05e8\u05d0\u05ea [[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4-26]], \u05d4\u05e6\u05d8\u05e8\u05e4\u05d4 \u05dc\u05de\u05e4\u05dc\u05d2\u05ea [[\u05d9\u05e9\u05e8!]] \u05d5\u05d4\u05d5\u05e6\u05d1\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4-15 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4 \u05dc\u05e7\u05e8\u05d0\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4-26.{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05e2\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e0\u05dc\u05d9\u05d9\u05df|\u05d0\u05e0\u05d4 \u05d1\u05e8\u05e1\u05e7\u05d9|\u05d0\u05dc\u05e7\u05e1 \u05e8\u05d9\u05e3, \u05de\u05e0\u05db\"\u05dc\u05d9\u05ea \u05e2\u05de\u05d5\u05ea\u05ea '\u05dc\u05d5\u05d1\u05d9 \u05d4\u05de\u05d9\u05dc\u05d9\u05d5\u05df' \u05d5\u05e4\u05e2\u05d9\u05dc\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05de\u05e6\u05d8\u05e8\u05e4\u05ea \u05dc\u05d2\u05d3\u05d9 \u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8|breaking-news/article-1339278|30 \u05d1\u05d9\u05d5\u05e0\u05d9 2026}}}} \u05e8\u05d9\u05e3 \u05d0\u05d7\u05e8\u05d0\u05d9\u05ea \u05e2\u05dc \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05e7\u05dc\u05d9\u05d8\u05ea \u05d4\u05e2\u05dc\u05d9\u05d9\u05d4 \u05e9\u05dc \u05d4\u05de\u05e4\u05dc\u05d2\u05d4.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://yasharwitheisenkot.com/principles/aliyah-and-integration/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d9\u05e9\u05e8! \u05dc\u05e7\u05dc\u05d9\u05d8\u05ea \u05e2\u05dc\u05d9\u05d9\u05d4|\u05d0\u05ea\u05e8=\u05d9\u05e9\u05e8! \u05e2\u05dd \u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8}}</ref>\n\n== \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea-\u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea ==\n=== \u05d3\u05d5\u05e8 1.5 ===\n\u05e8\u05d9\u05e3 \u05d1\u05d9\u05e7\u05e9\u05d4 \"\u05dc\u05e1\u05e4\u05e8 \u05d0\u05ea \u05d4\u05e1\u05d9\u05e4\u05d5\u05e8 \u05e9\u05dc\u05d4\" \u05d5\u05dc\u05e4\u05d9\u05db\u05da \u05d4\u05d7\u05dc\u05d4 \u05dc\u05dc\u05de\u05d5\u05d3 [[\u05ea\u05e1\u05e8\u05d9\u05d8\u05d0\u05d5\u05ea]] \u05d1[[\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05e1\u05dd \u05e9\u05e4\u05d9\u05d2\u05dc \u05dc\u05e7\u05d5\u05dc\u05e0\u05d5\u05e2 \u05d5\u05dc\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4]] \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd. \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05e2\u05e9\u05d9\u05d9\u05ea\u05d4 \u05d4\u05e7\u05d5\u05dc\u05e0\u05d5\u05e2\u05d9\u05ea \u05d4\u05d1\u05d9\u05e0\u05d4 \u05e9\u05dc\u05d0 \u05de\u05d3\u05d5\u05d1\u05e8 \u05e8\u05e7 \u05d1\u05e1\u05d9\u05e4\u05d5\u05e8 \u05de\u05e9\u05e4\u05d7\u05ea\u05d4, \u05d0\u05dc\u05d0 \u05d1\u05e1\u05d9\u05e4\u05d5\u05e8 \u05e9\u05dc \u05db\u05dc \u05d3\u05d5\u05e8 \u05d4\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd, \u05d9\u05dc\u05d9\u05d3\u05d9 \u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea, \u05e9\u05d4\u05d9\u05d2\u05e8\u05d5 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05d9\u05dc\u05d3\u05d9\u05dd \u05d5\u05db\u05d9 \u05d4\u05d9\u05d0 \u05d7\u05dc\u05e7 \u05de[[\u05d3\u05d5\u05e8 1.5]] {{\u05d0\u05e0|Immigrant_generations}}.\n\n\u05d1-2015 \u05d4\u05e6\u05d8\u05e8\u05e4\u05d4 \u05dc\u05e7\u05d1\u05d5\u05e6\u05ea \"\u05d3\u05d5\u05e8 1.5\", \u05d4\u05e4\u05e2\u05d9\u05dc\u05d4 \u05de\u05d9\u05de\u05d9 [[\u05d4\u05de\u05d7\u05d0\u05d4 \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc 2011]] \u05d5\u05de\u05e2\u05dc\u05d4 \u05e1\u05d5\u05d2\u05d9\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d4\u05e7\u05e9\u05d5\u05e8\u05d5\u05ea \u05dc\u05e6\u05d9\u05d1\u05d5\u05e8 \u05d3\u05d5\u05d1\u05e8\u05d9 \u05d4\u05e8\u05d5\u05e1\u05d9\u05ea. \u05d1\u05d4\u05de\u05e9\u05da \u05d1\u05d9\u05e7\u05e9\u05d4 \u05e8\u05d9\u05e3 \u05dc\u05e2\u05e1\u05d5\u05e7 \u05d1\u05ea\u05e8\u05d1\u05d5\u05ea \u05d9\u05d5\u05e6\u05d0\u05d9 \u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea \u05d5\u05de\u05ea\u05d5\u05da \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05e6\u05de\u05d7\u05d4 \"[[\u05d4\u05d1\u05e8\u05d9\u05d2\u05d3\u05d4 \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea]]\".<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.kan.org.il/Item/?itemId=49637|\u05db\u05d5\u05ea\u05e8\u05ea=\"\u05dc\u05d0 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05e4\u05e8\u05e0\u05e1\u05d4\": \u05d4\u05e2\u05d5\u05dc\u05d9\u05dd \u05e9\u05d7\u05d6\u05e8\u05d5 \u05dc\u05e8\u05d5\u05e1\u05d9\u05d4|\u05d0\u05ea\u05e8=\u05db\u05d0\u05df-\u05ea\u05d0\u05d2\u05d9\u05d3 \u05d4\u05e9\u05d9\u05d3\u05d5\u05e8 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2020-06-14}}</ref>\n\n=== \u05d4\u05d1\u05e8\u05d9\u05d2\u05d3\u05d4 \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea ===\n\u05d1-2015 \u05d4\u05e7\u05d9\u05de\u05d4 \u05e8\u05d9\u05e3 \u05d1\u05d9\u05d7\u05d3 \u05e2\u05dd [[\u05d1\u05e8\u05d9 \u05e8\u05d5\u05d6\u05e0\u05d1\u05e8\u05d2]] \u05d0\u05ea \"\u05d4\u05d1\u05e8\u05d9\u05d2\u05d3\u05d4 \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea\" - \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea-\u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \u05d1\u05e0\u05d9 \"\u05d3\u05d5\u05e8 1.5\" \u05e9\u05e4\u05e2\u05dc\u05d4 \u05dc\u05d4\u05db\u05e8\u05ea \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc \u05e2\u05d5\u05dc\u05d9 \u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea \u05d1\u05e6\u05d9\u05d1\u05d5\u05e8 \u05d4\u05e8\u05d7\u05d1, \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05ea\u05e8\u05d1\u05d5\u05ea\u05d9\u05d9\u05dd \u05d1\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea, \u05d1\u05e8\u05e9\u05ea\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d5\u05d1\u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05e4\u05d9\u05d6\u05d9\u05d9\u05dd. \u05d4\u05d1\u05e8\u05d9\u05d2\u05d3\u05d4 \u05e4\u05e2\u05dc\u05d4 \u05d1\u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05de\u05d2\u05d5\u05d5\u05e0\u05d9\u05dd \u05db\u05d2\u05d5\u05df: \u05de\u05d5\u05d6\u05d9\u05e7\u05d4, \u05d0\u05d5\u05db\u05dc, \u05d9\u05d4\u05d3\u05d5\u05ea, \u05d7\u05d2\u05d9\u05dd, \u05e7\u05d5\u05dc\u05e0\u05d5\u05e2, \u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05d5\u05e2\u05d5\u05d3. \u05d1\u05d9\u05df \u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4:\n* \u05e2\u05e8\u05d1\u05d9 [[\u05d8\u05d5\u05e1\u05d5\u05d1\u05e7\u05d4]] (\u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd \u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d5 \u05d1\u05e7\u05e4\u05d4 [[\u05ea\u05de\u05d5\u05dc \u05e9\u05dc\u05e9\u05d5\u05dd (\u05d1\u05d9\u05ea \u05e7\u05e4\u05d4)|\u05ea\u05de\u05d5\u05dc \u05e9\u05dc\u05e9\u05d5\u05dd]] \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd) - \u05dc\u05d9\u05d9\u05df \u05de\u05d5\u05e4\u05e2\u05d9 \u05d4\u05d2\u05d9\u05e8\u05d4 \u05d0\u05d9\u05e0\u05d8\u05d9\u05de\u05d9\u05d9\u05dd \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea \u05de\u05e4\u05d9\u05d4\u05dd \u05e9\u05dc \u05d0\u05de\u05e0\u05d9\u05dd \u05d1\u05e0\u05d9 \u05d3\u05d5\u05e8 1.5, \u05d4\u05db\u05d5\u05dc\u05dc \u05d4\u05e7\u05e8\u05d0\u05ea \u05e9\u05d9\u05e8\u05d4, [[\u05e1\u05e4\u05d5\u05e7\u05df \u05d5\u05d5\u05e8\u05d3]] \u05d5\u05de\u05d5\u05d6\u05d9\u05e7\u05d4, \u05d1\u05dc\u05d9\u05d5\u05d5\u05d9 \u05e1\u05d9\u05e4\u05d5\u05e8\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05d4\u05de\u05ea\u05d0\u05e8\u05d9\u05dd \u05d0\u05ea \u05d7\u05d5\u05d5\u05d9\u05d5\u05ea \u05d4\u05d4\u05d2\u05d9\u05e8\u05d4 \u05d5\u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea\u05d9\u05ea \u05e2\u05dc\u05d9\u05d4 \u05d2\u05d3\u05dc\u05d5.{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05de\u05d0\u05e9\u05d4 \u05d0\u05d1\u05e8\u05d1\u05d5\u05da|\u05d5\u05e2\u05db\u05e9\u05d9\u05d5 \u05e8\u05d5\u05e1\u05e4\u05d5\u05d0\u05d8\u05d9\u05e7\u05d4: \u05d4\u05d2\u05d9\u05e2 \u05ea\u05d5\u05e8 \u05d4\u05de\u05d4\u05e4\u05db\u05d4 \u05e9\u05dc \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d3\u05d5\u05d1\u05e8\u05d9 \u05e8\u05d5\u05e1\u05d9\u05ea|0000017f-db76-df62-a9ff-dff7f4940000|10 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2017}}}}<ref>{{ynet|\u05e0\u05e2\u05dd \u05e4\u05e8\u05ea\u05d5\u05dd|\"\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05e8\u05d5\u05e1\u05d9\u05ea \u05dc\u05e2\u05e8\u05e1 \u05e4\u05d5\u05d0\u05d8\u05d9\u05e7\u05d4\"|4759897|31 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2016}}</ref>\n* [[\u05e0\u05d5\u05d1\u05d9 \u05d2\u05d5\u05d3|\u05e0\u05d5\u05b9\u05d1\u05b4\u05d9 \u05d2\u05d5\u05b9\u05d3]] \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9 \u05d4\u05de\u05d4\u05d5\u05d5\u05d4 \u05de\u05e1\u05d2\u05e8\u05ea \u05d7\u05d9\u05dc\u05d5\u05e0\u05d9\u05ea-\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea \u05dc\u05d7\u05d2\u05d9\u05d2\u05ea \u05d4\u05e9\u05e0\u05d4 \u05d4\u05d7\u05d3\u05e9\u05d4 \u05d1\u05e8\u05d5\u05d7 \u05d4\u05d7\u05d2 \u05e9\u05e0\u05d7\u05d5\u05d2 \u05de\u05ea\u05e7\u05d5\u05e4\u05ea \u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea. \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05e0\u05d5\u05e2\u05d3 \u05dc\u05e9\u05d1\u05d5\u05e8 \u05e1\u05d8\u05d9\u05d2\u05de\u05d5\u05ea \u05e2\u05dc \u05d4\u05e7\u05e9\u05e8 \u05d1\u05d9\u05e0\u05d5 \u05dc\u05d1\u05d9\u05df \u05d4[[\u05e1\u05d9\u05dc\u05d1\u05e1\u05d8\u05e8]] \u05d5\u05dc\u05e2\u05d5\u05d3\u05d3 \u05d3\u05d5\u05d1\u05e8\u05d9 \u05e8\u05d5\u05e1\u05d9\u05ea \u05dc\u05d0\u05e8\u05d7 \u05d0\u05ea \u05d7\u05d1\u05e8\u05d9\u05d4\u05dd \u05d4\u05e6\u05d1\u05e8\u05d9\u05dd \u05d1\u05d7\u05d2.{{\u05d4\u05e2\u05e8\u05d4|[https://www.novygodisraeli.com/ \u05d0\u05ea\u05e8 \u05e0\u05d5\u05d1\u05d9 \u05d2\u05d5\u05d3]}}<ref>{{\u05d4\u05d0\u05e8\u05e5|\u05d3\u05e4\u05e0\u05d4 \u05d0\u05e8\u05d3|\u05d0\u05dc \u05ea\u05e7\u05e8\u05d0\u05d5 \u05dc\u05d6\u05d4 \u05e1\u05d9\u05dc\u05d1\u05e1\u05d8\u05e8: \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05e9\u05e8\u05d5\u05e6\u05d9\u05dd \u05e9\u05ea\u05d7\u05d2\u05d2\u05d5 \u05d0\u05ea \u05e0\u05d5\u05d1\u05d9 \u05d2\u05d5\u05d3|0000017f-e757-d97e-a37f-f77792a50000|31 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2015}}</ref> \u05e2\u05dc \u05d0\u05e3 \u05d4\u05d9\u05e9\u05d2\u05d9 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8, \u05e8\u05d9\u05e3 \u05e1\u05d1\u05d5\u05e8\u05d4 \u05db\u05d9 \"\u05d9\u05e9 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05e2\u05d3\u05d9\u05d9\u05df \u05d7\u05d5\u05e9\u05d1\u05d9\u05dd \u05e9\u05e0\u05d5\u05d1\u05d9 \u05d2\u05d5\u05d3 \u05d4\u05d5\u05d0 \u05d7\u05d2 [[\u05e0\u05e6\u05e8\u05d5\u05ea|\u05e0\u05d5\u05e6\u05e8\u05d9]], \u05d9\u05e9 \u05d4\u05e8\u05d1\u05d4 \u05d1\u05d5\u05e8\u05d5\u05ea\".<ref>{{ynet|\u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8\u05d4 \u05dc\u05d5\u05e7\u05e9|\"\u05e2\u05d3\u05d9\u05d9\u05df \u05d7\u05d5\u05e9\u05d1\u05d9\u05dd \u05e9\u05e0\u05d5\u05d1\u05d9 \u05d2\u05d5\u05d3 \u05d4\u05d5\u05d0 \u05d7\u05d2 \u05e0\u05d5\u05e6\u05e8\u05d9, \u05d9\u05e9 \u05d4\u05e8\u05d1\u05d4 \u05d1\u05d5\u05e8\u05d5\u05bc\u05ea\"|judaism/article/hkiiifmn11l|31 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2025}}</ref>\n* \u05de\u05d1\u05e6\u05e2 [[\u05d7\u05d5\u05e7 \u05de\u05e2\u05de\u05d3 \u05d5\u05ea\u05d9\u05e7\u05d9 \u05de\u05dc\u05d7\u05de\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4|\u05d5\u05b5\u05d8\u05b5\u05e8\u05b7\u05df]]{{\u05d4\u05e2\u05e8\u05d4|[https://www.mivtzaveteran.com/ \u05d0\u05ea\u05e8 \u05de\u05d1\u05e6\u05e2 \u05d5\u05d8\u05e8\u05df]}} \u05d4\u05e0\u05d7\u05d2\u05d2 \u05d1-[[\u05d9\u05d5\u05dd \u05d4\u05e0\u05d9\u05e6\u05d7\u05d5\u05df (9 \u05d1\u05de\u05d0\u05d9)|9 \u05dc\u05de\u05d0\u05d9]], \u05e0\u05d5\u05e2\u05d3 \u05dc\u05e1\u05e4\u05e8 \u05d0\u05ea \u05e1\u05d9\u05e4\u05d5\u05e8\u05d9 \u05d4\u05d2\u05d1\u05d5\u05e8\u05d4 \u05e9\u05dc \u05d4\u05e1\u05d1\u05d9\u05dd \u05d5\u05d4\u05e1\u05d1\u05ea\u05d5\u05ea \u05e9\u05dc \u05d3\u05d5\u05e8 1.5 \u05e9\u05dc\u05d7\u05de\u05d5 \u05d1[[\u05d4\u05e6\u05d1\u05d0 \u05d4\u05d0\u05d3\u05d5\u05dd|\u05e6\u05d1\u05d0 \u05d4\u05d0\u05d3\u05d5\u05dd]] \u05d1[[\u05de\u05dc\u05d7\u05de\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4]]. \u05d1\u05e9\u05d9\u05ea\u05d5\u05e3 \u05e2\u05dd [[\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d1\u05e1\u05dc\u05d5\u05df]], \u05de\u05ea\u05e7\u05d9\u05d9\u05de\u05d9\u05dd \u05de\u05e4\u05d2\u05e9\u05d9\u05dd \u05e2\u05dd \u05d5\u05d8\u05e8\u05e0\u05d9\u05dd \u05d1[[\u05d9\u05d5\u05dd \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05e9\u05d5\u05d0\u05d4 \u05d5\u05dc\u05d2\u05d1\u05d5\u05e8\u05d4|\u05d9\u05d5\u05dd \u05d4\u05e9\u05d5\u05d0\u05d4]] \u05d5[[\u05d9\u05d5\u05dd \u05d4\u05e0\u05d9\u05e6\u05d7\u05d5\u05df (9 \u05d1\u05de\u05d0\u05d9)|\u05d1\u05d9\u05d5\u05dd \u05d4\u05e0\u05d9\u05e6\u05d7\u05d5\u05df]] \u05d1\u05e8\u05d7\u05d1\u05d9 \u05d4\u05d0\u05e8\u05e5. \u05d1\u05e0\u05d5\u05e1\u05e3, \u05d4\u05d5\u05e7\u05dd \u05d0\u05ea\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05d4\u05db\u05d5\u05dc\u05dc \u05e1\u05d9\u05e4\u05d5\u05e8\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05e9\u05dc \u05d5\u05d8\u05e8\u05e0\u05d9\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd, \u05de\u05d5\u05e9\u05d2\u05d9\u05dd \u05d4\u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05de\u05dc\u05d7\u05de\u05d4 \u05d5\u05e2\u05d5\u05d3.{{\u05d4\u05e2\u05e8\u05d4|{{\u05d9\u05d5\u05d8\u05d9\u05d5\u05d1|Gy-8OaKQISU|\u05e9\u05dd=\u05e2\u05d5\u05e9\u05d9\u05dd \u05e1\u05d3\u05e8 \u05d7\u05d3\u05e9 - 05.05.2016 - \u05ea\u05db\u05e0\u05d9\u05ea \u05de\u05dc\u05d0\u05d4|\u05d0\u05d5\u05e8\u05da=27:58|\u05e2\u05e8\u05d5\u05e5=\u05db\u05d0\u05df \u05d7\u05d9\u05e0\u05d5\u05db\u05d9\u05ea}}}} \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea, \u05d1-2017 \u05e0\u05d7\u05e7\u05e7 \u05d7\u05d5\u05e7 \u05d4\u05e7\u05d5\u05d1\u05e2 \u05d0\u05ea 9 \u05d1\u05de\u05d0\u05d9 \u05db\u05d9\u05d5\u05dd \u05dc\u05e6\u05d9\u05d5\u05df \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e9\u05dc \u05e0\u05d9\u05e6\u05d7\u05d5\u05df [[\u05d1\u05e2\u05dc\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea]] \u05e2\u05dc [[\u05d2\u05e8\u05de\u05e0\u05d9\u05d4 \u05d4\u05e0\u05d0\u05e6\u05d9\u05ea]] \u05d1[[\u05de\u05dc\u05d7\u05de\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4]].<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://main.knesset.gov.il/About/Occasion/Pages/ReleaseFromGermany.aspx|\u05d4\u05db\u05d5\u05ea\u05d1=|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d9\u05d5\u05dd \u05d4\u05e0\u05d9\u05e6\u05d7\u05d5\u05df \u05e2\u05dc \u05d2\u05e8\u05de\u05e0\u05d9\u05d4 \u05d4\u05e0\u05d0\u05e6\u05d9\u05ea|\u05d0\u05ea\u05e8=\u05d4\u05db\u05e0\u05e1\u05ea|\u05ea\u05d0\u05e8\u05d9\u05da=}}</ref>\n* \u05e4\u05e1\u05d8\u05d9\u05d1\u05dc \u05d0\u05d5\u05d3\u05e1\u05d4-\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1{{\u05d4\u05e2\u05e8\u05d4|{{nrg|\u05e8\u05d7\u05dc\u05d9 \u05e8\u05d9\u05e3|\u05e0\u05d0\u05de\u05e0\u05d5\u05ea \u05d1\u05ea\u05e8\u05d1\u05d5\u05ea \u05d4\u05e8\u05d5\u05e1\u05d9\u05ea: \u05d4\u05de\u05e2\u05d1\u05d3\u05d4 \u05e9\u05dc \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1 \u05de\u05d2\u05d9\u05e2\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc|894/779|13 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2017|47|2}}}} \u05d5\u05e4\u05e1\u05d8\u05d9\u05d1\u05dc \u05e1\u05e0\u05d8 \u05e4\u05d8\u05e8\u05d1\u05d5\u05e8\u05d2{{\u05d4\u05e2\u05e8\u05d4|{{Time Out \u05d9\u05e9\u05e8\u05d0\u05dc|\u05d9\u05e2\u05dc \u05e1\u05d2\u05e8\u05e1\u05e7\u05d9|\u05de\u05e6\u05dc\u05de\u05d4 \u05de\u05d4\u05d7\u05dc\u05dc \u05d5\u05e1\u05e8\u05d8 \u05d1\u05d9\u05ea\u05d9: \u05ea\u05d9\u05e2\u05d5\u05d3 \u05e0\u05d3\u05d9\u05e8 \u05e9\u05dc \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05d1\u05d1\u05e8\u05d9\u05d4\"\u05de \u05d4\u05e1\u05d5\u05d1\u05d9\u05d9\u05d8\u05d9\u05ea|\u05e1\u05e0\u05d8-\u05e4\u05d8\u05e8\u05d1\u05d5\u05e8\u05d2-2018|21 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2018}}}} \u05d4\u05dd \u05e9\u05e0\u05d9 \u05e4\u05e1\u05d8\u05d9\u05d1\u05dc\u05d9 \u05ea\u05e8\u05d1\u05d5\u05ea \u05e9\u05d4\u05ea\u05e7\u05d9\u05d9\u05de\u05d5 \u05d1\u05e9\u05e0\u05d9\u05dd 2018\u20132019 \u05d1[[\u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05df \u05d0\u05e8\u05e5 \u05d9\u05e9\u05e8\u05d0\u05dc]] \u05d1\u05ea\u05dc \u05d0\u05d1\u05d9\u05d1, [[\u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05df \u05d4\u05e2\u05dd \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9 - \u05d1\u05d9\u05ea \u05d4\u05ea\u05e4\u05d5\u05e6\u05d5\u05ea|\u05d1\u05d9\u05ea \u05d4\u05ea\u05e4\u05d5\u05e6\u05d5\u05ea]], [[\u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05df \u05d7\u05d9\u05e4\u05d4 \u05dc\u05d0\u05de\u05e0\u05d5\u05ea|\u05de\u05d5\u05d6\u05d9\u05d0\u05d5\u05df \u05d7\u05d9\u05e4\u05d4 \u05dc\u05d0\u05d5\u05de\u05e0\u05d5\u05ea]] \u05d5\u05d1\u05e8\u05d7\u05d5\u05d1\u05d5\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd. \u05d0\u05de\u05e0\u05d9\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05d9\u05e6\u05e8\u05d5 \u05d0\u05de\u05e0\u05d5\u05ea \u05e2\u05db\u05e9\u05d5\u05d5\u05d9\u05ea \u05de\u05d5\u05dc\u05d8\u05d9 \u05d3\u05d9\u05e1\u05e6\u05d9\u05e4\u05dc\u05d9\u05e0\u05e8\u05d9\u05ea: [[\u05de\u05d7\u05d5\u05dc (\u05d0\u05de\u05e0\u05d5\u05ea \u05d4\u05d1\u05de\u05d4)|\u05de\u05d7\u05d5\u05dc]], [[\u05e4\u05e8\u05e4\u05d5\u05e8\u05de\u05e0\u05e1]], [[\u05de\u05d5\u05d6\u05d9\u05e7\u05d4]], [[\u05e4\u05d9\u05e1\u05d5\u05dc]] \u05d5\u05e2\u05d5\u05d3 \u05d1\u05e8\u05d5\u05d7 \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea, \u05d9\u05d4\u05d5\u05d3\u05d9\u05ea \u05d5\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea\u05d9\u05ea \u05e9\u05dc \u05d4\u05e2\u05e8\u05d9\u05dd \u05d4\u05e1\u05d5\u05d1\u05d9\u05d9\u05d8\u05d9\u05d5\u05ea.\n* \u05e1\u05d9\u05e4\u05d5\u05e8\u05d9 \u05de\u05d9\u05dc\u05d4 - \u05e7\u05de\u05e4\u05d9\u05d9\u05df \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9 \u05dc\u05e9\u05d9\u05ea\u05d5\u05e3 \u05e1\u05d9\u05e4\u05d5\u05e8\u05d9 [[\u05d1\u05e8\u05d9\u05ea \u05de\u05d9\u05dc\u05d4|\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d9\u05dc\u05d4]] \u05e9\u05dc \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d1\u05e0\u05d9 \u05d3\u05d5\u05e8 1.5, \u05e9\u05e2\u05d1\u05e8\u05d5 \u05d1\u05e8\u05d9\u05ea \u05de\u05d9\u05dc\u05d4 \u05d1\u05d4\u05d2\u05d9\u05e2\u05dd \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05e9\u05e0\u05d5\u05ea \u05d4-90.<ref>{{ynet||\"\u05d7\u05ea\u05db\u05d5 \u05d0\u05ea \u05db\u05d5\u05dc\u05dd \u05d1\u05e1\u05d9\u05d8\u05d5\u05e0\u05d5\u05ea\": \u05d2\u05d1\u05e8\u05d9\u05dd \u05e9\u05e2\u05d1\u05e8\u05d5 \u05d1\u05e8\u05d9\u05ea \u05de\u05d9\u05dc\u05d4 \u05de\u05d0\u05d5\u05d7\u05e8\u05ea \u05de\u05d3\u05d1\u05e8\u05d9\u05dd|5424712|15 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2018}}</ref>\n* \u05e2\u05d5\u05e0\u05ea \u05d4\u05d4\u05d5\u05db\u05d7\u05d5\u05ea - \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05de\u05d1\u05e7\u05e9 \u05dc\u05d7\u05e9\u05d5\u05e3 \u05d0\u05ea \u05d4\u05e2\u05d5\u05d1\u05d3\u05d4 \u05db\u05d9 \u05db-350,000 \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05d3\u05d5\u05d1\u05e8\u05d9 \u05e8\u05d5\u05e1\u05d9\u05ea \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc\u05d9\u05dd [[\u05e0\u05d9\u05e9\u05d5\u05d0\u05d9\u05dd \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc|\u05dc\u05d4\u05ea\u05d7\u05ea\u05df \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc]] \u05d5\u05d1\u05d3\u05e8\u05da \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05e2\u05d1\u05d5\u05e8 \u05ea\u05d4\u05dc\u05d9\u05da \u05de\u05e9\u05e4\u05d9\u05dc \u05e9\u05dc [[\u05d1\u05d9\u05e8\u05d5\u05e8 \u05d9\u05d4\u05d3\u05d5\u05ea]] \u05d1\u05e8\u05d1\u05e0\u05d5\u05ea.<ref>{{ynet||\u05de\u05e8\u05d3 \u05d4\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd: \"\u05dc\u05d0 \u05de\u05d5\u05db\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05dc\u05d4\u05d5\u05db\u05d9\u05d7 \u05d9\u05d4\u05d3\u05d5\u05ea \u05d1\u05e8\u05d1\u05e0\u05d5\u05ea\"|5584232|9 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2019}}</ref>\n\n=== \"\u05dc\u05d5\u05d1\u05d9 \u05d4\u05de\u05d9\u05dc\u05d9\u05d5\u05df\" ===\n\u05d1-2020 \u05e0\u05de\u05e0\u05ea\u05d4 \u05e8\u05d9\u05e3 \u05e2\u05dd \u05d4\u05de\u05d9\u05d9\u05e1\u05d3\u05d9\u05dd \u05e9\u05dc \u05d4\u05e2\u05de\u05d5\u05ea\u05d4 [[\u05dc\u05d5\u05d1\u05d9 \u05d4\u05de\u05d9\u05dc\u05d9\u05d5\u05df]] \u05d1\u05d9\u05d7\u05d3 \u05e2\u05dd [[\u05d9\u05d5\u05e0\u05ea\u05df \u05d3\u05d5\u05d1\u05d5\u05d1]], \u05d1\u05e8\u05d9 \u05e8\u05d5\u05d6\u05e0\u05d1\u05e8\u05d2, \u05d5\u05d0\u05d3\u05d9\u05dd \u05d1\u05dc\u05d5\u05de\u05d9\u05df, \u05e4\u05d5\u05dc\u05d4 \u05d1\u05e8\u05e7\u05df, \u05d1\u05dc\u05d4 \u05d0\u05dc\u05db\u05e1\u05e0\u05d3\u05e8\u05d5\u05d1 \u05d5\u05d0\u05e0\u05d4 \u05e4\u05e8\u05d5\u05d1\u05d9\u05d6. \"\u05dc\u05d5\u05d1\u05d9 \u05d4\u05de\u05d9\u05dc\u05d9\u05d5\u05df\" \u05d4\u05d9\u05d0 \u05e2\u05de\u05d5\u05ea\u05d4 \u05d0-\u05de\u05e4\u05dc\u05d2\u05ea\u05d9\u05ea \u05e9\u05e4\u05d5\u05e2\u05dc\u05ea \u05dc\u05d9\u05d9\u05e6\u05d2 \u05d5\u05dc\u05e7\u05d3\u05dd \u05d0\u05ea \u05d4\u05e6\u05e8\u05db\u05d9\u05dd \u05e9\u05dc 1.2 \u05de\u05d9\u05dc\u05d9\u05d5\u05df \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05d3\u05d5\u05d1\u05e8\u05d9 \u05d4\u05e8\u05d5\u05e1\u05d9\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc. \u05d4\u05e2\u05de\u05d5\u05ea\u05d4 \u05e4\u05e2\u05dc\u05d4 \u05dc\u05e6\u05d5\u05e8\u05da \u05e2\u05d9\u05e8\u05d5\u05d1\u05dd \u05e9\u05dc \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05d3\u05d5\u05d1\u05e8\u05d9 \u05d4\u05e8\u05d5\u05e1\u05d9\u05ea \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05e7\u05d1\u05dc\u05ea \u05d4\u05d4\u05d7\u05dc\u05d8\u05d5\u05ea, \u05e7\u05d9\u05d3\u05d5\u05dd \u05e9\u05d5\u05d5\u05d9\u05d5\u05df \u05d6\u05db\u05d5\u05d9\u05d5\u05ea \u05d3\u05ea\u05d9\u05d5\u05ea \u05d5\u05d0\u05d6\u05e8\u05d7\u05d9\u05d5\u05ea \u05d5\u05d9\u05d9\u05e6\u05d5\u05d2 \u05ea\u05e8\u05d1\u05d5\u05ea\u05d9 \u05d4\u05d5\u05dc\u05dd \u05d1\u05d4\u05de\u05e9\u05da \u05dc\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e9\u05dc \u05d4\u05d1\u05e8\u05d9\u05d2\u05d3\u05d4 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea.{{\u05d4\u05e2\u05e8\u05d4|{{\u05d9\u05d5\u05d8\u05d9\u05d5\u05d1|7tqG3vOT114|\u05e9\u05dd=\"\u05dc\u05d0 \u05e6\u05e8\u05d9\u05da \u05dc\u05de\u05d7\u05d5\u05e7 \u05d0\u05ea \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05e9\u05dc\u05e0\u05d5\": \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05d7\u05d5\u05d2\u05d2\u05d9\u05dd \u05e0\u05d5\u05d1\u05d9 \u05d2\u05d5\u05d3|\u05d0\u05d5\u05e8\u05da=11:46|\u05e2\u05e8\u05d5\u