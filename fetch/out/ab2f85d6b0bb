5db\u05d5\u05ea\u05d1 \u05d4\u05e0\u05d0\u05d5\u05de\u05d9\u05dd \u05e9\u05dc [[\u05d1\u05e0\u05d9\u05de\u05d9\u05df \u05e0\u05ea\u05e0\u05d9\u05d4\u05d5]] \u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4\u05e2\u05e9\u05e8\u05d9\u05dd|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea 2015]]. \u05de\u05d7\u05d1\u05e8 \u05d4\u05e1\u05e4\u05e8 \"[[\u05de\u05d3\u05d5\u05e2 \u05d0\u05ea\u05d4 \u05de\u05e6\u05d1\u05d9\u05e2 \u05d9\u05de\u05d9\u05df \u05d5\u05de\u05e7\u05d1\u05dc \u05e9\u05de\u05d0\u05dc?]]\", \u05e9\u05d9\u05e6\u05d0 \u05dc\u05d0\u05d5\u05e8 \u05d1\u05d4\u05d5\u05e6\u05d0\u05ea [[\u05e1\u05dc\u05e2 \u05de\u05d0\u05d9\u05e8]] \u05d1-[[2017]]. \u05d1-[[2011]] \u05d4\u05d9\u05d4 \u05de\u05d7\u05d1\u05e8 \u05e9\u05d5\u05ea\u05e3 \u05e9\u05dc \u05d4\u05e1\u05e4\u05e8\u05d5\u05df \"\u05e0\u05db\u05d1\u05d4 \u05d7\u05e8\u05d8\u05d0\". \u05de\u05d5\u05e2\u05de\u05d3 \u05d1\u05e8\u05e9\u05d9\u05de\u05ea [[\u05d4\u05dc\u05d9\u05db\u05d5\u05d3|\u05de\u05e4\u05dc\u05d2\u05ea \u05d4\u05dc\u05d9\u05db\u05d5\u05d3]] \u05dc[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4\u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05e9|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4-26]].\n\n== \u05d1\u05d9\u05d5\u05d2\u05e8\u05e4\u05d9\u05d4 ==\n\u05ea\u05d3\u05de\u05d5\u05e8 \u05d2\u05d3\u05dc \u05d1[[\u05e7\u05e8\u05d9\u05d9\u05ea \u05d0\u05e8\u05d1\u05e2]] \u05d1\u05de\u05e9\u05e4\u05d7\u05d4 [[\u05d7\u05d9\u05dc\u05d5\u05e0\u05d9\u05dd|\u05d7\u05d9\u05dc\u05d5\u05e0\u05d9\u05ea]] \u05d5\u05dc\u05de\u05d3 \u05d1[[\u05d1\u05d9\u05ea \u05d7\u05d9\u05e0\u05d5\u05da - \u05ea\u05d9\u05db\u05d5\u05df \u05e2\u05d9\u05e8\u05d5\u05e0\u05d9 \u05d2' (\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd)|\u05ea\u05d9\u05db\u05d5\u05df \u05e2\u05d9\u05e8\u05d5\u05e0\u05d9 \u05d2']] \u05d1[[\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]]. \u05e9\u05d9\u05e8\u05ea \u05d1[[\u05e6\u05d4\"\u05dc]] \u05d1[[\u05d7\u05d9\u05dc \u05d4\u05d4\u05e0\u05d3\u05e1\u05d4]].\n\n\u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05d9\u05e8\u05d5\u05ea\u05d5 \u05d4\u05e6\u05d1\u05d0\u05d9, \u05db\u05d0\u05e9\u05e8 \u05d4\u05d9\u05d4 \u05e1\u05de\u05dc \u05de\u05d7\u05dc\u05e7\u05ea \u05d8\u05d9\u05e8\u05d5\u05e0\u05d9\u05dd, \u05d4\u05d5\u05e8\u05e9\u05e2 \u05d1\u05d2\u05e0\u05d1\u05ea \u05e4\u05e8\u05d9\u05d8\u05d9 [[\u05d0\u05de\u05dc\"\u05d7]] \u05d5\u05e8\u05db\u05d5\u05e9 \u05e6\u05d1\u05d0\u05d9. \u05ea\u05d3\u05de\u05d5\u05e8 \u05e0\u05d9\u05d3\u05d5\u05df \u05dc-45 \u05d9\u05de\u05d9 [[\u05de\u05d0\u05e1\u05e8 \u05d1\u05e4\u05d5\u05e2\u05dc]] \u05dc\u05e8\u05d9\u05e6\u05d5\u05d9 \u05d1\u05e2\u05d1\u05d5\u05d3\u05d5\u05ea \u05e6\u05d1\u05d0\u05d9\u05d5\u05ea, 4 \u05d7\u05d5\u05d3\u05e9\u05d9 [[\u05de\u05d0\u05e1\u05e8 \u05e2\u05dc-\u05ea\u05e0\u05d0\u05d9]] \u05d5[[\u05d4\u05d5\u05e8\u05d3\u05d4 \u05d1\u05d3\u05e8\u05d2\u05d4 (\u05e6\u05d4\"\u05dc)|\u05d4\u05d5\u05e8\u05d3\u05d4]] \u05dc\u05d3\u05e8\u05d2\u05ea [[\u05e8\u05d1-\u05d8\u05d5\u05e8\u05d0\u05d9]]{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=\u05de\u05e0\u05d9\u05d1}}.\n\n\u05d1-[[2002]] \u05d4\u05d9\u05d4 \u05d1\u05d9\u05df \u05de\u05d9\u05d9\u05e1\u05d3\u05d9 \u05d4[[\u05de\u05d0\u05d7\u05d6]] [[\u05e9\u05d3\u05d4 \u05d1\u05d5\u05e2\u05d6]]{{\u05d4\u05e2\u05e8\u05d4|{{nrg|\u05e2\u05de\u05e8\u05d9 \u05de\u05e0\u05d9\u05d1|\u05de\u05d9 \u05d0\u05ea\u05d4 \u05d0\u05e8\u05d6 \u05ea\u05d3\u05de\u05d5\u05e8?|067/985|24 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2010|54|2}}|\u05e9\u05dd=\u05de\u05e0\u05d9\u05d1}}.\n\n\u05ea\u05d3\u05de\u05d5\u05e8 \u05e2\u05d1\u05d3 \u05db[[\u05db\u05ea\u05d1]] \u05d1\"\u05d9\u05d3\u05d9\u05e2\u05d5\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd\" (2003\u20132004), \u05d1[[\u05de\u05e7\u05d5\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df]] (2004\u20132006) \u05d5\u05d1\u05d4\u05de\u05e9\u05da \u05d2\u05dd \u05d1\u05d0\u05ea\u05e8 [[nrg]]. \u05dc\u05de\u05d3 \u05d4\u05d7\u05dc \u05de-[[2006]] \u05dc[[\u05d1\u05d5\u05d2\u05e8 \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4|\u05ea\u05d5\u05d0\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df]] \u05d1[[\u05de\u05d3\u05e2 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4]] \u05d1[[\u05d4\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05d4 \u05d4\u05e2\u05d1\u05e8\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]], \u05e1\u05d9\u05d9\u05dd \u05db\u05d1\u05d5\u05d2\u05e8 \u05d1\u05de\u05d3\u05e2 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05d5\u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9\u05dd \u05d4\u05e8\u05d1 \u05ea\u05d7\u05d5\u05de\u05d9\u05ea \u05d1[[\u05de\u05d3\u05e2\u05d9 \u05d4\u05e8\u05d5\u05d7]] (BA \u05db\u05dc\u05dc\u05d9). \u05d4\u05de\u05e9\u05d9\u05da \u05d0\u05d7\u05e8 \u05db\u05da \u05dc[[\u05ea\u05d5\u05d0\u05e8 \u05e9\u05e0\u05d9]] \u05d1\u05de\u05d3\u05e2 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05d1[[\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05d1\u05e8-\u05d0\u05d9\u05dc\u05df]]. \u05d1-2006 \u05e9\u05d9\u05de\u05e9 \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05db\u05d9\u05e8 \u05d1\u05de\u05d8\u05d4 \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05e9\u05dc [[\u05d4\u05dc\u05d9\u05db\u05d5\u05d3]] \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd. \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 [[2007]] \u05d4\u05e7\u05d9\u05dd \u05e2\u05dd [[\u05e8\u05d5\u05e0\u05df \u05e9\u05d5\u05d1\u05dc]] \u05d0\u05ea \u05ea\u05e0\u05d5\u05e2\u05ea \"[[\u05d0\u05dd \u05ea\u05e8\u05e6\u05d5]]\". \u05d1\u05d9\u05d5\u05e0\u05d9 [[2012]] \u05e4\u05e8\u05e9 \u05de\u05d4\u05ea\u05e0\u05d5\u05e2\u05d4. \u05d6\u05de\u05df \u05e7\u05e6\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05d4\u05e6\u05d8\u05e8\u05e3 \u05dc[[\u05de\u05d9\u05d3\u05d4 (\u05d0\u05ea\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8)|\u05d0\u05ea\u05e8 \u05de\u05d9\u05d3\u05d4]], \u05d5\u05d1\u05e1\u05d5\u05e3 2012 \u05db\u05d9\u05d4\u05df \u05d1\u05de\u05e9\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05e7\u05e6\u05e8\u05d4 \u05db\u05e2\u05d5\u05e8\u05da \u05d1\u05d0\u05ea\u05e8 [[nrg \u05de\u05e2\u05e8\u05d9\u05d1]]{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05e2\u05d9\u05df \u05d4\u05e9\u05d1\u05d9\u05e2\u05d9\u05ea|\u05d0\u05d5\u05e8\u05df \u05e4\u05e8\u05e1\u05d9\u05e7\u05d5|\u05d0\u05d9\u05df \u05d6\u05d5 \u05d0\u05d2\u05d3\u05d4|30341|27 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2012}}}}. \u05d1\u05de\u05d0\u05d9 2011 \u05d4\u05d5\u05e6\u05d9\u05d0\u05d4 \"\u05d0\u05dd \u05ea\u05e8\u05e6\u05d5\" \u05e1\u05e4\u05e8\u05d5\u05df \u05d1\u05df 73 \u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05d1\u05e9\u05dd \"\u05e0\u05db\u05d1\u05d4 \u05d7\u05e8\u05d8\u05d0\", \u05e9\u05db\u05ea\u05d1\u05d5 \u05d1\u05de\u05e9\u05d5\u05ea\u05e3 \u05ea\u05d3\u05de\u05d5\u05e8 \u05d5[[\u05d0\u05e8\u05d0\u05dc \u05e1\u05d2\"\u05dc]]{{\u05d4\u05e2\u05e8\u05d4|{{\u05e6-\u05e1\u05e4\u05e8|\u05de\u05d7\u05d1\u05e8=\u05d0\u05e8\u05d6 \u05ea\u05d3\u05de\u05d5\u05e8 \u05d5\u05d0\u05e8\u05d0\u05dc \u05e1\u05d2\"\u05dc|\u05e9\u05dd=\u05e0\u05db\u05d1\u05d4? \u05d7\u05e8\u05d8\u05d0|\u05de\u05d5\"\u05dc=\u05d4\u05d5\u05e6\u05d0\u05ea \u05d0\u05dd \u05ea\u05e8\u05e6\u05d5|\u05e9\u05e0\u05ea \u05d4\u05d5\u05e6\u05d0\u05d4=2011|\u05e7\u05d9\u05e9\u05d5\u05e8=https://imti.org.il/wp-content/uploads/2022/05/\u05e0\u05db\u05d1\u05d4-\u05d7\u05e8\u05d8\u05d0.pdf}}}}. \u05e2\u05dc \u05e4\u05d9 \u05d4\u05e4\u05e8\u05e1\u05d5\u05dd, [[\u05d4\u05e0\u05db\u05d1\u05d4]] \u05d4\u05d9\u05d0 \u05de\u05d9\u05ea\u05d5\u05e1 \u05e4\u05dc\u05e1\u05d8\u05d9\u05e0\u05d9 \u05e9\u05d4\u05d5\u05de\u05e6\u05d0 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05d5\u05da \u05d0\u05ea \u05d4\u05ea\u05d5\u05e7\u05e4\u05df \u05dc\u05e7\u05d5\u05e8\u05d1\u05df{{\u05d4\u05e2\u05e8\u05d4|{{\u05db\u05d9\u05e4\u05d4|\u05d0\u05d5\u05e8\u05d9 \u05e4\u05d5\u05dc\u05e7|\u05e0\u05db\u05d1\u05d4? \u05d7\u05e8\u05d8\u05d0|\u05d7\u05d3\u05e9\u05d5\u05ea/\u05e0\u05db\u05d1\u05d4-\u05d7\u05e8\u05d8\u05d0|31 \u05d1\u05de\u05d0\u05d9 2018}}}}.\n\n\u05d0\u05ea \u05d4\u05e1\u05e4\u05e8 \"[[\u05de\u05d3\u05d5\u05e2 \u05d0\u05ea\u05d4 \u05de\u05e6\u05d1\u05d9\u05e2 \u05d9\u05de\u05d9\u05df \u05d5\u05de\u05e7\u05d1\u05dc \u05e9\u05de\u05d0\u05dc?]]\" \u05d4\u05d7\u05dc \u05ea\u05d3\u05de\u05d5\u05e8 \u05dc\u05db\u05ea\u05d5\u05d1 \u05d1-[[2014]], \u05db\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05e1\u05d9\u05d5\u05dd \u05d1\u05e1\u05de\u05d9\u05e0\u05e8 \"[[\u05e7\u05e8\u05df \u05ea\u05e7\u05d5\u05d5\u05d4]]\" \u05e9\u05d4\u05e9\u05ea\u05ea\u05e3 \u05d1\u05d5 \u05d1[[\u05e0\u05d9\u05d5 \u05d9\u05d5\u05e8\u05e7]]. \u05d1-2017 \u05e8\u05d0\u05d4 \u05d4\u05e1\u05e4\u05e8 \u05d0\u05d5\u05e8{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05d9\u05d3\u05d4|\u05db\u05d5\u05ea\u05d1=[[\u05d0\u05de\u05e0\u05d5\u05df \u05dc\u05d5\u05e8\u05d3]]|\u05de\u05e1\u05e4\u05e8 \u05db\u05ea\u05d1\u05d4=52726|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d4\u05e9\u05de\u05d0\u05dc \u05de\u05de\u05e9\u05d9\u05da \u05dc\u05e9\u05dc\u05d5\u05d8, \u05d5\u05d6\u05d5 \u05d0\u05e9\u05de\u05ea \u05d4\u05d9\u05de\u05d9\u05df|\u05ea\u05d0\u05e8\u05d9\u05da=18 \u05d1\u05de\u05e8\u05e5 2017}}}}. \u05e2\u05dc \u05e4\u05d9 \u05de\u05d0\u05de\u05e8 \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05e9\u05db\u05ea\u05d1 \u05e2\u05dc \u05d4\u05e1\u05e4\u05e8 [[\u05d9\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e4\u05e0\u05d4\u05d9\u05d9\u05de\u05e8]], \"\u05de\u05e8\u05d1\u05d9\u05ea\u05d5 \u05db\u05db\u05d5\u05dc\u05d5 \u05e9\u05dc \u05d4\u05e1\u05e4\u05e8 \u05de\u05d5\u05e7\u05d3\u05e9 \u05dc\u05e0\u05d9\u05ea\u05d5\u05d7 \u05de\u05e2\u05de\u05d9\u05e7 \u05d5\u05e7\u05d5\u05dc\u05d7 \u05e9\u05dc \"\u05d4\u05d0\u05dc\u05d9\u05d8\u05d5\u05ea \u05d4\u05e9\u05de\u05d0\u05dc\u05e0\u05d9\u05d5\u05ea\" \u05d5\u05d9\u05db\u05d5\u05dc\u05ea\u05df \u05dc\u05db\u05e4\u05d5\u05ea \u05db\u05d1\u05d9\u05db\u05d5\u05dc \u05e2\u05dc \u05d4\u05e8\u05d5\u05d1 \u05d0\u05ea \u05e2\u05de\u05d3\u05d5\u05ea\u05d9\u05d4\u05df\"{{\u05d4\u05e2\u05e8\u05d4|{{nrg|\u05d9\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e4\u05e0\u05d4\u05d9\u05d9\u05de\u05e8|\u05e9\u05de\u05d0\u05dc\u05e0\u05d9\u05dd \u05de\u05d9\u05d5\u05d0\u05e9\u05d9\u05dd? \u05d4\u05e1\u05e4\u05e8 \u05e9\u05dc \u05d0\u05e8\u05d6 \u05ea\u05d3\u05de\u05d5\u05e8 \u05e0\u05db\u05ea\u05d1 \u05e2\u05d1\u05d5\u05e8\u05db\u05dd|877/064|8 \u05d1\u05de\u05d0\u05d9 2017|1|2}}}}. \u05dc\u05e4\u05d9 \u05d4\u05e1\u05e4\u05e8, [[\u05de\u05e0\u05d7\u05dd \u05d1\u05d2\u05d9\u05df]] \u05dc\u05d0 \u05d7\u05d5\u05dc\u05dc [[\u05d4\u05de\u05d4\u05e4\u05da|\u05de\u05d4\u05e4\u05da]], \u05d0\u05dc\u05d0 \u05d4\u05e0\u05e6\u05d9\u05d7 \u05d0\u05ea \u05e9\u05dc\u05d9\u05d8\u05ea \u05d4\u05d0\u05dc\u05d9\u05d8\u05d5\u05ea \u05d1\u05d3\u05e8\u05d2\u05d9 \u05d4\u05de\u05e7\u05e6\u05d5\u05e2 \u05d5\u05d4\u05d9\u05d9\u05e2\u05d5\u05e5{{\u05d4\u05e2\u05e8\u05d4|{{nrg|[[\u05e2\u05de\u05d9\u05ea \u05e1\u05d2\u05dc]]|\u05d5\u05d4\u05e8\u05e9\u05d5\u05ea \u05e0\u05ea\u05d5\u05e0\u05d4: \u05de\u05d9\u05dc\u05d9\u05d0\u05e8\u05d3 \u05e9\u05e7\u05dc \u05e2\u05dc \u05d3\u05e8\u05de\u05d4 \u05de\u05d9\u05d5\u05ea\u05e8\u05ea|877/534|12 \u05d1\u05de\u05d0\u05d9 2017|1|2}}}}. \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc [[2016]] \u05d4\u05d7\u05dc\u05d9\u05e3 \u05d0\u05ea [[\u05d0\u05e8\u05d0\u05dc \u05e1\u05d2\"\u05dc]] \u05db\u05de\u05d2\u05d9\u05e9 \u05e8\u05e6\u05d5\u05e2\u05d4 \u05d9\u05d5\u05de\u05d9\u05ea \u05d1[[\u05e8\u05d3\u05d9\u05d5 \u05d2\u05dc\u05d9 \u05d9\u05e9\u05e8\u05d0\u05dc]]. \u05d4\u05d5\u05d0 \u05d1\u05e2\u05dc \u05d8\u05d5\u05e8 \u05d1\u05d0\u05ea\u05e8 [[nrg]], \u05d5\u05d1\u05d0\u05ea\u05e8 \"[[\u05de\u05d9\u05d3\u05d4 (\u05d0\u05ea\u05e8 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8)|\u05de\u05d9\u05d3\u05d4]]\".\n\n\u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05ea [[2019]], \u05d1\u05e2\u05d5\u05d3\u05d5 \u05de\u05db\u05d4\u05df \u05db[[\u05d3\u05d5\u05d1\u05e8 (\u05de\u05e7\u05e6\u05d5\u05e2)|\u05d3\u05d5\u05d1\u05e8]] \u05de\u05d8\u05d4 \u05d4\u05d4\u05e1\u05d1\u05e8\u05d4 \u05e9\u05dc [[\u05d4\u05dc\u05d9\u05db\u05d5\u05d3]], \u05e9\u05d5\u05dc\u05d1 \u05ea\u05d3\u05de\u05d5\u05e8 \u05db[[\u05e4\u05e8\u05e9\u05df (\u05e2\u05d9\u05ea\u05d5\u05e0\u05d5\u05ea)|\u05e4\u05e8\u05e9\u05df]] \u05e7\u05d1\u05d5\u05e2 \u05d1\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05d0\u05e7\u05d8\u05d5\u05d0\u05dc\u05d9\u05d4 \u05e9\u05dc [[\u05d0\u05d9\u05dc\u05d4 \u05d7\u05e1\u05d5\u05df]] \u05d1[[\u05e8\u05e9\u05ea 13]]. \u05ea\u05d3\u05de\u05d5\u05e8 \u05d4\u05d9\u05d4 \u05e7\u05de\u05e4\u05d9\u05d9\u05e0\u05e8 \u05dc\u05e7\u05e8\u05d0\u05ea [[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4\u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05d0\u05d7\u05ea]]{{\u05d4\u05e2\u05e8\u05d4|[https://twitter.com/tadmorerez48/status/1087782039401758720 \u05e6\u05d9\u05d5\u05e5 \u05e9\u05dc \u05d0\u05e8\u05d6 \u05ea\u05d3\u05de\u05d5\u05e8 \u05d1\u05d8\u05d5\u05d5\u05d9\u05d8\u05e8], 22 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2019}}, \u05d5\u05e8\u05d0\u05e9 \u05d4\u05de\u05e4\u05dc\u05d2\u05d4 [[\u05d1\u05e0\u05d9\u05de\u05d9\u05df \u05e0\u05ea\u05e0\u05d9\u05d4\u05d5]] \u05d4\u05e6\u05d9\u05d1\u05d5 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4-41 \u05d1\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05dc\u05db\u05e0\u05e1\u05ea. \u05dc\u05d0\u05d7\u05e8 \u05d4\u05ea\u05e4\u05d8\u05e8\u05d5\u05ea\u05d5 \u05e9\u05dc [[\u05e4\u05e0\u05d7\u05e1 \u05e2\u05d9\u05d3\u05df]] \u05de\u05d4\u05e8\u05e9\u05d9\u05de\u05d4, \u05ea\u05d3\u05de\u05d5\u05e8 \u05e7\u05d5\u05d3\u05dd \u05dc\u05de\u05e7\u05d5\u05dd \u05d4-40, \u05d0\u05da \u05dc\u05d0 \u05e0\u05d1\u05d7\u05e8 \u05dc\u05db\u05e0\u05e1\u05ea. \u05d1-2021 \u05d4\u05d7\u05dc \u05dc\u05d4\u05d2\u05d9\u05e9 \u05d0\u05ea \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05d7\u05d3\u05e9\u05d5\u05ea \"[[\u05d4\u05d0\u05d5\u05dc\u05e4\u05df \u05d4\u05e4\u05ea\u05d5\u05d7]]\" \u05d1\u05e2\u05e8\u05d5\u05e5 20, \u05d0\u05e9\u05e8 \u05dc\u05d9\u05de\u05d9\u05dd \u05d4\u05e4\u05da \u05dc\"[[\u05e2\u05db\u05e9\u05d9\u05d5 14]]\". \u05d1-12 \u05d1\u05d9\u05d5\u05dc\u05d9 [[2022]] \u05d4\u05d5\u05d3\u05d9\u05e2 \u05e2\u05dc \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d1\u05dc\u05d9\u05db\u05d5\u05d3 (2022)|\u05e4\u05e8\u05d9\u05d9\u05de\u05e8\u05d9\u05d6 \u05d1\u05de\u05e4\u05dc\u05d2\u05ea \u05d4\u05dc\u05d9\u05db\u05d5\u05d3]]{{\u05d4\u05e2\u05e8\u05d4|{{\u05e1\u05e8\u05d5\u05d2\u05d9\u05dd|\u05d2\u05d9\u05d0 \u05e2\u05d6\u05e8\u05d0|\u05d0\u05d9\u05e9 \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d4\u05d5\u05d3\u05d9\u05e2: \u05d0\u05ea\u05de\u05d5\u05d3\u05d3 \u05d1\u05e4\u05e8\u05d9\u05d9\u05de\u05e8\u05d9\u05d6 \u05d1\u05dc\u05d9\u05db\u05d5\u05d3|690410-\u05d0\u05d9\u05e9-\u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea-\u05d4\u05d5\u05d3\u05d9\u05e2-\u05d0\u05ea\u05de\u05d5\u05d3\u05d3-\u05d1\u05e4\u05e8\u05d9\u05d9\u05de\u05e8\u05d9\u05d6-\u05d1\u05dc|12 \u05d1\u05d9\u05d5\u05dc\u05d9 2022}}}}. \u05ea\u05d3\u05de\u05d5\u05e8 \u05d4\u05d2\u05d9\u05e2 \u05d1\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d0\u05dc\u05d5 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4-47, \u05d5\u05dc\u05d0 \u05e0\u05d1\u05d7\u05e8 \u05dc\u05db\u05e0\u05e1\u05ea.\n\n\u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 [[2026]] \u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d1\u05dc\u05d9\u05db\u05d5\u05d3 (2026)|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05dc\u05de\u05e4\u05dc\u05d2\u05ea \u05d4\u05dc\u05d9\u05db\u05d5\u05d3]] \u05db\u05e0\u05e6\u05d9\u05d2 \u05de\u05d7\u05d5\u05d6 \u05d9-\u05dd, \u05d9\u05d5\"\u05e9 \u05d5\u05e9\u05e4\u05dc\u05d4, \u05d5\u05e0\u05d1\u05d7\u05e8 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4-27 \u05dc\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05dc\u05db\u05e0\u05e1\u05ea \u05dc\u05e7\u05e8\u05d0\u05ea [[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4\u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05e9|\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4-26]]<ref name=\":0\">{{\u05e1\u05e8\u05d5\u05d2\u05d9\u05dd||\u05e8\u05d1 \u05d4\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05dc\u05d9\u05db\u05d5\u05d3 \u05d4\u05d5\u05db\u05e8\u05e2: \u05e0\u05ea\u05e0\u05d9\u05d4\u05d5 \u05d2\u05d1\u05e8 \u05e2\u05dc \u05d1\u05d9\u05d8\u05df \u05d1\u05de\u05d7\u05d5\u05d6\u05d5\u05ea|101008824-\u05e7\u05e8\u05d1-\u05d4\u05e9\u05dc\u05d9\u05d8\u05d4-\u05d1\u05dc\u05d9\u05db\u05d5\u05d3-\u05d4\u05d5\u05db\u05e8\u05e2-\u05e0\u05ea\u05e0\u05d9\u05d4\u05d5-\u05d2\u05d1\u05e8-\u05e2\u05dc|18 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2026}}</ref>.\n\n\u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2026 \u05e7\u05e8\u05d0 [[\u05d0\u05d5\u05e8\u05d9 \u05de\u05e9\u05d2\u05d1]] \u05dc\u05d4\u05d7\u05e8\u05d9\u05dd \u05d0\u05ea \u05e8\u05e9\u05ea\u05d5\u05ea [[\u05e6\u05d5\u05de\u05ea \u05e1\u05e4\u05e8\u05d9\u05dd]] \u05d5[[\u05e1\u05d8\u05d9\u05de\u05e6\u05e7\u05d9]], \u05d4\u05de\u05d5\u05db\u05e8\u05d5\u05ea \u05d0\u05ea \u05e1\u05e4\u05e8\u05d5 \u05e9\u05dc \u05ea\u05d3\u05de\u05d5\u05e8 \"[[\u05de\u05e8\u05d3 \u05d4\u05d2\u05e0\u05e8\u05dc\u05d9\u05dd (\u05e1\u05e4\u05e8)|\u05de\u05e8\u05d3 \u05d4\u05d2\u05e0\u05e8\u05dc\u05d9\u05dd]]\" \u05d1\u05d8\u05e2\u05e0\u05d4 \u05e9\u05dc\u05d0 \u05db\u05dc \u05e1\u05e4\u05e8 \u05e9\u05e0\u05d3\u05e4\u05e1 \u05e8\u05d0\u05d5\u05d9 \u05dc\u05de\u05db\u05d9\u05e8\u05d4, \u05d5\u05d4\u05e9\u05d5\u05d5\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05dc\"[[\u05de\u05d9\u05d9\u05df \u05e7\u05d0\u05de\u05e4\u05e3]]\".<ref>{{\u05e4\u05d5\u05e1\u05d8 \u05e4\u05d9\u05d9\u05e1\u05d1\u05d5\u05e7|nhavip123|Uri Misgav3{{\u05db}}|pfbid0aCSH6N7FUnEnXEnjuyc7DmECLjRc5H8syCF5JbTdbZ9aFqMbofbGRWk7ZXiurcdZl||\u05e4\u05d5\u05e1\u05d8|22 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2026}}</ref> \u05dc\u05d3\u05d1\u05e8\