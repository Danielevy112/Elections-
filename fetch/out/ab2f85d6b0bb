) \u05d0\u05d5\u05d7\u05e0\u05d4''' (\u05e0\u05d5\u05dc\u05d3 \u05d1-[[27 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc]] [[1966]]) \u05d4\u05d5\u05d0 [[\u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05e7\u05d0\u05d9]] [[\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9]] \u05e9\u05db\u05d9\u05d4\u05df \u05db[[\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8\u05d9\u05d9\u05d4|\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8\u05d9\u05d9\u05ea]] [[\u05e6\u05e4\u05ea]].\n\n== \u05d1\u05d9\u05d5\u05d2\u05e8\u05e4\u05d9\u05d4 ==\n{{\u05dc\u05e9\u05db\u05ea\u05d1|\u05e0\u05d5\u05e9\u05d0=\u05d0\u05d9\u05e9\u05d9\u05dd}}\n\u05e0\u05d5\u05dc\u05d3 \u05d5\u05d2\u05d3\u05dc \u05d1\u05e6\u05e4\u05ea. \u05d1\u05df \u05dc\u05de\u05e9\u05e4\u05d7\u05d4 \u05e9\u05d5\u05e8\u05e9\u05d9\u05ea \u05de\u05e6\u05e4\u05ea \u05db\u05e2\u05e9\u05e8\u05d4 \u05d3\u05d5\u05e8\u05d5\u05ea \u05d5\u05de\u05e6\u05d3 \u05d0\u05d9\u05de\u05d5 \u05de\u05e9\u05e4\u05d7\u05ea \u05e4\u05d9\u05e9\u05e8 \u05e9\u05e2\u05dc\u05d5 \u05dc\u05d0\u05d7\u05e8 \u05de\u05dc\u05d7\u05de\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4 \u05de\u05d0\u05d9\u05e8\u05d5\u05e4\u05d4.\n\n\u05e0\u05e7\u05e8\u05d0 \u05e2\u05dc \u05e9\u05dd \u05d3\u05d5\u05d3\u05d5 {{\u05d9\u05d6\u05db\u05d5\u05e8|en_adacd92f9feec25e749d1b02601b28b7|\u05d9\u05d4\u05d5\u05e9\u05e2 \u05e4\u05e8'\u05d2 \u05d0\u05d5\u05d7\u05e0\u05d4}}, \u05d0\u05e9\u05e8 \u05e0\u05d4\u05e8\u05d2 \u05d1-1948 \u05d1[[\u05d4\u05e7\u05e8\u05d1_\u05e2\u05dc_\u05e6\u05e4\u05ea#\u05ea\u05e7\u05d9\u05e4\u05d5\u05ea_\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea_\u05e2\u05e8\u05d1\u05d9\u05d5\u05ea|\u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d9\u05d4\u05d5\u05d3\u05d9 \u05e6\u05e4\u05ea]] \u05d1[[\u05de\u05dc\u05d7\u05de\u05ea \u05d4\u05e9\u05d7\u05e8\u05d5\u05e8]], \u05d1\u05e2\u05de\u05d3\u05d4 \u05d1\u05d9\u05df \u05d4\u05e8\u05d5\u05d1\u05e2 \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9 \u05dc\u05e8\u05d5\u05d1\u05e2 \u05d4\u05e2\u05e8\u05d1\u05d9, \u05de\u05db\u05d3\u05d5\u05e8 \u05e9\u05dc [[\u05e6\u05dc\u05e3 (\u05d9\u05e8\u05d9)|\u05e6\u05dc\u05e3]] \u05e2\u05e8\u05d1\u05d9 \u05d1\u05de\u05e6\u05d7\u05d5.\n\n[[\u05d2\u05d9\u05d5\u05e1 \u05dc\u05e6\u05d4\"\u05dc|\u05d4\u05ea\u05d2\u05d9\u05d9\u05e1 \u05dc\u05e6\u05d4\"\u05dc]] \u05d1\u05e9\u05e0\u05ea 1984. \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05d9\u05e8\u05d5\u05ea\u05d5 \u05d1\u05e6\u05d4\"\u05dc \u05de\u05d9\u05dc\u05d0 \u05e9\u05d5\u05e8\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9 \u05e4\u05d9\u05e7\u05d5\u05d3 \u05d5\u05de\u05d8\u05d4, \u05d5\u05d1\u05d4\u05dd \u05de\u05e4\u05e7\u05d3 \u05e4\u05dc\u05d5\u05d2\u05d4 \u05d1\u05d2\u05d3\u05d5\u05d3 77 \u05e9\u05dc [[\u05d7\u05d8\u05d9\u05d1\u05d4 7]], \u05e7\u05e6\u05d9\u05df \u05de\u05d8\u05d4 \u05d1\u05d7\u05d8\u05d9\u05d1\u05d4, \u05e7\u05e6\u05d9\u05df \u05dc\u05d5\u05d2\u05d9\u05e1\u05d8\u05d9\u05e7\u05d4 \u05d1[[\u05e2\u05d5\u05e6\u05d1\u05ea \u05d2\u05e2\u05e9]] (\u05d0\u05d5\u05d2\u05d3\u05d4 36), \u05e7\u05e6\u05d9\u05df \u05dc\u05d5\u05d2\u05d9\u05e1\u05d8\u05d9\u05e7\u05d4 \u05d1\u05d0\u05d5\u05d2\u05d3\u05d4 366, \u05e8\u05d0\u05e9 \u05e2\u05e0\u05e3 \u05d0\u05e8\u05d2\u05d5\u05df \u05d5\u05ea\u05d5\u05e8\u05ea \u05dc\u05d7\u05d9\u05de\u05d4 \u05d1[[\u05d7\u05d9\u05dc \u05d4\u05dc\u05d5\u05d2\u05d9\u05e1\u05d8\u05d9\u05e7\u05d4]] \u05d5\u05e7\u05e6\u05d9\u05df \u05de\u05d8\u05d4 \u05d1[[\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d4\u05e6\u05e4\u05d5\u05df]]. \u05d1\u05e9\u05e0\u05ea 2007 \u05d4\u05e9\u05ea\u05d7\u05e8\u05e8 \u05de\u05e6\u05d4\"\u05dc \u05d1\u05d3\u05e8\u05d2\u05ea [[\u05d3\u05e8\u05d2\u05d5\u05ea \u05e6\u05d4\"\u05dc#\u05e1\u05d2\u05df-\u05d0\u05dc\u05d5\u05e3|\u05e1\u05d2\u05df-\u05d0\u05dc\u05d5\u05e3]].\n\n\u05d1\u05d5\u05d2\u05e8 \u05e7\u05d5\u05e8\u05e1 \u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05dd \u05d5\u05e0\u05d5\u05e9\u05d0\u05d9 \u05de\u05e9\u05e8\u05d4 \u05d1\u05db\u05d9\u05e8\u05d9\u05dd \u05d1\u05ea\u05d0\u05d2\u05d9\u05d3\u05d9\u05dd \u05d1[[\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1]]. \u05d1\u05d5\u05d2\u05e8 \u05d4\u05de\u05db\u05dc\u05dc\u05d5\u05ea \u05dc[[\u05d1\u05d9\u05d8\u05d7\u05d5\u05df \u05dc\u05d0\u05d5\u05de\u05d9]] (\u05e4\u05d9\u05e7\u05d5\u05d3 \u05d5\u05de\u05d8\u05d4) \u2013 \u05de\u05d2\u05de\u05ea \u05de\u05d3\u05e2\u05d9 \u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05d5\u05d1\u05d5\u05d2\u05e8 \u05ea\u05d5\u05d0\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05de\u05e9\u05e4\u05d8\u05d9\u05dd, \u05d1\u05e2\u05dc [[\u05ea\u05d5\u05d0\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df]] \u05d1[[\u05de\u05e0\u05d4\u05dc \u05e2\u05e1\u05e7\u05d9\u05dd]] \u05d5[[\u05ea\u05d5\u05d0\u05e8 \u05e9\u05e0\u05d9]] \u05d1\u05de\u05e0\u05d4\u05dc \u05d7\u05d9\u05e0\u05d5\u05db\u05d9.\n\n\u05d1\u05d9\u05df \u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05d5\n* \u05de\u05ea\u05d0\u05dd \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d2\u05d5\u05e4\u05d9 \u05d4\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d1[[\u05de\u05e9\u05e8\u05d3 \u05e8\u05d0\u05e9 \u05d4\u05de\u05de\u05e9\u05dc\u05d4]] [[\u05de\u05d7\u05d5\u05d6 \u05d4\u05e6\u05e4\u05d5\u05df|\u05d1\u05e6\u05e4\u05d5\u05df]]\n* \u05d9\u05d5\"\u05e8 \u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df \u05ea\u05d0\u05d2\u05d9\u05d3 \u05e4\u05dc\u05d2 \u05d4\u05d2\u05dc\u05d9\u05dc\n* \u05d9\u05d5\"\u05e8 \u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df \u05e4\u05d0\u05e8\u05e7 \u05e6\u05d7\"\u05e8\n* \u05d9\u05d5\"\u05e8 \u05d4\u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df \u05d4\u05d7\u05d1\u05e8\u05d4 \u05dc\u05e4\u05d9\u05ea\u05d5\u05d7 \u05e6\u05e4\u05ea\n* \u05d9\u05d5\"\u05e8 \u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df \u05d4\u05de\u05db\u05dc\u05dc\u05d4 \u05d4\u05d9\u05de\u05d9\u05ea \u05d0\u05e9\u05d3\u05d5\u05d3\n* \u05d9\u05d5\u05e8 \u05d4\u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df \u05de\u05e2\u05e8\u05da \u05d4\u05d7\u05d9\u05e0\u05d5\u05da \u05d0\u05de\u05d9\u05ea \u05d5\u05e2\u05de\u05dc \u05e6\u05e4\u05ea\n* \u05d7\u05d1\u05e8 \u05d3\u05e8\u05d9\u05e7\u05d8\u05e8\u05d9\u05d5\u05df \u05d7\u05d1\u05e8\u05d4 \u05dc\u05de\u05e9\u05e7 \u05d5\u05db\u05dc\u05db\u05dc\u05d4\n* \u05d7\u05d1\u05e8 \u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df \u05dc\u05dc\"\u05df\n* \u05d7\u05d1\u05e8 \u05d3\u05e8\u05d9\u05e7\u05d8\u05e8\u05d9\u05d5\u05df \u05de\u05db\u05dc\u05dc\u05ea \u05e6\u05e4\u05ea\n* \u05de\u05e0\u05d4\u05dc \u05db\u05dc\u05dc\u05d9 \u05d1\u05e8\u05e9\u05ea \u05dc\u05d0\u05d5\u05db\u05dc\u05e1\u05d9\u05d4 \u05dc\u05e6\u05e8\u05db\u05d9\u05dd \u05de\u05d9\u05d5\u05d7\u05d3\u05d9\u05dd\n* \u05de\u05e0\u05db\"\u05dc \u05e4\u05d2\u05e1\u05d5\u05e1 \u05e2\u05d9\u05dc\u05d9\u05ea\n* \u05d9\u05d5\"\u05e8 \u05d5\u05e2\u05d3\u05ea \u05ea\u05db\u05e0\u05d5\u05df \u05d5\u05d1\u05e0\u05d9\u05d4, \u05db\u05e1\u05e4\u05d9\u05dd \u05d5\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d1\u05e8\u05e9\u05d5\u05ea.\n* \u05d7\u05d1\u05e8 \u05d4\u05e0\u05d4\u05dc\u05ea \u05de\u05d6\u05db\u05d9\u05e8\u05d5\u05ea [[\u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05d4\u05e2\u05d5\u05dc\u05de\u05d9]]\n* \u05d9\u05d5\"\u05e8 \u05e1\u05e0\u05d9\u05e3 \u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05d1\u05e6\u05e4\u05ea\n\n\u05d1\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc[[\u05d4\u05db\u05e0\u05e1\u05ea \u05d4-19|\u05db\u05e0\u05e1\u05ea \u05d4-19]] \u05d4\u05d9\u05d4 \u05de\u05d5\u05e2\u05de\u05d3 \u05ea\u05e0\u05d5\u05e2\u05ea [[\u05d4\u05dc\u05d9\u05db\u05d5\u05d3]] \u05db\u05e0\u05e6\u05d9\u05d2 \u05de\u05d7\u05d5\u05d6 \u05d4\u05d2\u05dc\u05d9\u05dc \u05d5\u05d4\u05e2\u05de\u05e7\u05d9\u05dd. \u05d1\u05e9\u05e0\u05ea [[2008]] \u05e0\u05d1\u05d7\u05e8 \u05dc\u05e8\u05d0\u05e9\u05d5\u05e0\u05d4 \u05db\u05d7\u05d1\u05e8 \u05de\u05d5\u05e2\u05e6\u05ea \u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05e6\u05e4\u05ea. \u05e9\u05d9\u05de\u05e9 \u05db\u05d7\u05d1\u05e8 \u05d5\u05e2\u05d3\u05ea \u05db\u05e1\u05e4\u05d9\u05dd \u05d5\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea.\n\n\u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc (2018)|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea \u05e9\u05e0\u05e2\u05e8\u05db\u05d5 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2018]] \u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05d1\u05e9\u05dc\u05d9\u05e9\u05d9\u05ea \u05e2\u05dc \u05e8\u05d0\u05e9\u05d5\u05ea \u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05e6\u05e4\u05ea \u05d5\u05e0\u05d9\u05e6\u05d7 \u05d1\u05e8\u05d5\u05d1 \u05e9\u05dc 62% \u05d1\u05e1\u05d9\u05d1\u05d5\u05d1 \u05e9\u05e0\u05d9.\n\n\u05d1\u05de\u05d4\u05dc\u05da \u05db\u05d4\u05d5\u05e0\u05ea\u05d5 \u05d6\u05db\u05ea\u05d4 \u05e6\u05e4\u05ea \u05d1\u05e6\u05d9\u05d5\u05df \u05e9\u05dc \"\u05d7\u05de\u05d9\u05e9\u05d4 \u05db\u05d5\u05db\u05d1\u05d9 \u05d9\u05d5\u05e4\u05d9\", \u05de\u05d8\u05e2\u05dd [[\u05d4\u05de\u05d5\u05e2\u05e6\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05d9\u05e4\u05d4]], \u05d0\u05e8\u05d1\u05e2 \u05e4\u05e2\u05de\u05d9\u05dd \u05d1\u05e8\u05e6\u05d9\u05e4\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05e9\u05e0\u05d9\u05dd 2019\u20132022 \u05d5\u05d1\u05e9\u05e0\u05ea 2021 \u05de\u05d5\u05e2\u05de\u05d3\u05ea \u05dc\u05ea\u05d7\u05e8\u05d5\u05ea \u05d3\u05d2\u05dc \u05d4\u05d9\u05d5\u05e4\u05d9.\n\n\u05d1\u05e9\u05e0\u05ea 2022 \u05d1\u05d4\u05d9\u05d5\u05ea\u05d5 \u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8 \u05d6\u05db\u05ea\u05d4 \u05e6\u05e4\u05ea \u05d1\u05e4\u05e8\u05e1 \u05d7\u05d9\u05e0\u05d5\u05da \u05de\u05d7\u05d5\u05d6\u05d9/\u05d0\u05e8\u05e6\u05d9.\n\n\u05d1\u05ea\u05e7\u05d5\u05e4\u05ea \u05db\u05d4\u05d5\u05e0\u05ea\u05d5 \u05e7\u05d5\u05d3\u05de\u05d5 \u05d1\u05e6\u05e4\u05ea \u05de\u05d9\u05d6\u05de\u05d9\u05dd \u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da, \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea, \u05d4\u05ea\u05e9\u05ea\u05d9\u05d5\u05ea \u05d5\u05d4\u05e1\u05e4\u05d5\u05e8\u05d8. \u05d1\u05ea\u05d7\u05d5\u05dd \u05d4\u05d7\u05d9\u05e0\u05d5\u05da \u05d4\u05d5\u05e7\u05dd \u05de\u05e8\u05db\u05d6 \u05dc\u05d7\u05d3\u05e9\u05e0\u05d5\u05ea, \u05d9\u05d6\u05de\u05d5\u05ea, \u05e7\u05d9\u05d9\u05de\u05d5\u05ea, \u05d7\u05dc\u05dc \u05d5\u05e8\u05d5\u05d1\u05d5\u05d8\u05d9\u05e7\u05d4, \u05dc\u05e6\u05d3 \u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \u05dc\u05e2\u05d9\u05d3\u05d5\u05d3 \u05de\u05e6\u05d5\u05d9\u05e0\u05d5\u05ea \u05d5\u05d2\u05d9\u05d5\u05e1 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9.\n\n\u05d1\u05ea\u05d7\u05d5\u05dd \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05e0\u05d5\u05e1\u05d3\u05d5 \u05e4\u05e1\u05d8\u05d9\u05d1\u05dc \u05d4\u05dc\u05d3\u05d9\u05e0\u05d5 \u05d5\u05e4\u05e1\u05d8\u05d9\u05d1\u05dc \u05d4\u05e1\u05dc\u05d9\u05d7\u05d5\u05ea \u05d5\u05d4\u05e4\u05d9\u05d5\u05d8\u05d9\u05dd, \u05d5\u05d4\u05d5\u05e8\u05d7\u05d1\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05d1\u05e2\u05d9\u05e8. \u05d1\u05de\u05e1\u05d2\u05e8\u05ea [[\u05e4\u05e1\u05d8\u05d9\u05d1\u05dc \u05d4\u05db\u05dc\u05d9\u05d6\u05de\u05e8\u05d9\u05dd \u05d4\u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9 \u05d1\u05e6\u05e4\u05ea|\u05e4\u05e1\u05d8\u05d9\u05d1\u05dc \u05d4\u05db\u05dc\u05d9\u05d6\u05de\u05e8\u05d9\u05dd]] \u05d4\u05d5\u05e8\u05d7\u05d1 \u05d4\u05d9\u05e7\u05e3 \u05d4\u05de\u05d5\u05e4\u05e2\u05d9\u05dd.\n\n\u05d1\u05ea\u05d7\u05d5\u05dd \u05d4\u05ea\u05e9\u05ea\u05d9\u05d5\u05ea \u05d1\u05d5\u05e6\u05e2\u05d5 \u05e2\u05d1\u05d5\u05d3\u05d5\u05ea \u05dc\u05e4\u05d9\u05ea\u05d5\u05d7 \u05d4\u05e2\u05d9\u05e8, \u05d5\u05d1\u05d4\u05df \u05e1\u05dc\u05d9\u05dc\u05ea \u05db\u05d1\u05d9\u05e9\u05d9\u05dd, \u05e4\u05ea\u05d9\u05d7\u05ea \u05e6\u05d9\u05e8\u05d9 \u05ea\u05e0\u05d5\u05e2\u05d4, \u05d4\u05e7\u05de\u05ea \u05de\u05e2\u05d2\u05dc\u05d9 \u05ea\u05e0\u05d5\u05e2\u05d4 \u05d5\u05e8\u05de\u05d6\u05d5\u05e8\u05d9\u05dd \u05d5\u05e4\u05d9\u05ea\u05d5\u05d7 \u05e9\u05db\u05d5\u05e0\u05d5\u05ea \u05d5\u05ea\u05d9\u05e7\u05d5\u05ea. \u05d1\u05e0\u05d5\u05e1\u05e3 \u05d4\u05d5\u05e7\u05de\u05d5 \u05e4\u05d0\u05e8\u05e7\u05d9\u05dd \u05d5\u05d2\u05e0\u05d9 \u05de\u05e9\u05d7\u05e7\u05d9\u05dd \u05d1\u05e8\u05d7\u05d1\u05d9 \u05d4\u05e2\u05d9\u05e8.\n\n\u05d1\u05e9\u05e0\u05d9\u05dd 2022\u20132023 \u05d0\u05d5\u05e9\u05e8\u05d5 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05e1\u05db\u05dd \u05d2\u05d2 \u05ea\u05d5\u05db\u05e0\u05d9\u05d5\u05ea \u05dc\u05d4\u05e7\u05de\u05ea \u05db\u05be5,000 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d3\u05d9\u05d5\u05e8 \u05d1\u05e6\u05e4\u05d5\u05df \u05d4\u05e2\u05d9\u05e8.\n\n\u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc (2024)|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea 2024]] \u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05dc\u05db\u05d4\u05d5\u05e0\u05d4 \u05e0\u05d5\u05e1\u05e4\u05ea, \u05d0\u05d5\u05dc\u05dd \u05d4\u05e4\u05e1\u05d9\u05d3 \u05dc[[\u05d9\u05d5\u05e1\u05d9 \u05e7\u05e7\u05d5\u05df]] \u05db\u05e9\u05e7\u05d9\u05d1\u05dc 45% \u05de\u05d4\u05e7\u05d5\u05dc\u05d5\u05ea \u05dc\u05e2\u05d5\u05de\u05ea \u05e7\u05e7\u05d5\u05df \u05e9\u05e7\u05d9\u05d1\u05dc 52.2% \u05de\u05d4\u05e7\u05d5\u05dc\u05d5\u05ea.\n\n\u05d0\u05d5\u05d7\u05e0\u05d4 \u05e0\u05d1\u05d7\u05e8 \u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d1\u05dc\u05d9\u05db\u05d5\u05d3 (2026)|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d1\u05dc\u05d9\u05db\u05d5\u05d3]] \u05dc\u05e7\u05e8\u05d0\u05ea [[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4\u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05e9\u05e9]] \u05dc\u05de\u05d7\u05d5\u05d6 \u05d4\u05d2\u05dc\u05d9\u05dc \u05d5\u05d4\u05e2\u05de\u05e7\u05d9\u05dd. \u05d4\u05d5\u05e6\u05d1 \u05d1\u05de\u05e7\u05d5\u05dd 31 \u05d1\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05de\u05e4\u05dc\u05d2\u05d4 \u05dc\u05db\u05e0\u05e1\u05ea.{{\u05d4\u05e2\u05e8\u05d4|{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05d5\u05ea\u05e8\u05ea=\u05de\u05d9 \u05e9\u05dc\u05d0 \u05e8\u05e6\u05d4 \u05d0\u05ea \u05e9\u05d5\u05e7\u05d9 \u05d0\u05d5\u05d7\u05e0\u05d4 \u05db\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8 - \u05e2\u05e9\u05d5\u05d9 \u05dc\u05e7\u05d1\u05dc \u05d0\u05d5\u05ea\u05d5 \u05db\u05d7\u05d1\u05e8 \u05db\u05e0\u05e1\u05ea|\u05d0\u05ea\u05e8=\u05d7\u05d3\u05e9 \u05d1\u05d2\u05dc\u05d9\u05dc|\u05ea\u05d0\u05e8\u05d9\u05da=2026-08-18|\u05db\u05ea\u05d5\u05d1\u05ea=https://g-news.co.il/\u05de\u05d9-\u05e9\u05dc\u05d0-\u05e8\u05e6\u05d4-\u05d0\u05ea-\u05e9\u05d5\u05e7\u05d9-\u05d0\u05d5\u05d7\u05e0\u05d4-\u05db\u05e8\u05d0\u05e9-\u05e2\u05d9\u05e8-\u05d9\u05e7\u05d1\u05dc-\u05d0/|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2026-09-23|\u05d4\u05db\u05d5\u05ea\u05d1=\u05de\u05d0\u05d9\u05e8 \u05d9\u05e0\u05e7\u05d5}}}}\n\n== \u05d7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd ==\n\u05e0\u05e9\u05d5\u05d9 \u05dc\u05d3\u05d5\u05e8\u05d9\u05ea, \u05e2\u05d5\u05e8\u05db\u05ea \u05d3\u05d9\u05df \u05d1\u05de\u05e7\u05e6\u05d5\u05e2\u05d4, \u05d5\u05d0\u05d1 \u05dc\u05e9\u05dc\u05d5\u05e9\u05d4 \u05d1\u05e0\u05d9\u05dd.{{\u05d4\u05e2\u05e8\u05d4|{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://likudnik.co.il/\u05e2\u05d5\u05d3-\u05d3\u05d5\u05e8\u05d9\u05ea-\u05d0\u05d5\u05d7\u05e0\u05d4-\u05de\u05e6\u05e4\u05ea-\u05dc\u05db\u05e0\u05e1\u05ea-\u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05e2\u05d5\"\u05d3 \u05d3\u05d5\u05e8\u05d9\u05ea \u05d0\u05d5\u05d7\u05e0\u05d4: \u05de\u05e6\u05e4\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05d0\u05ea\u05e8=\u05dc\u05d9\u05db\u05d5\u05d3\u05e0\u05d9\u05e7|\u05ea\u05d0\u05e8\u05d9\u05da=14 \u05d1\u05d9\u05d5\u