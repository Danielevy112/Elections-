    <script type="text/javascript">

        var lang = 'he';
        function initCombo(id, defVal, defId) {
            const input = document.getElementById(id);
            const hiddenInput = document.getElementById(id + 'Id');
            const listbox = document.getElementById('select' + id);

            if (!input || !hiddenInput || !listbox) return;

            if (defVal) input.value = defVal;
            if (defId) hiddenInput.value = defId;

            // נשמור הפניה לכל האפשרויות
            const items = Array.from(listbox.querySelectorAll('li'));

            // לולאה על כל האפשרויות – נצרף את הפונקציה
            items.forEach(item => {
                item.setAttribute('tabindex', '0');

                const handleSelection = () => {
                    input.value = item.textContent;
                    hiddenInput.value = item.getAttribute('data-value');
                        if (id === "Town") {
                        const townId = hiddenInput.value;
                        window.location = 'ballotresults?cityID=' + encodeURIComponent(townId) + '&lang=' + lang;
                }

                 if (id === "PollingStation") {
                     const ballotNumber = hiddenInput.value;
                     const townId = document.getElementById("TownId").value;

                     if (townId && ballotNumber) {
                         window.location = 'ballotresults?cityID=' + encodeURIComponent(townId) +
                             '&BallotNumber=' + encodeURIComponent(ballotNumber) +
                             '&lang=' + lang;
                     }
                 }
                   // showResults();
                };

                // נשמור את הפונקציה על האובייקט לצורך שימוש חוזר (באנטר)
                item._handleSelection = handleSelection;

                item.addEventListener('click', handleSelection);
            });

            // לחיצה על אנטר/רווח בקלט תבחר את הפריט המסומן
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const activeItem = listbox.querySelector('li[aria-selected="true"]');
                    if (activeItem && activeItem._handleSelection) {
                        activeItem._handleSelection(); // נשתמש ישירות בפונקציה
                    }
                }
            });

        }

    </script>
