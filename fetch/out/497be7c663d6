u05e1\u05d9\u05db\u05d4 \u05de\u05e8\u05ea\u05d4 \u05dc\u05d5\u05d0\u05d9\u05d6 \u05d4\u05d5\u05d0 \u05e4\u05e8\u05e1\u05dd \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05e9\u05e0\u05d9\u05dd \u05d0\u05e8\u05d1\u05e2\u05d4 \u05e8\u05d5\u05de\u05e0\u05d9\u05dd, \u05e9\u05e0\u05d9 \u05d0\u05d5\u05e1\u05e4\u05d9 \u05e1\u05d9\u05e4\u05d5\u05e8\u05d9\u05dd \u05e7\u05e6\u05e8\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d5\u05de\u05d7\u05d6\u05d4. \u05e1\u05d2\u05e0\u05d5\u05e0\u05d5 \u05d4\u05e1\u05e4\u05e8\u05d5\u05ea\u05d9 \u05e9\u05d9\u05dc\u05d1 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05d0\u05dc\u05de\u05e0\u05d8\u05d9\u05dd \u05d0\u05d5\u05d8\u05d5\u05d1\u05d9\u05d5\u05d2\u05e8\u05e4\u05d9\u05d9\u05dd.\n\n\u05d1\u05e9\u05e0\u05ea 2002 \u05d9\u05e6\u05e8 \u05e1\u05e8\u05d8 \u05ea\u05d9\u05e2\u05d5\u05d3\u05d9 \u05e2\u05dc [[\u05de\u05dc\u05d7\u05de\u05ea \u05d0\u05e4\u05d2\u05e0\u05d9\u05e1\u05d8\u05df (2001\u20132021)|\u05de\u05dc\u05d7\u05de\u05ea \u05d0\u05e4\u05d2\u05e0\u05d9\u05e1\u05d8\u05df]] \u05d5\u05d4\u05d5\u05e4\u05d9\u05e2 \u05d1\u05de\u05e1\u05e4\u05e8 \u05e1\u05e8\u05d8\u05d9\u05dd \u05e7\u05d5\u05de\u05d9\u05dd. \u05d1\u05e0\u05d5\u05e1\u05e3, \u05d1\u05e9\u05e0\u05ea 2011 \u05d4\u05d5\u05d0 \u05d4\u05e0\u05d7\u05d4 \u05d0\u05ea \u05e1\u05d3\u05e8\u05ea \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05e2\u05d8\u05d5\u05e8\u05ea \u05d4\u05e4\u05e8\u05e1\u05d9\u05dd \"Ari og Per\", \u05d5\u05de\u05e9\u05e0\u05ea 2013 \u05d5\u05e2\u05d3 \u05de\u05d5\u05ea\u05d5 \u05d4\u05d5\u05d0 \u05d4\u05d9\u05d4 \u05e4\u05e2\u05d9\u05dc \u05db\u05d0\u05de\u05df \u05d7\u05d6\u05d5\u05ea\u05d9, \u05d5\u05e9\u05d0\u05d1 \u05d4\u05e9\u05e8\u05d0\u05d4 \u05e8\u05d1\u05d4 \u05de\u05d6\u05e8\u05dd \u05d4[[\u05e0\u05d0\u05d5-\u05d0\u05e7\u05e1\u05e4\u05e8\u05e1\u05d9\u05d5\u05e0\u05d9\u05d6\u05dd]] \u05d5\u05de\u05d0\u05de\u05e0\u05d9\u05dd \u05db\u05de\u05d5 [[\u05d6'\u05d0\u05df-\u05de\u05d9\u05e9\u05dc \u05d1\u05e1\u05e7\u05d9\u05d4]].\n\n== \u05d7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd ==\n\u05d1\u05df \u05d4\u05ea\u05d7\u05ea\u05df \u05e2\u05dd \u05d4\u05e0\u05e1\u05d9\u05db\u05d4 \u05d4\u05e0\u05d5\u05e8\u05d5\u05d5\u05d2\u05d9\u05ea [[\u05de\u05e8\u05ea\u05d4 \u05dc\u05d5\u05d0\u05d9\u05d6, \u05e0\u05e1\u05d9\u05db\u05ea \u05e0\u05d5\u05e8\u05d5\u05d5\u05d2\u05d9\u05d4|\u05de\u05e8\u05ea\u05d4 \u05dc\u05d5\u05d0\u05d9\u05d6]] \u05d1-24 \u05d1\u05de\u05d0\u05d9 2002. \u05dc\u05d6\u05d5\u05d2 \u05e0\u05d5\u05dc\u05d3\u05d5 \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05e9\u05e0\u05d9\u05dd \u05e9\u05dc\u05d5\u05e9 \u05d1\u05e0\u05d5\u05ea - \u05de\u05d5\u05d3 \u05d0\u05e0\u05d2'\u05dc\u05d9\u05e7\u05d4, \u05dc\u05d0\u05d4 \u05d0\u05d9\u05d6\u05d3\u05d5\u05e8\u05d4 \u05d5\u05d0\u05de\u05d4 \u05d8\u05dc\u05d5\u05dc\u05d4. \u05d4\u05dd \u05d7\u05d9\u05d5 \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05e9\u05e0\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05e9\u05d5\u05e0\u05d9\u05dd, \u05db\u05d5\u05dc\u05dc \u05dc\u05d5\u05e0\u05d3\u05d5\u05df \u05d5\u05e0\u05d9\u05d5 \u05d9\u05d5\u05e8\u05e7, \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05dd \u05e0\u05e4\u05e8\u05d3\u05d5 \u05dc\u05d1\u05e1\u05d5\u05e3 \u05d1-2016 \u05d5\u05d4\u05ea\u05d2\u05e8\u05e9\u05d5 \u05d1-2017.\n\n\u05d1-25 \u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2019 \u05d1\u05df \u05d4\u05ea\u05d0\u05d1\u05d3 \u05d1\u05d1\u05d9\u05ea\u05d5 \u05d1[[\u05dc\u05d5\u05de\u05d3\u05d0\u05dc\u05df]] \u05d1\u05d2\u05d9\u05dc 47. \u05dc\u05d0\u05d5\u05e8\u05da \u05e9\u05e0\u05d5\u05ea\u05d9\u05d5 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea \u05d1\u05df \u05e1\u05d1\u05dc \u05de\u05d0\u05dc\u05db\u05d5\u05d4\u05d5\u05dc\u05d9\u05d6\u05dd \u05d5\u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05e2\u05dd \u05d1\u05e2\u05d9\u05d5\u05ea \u05e0\u05e4\u05e9\u05d9\u05d5\u05ea. \u05d1\u05d6\u05de\u05df \u05de\u05d5\u05ea\u05d5 \u05d1\u05df \u05d4\u05d9\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05d9\u05d7\u05e1\u05d9\u05dd \u05e2\u05dd \u05e2\u05d5\u05e8\u05db\u05ea \u05d4\u05d3\u05d9\u05df \u05d0\u05d1\u05d4 \u05e8\u05d9\u05e9 \u05d4\u05d9\u05d9\u05dc\u05de\u05df.\n\n\u05d4\u05dc\u05d5\u05d5\u05d9\u05d9\u05ea\u05d5 \u05e0\u05e2\u05e8\u05db\u05d4 \u05d1[[\u05e7\u05ea\u05d3\u05e8\u05dc\u05ea \u05d0\u05d5\u05e1\u05dc\u05d5]] \u05d1-3 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2020 \u05d5\u05d4\u05d5\u05d0 \u05e0\u05e7\u05d1\u05e8 \u05d1\u05d1\u05d9\u05ea \u05d4\u05e7\u05d1\u05e8\u05d5\u05ea ''V\u00e5r Frelsers gravlund'' \u05d1\u05d0\u05d5\u05e1\u05dc\u05d5''.''\n\n== \u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd ==\n{{\u05d5\u05d9\u05e7\u05d9\u05e9\u05d9\u05ea\u05d5\u05e3 \u05d1\u05e9\u05d5\u05e8\u05d4}}\n* [https://web.archive.org/web/20200419161313/https://aribehn.com/ \u05d4\u05d0\u05ea\u05e8 \u05d4\u05e8\u05e9\u05de\u05d9 \u05db\u05e4\u05d9 \u05e9\u05d0\u05d5\u05e8\u05db\u05d1 \u05d1\u05d0\u05e8\u05db\u05d9\u05d5\u05df \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05d1-19 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2020]\n{{\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc\u05d9 \u05e7\u05d5\u05dc\u05e0\u05d5\u05e2\u05e0\u05d9\u05dd-\u05de\u05d5\u05d6\u05d9\u05e7\u05d0\u05d9\u05dd}}\n* {{Find a Grave}}\n\n== \u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd ==\n{{\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd|\u05d9\u05d9\u05e9\u05d5\u05e8=\u05e9\u05de\u05d0\u05dc}}\n\n{{\u05d1\u05e7\u05e8\u05ea \u05d6\u05d4\u05d5\u05d9\u05d5\u05ea}}\n\n{{\u05e7\u05e6\u05e8\u05de\u05e8|\u05e1\u05d5\u05e4\u05e8\u05d9\u05dd|\u05e0\u05d5\u05e8\u05d5\u05d5\u05d2\u05d9\u05dd}}\n{{\u05de\u05d9\u05d5\u05df \u05e8\u05d2\u05d9\u05dc:\u05d1\u05df, \u05d0\u05e8\u05d9}}\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05de\u05ea\u05d0\u05d1\u05d3\u05d9\u05dd: \u05d0\u05de\u05e0\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e1\u05d5\u05e4\u05e8\u05d9\u05dd \u05e0\u05d5\u05e8\u05d5\u05d5\u05d2\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e6\u05d9\u05d9\u05e8\u05d9\u05dd \u05e0\u05d5\u05e8\u05d5\u05d5\u05d2\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05d1\u05d5\u05d2\u05e8\u05d9 \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05d0\u05d5\u05e1\u05dc\u05d5]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e0\u05d5\u05e8\u05d5\u05d5\u05d2\u05d9\u05dd \u05e9\u05e0\u05d5\u05dc\u05d3\u05d5 \u05d1-1972]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e0\u05e4\u05d8\u05e8\u05d9\u05dd \u05d1-2019]]"}}}]},"1817465":{"pageid":1817465,"ns":0,"title":"\u05e4\u05dc\u05e8 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd","revisions":[{"slots":{"main":{"contentmodel":"wikitext","contentformat":"text/x-wiki","*":"{{\u05de\u05e0\u05d4\u05d9\u05d2\n| \u05ea\u05de\u05d5\u05e0\u05d4 = Fleur Hassan Nahoum.jpg\n| \u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05d9\u05d3\u05d4 = [[27 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8]] [[1973]]\n| \u05de\u05e7\u05d5\u05dd \u05dc\u05d9\u05d3\u05d4 = {{\u05d3\u05d2\u05dc|\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4}} [[\u05dc\u05d5\u05e0\u05d3\u05d5\u05df]], [[\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4]]\n| \u05d4\u05e9\u05db\u05dc\u05d4 = [[\u05e2\u05d5\u05e8\u05db\u05ea \u05d3\u05d9\u05df]], [[\u05e7\u05d9\u05e0\u05d2\u05e1 \u05e7\u05d5\u05dc\u05d2' \u05dc\u05d5\u05e0\u05d3\u05d5\u05df]]\n| \u05e2\u05d9\u05e1\u05d5\u05e7 = \u05dc\u05e9\u05e2\u05d1\u05e8 \u05de\u05e9\u05e0\u05d4 \u05dc\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd\n| \u05de\u05e4\u05dc\u05d2\u05d4 = [[\u05d4\u05dc\u05d9\u05db\u05d5\u05d3]] <br> [[\u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc]]\n| \u05e1\u05d9\u05e2\u05d4 = [[\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05ea\u05e6\u05dc\u05d9\u05d7]]\n| \u05ea\u05d0\u05e8\u05d9\u05da \u05e2\u05dc\u05d9\u05d9\u05d4 = 2001\n| \u05ea\u05e4\u05e7\u05d9\u05d31 = {{\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05de\u05d5\u05d5\u05d9\u05e7\u05d9\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd}}\n}}\n'''\u05e4\u05dc\u05e8 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd''' (\u05e0\u05d5\u05dc\u05d3\u05d4 \u05d1-[[27 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8]] [[1973]]) \u05d4\u05d9\u05d0 [[\u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05e7\u05d0\u05d9]]\u05ea [[\u05d9\u05d5\u05e2\u05e5 \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea|\u05d5\u05d9\u05d5\u05e2\u05e6\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea]] [[\u05d9\u05e9\u05e8\u05d0\u05dc]]\u05d9\u05ea \u05d9\u05dc\u05d9\u05d3\u05ea [[\u05d4\u05de\u05de\u05dc\u05db\u05d4 \u05d4\u05de\u05d0\u05d5\u05d7\u05d3\u05ea|\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4]], \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d1\u05e2\u05d1\u05e8\u05d4 \u05d7\u05d1\u05e8\u05ea [[\u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05de\u05d5\u05e2\u05e6\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]] \u05d5\u05e0\u05e9\u05d0\u05d4 \u05e2\u05d3 \u05de\u05e8\u05e5 2023 \u05d1\u05ea\u05d5\u05d0\u05e8 \u05de\u05e9\u05e0\u05d4 \u05dc[[\u05de\u05e9\u05d4 \u05dc\u05d9\u05d0\u05d5\u05df|\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]] \u05d5\u05d0\u05d7\u05e8\u05d0\u05d9\u05ea \u05e2\u05dc \u05ea\u05d9\u05e7\u05d9 \u05e7\u05e9\u05e8\u05d9 \u05d7\u05d5\u05e5, \u05e4\u05d9\u05ea\u05d5\u05d7 \u05db\u05dc\u05db\u05dc\u05d9 \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9 \u05d5\u05ea\u05d9\u05d9\u05e8\u05d5\u05ea, \u05d5\u05d7\u05d1\u05e8\u05ea \u05d4\u05e0\u05d4\u05dc\u05d4 \u05d1[[\u05d4\u05e8\u05e9\u05d5\u05ea \u05dc\u05e4\u05d9\u05ea\u05d5\u05d7 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05e8\u05e9\u05d5\u05ea \u05dc\u05e4\u05d9\u05ea\u05d5\u05d7 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]]. \u05d1-2020 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05de\u05de\u05e7\u05d9\u05de\u05d5\u05ea [[\u05d4\u05e4\u05d5\u05e8\u05d5\u05dd \u05d4\u05e2\u05e1\u05e7\u05d9 \u05d0\u05d9\u05d7\u05d5\u05d3 \u05d4\u05d0\u05de\u05d9\u05e8\u05d5\u05d9\u05d5\u05ea - \u05d9\u05e9\u05e8\u05d0\u05dc]]. \u05d1-2023 \u05de\u05d5\u05e0\u05ea\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e9\u05e8 [[\u05d0\u05dc\u05d9 \u05db\u05d4\u05df (\u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05e7\u05d0\u05d9, 1972)|\u05d0\u05dc\u05d9 \u05db\u05d4\u05df]] \u05dc\u05e9\u05dc\u05d9\u05d7\u05d4 \u05de\u05d9\u05d5\u05d7\u05d3\u05ea \u05e9\u05dc [[\u05de\u05e9\u05e8\u05d3 \u05d4\u05d7\u05d5\u05e5]] \u05dc\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 [[\u05d7\u05d3\u05e9\u05e0\u05d5\u05ea]].<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.gov.il/he/departments/news/michal-kotler-and-wesch-fleur-hasan-nahum|\u05db\u05d5\u05ea\u05e8\u05ea=\u05e9\u05d7\u05e7\u05e0\u05d9 \u05d7\u05d9\u05d6\u05d5\u05e7 \u05dc\u05d3\u05d9\u05e4\u05dc\u05d5\u05de\u05d8\u05d9\u05d4 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea \u05d1\u05e2\u05d5\u05dc\u05dd|\u05d0\u05ea\u05e8=GOV.IL|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2023-10-10}}</ref> \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05de\u05e8\u05d1\u05d4 \u05dc\u05d9\u05d9\u05e6\u05d2 \u05d0\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05e8\u05d0\u05d9\u05d5\u05e0\u05d5\u05ea \u05dc\u05db\u05dc\u05d9 \u05de\u05d3\u05d9\u05d4 \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9\u05d9\u05dd.\n\n== \u05d1\u05d9\u05d5\u05d2\u05e8\u05e4\u05d9\u05d4 ==\n\u05e4\u05dc\u05e8 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05e0\u05d5\u05dc\u05d3\u05d4 \u05d1[[\u05dc\u05d5\u05e0\u05d3\u05d5\u05df]], \u05e9\u05d1\u05d1\u05e8\u05d9\u05d8\u05e0\u05d9\u05d4, \u05d5\u05d2\u05d3\u05dc\u05d4 \u05d1[[\u05d2\u05d9\u05d1\u05e8\u05dc\u05d8\u05e8]]. \u05d4\u05d9\u05d0 \u05d1\u05ea\u05dd \u05e9\u05dc \u05e1\u05e8 [[\u05d9\u05d4\u05d5\u05e9\u05e2 \u05d7\u05e1\u05df]], \u05e9\u05db\u05d9\u05d4\u05df \u05db[[\u05e8\u05d0\u05e9 \u05d4\u05e9\u05e8\u05d9\u05dd \u05e9\u05dc \u05d2\u05d9\u05d1\u05e8\u05dc\u05d8\u05e8]],<ref>{{Cite web|url=https://www.chronicle.gi/sir-joshuas-daughter-takes-seat-in-jerusalem-council/|title=Sir Joshua\u2019s daughter takes seat in Jerusalem council}}</ref> \u05d5\u05de\u05e8\u05e1\u05dc \u05d1\u05df-\u05e1\u05d9\u05de\u05d5\u05df,<ref>{{Cite web|url=https://www.independent.co.uk/news/people/obituary-sir-joshua-hassan-1248542.html|title=Obituary: Sir Joshua Hassan &#124; The Independent}}</ref> \u05e9\u05e0\u05d9\u05d4\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05de\u05de\u05d5\u05e6\u05d0 [[\u05de\u05e8\u05d5\u05e7\u05d5|\u05de\u05e8\u05d5\u05e7\u05d0\u05d9]]. \u05d0\u05d7\u05d5\u05ea\u05d4 \u05d4\u05e6\u05e2\u05d9\u05e8\u05d4, \u05de\u05e8\u05dc\u05df \u05d7\u05e1\u05df-\u05e0\u05d4\u05d5\u05df, \u05e9\u05d9\u05de\u05e9\u05d4 \u05d7\u05d1\u05e8\u05ea \u05e4\u05e8\u05dc\u05de\u05e0\u05d8 \u05d2\u05d9\u05d1\u05e8\u05dc\u05d8\u05e8\u05d9\u05ea \u05d5\u05de\u05e0\u05d4\u05d9\u05d2\u05d4 \u05e9\u05dc \u05de\u05e4\u05dc\u05d2\u05ea \"\u05d2\u05d9\u05d1\u05e8\u05dc\u05d8\u05e8 \u05d1\u05d9\u05d7\u05d3\".<ref name=\"Independent Israel no apartheid\">{{Cite news|last=Joe Wallen|date=16 January 2018|title=Jerusalem's new British-born deputy mayor: Israel is no apartheid state - it just has an issue with bad PR|work=The Independent|url=https://www.independent.co.uk/news/world/middle-east/jerusalem-donald-trump-decision-fleur-hassan-nahoum-israel-interview-a8162816.html}}</ref>\n\n\u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05d3\u05d5\u05d1\u05e8\u05ea \u05e2\u05d1\u05e8\u05d9\u05ea, \u05e1\u05e4\u05e8\u05d3\u05d9\u05ea \u05d5\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea.<ref name=\"auto\">{{Cite web|url=https://www.jns.org/meet-jerusalems-deputy-mayor-fleur-hassan-nahoum/|title=Meet Jerusalem\u2019s deputy mayor: Fleur Hassan-Nahoum - JNS.org}}</ref> \u05d1\u05e9\u05e0\u05ea 1991 \u05d7\u05d6\u05e8\u05d4 \u05dc\u05dc\u05d5\u05e0\u05d3\u05d5\u05df \u05dc\u05dc\u05de\u05d5\u05d3 [[\u05de\u05e9\u05e4\u05d8\u05d9\u05dd]] \u05d1[[\u05e7\u05d9\u05e0\u05d2\u05e1 \u05e7\u05d5\u05dc\u05d2' \u05dc\u05d5\u05e0\u05d3\u05d5\u05df]], \u05e9\u05dd \u05db\u05d9\u05d4\u05e0\u05d4 \u05db\u05e0\u05e9\u05d9\u05d0\u05ea \u05d4\u05d0\u05d2\u05d5\u05d3\u05d4 \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9\u05ea.{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=Independent Israel no apartheid}} \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d4\u05d5\u05e1\u05de\u05db\u05d4 \u05db\u05e4\u05e8\u05e7\u05dc\u05d9\u05d8\u05d4 \u05d1\u05e9\u05e0\u05ea 1997, \u05d4\u05d9\u05d0 \u05d4\u05ea\u05de\u05d7\u05ea\u05d4 \u05d1\u05dc\u05d5\u05e0\u05d3\u05d5\u05df \u05d5\u05d4\u05e4\u05db\u05d4 \u05dc\u05de\u05e0\u05d4\u05dc\u05ea \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df \u05e9\u05dc \u05d4\u05e1\u05d9\u05d5\u05e2 \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9 \u05d4\u05e2\u05d5\u05dc\u05de\u05d9.{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=auto}}\n\n\u05d1\u05e9\u05e0\u05ea 2001 [[\u05e2\u05dc\u05d9\u05d9\u05d4 \u05dc\u05d0\u05e8\u05e5 \u05d9\u05e9\u05e8\u05d0\u05dc|\u05e2\u05dc\u05ea\u05d4]] \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc.{{\u05d4\u05e2\u05e8\u05d4|{{JP|Gil Hoffman|Jerusalem mayoral candidate picks U.K.-born politician as running mate|/israel-news/elkin-puts-anglo-candidate-second-on-his-list-563512|July 26, 2018}}}} \u05d4\u05d9\u05d0 \u05e0\u05e9\u05d5\u05d0\u05d4 \u05d5\u05d0\u05dd \u05dc\u05d0\u05e8\u05d1\u05e2\u05d4.<ref>{{Cite web|url=https://fuentelatina.org/en/fleur-hassan-nahoum-councilor-of-jerusalem-the-transfer-of-the-us-embassy-pushes-the-palestinians-to-sit-down-and-talk-to-us/|title=Fleur Hassan-Nahoum, Councilor of Jerusalem: \"The transfer of the US embassy pushes the Palestinians to sit down and talk to us\"|date=May 17, 2018|accessdate=2020-04-10|archiveurl=https://web.archive.org/web/20190815151031/https://fuentelatina.org/en/fleur-hassan-nahoum-councilor-of-jerusalem-the-transfer-of-the-us-embassy-pushes-the-palestinians-to-sit-down-and-talk-to-us/|archivedate=2019-08-15|url-status=dead}}</ref>\n\n\u05d1-2024 \u05e7\u05d9\u05d1\u05dc\u05d4 \u05d0\u05ea [[\u05e4\u05e8\u05e1 \u05d1\u05d5\u05e0\u05d9 \u05e6\u05d9\u05d5\u05df]] \u05d1\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \"\u05d4\u05e1\u05d1\u05e8\u05d4\".\n\n== \u05e7\u05e8\u05d9\u05d9\u05e8\u05d4 \u05e2\u05e1\u05e7\u05d9\u05ea ==\n\u05e2\u05dd \u05e1\u05d9\u05d5\u05dd \u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05dd \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05e2\u05d5\u05e8\u05db\u05ea \u05d3\u05d9\u05df \u05d1[[\u05de\u05d9\u05d3\u05dc \u05d8\u05de\u05e4\u05dc]] \u05d5\u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05e9\u05d9\u05de\u05e9\u05d4 \u05db\u05de\u05e0\u05d4\u05dc\u05ea \u05e7\u05de\u05e4\u05d9\u05d9\u05df \u05d1\u05d7\u05d1\u05e8\u05ea \"\u05d4\u05e1\u05d9\u05d5\u05e2 \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9 \u05d4\u05e2\u05d5\u05dc\u05de\u05d9\", \u05d0\u05e8\u05d2\u05d5\u05df \u05e6\u05d3\u05e7\u05d4 \u05d9\u05d4\u05d5\u05d3\u05d9 \u05d1\u05e8\u05d9\u05d8\u05d9 \u05e9\u05e2\u05d1\u05d3 \u05e2\u05dd \u05e7\u05d4\u05d9\u05dc\u05d5\u05ea \u05d9\u05d4\u05d5\u05d3\u05d9\u05d5\u05ea \u05d5\u05dc\u05d0 \u05d9\u05d4\u05d5\u05d3\u05d9\u05d5\u05ea.<ref>{{Cite web|last=Debbie Bartlett|date=29 December 2017|url=http://www.surinenglish.com/gibraltar/201712/29/deputy-mayor-jerusalem-gibraltarian-20171229110216-v.html|title=New deputy mayor of Jerusalem is Gibraltarian|website=SUR in English}}</ref>\n\n\u05dc\u05d0\u05d7\u05e8 [[\u05e2\u05dc\u05d9\u05d9\u05d4 \u05dc\u05d0\u05e8\u05e5 \u05d9\u05e9\u05e8\u05d0\u05dc|\u05e9\u05e2\u05dc\u05ea\u05d4]] \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05de\u05d4\u05dc\u05da [[\u05d4\u05d0\u05d9\u05e0\u05ea\u05d9\u05e4\u05d0\u05d3\u05d4 \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4]],<ref>{{Cite web|url=https://tedxjerusalem.com/speaker/fleur-hassan-nahoum/|title=Fleur Hassan-Nahoum|publisher=TEDx Jerusalem}}</ref> \u05db\u05d9\u05d4\u05e0\u05d4 \u05db\u05d1\u05db\u05d9\u05e8\u05d4 \u05d1[[\u05d2'\u05d5\u05d9\u05e0\u05d8]] \u05d5\u05de\u05e9\u05e0\u05ea 2007 \u05db\u05de\u05e0\u05db\"\u05dc\u05d9\u05ea \u05d1\u05d9\u05ea \u05d4\u05d9\u05dc\u05d3\u05d9\u05dd \"\u05ea\u05e7\u05d5\u05d5\u05d4\", \u05d4\u05ea\u05d5\u05de\u05da \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd \u05d7\u05e1\u05e8\u05d9 \u05d1\u05d9\u05ea, \u05d9\u05d5\u05e6\u05d0\u05d9 [[\u05d1\u05e8\u05d9\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d5\u05ea]] \u05dc\u05e9\u05e2\u05d1\u05e8.<ref>{{Cite web|title=Fleur Hassan-Nahoum|publisher=[[Women's International Zionist Organization]]|url=http://www.wizo.org/guest-speakers/fleur-hassan-nahoum.html}}</ref> \u05d1\u05d4\u05de\u05e9\u05da \u05d4\u05d9\u05d9\u05ea\u05d4 \u05de\u05de\u05d9\u05d9\u05e1\u05d3\u05d9 \u05d7\u05d1\u05e8\u05ea \u05d9\u05d9\u05e2\u05d5\u05e5 \u05d4\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea Message Experts \u05e9\u05d1\u05d9\u05df \u05e8\u05e9\u05d9\u05de\u05ea \u05dc\u05e7\u05d5\u05d7\u05d5\u05ea\u05d9\u05d4 [[\u05de\u05d5\u05d1\u05d9\u05dc\u05d0\u05d9\u05d9]], [[\u05e0\u05d9\u05d9\u05e1|NICE]], [[\u05d0\u05de\u05d3\u05d5\u05e7\u05e1]], [[\u05e1\u05d9\u05e1\u05e7\u05d5 \u05de\u05e2\u05e8\u05db\u05d5\u05ea|\u05e1\u05d9\u05e1\u05e7\u05d5]], [[\u05e1\u05d9\u05de\u05e0\u05e1 (\u05d7\u05d1\u05e8\u05d4)|\u05e1\u05d9\u05de\u05e0\u05e1]], [[\u05de\u05db\u05d1\u05d9 \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05d1\u05e8\u05d9\u05d0\u05d5\u05ea]], [[\u05de\u05e9\u05e8\u05d3 \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea]], [[\u05d4\u05de\u05d5\u05e1\u05d3 \u05dc\u05d1\u05d9\u05d8\u05d5\u05d7 \u05dc\u05d0\u05d5\u05de\u05d9]] \u05d5\u05e2\u05d5\u05d3. \u05db\u05d7\u05dc\u05e7 \u05de\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea\u05d4 \u05dc\u05e7\u05d9\u05d3\u05d5\u05dd \u05d4\u05d9\u05d9\u05d8\u05e7 \u05d5\u05ea\u05e2\u05e1\u05d5\u05e7\u05d4 \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd, \u05db\u05d9\u05d4\u05e0\u05d4 \u05d1\u05d3\u05d9\u05e8\u05e7\u05d8\u05d5\u05e8\u05d9\u05d5\u05df \u05e9\u05dc \u05e2\u05de\u05d5\u05ea\u05ea \"Made in Jerusalem\" \u05e9\u05de\u05e7\u05d3\u05de\u05ea \u05d4\u05d9\u05d9\u05d8\u05e7 \u05d5\u05d9\u05d6\u05de\u05d5\u05ea \u05d1\u05d1\u05d9\u05e8\u05d4.\n\n== \u05e7\u05e8\u05d9\u05d9\u05e8\u05d4 \u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea ==\n\u05d1\u05e9\u05e0\u05ea 2013 \u05d4\u05e6\u05d8\u05e8\u05e4\u05d4 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05dc\u05de\u05e4\u05dc\u05d2\u05ea \"[[\u05d9\u05e8\u05d5\u05e9\u05dc\u05de\u05d9\u05dd (\u05de\u05e4\u05dc\u05d2\u05d4)|\u05d9\u05e8\u05d5\u05e9\u05dc\u05de\u05d9\u05dd]]\" \u05d4\u05dc\u05d9\u05d1\u05e8\u05dc\u05d9\u05ea-\u05e4\u05dc\u05d5\u05e8\u05dc\u05d9\u05e1\u05d8\u05d9\u05ea.<ref>{{Cite news|last=Rafi Perlstein|date=5 August 2018|url=http://mynetjerusalem.co.il/\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea-2018/308395/9|script-title=he:\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea 2018: \u05d0\u05d7\u05e8\u05d9 \u05e9\u05d2\u05e8\u05de\u05d4 \u05dc\u05e1\u05e2\u05e8\u05d4 \u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea, \u05d7\u05d1\u05e8\u05ea \u05d4\u05de\u05d5\u05e2\u05e6\u05d4 \u05e4\u05dc\u05e8 \u05d7\u05e1\u05df\u05be\u05e0\u05d7\u05d5\u05dd \u05e4\u05d5\u05ea\u05d7\u05ea \u05d0\u05ea \u05d4\u05e4\u05d4|title=Elections 2018: After a political storm, Councilor Fleur Hassan-Nahoum opens her mouth|access-date=2020-07-11|archive-url=https://web.archive.org/web/20190909084116/http://mynetjerusalem.co.il/\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea-2018/308395/9|archive-date=2019-09-09|url-status=dead}}</ref> \u05d1\u05e9\u05e0\u05ea 2016 \u05e0\u05db\u05e0\u05e1\u05d4, \u05db\u05d7\u05dc\u05e7 \u05de\u05e8\u05d5\u05d8\u05e6\u05d9\u05d4 \u05d1\u05e8\u05e9\u05d9\u05de\u05ea \u05e1\u05d9\u05e2\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05de\u05d9\u05dd, \u05dc\u05de\u05d5\u05e2\u05e6\u05ea \u05d4\u05e2\u05d9\u05e8 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05d5\u05d4\u05d5\u05d1\u05d9\u05dc\u05d4 \u05d0\u05ea \u05d4\u05d5\u05d5\u05e2\u05d3\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e8 \u05d0\u05ea\u05e8\u05d9 \u05de\u05d5\u05e8\u05e9\u05ea. \u05d4\u05d9\u05d0 \u05db\u05d9\u05d4\u05e0\u05d4 \u05db\u05d9\u05d5\"\u05e8 \"\u05d9\u05e8\u05d5\u05e9\u05dc\u05de\u05d9\u05dd\" \u05de\u05d3\u05e6\u05de\u05d1\u05e8 2017 \u05d5\u05d4\u05e6\u05d8\u05e8\u05e4\u05d4 \u05dc\u05e7\u05d5\u05d0\u05dc\u05d9\u05e6\u05d9\u05d4 \u05e9\u05dc [[\u05e0\u05d9\u05e8 \u05d1\u05e8\u05e7\u05ea]], \u05e4\u05d7\u05d5\u05ea \u05de\u05e9\u05e0\u05d4 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05e4\u05e8\u05e9\u05d4 \u05d5\u05d4\u05e4\u05db\u05d4 \u05dc\u05d9\u05d5\"\u05e8 \u05d4\u05d0\u05d5\u05e4\u05d5\u05d6\u05d9\u05e6\u05d9\u05d4, \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d4\u05ea\u05e0\u05d2\u05d3\u05d5\u05ea\u05d4 \u05dc\u05de\u05d4\u05dc\u05da \u05d4\u05e9\u05d1\u05d9\u05ea\u05d4 \u05e9\u05dc \u05d1\u05e8\u05e7\u05ea, \u05d1\u05de\u05e1\u05d2\u05e8\u05ea\u05d4 \u05dc\u05d0 \u05e0\u05d0\u05e1\u05e4\u05d4 \u05d0\u05e9\u05e4\u05d4 \u05de\u05e8\u05d7\u05d5\u05d1\u05d5\u05ea \u05d4\u05e2\u05d9\u05e8 \u05db\u05de\u05d4 \u05d9\u05de\u05d9\u05dd.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.kolhair.co.il/jerusalem-news/38365/|\u05db\u05d5\u05ea\u05e8\u05ea=\u05e1\u05d2\u05e0\u05d9\u05ea \u05e8\u05d0\u05e9 \u05d4\u05e2\u05d9\u05e8 \u05d4\u05d7\u05d3\u05e9\u05d4 \u05e4\u05dc\u05e8 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05de\u05d2\u05d9\u05d1\u05d4 \u05dc\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05d7\u05e8\u05d9\u05e4\u05d4 \u05e0\u05d2\u05d3\u05d4 {{!}} \u05db\u05dc \u05d4\u05e2\u05d9\u05e8|\u05d0\u05ea\u05e8=\u05db\u05dc \u05d4\u05e2\u05d9\u05e8 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05ea\u05d0\u05e8\u05d9\u05da=2017-12-27|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2020-04-13}}</ref> \u05dc\u05d0\u05d7\u05e8 \u05db\u05e0\u05d9\u05e1\u05ea\u05d4 \u05dc\u05e7\u05d5\u05d0\u05dc\u05d9\u05e6\u05d9\u05d4 \u05e7\u05d9\u05d1\u05dc\u05d4 \u05d0\u05ea \u05ea\u05d9\u05e7 \u05d4\u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05d5\u05e9\u05d9\u05de\u05d5\u05e8 \u05d0\u05ea\u05e8\u05d9\u05dd.\n\n\u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc (2018)|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea]] \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2018 \u05d4\u05e6\u05d8\u05e8\u05e4\u05d4 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05dc\u05e8\u05e9\u05d9\u05de\u05ea\u05d5 \u05e9\u05dc \u05d4\u05e9\u05e8 [[\u05d6\u05d0\u05d1 \u05d0\u05dc\u05e7\u05d9\u05df]] \u05de\u05de\u05e4\u05dc\u05d2\u05ea \"\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05ea\u05e6\u05dc\u05d9\u05d7\", \u05e9\u05d4\u05d5\u05e7\u05de\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05e8\u05d0\u05e9 \u05d4\u05e2\u05d9\u05e8 \u05d4\u05e7\u05d5\u05d3\u05dd \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd [[\u05e0\u05d9\u05e8 \u05d1\u05e8\u05e7\u05ea]].{{\u05d4\u05e2\u05e8\u05d4|{{JP|Gil Hoffman|Jerusalem mayoral candidate picks U.K.-born politician as running mate|/israel-news/elkin-puts-anglo-candidate-second-on-his-list-563512|July 26, 2018}}}}\n\n\u05dc\u05d0\u05d7\u05e8 \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05e1\u05d9\u05e2\u05ea\u05d4 \u05d4\u05ea\u05e4\u05e6\u05dc\u05d4 \u05d5\u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05e0\u05d5\u05ea\u05e8\u05d4 \u05d1\u05e1\u05d9\u05e2\u05ea \u05d9\u05d7\u05d9\u05d3. \u05d1\u05be13 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2018 \u05e8\u05d0\u05e9 \u05d4\u05e2\u05d9\u05e8 [[\u05de\u05e9\u05d4 \u05dc\u05d9\u05d0\u05d5\u05df]] \u05de\u05d9\u05e0\u05d4 \u05d0\u05d5\u05ea\u05d4 \u05dc\u05de\u05e9\u05e0\u05d4 \u05dc\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd, \u05db\u05de\u05de\u05d5\u05e0\u05d4 \u05e2\u05dc \u05e7\u05e9\u05e8\u05d9 \u05ea\u05d9\u05d9\u05e8\u05d5\u05ea \u05d5\u05d9\u05d7\u05e1\u05d9 \u05d7\u05d5\u05e5,<ref>{{Cite web|url=https://jewishinsider.com/2019/04/jerusalem-is-the-laboratory-for-the-solution-says-deputy-mayor/|title=Jerusalem is the \u2018laboratory for the solution\u2019 says deputy mayor|date=April 1, 2019|website=Jewish Insider}}</ref> \u05db\u05d5\u05dc\u05dc \u05e4\u05d9\u05dc\u05e0\u05ea\u05e8\u05d5\u05e4\u05d9\u05d4, \u05e4\u05d9\u05ea\u05d5\u05d7 \u05db\u05dc\u05db\u05dc\u05d9 \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9, \u05d9\u05d7\u05e1\u05d9\u05dd \u05e2\u05e1\u05e7\u05d9\u05d9\u05dd \u05d5\u05e2\u05e0\u05d9\u05d9\u05e0\u05d9 \u05ea\u05e4\u05d5\u05e6\u05d5\u05ea.<ref>{{Cite web|title=UK-born politician named Jerusalem's first Diaspora minister|url=https://jewishnews.timesofisrael.com/uk-born-politician-named-jerusalems-first-diaspora-minister|date=28 December 2018|accessdate=7 January 2019|first=James|last=Martin}}</ref> \u05d1\u05d9\u05df \u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d0\u05d7\u05e8\u05d9\u05d5\u05ea \u05e9\u05dc \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05d4\u05d5\u05d0 \u05d4\u05ea\u05d0\u05de\u05ea \u05e9\u05d2\u05e8\u05d9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea \u05d1\u05e2\u05d9\u05e8. \u05d4\u05d9\u05d0 \u05e2\u05d5\u05d1\u05d3\u05ea \u05de\u05d5\u05dc \u05de\u05e9\u05e8\u05d3 \u05d4\u05d7\u05d5\u05e5 \u05d4\u05d0\u05de\u05e8\u05d9\u05e7\u05d0\u05d9 \u05e2\u05dc \u05e9\u05d2\u05e8\u05d9\u05e8\u05d5\u05ea \u05d0\u05e8\u05e6\u05d5\u05ea \u05d4\u05d1\u05e8\u05d9\u05ea \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05d5\u05e2\u05d5\u05d6\u05e8\u05ea \u05dc\u05ea\u05db\u05e0\u05df \u05de\u05d7\u05d5\u05d6 \u05e9\u05d2\u05e8\u05d9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d1\u05e9\u05db\u05d5\u05e0\u05ea [[\u05d0\u05e8\u05e0\u05d5\u05e0\u05d4 (\u05e9\u05db\u05d5\u05e0\u05d4)|\u05d0\u05e8\u05e0\u05d5\u05e0\u05d4]] \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd.<ref>{{Cite web|url=https://jewishinsider.com/2019/04/daily-kickoff-on-the-trail-with-nir-barkat-meet-fleur-hassan-nahoum-jeff-zucker-for-nyc-mayor-will-bloomberg-reconsider/|title=Daily Kickoff: On the trail with Nir Barkat &#124; Meet Fleur Hassan-Nahoum &#124; Jeff Zucker for NYC Mayor? &#124; Will Bloomberg reconsider?|date=April 2, 2019|website=Jewish Insider}}</ref> \u05db\u05de\u05d5 \u05db\u05df \u05d4\u05d9\u05d0 \u05de\u05db\u05d4\u05e0\u05ea \u05db\u05d7\u05d1\u05e8\u05ea \u05d4\u05e0\u05d4\u05dc\u05d4 \u05d1[[\u05d4\u05e8\u05e9\u05d5\u05ea \u05dc\u05e4\u05d9\u05ea\u05d5\u05d7 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd|\u05e8\u05e9\u05d5\u05ea \u05dc\u05e4\u05d9\u05ea\u05d5\u05d7 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]], \u05d5\u05de\u05ea\u05de\u05e7\u05d3\u05ea \u05d1\u05e7\u05d9\u05d3\u05d5\u05dd \u05d4\u05d9\u05d9\u05d8\u05e7 \u05d5\u05ea\u05d9\u05d9\u05e8\u05d5\u05ea.\n\n\u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2020 \u05dc\u05e7\u05e8\u05d0\u05ea [[\u05d4\u05e1\u05db\u05dd \u05d4\u05e9\u05dc\u05d5\u05dd \u05d1\u05d9\u05df \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05d0\u05d9\u05d7\u05d5\u05d3 \u05d4\u05d0\u05de\u05d9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d4\u05e2\u05e8\u05d1\u05d9\u05d5\u05ea]] \u05d4\u05d9\u05d9\u05ea\u05d4 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05de\u05de\u05e7\u05d9\u05de\u05d5\u05ea \u05d4\u05e4\u05d5\u05e8\u05d5\u05dd \u05d4\u05e2\u05e1\u05e7\u05d9 \u05d0\u05d9\u05d7\u05d5\u05d3 \u05d4\u05d0\u05de\u05d9\u05e8\u05d5\u05d9\u05d5\u05ea-\u05d9\u05e9\u05e8\u05d0\u05dc UAE - Israel Business Council, \u05e9\u05e4\u05d5\u05e2\u05dc \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05e9\u05d9\u05ea\u05d5\u05e4\u05d9 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05d9\u05df \u05d9\u05e9\u05e8\u05d0\u05dc \u05dc\u05de\u05d3\u05d9\u05e0\u05d5\u05ea \u05d4\u05de\u05e4\u05e8\u05e5 \u05d1\u05ea\u05d7\u05d5\u05de\u05d9 \u05d4\u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4, \u05d4\u05e2\u05e1\u05e7\u05d9\u05dd \u05d5\u05d4\u05ea\u05d9\u05d9\u05e8\u05d5\u05ea. \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2020 \u05d1\u05d9\u05e7\u05e8\u05d4 \u05d1\u05d3\u05d5\u05d1\u05d0\u05d9 \u05db\u05d7\u05dc\u05e7 \u05de\u05de\u05e9\u05dc\u05d7\u05ea \u05e9\u05dc \u05d3\u05d9\u05e4\u05dc\u05d5\u05de\u05d8\u05d9\u05dd \u05d5\u05d0\u05e0\u05e9\u05d9 \u05e2\u05e1\u05e7\u05d9\u05dd, \u05d5\u05d0\u05de\u05e8\u05d4 \u05db\u05d9 \u05d4\u05d9\u05d0 \u05e4\u05d5\u05e2\u05dc\u05ea \u05e2\u05dd \u05e8\u05d0\u05e9 \u05d4\u05e2\u05d9\u05e8 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd, [[\u05de\u05e9\u05d4 \u05dc\u05d9\u05d0\u05d5\u05df]], \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05de\u05e8\u05db\u05d6 \u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9 \u05d1\u05d9\u05e0\u05dc\u05d0\u05d5\u05de\u05d9 \u05d1[[\u05de\u05d6\u05e8\u05d7 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd]].<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.cnbc.com/2020/10/12/saudi-arabia-is-the-white-whale-of-israels-middle-east-peace-deals-jerusalem-official-says.html|\u05d4\u05db\u05d5\u05ea\u05d1=Natasha Turak|\u05db\u05d5\u05ea\u05e8\u05ea=Saudi Arabia is the 'white whale' of Israel's Middle East peace deals, Jerusalem official says|\u05d0\u05ea\u05e8=CNBC|\u05ea\u05d0\u05e8\u05d9\u05da=2020-10-12|\u05e9\u05e4\u05d4=en|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2020-10-13}}</ref>\n\n\u05dc\u05e7\u05e8\u05d0\u05ea [[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea \u05d4\u05e2\u05e9\u05e8\u05d9\u05dd \u05d5\u05d7\u05de\u05e9]] \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d4 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05d1\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05dc\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05dc\u05db\u05e0\u05e1\u05ea \u05d0\u05da \u05dc\u05d0 \u05e0\u05d1\u05d7\u05e8\u05d4 \u05dc\u05de\u05e7\u05d5\u05dd \u05e8\u05d9\u05d0\u05dc\u05d9.\n\n\u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2026 \u05d4\u05d5\u05d3\u05d9\u05e2\u05d4 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05e2\u05dc \u05d4\u05e6\u05d8\u05e8\u05e4\u05d5\u05ea \u05dc\u05de\u05e4\u05dc\u05d2\u05ea\u05d5 \u05e9\u05dc [[\u05e2\u05d5\u05e4\u05e8 \u05d5\u05d9\u05e0\u05d8\u05e8]].{{\u05d4\u05e2\u05e8\u05d4|{{ynet|\u05d0\u05de\u05d9\u05e8 \u05d0\u05d8\u05d9\u05e0\u05d2\u05e8|\u05d5\u05d9\u05e0\u05d8\u05e8 \u05d7\u05e9\u05e3 \u05d0\u05ea \u05d4\u05e8\u05e9\u05d9\u05de\u05d4 \u05dc\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea: \"\u05e8\u05d5\u05e6\u05d9\u05dd \u05de\u05de\u05e9\u05dc\u05ea \u05d9\u05de\u05d9\u05df \u05e8\u05d7\u05d1\u05d4. \u05d4\u05e4\u05ea\u05e8\u05d5\u05df \u05d1\u05e2\u05d6\u05d4 - \u05d4\u05d2\u05d9\u05e8\u05d4\"|news/elections2026/article/s13ku7jdzg|25 \u05d1\u05d0\u05d5\u05d2\u05d5\u05e1\u05d8 2026}}}}\n\n== \u05d4\u05e9\u05e7\u05e4\u05d5\u05ea \u05d5\u05d3\u05e2\u05d5\u05ea ==\n\u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05de\u05d2\u05d3\u05d9\u05e8\u05d4 \u05d0\u05ea \u05e2\u05e6\u05de\u05d4 \u05db\u05d9\u05d4\u05d5\u05d3\u05d9\u05d4 \u05d3\u05ea\u05d9\u05ea [[\u05e6\u05d9\u05d5\u05e0\u05d5\u05ea|\u05d5\u05e6\u05d9\u05d5\u05e0\u05d9\u05ea]].<ref>{{Cite news|date=19 May 2017|url=http://jewishnews.timesofisrael.com/meet-jerusalems-orthodox-feminist-would-be-mayor/|title=Meet Jerusalem's 'Orthodox feminist' would-be mayor|first=Stephen|last=Oryszczuk|work=The Times of Israel}}</ref> \u05d4\u05d9\u05d0 \u05de\u05d0\u05de\u05d9\u05e0\u05d4 \u05e9\u05e0\u05e9\u05d9\u05dd \u05e6\u05e8\u05d9\u05db\u05d5\u05ea \u05dc\u05e7\u05d7\u05ea \u05d7\u05dc\u05e7 \u05d1\u05e9\u05dc\u05d8\u05d5\u05df \u05d4\u05de\u05e7\u05d5\u05de\u05d9, \"\u05d0\u05e0\u05d9 \u05de\u05d0\u05de\u05d9\u05e0\u05d4 \u05d1\u05d0\u05de\u05d5\u05e0\u05d4 \u05e9\u05dc\u05de\u05d4 \u05e9\u05e2\u05d3 \u05e9\u05e0\u05e9\u05d9\u05dd \u05dc\u05d0 \u05d9\u05d4\u05d5\u05d5 50% \u05de\u05e2\u05de\u05d3\u05d5\u05ea \u05e7\u05d1\u05dc\u05ea \u05d4\u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05d4\u05e2\u05d5\u05dc\u05dd \u05e9\u05dc\u05e0\u05d5 \u05d9\u05d9\u05e9\u05d0\u05e8 \u05dc\u05d0 \u05de\u05d0\u05d5\u05d6\u05df. \u05d4\u05e9\u05dc\u05d8\u05d5\u05df \u05d4\u05de\u05e7\u05d5\u05de\u05d9 \u05de\u05e9\u05e4\u05d9\u05e2 \u05e2\u05dc \u05d7\u05d9\u05d9 \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05dd \u05e9\u05dc\u05e0\u05d5 \u05d5\u05d6\u05d4 \u05d7\u05d9\u05d5\u05e0\u05d9 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e7 \u05e0\u05e9\u05d9\u05dd \u05d1\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd \u05d0\u05dc\u05d4 \u05de\u05db\u05d9\u05d5\u05d5\u05df \u05e9\u05db\u05e9\u05e0\u05e9\u05d9\u05dd \u05e1\u05d1\u05d9\u05d1 \u05d4\u05e9\u05d5\u05dc\u05d7\u05df \u05d4\u05d4\u05d7\u05dc\u05d8\u05d5\u05ea \u05e4\u05e9\u05d5\u05d8 \u05d8\u05d5\u05d1\u05d5\u05ea \u05d9\u05d5\u05ea\u05e8.\"<ref>{{Cite news|last=Shoshanna Keats Jaskoll|date=22 October 2018|url=https://www.thejc.com/comment/columnists/voting-for-women-can-make-our-lives-better-1.471212|title=Voting for women can make our lives better|work=The Jewish Chronicle}}</ref> \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05d2\u05dd \u05d4\u05e6\u05d4\u05d9\u05e8\u05d4 \u05e9\u05d4\u05d2\u05d3\u05dc\u05ea \u05d4\u05d4\u05e9\u05ea\u05ea\u05e4\u05d5\u05ea \u05d1\u05db\u05d5\u05d7 \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d5\u05d1\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da \u05d1\u05de\u05d2\u05d6\u05e8 \u05d4\u05e2\u05e8\u05d1\u05d9 \u05d4\u05dd \u05d0\u05ea\u05d2\u05e8\u05d9\u05dd \u05d2\u05d3\u05d5\u05dc\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e2\u05d9\u05e8\u05d9\u05d9\u05d4.<ref name=\"auto\" />\n\n\u05d4\u05d9\u05d0 \u05ea\u05d5\u05de\u05db\u05ea \u05d1\u05d0\u05d5\u05db\u05dc\u05d5\u05e1\u05d9\u05d5\u05ea \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc \u05db\u05d5\u05dc\u05dc \u05e0\u05e9\u05d9\u05dd [[\u05d9\u05d4\u05d3\u05d5\u05ea \u05d7\u05e8\u05d3\u05d9\u05ea|\u05d7\u05e8\u05d3\u05d9\u05d5\u05ea]], \u05de\u05d4\u05d2\u05e8\u05d9\u05dd [[\u05d0\u05ea\u05d9\u05d5\u05e4\u05d9\u05d4|\u05d5\u05d0\u05ea\u05d9\u05d5\u05e4\u05d9\u05dd]].{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=Independent Israel no apartheid}} \u05d4\u05d9\u05d0 \u05d3\u05d9\u05d1\u05e8\u05d4 \u05d1\u05e4\u05d5\u05de\u05d1\u05d9 \u05e2\u05dc \u05e4\u05d9\u05ea\u05d5\u05d7 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05db\u05de\u05d5\u05e7\u05d3 \u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4; \u05e1\u05d5\u05d2\u05d9\u05d5\u05ea \u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05d5\u05e0\u05d9\u05d9\u05d3\u05d5\u05ea; \u05d9\u05e2\u05d9\u05dc\u05d5\u05ea \u05ea\u05e7\u05e6\u05d9\u05d1\u05d9\u05ea; \u05de\u05de\u05e9\u05dc \u05ea\u05e7\u05d9\u05df; \u05d5\u05e2\u05dc \u05d6\u05db\u05d5\u05d9\u05d5\u05ea\u05d9\u05d4\u05dd \u05e9\u05dc \u05d7\u05d5\u05dc\u05d9 \u05e1\u05e8\u05d8\u05df. \u05d1\u05e8\u05d0\u05d9\u05d5\u05df \u05d1\u05e9\u05e0\u05ea 2019 \u05d0\u05de\u05e8\u05d4 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05db\u05d9 \u05e2\u05dc \u05e8\u05e7\u05e2 \u05de\u05e9\u05e4\u05d7\u05ea\u05d4 \u05d4\u05de\u05d2\u05d5\u05d5\u05df \u05d4\u05d9\u05d0 \u05de\u05e1\u05d5\u05d2\u05dc\u05ea \u05dc\u05d4\u05d1\u05d9\u05df \u05d5\u05dc\u05d4\u05d5\u05e9\u05d9\u05d8 \u05d9\u05d3 \u05dc\u05e7\u05d4\u05d9\u05dc\u05d5\u05ea \u05e9\u05d5\u05e0\u05d5\u05ea: \"\u05d0\u05e0\u05d9 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05db\u05d1\u05d3 \u05d0\u05ea \u05d4\u05ea\u05e8\u05d1\u05d5\u05ea \u05d4\u05e2\u05e8\u05d1\u05d9\u05ea, \u05dc\u05d3\u05d1\u05e8 \u05db\u05de\u05d5 \u05d0\u05e0\u05d3\u05dc\u05d5\u05e1\u05d9\u05ea \u05d5\u05dc\u05d7\u05e9\u05d5\u05d1 \u05db\u05de\u05d5 \u05d0\u05d3\u05dd \u05dc\u05d8\u05d9\u05e0\u05d9, \u05d1\u05e8\u05d9\u05d8\u05d9 \u05d5\u05d9\u05d4\u05d5\u05d3\u05d9 \u05e1\u05e4\u05e8\u05d3\u05d9 \u05d2\u05dd \u05d9\u05d7\u05d3.\"<ref name=\"auto\" />\n\n\u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05dc\u05e8\u05e9\u05d5\u05d9\u05d5\u05ea \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea 2018, \u05e7\u05e8\u05d0 \u05e1\u05e0\u05d9\u05e3 \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05d4\u05de\u05e7\u05d5\u05de\u05d9 \u05e9\u05dc \u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05dc\u05e8\u05d0\u05e9 \u05d4\u05de\u05de\u05e9\u05dc\u05d4 \u05e0\u05ea\u05e0\u05d9\u05d4\u05d5 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d1\u05d5 \u05de\u05ea\u05de\u05d9\u05db\u05ea\u05d5 \u05d1\u05d6\u05d0\u05d1 \u05d0\u05dc\u05e7\u05d9\u05df \u05dc\u05e8\u05d0\u05e9\u05d5\u05ea \u05d4\u05e2\u05d9\u05e8, \u05de\u05e9\u05d5\u05dd \u05e9\u05dc\u05d8\u05e2\u05e0\u05ea\u05dd \"\u05de\u05e1\u05e4\u05e8 \u05e9\u05ea\u05d9\u05d9\u05dd \u05e9\u05dc \u05d0\u05dc\u05e7\u05d9\u05df \u05d4\u05d9\u05d0 \u05d4\u05d2\u05d1\u05e8\u05ea \u05e4\u05dc\u05e8 \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05d0\u05e9\u05e8 \u05dc\u05e4\u05d9 \u05d4\u05e4\u05e8\u05e1\u05d5\u05de\u05d9\u05dd \u05d4\u05d9\u05d0 \u05e4\u05e2\u05d9\u05dc\u05d4 \u05d1\u05e2\u05de\u05d5\u05ea\u05ea \u2018[[\u05db\u05e9\u05e8\u05d5\u05ea \u05d0\u05dc\u05d8\u05e8\u05e0\u05d8\u05d9\u05d1\u05d9\u05ea|\u05d4\u05e9\u05d2\u05d7\u05d4 \u05e4\u05e8\u05d8\u05d9\u05ea]]\u2019...\u05d5\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05de\u05d9\u05de\u05d5\u05df \u05e9\u05dc\u05d4 \u05d4\u05dd \u05e7\u05e8\u05df \u2018\u05e9\u05d5\u05e1\u05d8\u05e8\u05de\u05df\u2019, \u05e7\u05e8\u05df \u2018\u05dc\u05d9\u05e9\u05d8\u05d0\u05d2\u2019 \u05d5\u2019\u05d4\u05e4\u05d3\u05e8\u05e6\u05d9\u05d4 \u05e9\u05dc \u05e0\u05d9\u05d5 \u05d9\u05d5\u05e8\u05e7\u2019, \u05db\u05d0\u05e9\u05e8 \u05d9\u05d3\u05d5\u05e2 \u05dc\u05db\u05dc \u05d2\u05dd \u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc\u05d4\u05df \u05dc\u201d[[\u05d4\u05e7\u05e8\u05df \u05d4\u05d7\u05d3\u05e9\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc|\u05e7\u05e8\u05df \u05d4\u05d7\u05d3\u05e9\u05d4 \u05dc\u05d9\u05e9\u05e8\u05d0\u05dc]]\u201d.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=https://www.20il.co.il/\u05db\u05ea\u05d1\u05d4-\u05d4\u05dc\u05d9\u05db\u05d5\u05d3-\u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd-\u05d3\u05d5\u05e8\u05e9-\u05de\u05e8\u05d4\u05de-\u05e9\u05dc\u05d0-\u05dc\u05ea\u05de/|\u05d4\u05db\u05d5\u05ea\u05d1=\u05d4\u05e8\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8 \u05e0\u05d5\u05d7 \u05dc\u05d2\u05dc\u05d5\u05e9 \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d9\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea 20, \u05dc\u05d7\u05e5 \u05e2\u05db\u05e9\u05d9\u05d5 \u05dc\u05d4\u05d5\u05e8\u05d3\u05d4|\u05db\u05d5\u05ea\u05e8\u05ea=\u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05d3\u05d5\u05e8\u05e9 \u05de\u05e8\u05d4\u201d\u05de \u05e9\u05dc\u05d0 \u05dc\u05ea\u05de\u05d5\u05da \u05d1\u05d0\u05dc\u05e7\u05d9\u05df|\u05d0\u05ea\u05e8=\u05d7\u05d3\u05e9\u05d5\u05ea 20|\u05ea\u05d0\u05e8\u05d9\u05da=2018-09-30|\u05e9\u05e4\u05d4=\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2020-05-04|archive-date=2020-06-16|archive-url=https://web.archive.org/web/20200616051418/https://www.20il.co.il/\u05db\u05ea\u05d1\u05d4-\u05d4\u05dc\u05d9\u05db\u05d5\u05d3-\u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd-\u05d3\u05d5\u05e8\u05e9-\u05de\u05e8\u05d4\u05de-\u05e9\u05dc\u05d0-\u05dc\u05ea\u05de/|url-status=dead}}</ref>\n\n\u05d1\u05d3\u05e6\u05de\u05d1\u05e8 2019 \u05de\u05d7\u05d5 \u05de\u05e1\u05e4\u05e8 \u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05e9\u05db\u05d5\u05dc\u05d5\u05ea \u05e2\u05dc \u05e0\u05d5\u05db\u05d7\u05d5\u05ea\u05d4 \u05e9\u05dc \u05d7\u05e1\u05df-\u05e0\u05d7\u05d5\u05dd \u05d1\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d1\u05e0\u05d5\u05e9\u05d0 \u05ea\u05d5\u05db\u05e0\u05d9\u05ea [[\u05d4\u05e8\u05db\u05d1\u05dc \u05dc\u05db\u05d5\u05ea\u05dc|\u05d4\u05e8\u05db\u05d1\u05dc \u05dc\u05e2\u05d9\u05e8 \u05d4\u05e2\u05ea\u05d9\u05e7\u05d4]], \u05e9\u05d0\u05d5\u05e8\u05d2\u05df \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d0\u05e8\u05d2\u05d5\u05df \"[[\u05e2\u05de\u05e7 \u05e9\u05d5\u05d5\u05d4 (\u05d0\u05e8\u05d2\u05d5\u05df)|\u05e2\u05de\u05e7 \u05e9\u05d5\u05d5\u05d4]]\".<ref>{{Cite news|last=Michal Chin|url=https://www.mako.co.il/news-politics/2019_q4/Article-61b13f36c1d1f61027.htm:\u05de\u05e9\u05e4\u05d7\u05d5\u05ea \u05e9\u05db\u05d5\u05dc\u05d5\u05ea \u05de\u05d5\u05d7\u05d5\u05ea: \u05de\u05e9\u05e0\u05d4 \u05dc\u05e8\u05d0\u05e9 \u05e2\u05d9\u05e8\u05d9\u05d9\u05ea \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u05ea\u05e9\u05ea\u05ea\u05e3 \u05d1\u05db\u05e0\u05e1 \u05e9\u05dc \u05d0\u05e8\u05d2\u05d5\u05df \u05e9\u05de\u05d0\u05dc \u05e7\u05d9\u05e6\u05d5\u05e0\u0