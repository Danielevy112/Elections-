u05d5\u05e5 \u05d4\u05de\u05d0\u05d5\u05d7\u05d3]], 2005.\n* '''\u05dc\u05d0 \u05db\u05e0\u05e2\u05e0\u05d9\u05dd, \u05dc\u05d0 \u05e6\u05dc\u05d1\u05e0\u05d9\u05dd - \u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05de\u05d9\u05ea\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea''', [[\u05db\u05ea\u05e8 \u05e1\u05e4\u05e8\u05d9\u05dd]], 2008{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05d9\u05d0\u05d9\u05e8 \u05e9\u05dc\u05d2|\u05e2\u05d1\u05e8\u05d9\u05dd, \u05db\u05e0\u05e2\u05e0\u05d9\u05dd, \u05d0\u05d5 \u05e1\u05ea\u05dd \u05d9\u05dd-\u05ea\u05d9\u05db\u05d5\u05e0\u05d9\u05d9\u05dd?|1.1327235|26 \u05d1\u05de\u05d0\u05d9 2008}}}}.\n* '''\u05d4\u05de\u05d9\u05ea\u05d5\u05e1 \u05e9\u05dc \u05e0\u05d9\u05d5\u05d1\u05d4: \u05d0\u05ea\u05d9\u05e7\u05d4 \u05d5\u05d0\u05dc\u05d9\u05de\u05d5\u05ea \u05d1\u05de\u05d9\u05ea\u05d5\u05e1\u05d9\u05dd \u05d1\u05e0\u05d9 \u05d6\u05de\u05e0\u05e0\u05d5''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05d4\u05e7\u05d9\u05d1\u05d5\u05e5 \u05d4\u05de\u05d0\u05d5\u05d7\u05d3, 2010.\n* '''\u05d4\u05db\u05d1\u05d5\u05dc, \u05d4\u05e2\u05e7\u05d5\u05d3 \u05d5\u05d4\u05e6\u05dc\u05d5\u05d1: \u05d0\u05dc\u05d1\u05e8 \u05e7\u05d0\u05de\u05d9 \u05d5\u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d4\u05d0\u05dc\u05d9\u05de\u05d5\u05ea''', \u05db\u05e8\u05de\u05dc, 2013{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05de\u05e9\u05d4 \u05e1\u05dc\u05d5\u05d7\u05d5\u05d1\u05e1\u05e7\u05d9|\u05d4\u05e9\u05ea\u05d9\u05e7\u05d4 \u05d4\u05e8\u05d5\u05e2\u05de\u05ea \u05e9\u05dc \u05d0\u05dc\u05d1\u05e8 \u05e7\u05d0\u05de\u05d9|1.2208549|7 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2014}}}}.\n* '''\u05d6\u05e8\u05ea\u05d5\u05e1\u05d8\u05e8\u05d0 \u05d1\u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd: \u05e4\u05e8\u05d9\u05d3\u05e8\u05d9\u05da \u05e0\u05d9\u05d8\u05e9\u05d4 \u05d5\u05d4\u05de\u05d5\u05d3\u05e8\u05e0\u05d9\u05d5\u05ea \u05d4\u05d9\u05d4\u05d5\u05d3\u05d9\u05ea''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05de\u05d5\u05e1\u05d3 \u05d1\u05d9\u05d0\u05dc\u05d9\u05e7, 2016{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05d0\u05dc\u05e2\u05d3 \u05e0\u05d1\u05d5|\u05db\u05da \u05d4\u05e9\u05e4\u05d9\u05e2 \u05e0\u05d9\u05d8\u05e9\u05d4 \u05e2\u05dc \u05e9\u05e9\u05d4 \u05d4\u05d5\u05d2\u05d9\u05dd \u05d9\u05d4\u05d5\u05d3\u05d9\u05dd|1.3003175|13 \u05d1\u05d9\u05d5\u05dc\u05d9 2016}}}}.\n* '''\u05e2\u05dc \u05d0\u05e8\u05e5 \u05d0\u05d1\u05e0\u05d9\u05dd: 1967: \u05de\u05e7\u05d5\u05de\u05d5 \u05e9\u05dc \u05d4\u05de\u05e7\u05d5\u05dd \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05d4\u05e7\u05d9\u05d1\u05d5\u05e5 \u05d4\u05de\u05d0\u05d5\u05d7\u05d3, 2017{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05d0\u05d1\u05e0\u05e8 \u05e9\u05e4\u05d9\u05e8\u05d0|\u05e9\u05dc\u05d5\u05e9\u05d4 \u05e1\u05e4\u05e8\u05d9\u05dd \u05e2\u05dc \u05d4\u05de\u05d5\u05e8\u05e9\u05ea \u05d4\u05e1\u05de\u05d5\u05e8\u05d4 \u05de\u05d0\u05d9\u05de\u05d4 \u05d5\u05de\u05d3\u05dd \u05e9\u05dc \u05d4\u05db\u05d9\u05d1\u05d5\u05e9 \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9 \u05d1\u05e9\u05d8\u05d7\u05d9\u05dd|1.4143824|5 \u05d1\u05d9\u05d5\u05e0\u05d9 2017|\u05de\u05e0\u05d5\u05d9\u05d9\u05dd=\u05dc\u05d0}}}}.\n* '''\u05d4\u05e1\u05d3\u05e8 \u05d4\u05de\u05d9\u05ea\u05d9 \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05e8\u05e0\u05d9\u05d5\u05ea''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05db\u05e8\u05de\u05dc, 2017{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05de\u05e9\u05d4 \u05d0\u05d9\u05d3\u05dc|\u05d8\u05e2\u05d5\u05ea\u05d5 \u05e9\u05dc \u05de\u05e7\u05e1 \u05d5\u05d1\u05e8|1.6527550|3 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2018}}}}.\n* '''[http://www.biupress.co.il/website/index.asp?id=1114 \u05d7\u05d1\u05dc\u05d9 \u05de\u05d5\u05dc\u05d3\u05ea: \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05d5\u05ea \u05d1\u05d9\u05df \u05d7\u05d1\u05dc\u05d9 \u05dc\u05d9\u05d3\u05d4 \u05dc\u05d7\u05d1\u05dc\u05d9 \u05de\u05e9\u05d9\u05d7]''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05d1\u05e8-\u05d0\u05d9\u05dc\u05df, 2019\n* '''\u05db\u05d1\u05dc\u05d9 \u05de\u05e9\u05d9\u05d7''' - \u05de\u05e1\u05d5\u05ea \u05d5\u05de\u05e1\u05e2\u05d5\u05ea, \u05d4\u05d5\u05e6\u05d0\u05ea \u05db\u05e8\u05de\u05dc, 2019.\n* '''\u05d4\u05dc\u05d1\u05e0\u05d8\u05d9\u05e0\u05d9\u05ea - \u05d6'\u05e7\u05dc\u05d9\u05df \u05db\u05d4\u05e0\u05d5\u05d1: \u05d1\u05d9\u05d5\u05d2\u05e8\u05e4\u05d9\u05d4 \u05d0\u05d9\u05e0\u05d8\u05dc\u05e7\u05d8\u05d5\u05d0\u05dc\u05d9\u05ea''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05db\u05e8\u05de\u05dc, 2022.\n* '''\u05d2\u05dd \u05db\u05e0\u05e2\u05e0\u05d9\u05dd \u05d2\u05dd \u05e6\u05dc\u05d1\u05e0\u05d9\u05dd - \u05de\u05e1\u05d5\u05ea\u05d9\u05d9 \u05d1\u05d0\u05e8\u05e5-\u05d9\u05e9\u05e8\u05d0\u05dc''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05db\u05e8\u05de\u05dc, 2022{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05d9\u05d5\u05e8\u05dd \u05d1\u05d9\u05dc\u05d5|\u05d3\u05d5\u05d3 \u05d0\u05d5\u05d7\u05e0\u05d4 \u05de\u05de\u05e9\u05d9\u05da \u05dc\u05d3\u05d1\u05d5\u05e7 \u05d1\u05d3\u05e2\u05ea\u05d5 \u05e9\u05d4\u05e1\u05db\u05e0\u05d4 \u05d4\u05de\u05e9\u05d9\u05d7\u05d9\u05ea \u05d4\u05d9\u05d0 \u05d4\u05d0\u05d9\u05d5\u05dd \u05d4\u05e7\u05d9\u05d5\u05de\u05d9 \u05d4\u05d2\u05d3\u05d5\u05dc \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e2\u05dc \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05d5\u05ea|00000184-9e98-df75-afa6-ffbe79340000|23 \u05d1\u05e0\u05d5\u05d1\u05de\u05d1\u05e8 2022}}}}.\n* '''\u05d4\u05e8\u05dc\u05d9\u05d2\u05d9\u05d5\u05d6\u05d9 \u05d4\u05db\u05d5\u05e4\u05e8: \u05d2\u05e8\u05e9\u05dd \u05e9\u05dc\u05d5\u05dd \u05d5\u05d4\u05ea\u05d0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05d4\u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05d5\u05ea''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05de\u05d5\u05e1\u05d3 \u05d1\u05d9\u05d0\u05dc\u05d9\u05e7, 2023\n* '''\u05d4\u05d0\u05dd \u05e2\u05d5\u05d3 \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05d0\u05e0\u05d7\u05e0\u05d5?'''-\u05de\u05e1\u05d4 \u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea, \u05d4\u05d5\u05e6\u05d0\u05ea [[\u05d4\u05de\u05db\u05d5\u05df \u05dc\u05de\u05d7\u05e9\u05d1\u05d4 \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea]], 2025\n* '''\u05d4\u05de\u05e0\u05d3\u05e8\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d9\u05e8\u05d5\u05e9\u05dc\u05d9\u05dd \u2013 \u05d4\u05e6\u05d5\u05e4\u05d9\u05dd \u05dc\u05d1\u05d9\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05de\u05d2\u05d1\u05e2\u05ea \u05e8\u05dd, 1980-1973''', \u05d4\u05d5\u05e6\u05d0\u05ea \u05db\u05e8\u05de\u05dc, 2025\n* '''\u05e4\u05e9\u05d9\u05d6\u05dd: \u05e7\u05d4\u05d9\u05dc\u05ea \u05d7\u05d5\u05d5\u05d9\u05d4 \u05d1\u05d0\u05d9\u05e8\u05d5\u05e4\u05d4, 1919-1945,''' \u05d4\u05d5\u05e6\u05d0\u05ea \u05de\u05d5\u05e1\u05d3 \u05d1\u05d9\u05d0\u05dc\u05d9\u05e7, 2026\n\n==\u05e1\u05e4\u05e8\u05d9\u05dd \u05e9\u05e2\u05e8\u05da==\n* '''\u05e2\u05d9\u05e6\u05d5\u05d1\u05d4 \u05e9\u05dc \u05d4\u05d6\u05d4\u05d5\u05ea \u05d4\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05ea''', \u05e4\u05e8\u05e0\u05e7 \u05e7\u05d0\u05e1, \u05dc\u05d5\u05e0\u05d3\u05d5\u05df, 1995\n* '''\u05de\u05d9\u05ea\u05d5\u05e1 \u05d5\u05d6\u05d9\u05db\u05e8\u05d5\u05df''', [[\u05d4\u05e7\u05d9\u05d1\u05d5\u05e5 \u05d4\u05de\u05d0\u05d5\u05d7\u05d3]], 1996.\n* [[\u05d9\u05e2\u05e7\u05d1 \u05d8\u05dc\u05de\u05d5\u05df]], '''\u05d7\u05d9\u05d3\u05ea \u05d4\u05d4\u05d5\u05d5\u05d4 \u05d5\u05e2\u05d5\u05e8\u05de\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4''', [[\u05de\u05d5\u05e1\u05d3 \u05d1\u05d9\u05d0\u05dc\u05d9\u05e7]], 2000\n* '''\u05dc\u05e7\u05e8\u05d5\u05d0 \u05d0\u05ea \u05d0\u05dc\u05d1\u05e8 \u05de\u05de\u05d9''', \u05e4\u05e8\u05d9\u05d6, \u05d6'\u05e0\u05d1\u05d4, \u05d1\u05e8\u05d9\u05e1\u05dc, 2002\n* [[\u05d9\u05d4\u05d5\u05e9\u05e2 \u05d0\u05e8\u05d9\u05d0\u05dc\u05d9]],''' \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05d5\u05de\u05d8\u05d4-\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4''', \u05de\u05d5\u05e1\u05d3 \u05d1\