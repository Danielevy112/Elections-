\u05d1[[\u05db\u05e4\u05e8 \u05e2\u05d6\u05d4]] \u05dc\u05e6\u05dc\u05d9\u05dc \u05d5\u05e2\u05d9\u05d3\u05d9\u05ea \u05e8\u05d5\u05e0\u05df. \u05d1\u05d9\u05dc\u05d3\u05d5\u05ea\u05d5 \u05e2\u05d1\u05e8\u05d4 \u05de\u05e9\u05e4\u05d7\u05ea\u05d5 \u05dc[[\u05db\u05d5\u05db\u05d1 \u05d9\u05d0\u05d9\u05e8 \u05e6\u05d5\u05e8 \u05d9\u05d2\u05d0\u05dc]], \u05d5\u05d0\u05ea \u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05d4\u05ea\u05d9\u05db\u05d5\u05df \u05e1\u05d9\u05d9\u05dd \u05d1\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 [[\u05e2\u05de\u05d9 \u05d0\u05e1\u05e3 (\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8)|\u05e2\u05de\u05d9 \u05d0\u05e1\u05e3]]. \u05d4\u05d5\u05d0 [[\u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea|\u05d4\u05ea\u05e0\u05d3\u05d1]] \u05dc\u05e9\u05e0\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea \u05d3\u05e8\u05da [[\u05d4\u05ea\u05e0\u05d5\u05e2\u05d4 \u05d4\u05e7\u05d9\u05d1\u05d5\u05e6\u05d9\u05ea]] \u05d1\u05e4\u05e0\u05d9\u05de\u05d9\u05d9\u05ea \u05e0\u05d5\u05d5\u05d4 \u05d0\u05d9\u05d9\u05dc, \u05d4\u05de\u05d8\u05e4\u05dc\u05ea \u05d1\u05d9\u05dc\u05d3\u05d9\u05dd \u05e2\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d5\u05ea. \u05e9\u05d9\u05e8\u05ea \u05d1\u05e6\u05d4\"\u05dc \u05d1[[\u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d2\u05dc\u05df]]. \u05d1\u05e9\u05e0\u05ea 2014 \u05e1\u05d9\u05d9\u05dd \u05d1\u05d4\u05e6\u05d8\u05d9\u05d9\u05e0\u05d5\u05ea \u05e7\u05d5\u05e8\u05e1 \u05e7\u05e6\u05d9\u05e0\u05d9\u05dd \u05d1[[\u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8 \u05dc\u05e7\u05e6\u05d9\u05e0\u05d9\u05dd \u05e9\u05dc \u05e6\u05d4\"\u05dc|\u05d1\u05d4\"\u05d3 1]]. \u05e9\u05d9\u05e8\u05ea \u05db\u05de\u05e4\u05e7\u05d3 \u05e6\u05d5\u05d5\u05ea \u05d1\u05de\u05d1\u05e6\u05e2 [[\u05e8\u05e6\u05d7 \u05e9\u05dc\u05d5\u05e9\u05ea \u05d4\u05e0\u05e2\u05e8\u05d9\u05dd|\u05e9\u05d5\u05d1\u05d5 \u05d0\u05d7\u05d9\u05dd]], \u05d1[[\u05de\u05d1\u05e6\u05e2 \u05e6\u05d5\u05e7 \u05d0\u05d9\u05ea\u05df]] \u05d5\u05d1[[\u05de\u05dc\u05d7\u05de\u05ea \u05d7\u05e8\u05d1\u05d5\u05ea \u05d1\u05e8\u05d6\u05dc]]. \u05d1\u05e9\u05e0\u05ea [[2021]] \u05e1\u05d9\u05d9\u05dd \u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05ea\u05d5\u05d0\u05e8 \u05e8\u05d0\u05e9\u05d5\u05df \u05d1[[\u05de\u05e9\u05e4\u05d8\u05d9\u05dd]] \u05d1[[\u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1]]. [[\u05d4\u05ea\u05de\u05d7\u05d5\u05ea (\u05e2\u05e8\u05d9\u05db\u05ea \u05d3\u05d9\u05df)|\u05d4\u05ea\u05de\u05d7\u05d4]] \u05d1[[\u05e4\u05e8\u05e7\u05dc\u05d9\u05d8\u05d5\u05ea \u05d4\u05de\u05d3\u05d9\u05e0\u05d4]] \u05d1\u05de\u05d7\u05dc\u05e7\u05d4 \u05d4\u05db\u05dc\u05db\u05dc\u05d9\u05ea \u05d4\u05e2\u05d5\u05e1\u05e7\u05ea \u05d1[[\u05e9\u05d7\u05d9\u05ea\u05d5\u05ea \u05e9\u05dc\u05d8\u05d5\u05e0\u05d9\u05ea \u05d1\u05d9\u05e9\u05e8\u05d0\u05dc|\u05e9\u05d7\u05d9\u05ea\u05d5\u05ea \u05e9\u05dc\u05d8\u05d5\u05e0\u05d9\u05ea]], \u05e2\u05d1\u05d9\u05e8\u05d5\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05e0\u05d9\u05d5\u05ea \u05d5\u05e2\u05d1\u05d9\u05e8\u05d5\u05ea [[\u05e6\u05d5\u05d5\u05d0\u05e8\u05d5\u05df \u05dc\u05d1\u05df]].{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=MAKO|{{\u05de\u05d0\u05e7\u05d5|[[\u05d0\u05d9\u05dc\u05df \u05dc\u05d5\u05e7\u05d0\u05e5']]|\"\u05dc\u05d0 \u05d7\u05d9\u05db\u05d9\u05e0\u05d5 \u05dc\u05d0\u05e3 \u05d0\u05d7\u05d3\": \u05d4\u05d9\u05d5\u05d6\u05de\u05d4 \u05e9\u05dc \u05e4\u05e2\u05d9\u05dc\u05d9 \u05d0\u05d7\u05d9\u05dd \u05dc\u05e0\u05e9\u05e7 \u05dc\u05e9\u05d9\u05e7\u05d5\u05dd \u05db\u05e4\u05e8 \u05e2\u05d6\u05d4|f5aaafddaeb2691027|news-israel/2025_q2|13 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2025}}}}\n\n=== \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea ===\n\u05e8\u05d5\u05e0\u05df \u05d4\u05d5\u05d0 \u05d1\u05d5\u05d2\u05e8 \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4-Fellowship \u05e9\u05dc \"[[StandWithUs]]\", \u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05de\u05db\u05e9\u05d9\u05e8\u05d4 \u05e1\u05d8\u05d5\u05d3\u05e0\u05d8\u05d9\u05dd \u05de\u05d5\u05d1\u05d9\u05dc\u05d9\u05dd \u05dc\u05e7\u05d9\u05d3\u05d5\u05dd \u05ea\u05d3\u05de\u05d9\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05e2\u05d5\u05dc\u05dd. \u05d1\u05e9\u05e0\u05ea 2022 \u05d9\u05d9\u05e1\u05d3 \u05e2\u05dd \u05d7\u05d1\u05e8\u05d9\u05dd \u05d0\u05ea \u05e2\u05de\u05d5\u05ea\u05ea \"\u05d9\u05d4\u05d1-\u05de\u05d7\u05e0\u05db\u05d9\u05dd \u05dc\u05e6\u05d9\u05d5\u05e0\u05d5\u05ea\", \u05e9\u05de\u05d8\u05e8\u05ea\u05d4 \u05dc\u05e2\u05d5\u05e8\u05e8 \u05d5\u05dc\u05d4\u05e2\u05de\u05d9\u05e7 \u05d0\u05ea \u05d4\u05d6\u05d4\u05d5\u05ea \u05d4\u05e6\u05d9\u05d5\u05e0\u05d9\u05ea \u05d1\u05e7\u05e8\u05d1 \u05e7\u05d1\u05d5\u05e6\u05d5\u05ea \u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d7\u05d9\u05e0\u05d5\u05da, \u05d1\u05d9\u05e8\u05d5\u05e8 \u05e8\u05e2\u05d9\u05d5\u05e0\u05d9 \u05d5\u05e2\u05e9\u05d9\u05d9\u05d4 \u05d7\u05d1\u05e8\u05ea\u05d9\u05ea.<ref>{{\u05e7\u05d9\u05e9\u05d5\u05e8 \u05db\u05dc\u05dc\u05d9|\u05db\u05ea\u05d5\u05d1\u05ea=Https://podcasts.apple.com/ch/podcast/\u05e2\u05d9\u05df-\u05dc\u05e6\u05d9\u05d5\u05df/id1693224104|\u05db\u05d5\u05ea\u05e8\u05ea=\u05e2\u05d9\u05df \u05dc\u05e6\u05d9\u05d5\u05df, \u05de\u05d1\u05d8 \u05e2\u05dc \u05e6\u05d9\u05d5\u05e0\u05d5\u05ea \u05d1\u05d2\u05d5\u05d1\u05d4 \u05d4\u05e2\u05d9\u05e0\u05d9\u05d9\u05dd|\u05d0\u05ea\u05e8=[[\u05d0\u05e4\u05dc \u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8\u05d9\u05dd]]|\u05ea\u05d0\u05e8\u05d9\u05da_\u05d5\u05d9\u05d3\u05d5\u05d0=2025-04-17}}</ref>\n\n\u05d1\u05e9\u05e0\u05ea 2023 \u05d4\u05d7\u05dc \u05d0\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea\u05d5 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea [[\u05d4\u05de\u05d7\u05d0\u05d4 \u05e0\u05d2\u05d3 \u05d4\u05e8\u05e4\u05d5\u05e8\u05de\u05d4 \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05ea]], \u05ea\u05d7\u05d9\u05dc\u05d4 \u05d1\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05ea\u05d0\u05e8\u05d2\u05e0\u05d5\u05ea \u05e2\u05e6\u05de\u05d0\u05d9\u05ea \u05e2\u05dd \u05d7\u05d1\u05e8\u05d9\u05d5 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05e6\u05d1\u05d0\u05d9 \u05d5\u05d4\u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05dd, \u05d5\u05d1\u05d4\u05de\u05e9\u05da \u05db\u05d0\u05d7\u05d3 \u05de\u05de\u05d5\u05d1\u05d9\u05dc\u05d9 \u05ea\u05e0\u05d5\u05e2\u05ea \"[[\u05d0\u05d7\u05d9\u05dd \u05d5\u05d0\u05d7\u05d9\u05d5\u05ea \u05dc\u05e0\u05e9\u05e7]]\"<ref name=\":1\" />. \u05d1\u05de\u05d4\u05dc\u05da \u05ea\u05e7\u05d5\u05e4\u05d4 \u05d6\u05d5, \u05d4\u05e6\u05d4\u05d9\u05e8 \u05db\u05d9 \u05d9\u05e9\u05e2\u05d4 \u05d0\u05ea \u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea\u05d5 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05dd \u05d1\u05de\u05d9\u05d3\u05d4 \u05d5\u05ea\u05d5\u05e9\u05dc\u05dd \u05d7\u05e7\u05d9\u05e7\u05ea \u05d4\u05e8\u05e4\u05d5\u05e8\u05de\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05de\u05de\u05e9\u05dc\u05d4, \u05d0\u05da \u05d1\u05e4\u05d5\u05e2\u05dc \u05d4\u05de\u05e9\u05d9\u05da \u05dc\u05d4\u05ea\u05d9\u05d9\u05e6\u05d1 \u05dc\u05e9\u05d9\u05e8\u05d5\u05ea \u05db\u05e1\u05d3\u05e8\u05d5<ref name=\":0\">{{ynet|\u05e8\u05d5\u05e2\u05d9 \u05e8\u05d5\u05d1\u05d9\u05e0\u05e9\u05d8\u05d9\u05d9\u05df|\u05d3\u05d9\u05e1\u05d8\u05dc \u05dc\u05e4\u05e2\u05d9\u05dc \u05d0\u05d7\u05d9\u05dd \u05dc\u05e0\u05e9\u05e7 \u05e9\u05e1\u05d1\u05ea\u05d5 \u05e0\u05e8\u05e6\u05d7\u05d4 \u05d1-7/10: \"\u05d4\u05d5\u05d1\u05dc\u05ea\u05dd \u05dc\u05d8\u05d1\u05d7, \u05d9\u05d3\u05d9\u05da \u05de\u05d2\u05d5\u05d0\u05dc\u05d5\u05ea \u05d1\u05d3\u05dd\"|news/article/r1ejyz6v0|11 \u05d1\u05d9\u05d5\u05dc\u05d9 2024}}}</ref>.\n\n\u05e2\u05dd \u05e4\u05e8\u05d5\u05e5 [[\u05d8\u05d1\u05d7 \u05e9\u05d1\u05e2\u05d4 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8|\u05de\u05ea\u05e7\u05e4\u05ea \u05d4\u05e4\u05ea\u05e2]] \u05d1-7 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2023, \u05d2\u05d9\u05d9\u05e1 \u05e2\u05e6\u05de\u05d0\u05d9\u05ea \u05d0\u05ea \u05e6\u05d5\u05d5\u05ea\u05d5 \u05e2\u05d5\u05d3 \u05d1\u05d8\u05e8\u05dd \u05e7\u05d1\u05dc\u05ea \u05e6\u05d5 \u05e7\u05e8\u05d9\u05d0\u05d4 \u05e8\u05e9\u05de\u05d9, \u05d5\u05d4\u05dd \u05d9\u05e8\u05d3\u05d5 \u05dc\u05dc\u05d7\u05d9\u05de\u05d4 \u05d1[[\u05e2\u05d5\u05d8\u05e3 \u05e2\u05d6\u05d4]], \u05d1\u05de\u05d4\u05dc\u05db\u05d4 \u05e0\u05dc\u05d7\u05de\u05d5 \u05d1\u05de\u05d7\u05d1\u05dc\u05d9\u05dd [[\u05d4\u05d8\u05d1\u05d7 \u05d1\u05e0\u05d9\u05e8 \u05e2\u05d5\u05d6|\u05e9\u05e4\u05dc\u05e9\u05d5 \u05dc\u05e7\u05d9\u05d1\u05d5\u05e5 \u05e0\u05d9\u05e8 \u05e2\u05d5\u05d6]]. \u05d1\u05e2\u05d5\u05d3\u05d5 \u05e0\u05dc\u05d7\u05dd, \u05d4\u05de\u05ea\u05d9\u05df \u05dc\u05d0\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05de\u05e1\u05d1\u05ea\u05d5, \u05e0\u05d9\u05e8\u05d4 \u05e8\u05d5\u05e0\u05df, \u05ea\u05d5\u05e9\u05d1\u05ea [[\u05db\u05e4\u05e8 \u05e2\u05d6\u05d4]]. \u05db\u05e2\u05d1\u05d5\u05e8 \u05d9\u05d5\u05de\u05d9\u05d9\u05dd \u05e0\u05d5\u05d3\u05e2 \u05db\u05d9 \u05d4\u05d9\u05d0 \u05e0\u05e8\u05e6\u05d7\u05d4 \u05d1\u05d1\u05d9\u05ea\u05d4 \u05d9\u05d7\u05d3 \u05e2\u05dd \u05d4\u05de\u05d8\u05e4\u05dc\u05ea \u05e9\u05dc\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05d7\u05d1\u05dc\u05d9 \u05d7\u05de\u05d0\u05e1, \u05d0\u05e9\u05e8 \u05d4\u05d5\u05ea\u05d9\u05e8\u05d5 \u05d1\u05de\u05e7\u05d5\u05dd \u05de\u05db\u05ea\u05d1 \u05d4\u05de\u05e4\u05e8\u05d8 \u05d0\u05ea \u05db\u05d5\u05d5\u05e0\u05d5\u05ea\u05d9\u05d4\u05dd<ref>{{ynet|\u05de\u05ea\u05df \u05e6\u05d5\u05e8\u05d9|\"\u05ea\u05de\u05d5\u05ea\u05d5, \u05d5\u05dc\u05d0 \u05ea\u05d9\u05e9\u05d0\u05e8\u05d5 \u05e4\u05d4\": \u05d4\u05de\u05db\u05ea\u05d1 \u05e9\u05d4\u05d5\u05ea\u05d9\u05e8\u05d5 \u05de\u05d7\u05d1\u05dc\u05d9 \u05d7\u05de\u05d0\u05e1 \u05d1\u05d1\u05d9\u05ea \u05e0\u05d9\u05e8\u05d4 \u05e9\u05e0\u05e8\u05e6\u05d7\u05d4 \u05d1\u05db\u05e4\u05e8 \u05e2\u05d6\u05d4|news/article/sycm17396|4 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2024}}</ref>. \u05d7\u05e8\u05e3 \u05d4\u05d0\u05e1\u05d5\u05df \u05d4\u05de\u05e9\u05e4\u05d7\u05ea\u05d9, \u05d4\u05de\u05e9\u05d9\u05da \u05dc\u05e9\u05e8\u05ea \u05d1\u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc \u05d1\u05de\u05e9\u05da 320 \u05d9\u05de\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd<ref name=\":0\" />. \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05de\u05dc\u05d7\u05de\u05d4, \u05d9\u05d6\u05dd \u05e8\u05d5\u05e0\u05df \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05ea\u05e0\u05d3\u05d1\u05d5\u05ea\u05d9 \u05dc\u05e9\u05d9\u05e4\u05d5\u05e5 \u05d5\u05d1\u05e0\u05d9\u05d9\u05d4 \u05de\u05d7\u05d5\u05d3\u05e9\u05ea \u05e9\u05dc 16 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d3\u05d9\u05d5\u05e8 \u05d1\u05e7\u05d9\u05d1\u05d5\u05e5 \u05db\u05e4\u05e8 \u05e2\u05d6\u05d4. \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d1\u05d5\u05e6\u05e2 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05ea\u05e0\u05d3\u05d1\u05d9\u05dd \u05d5\u05ea\u05d5\u05e8\u05de\u05d9\u05dd \u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd, \u05d5\u05e0\u05de\u05e1\u05e8 \u05dc\u05d9\u05d3\u05d9 \u05d4\u05e7\u05d9\u05d1\u05d5\u05e5 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2025. \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05d5\u05d0 \u05d9\u05d5\u05d6\u05de\u05d4 \u05de\u05e9\u05d5\u05ea\u05e4\u05ea \u05e9\u05dc \u05d4\u05e7\u05d9\u05d1\u05d5\u05e5 \u05d9\u05d7\u05d3 \u05e2\u05dd \"\u05d1\u05d5\u05e0\u05d9\u05dd \u05de\u05d7\u05d3\u05e9\", \u05d4\u05d6\u05e8\u05d5\u05e2 \u05d4\u05d1\u05d9\u05e6\u05d5\u05e2\u05d9\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05ea \u05e9\u05dc \"\u05d0\u05d7\u05d9\u05dd \u05d5\u05d0\u05d7\u05d9\u05d5\u05ea \u05dc\u05e0\u05e9\u05e7\".{{\u05d4\u05e2\u05e8\u05d4|\u05e9\u05dd=MAKO}}<ref>{{ynet|\u05de\u05d0\u05d9\u05d4 \u05d1\u05e0\u05d9\u05d8\u05d4|\"\u05d0\u05d7\u05e8\u05d9 \u05d9\u05d5\u05ea\u05e8 \u05de\u05e9\u05e0\u05d4 \u05e9\u05d4\u05de\u05d3\u05d9\u05e0\u05d4 \u05dc\u05d0 \u05e0\u05d2\u05e2\u05d4 \u05d1\u05e7\u05d9\u05d1\u05d5\u05e5, \u05d4\u05d7\u05dc\u05d8\u05e0\u05d5 \u05dc\u05e9\u05e4\u05e5 \u05d1\u05db\u05e4\u05e8 \u05e2\u05d6\u05d4\"|architecture/article/byenv4alyg|12 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2025}}</ref>\n\n\u05d1\u05e9\u05e0\u05ea 2024 \u05e0\u05d1\u05d7\u05e8 \u05dc\u05e8\u05e9\u05d9\u05de\u05ea 40 \u05d4\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d4\u05de\u05d1\u05d8\u05d9\u05d7\u05d9\u05dd \u05d1\u05e0\u05d9 \u05e4\u05d7\u05d5\u05ea \u05de-40 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e2\u05d9\u05ea\u05d5\u05df \"[[TheMarker]]\".<ref name=\":1\">{{TheMarker|\u05d9\u05e4\u05e2\u05ea \u05e8\u05d0\u05d5\u05d1\u05df|40/40 \u05d4\u05e6\u05e2\u05d9\u05e8\u05d9\u05dd \u05d4\u05de\u05d1\u05d8\u05d9\u05d7\u05d9\u05dd 2025: \u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df|00000194-0326-d453-a3fd-a32f58ea0000|1 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2025}}</ref>\n\n=== \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea ===\n\u05d1-2026 \u05d4\u05e6\u05d8\u05e8\u05e3 \u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df \u05dc\u05de\u05e4\u05dc\u05d2\u05ea \"[[\u05d4\u05d3\u05de\u05d5\u05e7\u05e8\u05d8\u05d9\u05dd]]\" \u05d1\u05e8\u05d0\u05e9\u05d5\u05ea [[\u05d9\u05d0\u05d9\u05e8 \u05d2\u05d5\u05dc\u05df]],<ref>{{\u05d9\u05e9\u05e8\u05d0\u05dc \u05d4\u05d9\u05d5\u05dd||\u05d0\u05d7\u05ea \u05d4\u05d3\u05de\u05d5\u05d9\u05d5\u05ea \u05d4\u05d1\u05d5\u05dc\u05d8\u05d5\u05ea \u05de\u05d4\u05de\u05d7\u05d0\u05d4 \u05d4\u05db\u05e8\u05d9\u05d6\u05d4 \u05e2\u05dc \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05dc\u05db\u05e0\u05e1\u05ea|news/politics/article/19845838|6 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2026}}</ref> \u05d5\u05e0\u05d1\u05d7\u05e8 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05e9\u05d1\u05d9\u05e2\u05d9 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4 \u05d1[[\u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05d1\u05de\u05e4\u05dc\u05d2\u05ea \u05d4\u05d3\u05de\u05d5\u05e7\u05e8\u05d8\u05d9\u05dd (2026)|\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05e4\u05dc\u05d2\u05d4]].{{\u05d4\u05e2\u05e8\u05d4|{{NFC||\u05e2\u05d5\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df \u05db\u05d5\u05d1\u05e9 \u05d0\u05ea \u05d4\u05e9\u05d8\u05d7|0026-D-184654-00|5 \u05d1\u05d9\u05d5\u05dc\u05d9 2026}}}} \u05dc\u05e7\u05e8\u05d0\u05ea \u05d4\u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05e7\u05e8\u05d0 [[\u05e9\u05e8 \u05d4\u05d1\u05d9\u05d8\u05d7\u05d5\u05df]] [[\u05d9\u05e9\u05e8\u05d0\u05dc \u05db\"\u05e5 (\u05d4\u05dc\u05d9\u05db\u05d5\u05d3)|\u05d9\u05e9\u05e8\u05d0\u05dc \u05db\"\u05e5]] \u05dc\u05d4\u05d3\u05d9\u05d7 \u05d0\u05ea \u05e8\u05d5\u05e0\u05df \u05de\u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05dd, \u05d1\u05e2\u05e7\u05d1\u05d5\u05ea \u05d4\u05ea\u05d1\u05d8\u05d0\u05d5\u05d9\u05d5\u05ea\u05d9\u05d5 \u05d4\u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05d1\u05e2\u05e0\u05d9\u05d9\u05df \u05e1\u05e8\u05d1\u05e0\u05d5\u05ea \u05de\u05e6\u05d4\"\u05dc \u05db\u05e6\u05e2\u05d3 {{\u05d4|\u05de\u05d7\u05d0\u05d4 \u05e0\u05d2\u05d3 \u05d4\u05e8\u05e4\u05d5\u05e8\u05de\u05d4 \u05d4\u05de\u05e9\u05e4\u05d8\u05d9\u05ea}} \u05dc\u05db\u05e9\u05ea\u05e7\u05d5\u05d3\u05dd.{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05d0\u05e7\u05d5|\u05d3\u05e4\u05e0\u05d4 \u05dc\u05d9\u05d0\u05dc, \u05d9\u05e8\u05d5\u05df \u05d0\u05d1\u05e8\u05d4\u05dd|\u05db\"\u05e5: \u05d4\u05d5\u05e8\u05d9\u05ea\u05d9 \u05dc\u05e8\u05de\u05d8\u05db\"\u05dc \u05dc\u05d4\u05d3\u05d9\u05d7 \u05de\u05e9\u05d9\u05e8\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05dd \u05d0\u05ea \u05de\u05d5\u05e2\u05de\u05d3 \u05d4\u05d3\u05de\u05d5\u05e7\u05e8\u05d8\u05d9\u05dd \u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df|a7914c8753a7f91027|news-politics/2026_q3|19 \u05d1\u05d9\u05d5\u05dc\u05d9 2026}}}}\n\n== \u05ea\u05d1\u05d9\u05e2\u05d5\u05ea \u05d3\u05d9\u05d1\u05d4 ==\n\u05d1\u05e9\u05e0\u05ea 2024 \u05d4\u05d2\u05d9\u05e9 \u05ea\u05d1\u05d9\u05e2\u05ea [[\u05dc\u05e9\u05d5\u05df \u05d4\u05e8\u05e2]] \u05e0\u05d2\u05d3 \u05d7\u05d1\u05e8\u05ea \u05d4\u05db\u05e0\u05e1\u05ea [[\u05d2\u05dc\u05d9\u05ea \u05d3\u05d9\u05e1\u05d8\u05dc-\u05d0\u05d8\u05d1\u05e8\u05d9\u05d0\u05df]], \u05dc\u05d0\u05d7\u05e8 \u05e9\u05dc\u05d8\u05e2\u05e0\u05ea\u05d5 \u05d4\u05e1\u05d9\u05ea\u05d4 \u05e0\u05d2\u05d3\u05d5 \u05d1\u05db\u05da \u05e9\u05d8\u05e2\u05e0\u05d4 \u05d1\u05e8\u05e9\u05ea\u05d5\u05ea \u05d4\u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea \u05d1\u05d9\u05df \u05d4\u05d9\u05ea\u05e8 \u05db\u05d9 \u05d3\u05dd \u05e0\u05e8\u05e6\u05d7\u05d9 \u05d4\u05e9\u05d1\u05e2\u05d4 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9\u05d5 \u05d5\u05e9\u05d4\u05d5\u05d0 \"[[\u05e2\u05e8\u05d1 \u05e8\u05d1]]\". \u05d1\u05de\u05d4\u05dc\u05da \u05e9\u05e0\u05d4 \u05d6\u05d5 \u05d4\u05d2\u05d9\u05e9 \u05e2\u05d5\u05d3 \u05ea\u05d1\u05d9\u05e2\u05d5\u05ea \u05db\u05e0\u05d2\u05d3 \u05d0\u05e0\u05e9\u05d9\u05dd \u05e9\u05d4\u05ea\u05d1\u05d8\u05d0\u05d5 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d3\u05d5\u05de\u05d4.<ref name=\":0\" /><ref>{{\u05d7\u05d3\u05e9\u05d5\u05ea 13|[[\u05d0\u05d1\u05d9\u05e2\u05d3 \u05d2\u05dc\u05d9\u05e7\u05de\u05df]]|\u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df \u05dc\u05d7\"\u05db \u05d3\u05d9\u05e1\u05d8\u05dc: \"\u05d4\u05ea\u05e8\u05ea \u05d0\u05ea \u05d3\u05de\u05d9; \u05d4\u05ea\u05e0\u05e6\u05dc\u05d9 \u05d0\u05d5 \u05e9\u05d0\u05ea\u05d1\u05e2\"|item/news/domestic/crime-and-justice/ywwqv-904150223|15 \u05d1\u05d9\u05d5\u05dc\u05d9 2024}}</ref>{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05e2\u05d9\u05df \u05d4\u05e9\u05d1\u05d9\u05e2\u05d9\u05ea|\u05d0\u05d5\u05e8\u05df \u05e4\u05e8\u05e1\u05d9\u05e7\u05d5|\u05d0\u05d7\u05d9\u05dd-\u05dc\u05e0\u05e9\u05e7 \u05e0\u05d2\u05d3 \u05de\u05db\u05d5\u05e0\u05ea \u05d4\u05e8\u05e2\u05dc|528433|2 \u05d1\u05e1\u05e4\u05d8\u05de\u05d1\u05e8 2024}}}} \u05d3\u05d9\u05e1\u05d8\u05dc-\u05d0\u05d8\u05d1\u05e8\u05d9\u05d0\u05df \u05d8\u05e2\u05e0\u05d4 \u05e9\u05d1\u05d6\u05db\u05d5\u05ea [[\u05d7\u05e1\u05d9\u05e0\u05d5\u05ea \u05e4\u05e8\u05dc\u05de\u05e0\u05d8\u05e8\u05d9\u05ea|\u05d7\u05e1\u05d9\u05e0\u05d5\u05ea\u05d4]] \u05db\u05d7\u05d1\u05e8\u05ea \u05db\u05e0\u05e1\u05ea \u05d9\u05e9 [[\u05d3\u05d7\u05d9\u05d9\u05d4 \u05e2\u05dc \u05d4\u05e1\u05e3|\u05dc\u05d3\u05d7\u05d5\u05ea \u05d0\u05ea \u05d4\u05ea\u05d1\u05d9\u05e2\u05d4 \u05e2\u05dc \u05d4\u05e1\u05e3]], \u05d5\u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2026 \u05d1\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d8 \u05e7\u05d9\u05d1\u05dc \u05d0\u05ea \u05e2\u05de\u05d3\u05ea\u05d4.{{\u05d4\u05e2\u05e8\u05d4|{{\u05de\u05e2\u05e8\u05d9\u05d1 \u05d0\u05d5\u05e0\u05dc\u05d9\u05d9\u05df||\u05dc\u05d0 \u05ea\u05ea\u05e0\u05e6\u05dc \u05d5\u05dc\u05d0 \u05ea\u05e9\u05dc\u05dd: \u05d7\u05d1\u05e8\u05ea \u05d4\u05db\u05e0\u05e1\u05ea \u05de\u05d4\u05dc\u05d9\u05db\u05d5\u05d3 \u05e0\u05d9\u05e6\u05d7\u05d4 \u05d1\u05e2\u05e0\u05e7 \u05d1\u05d1\u05d9\u05ea \u05d4\u05de\u05e9\u05e4\u05d8|news/law/article-1277757|27 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2026}};{{\u05e9}}{{\u05d4\u05e2\u05e8\u05d4|[https://www.nevo.co.il/psika_html/shalom/SH-24-09-5803-265.htm \u05ea\"\u05d0 (\u05ea\"\u05d0) 5803-09-24 \u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df \u05e0' \u05d7\"\u05db \u05d2\u05dc\u05d9\u05ea \u05d3\u05d9\u05e1\u05d8\u05dc \u05d0\u05d8\u05d1\u05e8\u05d9\u05d0\u05df], \u05e0\u05d9\u05ea\u05df \u05d1-27 \u05d9\u05e0\u05d5\u05d0\u05e8 2026, \u05d1\u05d0\u05ea\u05e8 \"[[\u05d4\u05d5\u05e6\u05d0\u05ea \u05e0\u05d1\u05d5|\u05e0\u05d1\u05d5]]\"}}}}\n\n\u05d1\u05e4\u05e1\u05e7 \u05d3\u05d9\u05df \u05d0\u05d7\u05e8 \u05e0\u05e7\u05d1\u05e2 \u05e9\u05de\u05d5\u05e8\u05df \u05dc\u05d5\u05d9\u05d0\u05df, \u05e9\u05e4\u05e8\u05e1\u05de\u05d4 \u05d1\u05e9\u05e0\u05ea 2024 \u05e6\u05d9\u05d5\u05e6\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05e0\u05d2\u05d3 \u05e8\u05d5\u05e0\u05df, \u05ea\u05e4\u05e6\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05e1\u05da \u05e9\u05dc 27,000 \u05e9\"\u05d7 \u05d5\u05ea\u05e4\u05e8\u05e1\u05dd [[\u05d4\u05ea\u05e0\u05e6\u05dc\u05d5\u05ea]] \u05d1\u05d7\u05e9\u05d1\u05d5\u05df \u05d4[[\u05d8\u05d5\u05d5\u05d9\u05d8\u05e8]] \u05e9\u05dc\u05d4.{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05e2\u05d9\u05df \u05d4\u05e9\u05d1\u05d9\u05e2\u05d9\u05ea|\u05d0\u05d5\u05e8\u05df \u05e4\u05e8\u05e1\u05d9\u05e7\u05d5|\u05d4\u05db\u05e4\u05d9\u05e9\u05d4 \u05e4\u05e2\u05d9\u05dc \u05de\u05d7\u05d0\u05d4 \u05d5\u05ea\u05e9\u05dc\u05dd|578368|6 \u05d1\u05de\u05e8\u05e5 2026}}}}\n\n==\u05d7\u05d9\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05d9\u05dd==\n\u05e0\u05e9\u05d5\u05d9 \u05dc\u05ea\u05de\u05e8, \u05e1\u05d8\u05d0\u05d6'\u05e8\u05d9\u05ea \u05dc\u05e8\u05e4\u05d5\u05d0\u05d4, \u05d5\u05d0\u05d1 \u05dc\u05e9\u05e0\u05d9\u05d9\u05dd.{{\u05d4\u05e2\u05e8\u05d4|{{\u05d5\u05d5\u05d0\u05dc\u05d4||\u05d1\u05e9\u05e2\u05d4 \u05d8\u05d5\u05d1\u05d4: \u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df, \u05de\u05de\u05d5\u05d1\u05d9\u05dc\u05d9 \"\u05d0\u05d7\u05d9\u05dd \u05dc\u05e0\u05e9\u05e7\", \u05d0\u05d1\u05d0 \u05dc\u05e9\u05e0\u05d9\u05d9\u05dd|3822433|9 \u05d1\u05de\u05e8\u05e5 2026}}}} \u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05de\u05ea\u05d2\u05d5\u05e8\u05e8\u05ea \u05d1\u05d0\u05d6\u05d5\u05e8 \u05d4\u05de\u05e8\u05db\u05d6.{{\u05d4\u05e2\u05e8\u05d4|{{\u05d4\u05d0\u05e8\u05e5|\u05d9\u05e0\u05d0\u05d9 \u05d9\u05d7\u05d9\u05d0\u05dc \u05d5\u05e9\u05d9 \u05e4\u05d5\u05d2\u05dc\u05de\u05df|\u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df|00000190-3536-d4fa-ad9d-ff3fcc2a0000|20 \u05d1\u05d9\u05d5\u05e0\u05d9 2024}}}}\n\n== \u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd ==\n{{\u05d5\u05d9\u05e7\u05d9\u05e9\u05d9\u05ea\u05d5\u05e3 \u05d1\u05e9\u05d5\u05e8\u05d4}}\n{{\u05e8\u05e9\u05ea\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea}}\n* {{\u05d9\u05d5\u05d8\u05d9\u05d5\u05d1|n-yQNkr4_y4|\u05e9\u05dd='\u05d1\u05d5\u05e0\u05d9\u05dd \u05de\u05d7\u05d3\u05e9', \u05d4\u05e8\u05e6\u05e4\u05d5\u05ea \u05d4\u05d9\u05e8\u05d5\u05e7\u05d5\u05ea \u2013 \u05d0\u05d5\u05dc\u05e4\u05df \u05e9\u05d9\u05e9\u05d9|\u05e2\u05e8\u05d5\u05e5=\u05d1\u05d5\u05e0\u05d9\u05dd \u05de\u05d7\u05d3\u05e9|\u05d0\u05d5\u05e8\u05da=20:24|\u05ea\u05d0\u05e8\u05d9\u05da=11 \u05d1\u05d0\u05e4\u05e8\u05d9\u05dc 2025}}\n* {{\u05db\u05d0\u05df|\u05de\u05d5\u05d0\u05d1 \u05d5\u05e8\u05d3\u05d9|\u05de\u05d4\u05e7\u05d5\u05de\u05e0\u05d3\u05d5 \u05dc\u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05e7\u05d4: \u05e2\u05de\u05e8\u05d9 \u05e8\u05d5\u05e0\u05df \u05de\u05e6\u05d8\u05e8\u05e3 \u05dc\u05d9\u05d0\u05d9\u05e8 \u05d2\u05d5\u05dc\u05df|content/kan-news/newstv/p-963853/s2/1001403/|20 \u05d1\u05e4\u05d1\u05e8\u05d5\u05d0\u05e8 2026|content}}\n\n==\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd==\n{{\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd}}\n\n{{\u05de\u05d9\u05d5\u05df \u05e8\u05d2\u05d9\u05dc:\u05e8\u05d5\u05e0\u05df, \u05e2\u05de\u05e8\u05d9}}\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05d1\u05d5\u05d2\u05e8\u05d9 \u05d4\u05ea\u05d9\u05db\u05d5\u05df \u05d4\u05d0\u05d6\u05d5\u05e8\u05d9 \u05e2\u05de\u05d9 \u05d0\u05e1\u05e3]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05dc\u05d5\u05d7\u05de\u05d9 \u05d9\u05d7\u05d9\u05d3\u05ea \u05de\u05d2\u05dc\u05df]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05d1\u05d5\u05d2\u05e8\u05d9 \u05d0\u05d5\u05e0\u05d9\u05d1\u05e8\u05e1\u05d9\u05d8\u05ea \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1: \u05de\u05e9\u05e4\u05d8\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e4\u05e2\u05d9\u05dc\u05d9 \u05d0\u05d7\u05d9\u05dd \u05dc\u05e0\u05e9\u05e7]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05e4\u05e2\u05d9\u05dc\u05d9 \u05de\u05e4\u05dc\u05d2\u05ea \u05d4\u05d3\u05de\u05d5\u05e7\u05e8\u05d8\u05d9\u05dd]]\n[[\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4:\u05d9\u05e9\u05e8\u05d0\u05dc\u05d9\u05dd \u05e9\u05e0\u05d5\u05dc\u05d3\u05d5 \u05d1-1992]]"}}}]}}}}