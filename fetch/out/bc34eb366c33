d_article_1"><div class="OUTBRAIN" data-src="https://www.walla.co.il/news/politics/383958065" data-widget-id="AR_4"></div></div></div></section><section class="styles_section__gpdMj"><section><div><div class="styles_prose__mTq51"><p>יו"ר יש עתיד, יאיר לפיד, בירך גם הוא על החלטתו של גנץ: <mark>"מברך את גנץ שעשה היום את המעשה האחראי והנכון, מאחל לו הרבה בהצלחה בהמשך"</mark>.</p><p></p><p>יו"ר הדמוקרטים, יאיר גולן, מסר: <mark>"גנץ קיבל החלטה אחראית ונכונה. בשעה גורלית לעתידה של ישראל, האחריות המשותפת היא להבטיח את ניצחון גוש השינוי"</mark>. לדבריו, מפלגתו מחויבת לשינוי ולתיקון אמיתי, ולישראל יהודית, דמוקרטית, ליברלית, חזקה ובטוחה.</p></div></div></section><div class="styles_adSection__3hjUy"></div></section><section class="styles_section__gpdMj"><section><div><div class="styles_prose__mTq51"><p>גם יו"ר מפלגת המילואימניקים והכלכלית, יועז הנדל, בירך על ההחלטה: <mark>"בני גנץ עשה את המעשה הראוי והמתבקש למען המדינה"</mark>. הנדל קרא למצביעי הגוש השלישי להצטרף למפלגתו, וטען כי זו הדרך היחידה להקמת ממשלה ציונית.</p><p></p><p>מפלגת הציונות הדתית טענה כי פרישת גנץ נועדה למנוע אובדן קולות בגוש השמאל, ותקפה את עופר וינטר ומפלגות נוספות בימין שאינן עוברות את אחוז החסימה. "זוהי אזעקת אמת. אני קורא לעופר ולחבריו להתעשת ולקחת אחריות", נמסר מהמפלגה. עוד הזהירו: <mark>"אם הימין יאבד קולות השמאל יעלה לשלטון. לא מהמרים על מדינת ישראל!"</mark></p></div></div></section><div class="styles_adSection__3hjUy"><div id="outbrain_textlinks_article"><div class="OUTBRAIN" data-src="https://www.walla.co.il/news/politics/383958065" data-widget-id="AR_5"></div></div></div></section><section class="styles_section__gpdMj"><section><div><div class="styles_prose__mTq51"><p>ממפלגת עמך ישראל בראשות עופר וינטר נמסר: "אנו מודים לבני גנץ על עשרות שנות שירות למען מדינת ישראל". במפלגה טענו כי פרישתו ממחישה את חשיבותה, והוסיפו: <mark>"מי שרוצה ימין משרת ומכריע שאינו תלוי באצבע ה-61 של גולדקנופף יש לו רק בית אחד - עמך ישראל"</mark>.</p><p></p><p>גורמים במפלגת עמך ישראל הוסיפו: "גנץ פינה לנו את הדרך". לדבריהם, בניגוד למפלגתו של הנדל וליתר מפלגות גוש השינוי, מפלגתם אינה מוכנה להמשיך בחרם על בנימין נתניהו ומחנה הימין. עוד טענו כי סקרי עומק מצביעים על כך שמצביעי גנץ רואים בעמך ישראל את ביתם הפוליטי.</p></div></div></section><div class="styles_adSection__3hjUy"></div></section><section class="styles_section__gpdMj"><section><div><div class="styles_prose__mTq51"><p>יו"ר יהדות התורה, ח"כ יעקב אשר, בירך על החלטת גנץ: "ידידי בני גנץ הוא 'מענטש', אדם שתרם רבות למדינת ישראל ולביטחונה". אשר הוסיף כי השניים שמרו על קשר אישי והערכה הדדית למרות חילוקי הדעות.</p><p></p><p>רועי קונקול התייחס לפרישה וכתב: <mark>"תם ולא נשלם. עשינו כמיטב יכולתנו ולא הצלחנו לשכנע את עם ישראל שאנחנו כוח פוליטי שנדרש במערכת הפוליטית"</mark>. הוא הודה לגנץ ולצוותו והודיע כי לאחר מנוחה קצרה יצטרף לחבריו במילואים בלבנון.</p></div></div></section><div class="styles_adSection__3hjUy"><div id="outbrain_mid_article_2"><div class="OUTBRAIN" data-src="https://www.walla.co.il/news/politics/383958065" data-widget-id="AR_6"></div></div></div></section><section class="styles_section__gpdMj"><figure class="styles_figure__Gy6fa"><div><div class="styles_imgContainer__ZQraM styles_noBackground__pVDNY" style="aspect-ratio:16/9;height:auto"><img alt="גדי איזנקוט" title="גדי איזנקוט" loading="lazy" decoding="async" data-nimg="fill" class="styles_image__I1HhR" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 1201px) 746px, (min-width: 1025px) 541px, 100vw" srcSet="https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=360&amp;quality=75 360w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=384&amp;quality=75 384w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=480&amp;quality=75 480w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=640&amp;quality=75 640w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=720&amp;quality=75 720w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=960&amp;quality=75 960w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=1080&amp;quality=75 1080w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=1200&amp;quality=75 1200w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=1440&amp;quality=75 1440w, https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=1920&amp;quality=75 1920w" src="https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp?aspectRatio=16%3A9&amp;width=1920&amp;quality=75"/></div></div><figcaption class="styles_caption__eA6M4"><span class="styles_mediaDescription__XBQOC"> גדי איזנקוט, בירך על החלטתו של בני גנץ לפרוש מהבחירות: &quot;החלטה נכונה ואחראית&quot;.<!-- --> <span class="styles_mediaCredit__pVpye"> צילום: ראובן קסטרו</span></span></figcaption></figure><div class="styles_adSection__3hjUy"></div></section><section class="styles_section__gpdMj"><section><div><h3 class="styles_title__eSoDi">רק לפני תשעה ימים: &quot;אני רץ עד הסוף&quot;</h3><div class="styles_prose__mTq51"><p>הודעתו של גנץ מגיעה <a target="_blank" rel="noopener noreferrer" href="https://www.walla.co.il/news/politics/383956929">תשעה ימים בלבד לאחר שהצהיר כי בכוונתו להתמודד בבחירות עד הסוף.</a> ב-10 באוקטובר הודיע יו"ר כחול לבן כי אין בכוונתו לפרוש מהמרוץ, ותקף את שני הגושים הפוליטיים בטענה שהם מעדיפים ממשלות צרות על פני ממשלת אחדות.</p><p></p><p>"אני החלטתי לא להיכנע לאויבים שלנו, על מנת להילחם באויבינו אני חייב להיאבק על האחדות בינינו, ולכן אני רץ עד הסוף", אמר אז גנץ. הוא דחה את הטענות כי מפלגתו עלולה להביא לאובדן קולות, וטען כי יש לפחות שישה מנדטים המעוניינים להצביע לכחול לבן. עם זאת, הטענה לא נתמכה בסקרים פומביים, שבהם מפלגתו נותרה מתחת לאחוז החסימה.</p><p></p><p>באותה הצהרה הכריז גנץ גם על השקת קמפיין בחירות ארצי תחת הסיסמה "בוחרים אחדות, מצילים את המדינה", שהיה אמור להימשך עד הבחירות. כעת, פחות משבועיים לאחר השקת הקמפיין והצהרתו כי יתמודד עד הסוף, הודיע גנץ על החלטתו שלא להתמודד.</p></div></div></section></section><section class="styles_section__5aaaR"><span class="styles_heading__irBRr">עוד באותו נושא:</span> <div class="styles_tags__t0GRK"><a target="_self" href="/tags/בני_גנץ"><span class="styles_tag__Dgaoy">בני גנץ</span><span class="styles_tagSeparator__ebubC">, </span></a><a target="_self" href="/tags/בחירות-2026"><span class="styles_tag__Dgaoy">בחירות 2026</span><span class="styles_tagSeparator__ebubC">, </span></a><a target="_self" href="/tags/כחול_לבן"><span class="styles_tag__Dgaoy">כחול לבן</span></a></div></section></article></div><div class="styles_containedContainer__s7HIn"><div id="outbrain_endless_article"><div class="OUTBRAIN" data-src="https://www.walla.co.il/news/politics/383958065" data-widget-id="AR_2"></div></div></div><div class="styles_containedContainer__s7HIn"><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--></div></section><div id="leftRail" class="styles_outbrainRail__NmSWR"><div id="leftRailDFP1" class="styles_googleAdSlot__oqDfd"><div id="rectangle1_desktop" data-slot-name="rectangle1_desktop"></div></div><div id="outbrain_left_rail_article" class="styles_outbrainSlot__J_xdO"><div class="OUTBRAIN" data-src="https://www.walla.co.il/news/politics/383958065" data-widget-id=