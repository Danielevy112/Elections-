ia-proxy-walla.walla.cloud/2026/10/2/videos/1791643820_1280x720/index.m3u8\",\"use_crop\":false,\"credit\":\"דוברות כחול לבן\",\"is_foreign_contries_blocked\":false,\"parental_control\":false,\"duration\":106.2}},\"main_text\":\"\u003cp\u003eיו\\\"ר כחול לבן, הרמטכ\\\"ל ושר הביטחון לשעבר בני גנץ, הודיע היום (שני) \u003cmark\u003eכי לא יתמודד בבחירות הקרובות. \u003c/mark\u003eבהודעה מטעמו נמסר כי על אף החלטתו שלא להתמודד, בכוונתו להמשיך לפעול למען הקמת ממשלת אחדות שתפעל לטובת מדינת ישראל.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cmark\u003e\\\"לא אתמודד בבחירות הקרובות - אמשיך להיאבק למען אחדות\\\"\u003c/mark\u003e, מסר גנץ. לדבריו, הקמת ממשלת אחדות היא הדרך להתמודד עם האתגרים הניצבים בפני המדינה: \\\"זה הפתרון היחיד שימנע אסון נוסף וישמור על ישראל מול כל האתגרים מבית ומחוץ\\\".\u003c/p\u003e\",\"cancel_refresh\":false,\"disable_google_ads\":false,\"disable_taboola\":false,\"writers_subtitle_type\":\"location\",\"is_marketing\":false,\"item_type\":\"regular\",\"publish_date\":\"Mon Oct 19 2026 12:47:47 GMT+0000 (Coordinated Universal Time)\",\"display_date\":\"Mon Oct 19 2026 15:30:00 GMT+0000 (Coordinated Universal Time)\",\"sensitive_content\":false,\"show_updated_date\":true,\"main_live_media\":{\"autoplay\":false},\"vertical\":{\"id\":1,\"name\":\"חדשות\",\"slug\":\"news\",\"color\":\"#066BED\",\"is_google_index\":true},\"main_category\":{\"id\":5,\"name\":\"פוליטיקה וממשל\",\"slug\":\"politics\",\"is_google_index\":true},\"link\":\"https://www.walla.co.il/news/politics/383958065\",\"writers\":[{\"name\":\"אבי סולומון\",\"is_writer_page\":true,\"media\":{\"crop_values\":{\"1:1\":{\"crop_w\":0.667205,\"crop_x\":0.166397,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"1:1\"},\"3:4\":{\"crop_w\":0.500404,\"crop_x\":0.249798,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"3:4\"},\"4:3\":{\"crop_w\":0.889607,\"crop_x\":0.055197,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"4:3\"},\"16:9\":{\"crop_w\":1,\"crop_x\":0,\"crop_y\":0.078465,\"height\":0,\"aspect_ratio\":\"16:9\"},\"9:16\":{\"crop_w\":0.375303,\"crop_x\":0.312349,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"9:16\"}},\"id\":4057825,\"media_type\":\"image\",\"mediaProvider\":\"ראובן קסטרו\",\"title\":\"אבי סולומון\",\"url\":\"https://img.wcdn.co.il/4/0/5/7/4057825-46.jpeg\",\"use_crop\":false,\"is_foreign_contries_blocked\":false,\"parental_control\":false,\"updated_at\":\"2026-05-31T07:43:22.000Z\"},\"slug\":\"avi-solomon\"}],\"tags\":[{\"id\":\"2023\",\"name\":\"בני גנץ\",\"slug\":\"בני_גנץ\"},{\"id\":\"1143668\",\"name\":\"בחירות 2026\",\"slug\":\"בחירות-2026\"},{\"id\":\"153826\",\"name\":\"כחול לבן\",\"slug\":\"כחול_לבן\"}],\"content_provider\":{\"name\":\"מערכת וואלה חדשות\",\"media\":{\"crop_values\":{\"1:1\":{\"crop_w\":0.667205,\"crop_x\":0.166397,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"1:1\"},\"3:4\":{\"crop_w\":0.500404,\"crop_x\":0.249798,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"3:4\"},\"4:3\":{\"crop_w\":0.889607,\"crop_x\":0.055197,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"4:3\"},\"16:9\":{\"crop_w\":1,\"crop_x\":0,\"crop_y\":0.078465,\"height\":0,\"aspect_ratio\":\"16:9\"},\"9:16\":{\"crop_w\":0.375303,\"crop_x\":0.312349,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"9:16\"}},\"id\":3820010,\"media_type\":\"image\",\"mediaProvider\":\"וואלה! טכנולוגיה\",\"title\":\"לוגו חדשות\",\"url\":\"https://img.wcdn.co.il/3/8/2/0/3820010-46.png\",\"use_crop\":false,\"credit\":\"וואלה\",\"is_foreign_contries_blocked\":false,\"parental_control\":false,\"updated_at\":\"2024-12-23T14:31:03.000Z\"},\"id\":\"244\"},\"sections\":[{\"id\":\"383958065-main-text\",\"section_type\":\"text\",\"order\":0,\"text\":\"\u003cp\u003e\u003ca target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://www.walla.co.il/news/politics/383958067\\\"\u003eבכחול לבן אומרים\u003c/a\u003e כי ההחלטה התקבלה לאחר שבועות של התלבטויות ודיונים עם חברי הסיעה. למרות התאוששות קלה בסקרים הפנימיים, גנץ סבר כי אין הצדקה להמשך ההתמודדות וכי לא יוכל לקדם את רעיון האחדות מתוך הכנסת. במפלגה מדגישים כי הוא אינו פורש מהחיים הפוליטיים, \u003cmark\u003eובשלב זה לא יתמוך באף מועמד לראשות הממשלה.\u003c/mark\u003e\u003c/p\u003e\u003cp\u003eבהודעה הודגש כי גנץ ימשיך למקד את מאמציו בקידום ממשלת אחדות, גם לאחר החלטתו שלא להתמודד בבחירות. גנץ צפוי למסור הערב בשעה 20:00 הצהרה לתקשורת בכפר המכביה, באולם קונכיה. בתום ההצהרה תינתן לעיתונאים אפשרות להפנות אליו שאלות.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003ch3\u003e\u003c/h3\u003e\",\"media_description\":\"\",\"live_video_autoplay\":false},{\"id\":\"8744302\",\"section_type\":\"media\",\"order\":0,\"main_title\":\"\",\"media_description\":\"\\\"אמשיך להיאבק למען אחדות\\\". יו\\\"ר כחול לבן, בני גנץ, הודיע כי לא יתמודד בבחירות הקרובות \",\"media\":{\"crop_values\":{\"1:1\":{\"crop_w\":0.667205,\"crop_x\":0.166397,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"1:1\"},\"3:4\":{\"crop_w\":0.500404,\"crop_x\":0.249798,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"3:4\"},\"4:3\":{\"crop_w\":0.889607,\"crop_x\":0.055197,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"4:3\"},\"16:9\":{\"crop_w\":1,\"crop_x\":0,\"crop_y\":0.078465,\"height\":0,\"aspect_ratio\":\"16:9\"},\"9:16\":{\"crop_w\":0.375303,\"crop_x\":0.312349,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"9:16\"}},\"id\":\"4103918\",\"media_type\":\"image\",\"mediaProvider\":\"ראובן קסטרו\",\"title\":\"בני גנץ, כנס ישראל בוחרת חקלאות, 23 בספטמבר 2026\",\"url\":\"https://img.wcdn.co.il/4/1/0/3/4103918-46.jpeg\",\"use_crop\":false,\"is_foreign_contries_blocked\":false,\"parental_control\":false},\"live_video_autoplay\":false},{\"id\":\"8744303\",\"section_type\":\"text\",\"order\":1,\"text\":\"\u003cp\u003eיו\\\"ר מפלגת ישר! עם איזנקוט, גדי איזנקוט, בירך על החלטתו של גנץ: \u003cmark\u003e\\\"מודה לחברי, רא\\\"ל (במיל') בני גנץ, על החלטתו הנכונה והאחראית לפרוש מהתמודדות בבחירות הגורליות מאז קום המדינה\\\"\u003c/mark\u003e. איזנקוט הודה לגנץ על תרומתו לביטחון ישראל והביע ביטחון שימשיך לתרום לחברה הישראלית.\u003c/p\u003e\",\"main_title\":\"התגובות במערכת הפוליטית לפרישת גנץ\",\"media_description\":\"\",\"live_video_autoplay\":false},{\"id\":\"8744303-1\",\"section_type\":\"text\",\"order\":1,\"text\":\"\u003cp\u003eיו\\\"ר יש עתיד, יאיר לפיד, בירך גם הוא על החלטתו של גנץ: \u003cmark\u003e\\\"מברך את גנץ שעשה היום את המעשה האחראי והנכון, מאחל לו הרבה בהצלחה בהמשך\\\"\u003c/mark\u003e.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eיו\\\"ר הדמוקרטים, יאיר גולן, מסר: \u003cmark\u003e\\\"גנץ קיבל החלטה אחראית ונכונה. בשעה גורלית לעתידה של ישראל, האחריות המשותפת היא להבטיח את ניצחון גוש השינוי\\\"\u003c/mark\u003e. לדבריו, מפלגתו מחויבת לשינוי ולתיקון אמיתי, ולישראל יהודית, דמוקרטית, ליברלית, חזקה ובטוחה.\u003c/p\u003e\",\"media_description\":\"\",\"live_video_autoplay\":false},{\"id\":\"8744303-2\",\"section_type\":\"text\",\"order\":1,\"text\":\"\u003cp\u003eגם יו\\\"ר מפלגת המילואימניקים והכלכלית, יועז הנדל, בירך על ההחלטה: \u003cmark\u003e\\\"בני גנץ עשה את המעשה הראוי והמתבקש למען המדינה\\\"\u003c/mark\u003e. הנדל קרא למצביעי הגוש השלישי להצטרף למפלגתו, וטען כי זו הדרך היחידה להקמת ממשלה ציונית.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eמפלגת הציונות הדתית טענה כי פרישת גנץ נועדה למנוע אובדן קולות בגוש השמאל, ותקפה את עופר וינטר ומפלגות נוספות בימין שאינן עוברות את אחוז החסימה. \\\"זוהי אזעקת אמת. אני קורא לעופר ולחבריו להתעשת ולקחת אחריות\\\", נמסר מהמפלגה. עוד הזהירו: \u003cmark\u003e\\\"אם הימין יאבד קולות השמאל יעלה לשלטון. לא מהמרים על מדינת ישראל!\\\"\u003c/mark\u003e\u003c/p\u003e\",\"media_description\":\"\",\"live_video_autoplay\":false},{\"id\":\"8744303-3\",\"section_type\":\"text\",\"order\":1,\"text\":\"\u003cp\u003eממפלגת עמך ישראל בראשות עופר וינטר נמסר: \\\"אנו מודים לבני גנץ על עשרות שנות שירות למען מדינת ישראל\\\". במפלגה טענו כי פרישתו ממחישה את חשיבותה, והוסיפו: \u003cmark\u003e\\\"מי שרוצה ימין משרת ומכריע שאינו תלוי באצבע ה-61 של גולדקנופף יש לו רק בית אחד - עמך ישראל\\\"\u003c/mark\u003e.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eגורמים במפלגת עמך ישראל הוסיפו: \\\"גנץ פינה לנו את הדרך\\\". לדבריהם, בניגוד למפלגתו של הנדל וליתר מפלגות גוש השינוי, מפלגתם אינה מוכנה להמשיך בחרם על בנימין נתניהו ומחנה הימין. עוד טענו כי סקרי עומק מצביעים על כך שמצביעי גנץ רואים בעמך ישראל את ביתם הפוליטי.\u003c/p\u003e\",\"media_description\":\"\",\"live_video_autoplay\":false},{\"id\":\"8744303-4\",\"section_type\":\"text\",\"order\":1,\"text\":\"\u003cp\u003eיו\\\"ר יהדות התורה, ח\\\"כ יעקב אשר, בירך על החלטת גנץ: \\\"ידידי בני גנץ הוא 'מענטש', אדם שתרם רבות למדינת ישראל ולביטחונה\\\". אשר הוסיף כי השניים שמרו על קשר אישי והערכה הדדית למרות חילוקי הדעות.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eרועי קונקול התייחס לפרישה וכתב: \u003cmark\u003e\\\"תם ולא נשלם. עשינו כמיטב יכולתנו ולא הצלחנו לשכנע את עם ישראל שאנחנו כוח פוליטי שנדרש במערכת הפוליטית\\\"\u003c/mark\u003e. הוא הודה לגנץ ולצוותו והודיע כי לאחר מנוחה קצרה יצטרף לחבריו במילואים בלבנון.\u003c/p\u003e\",\"media_description\":\"\",\"live_video_autoplay\":false},{\"id\":\"8744305\",\"section_type\":\"media\",\"order\":3,\"main_title\":\"\",\"media_description\":\" גדי איזנקוט, בירך על החלטתו של בני גנץ לפרוש מהבחירות: \\\"החלטה נכונה ואחראית\\\".\",\"media\":{\"crop_values\":{\"1:1\":{\"crop_w\":0.667205,\"crop_x\":0.166397,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"1:1\"},\"3:4\":{\"crop_w\":0.500404,\"crop_x\":0.249798,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"3:4\"},\"4:3\":{\"crop_w\":0.889607,\"crop_x\":0.055197,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"4:3\"},\"16:9\":{\"crop_w\":1,\"crop_x\":0,\"crop_y\":0.078465,\"height\":0,\"aspect_ratio\":\"16:9\"},\"9:16\":{\"crop_w\":0.375303,\"crop_x\":0.312349,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"9:16\"}},\"id\":\"404729187\",\"media_type\":\"image\",\"mediaProvider\":\"ראובן קסטרו\",\"title\":\"גדי איזנקוט\",\"url\":\"https://image-resizer-walla.walla.cloud/image/2026/10/3/images/1792348197976_walla-media-picture_1301x922.webp\",\"use_crop\":false,\"is_foreign_contries_blocked\":false,\"parental_control\":false},\"live_video_autoplay\":false},{\"id\":\"8744306\",\"section_type\":\"text\",\"order\":4,\"text\":\"\u003cp\u003eהודעתו של גנץ מגיעה \u003ca target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://www.walla.co.il/news/politics/383956929\\\"\u003eתשעה ימים בלבד לאחר שהצהיר כי בכוונתו להתמודד בבחירות עד הסוף.\u003c/a\u003e ב-10 באוקטובר הודיע יו\\\"ר כחול לבן כי אין בכוונתו לפרוש מהמרוץ, ותקף את שני הגושים הפוליטיים בטענה שהם מעדיפים ממשלות צרות על פני ממשלת אחדות.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\\\"אני החלטתי לא להיכנע לאויבים שלנו, על מנת להילחם באויבינו אני חייב להיאבק על האחדות בינינו, ולכן אני רץ עד הסוף\\\", אמר אז גנץ. הוא דחה את הטענות כי מפלגתו עלולה להביא לאובדן קולות, וטען כי יש לפחות שישה מנדטים המעוניינים להצביע לכחול לבן. עם זאת, הטענה לא נתמכה בסקרים פומביים, שבהם מפלגתו נותרה מתחת לאחוז החסימה.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003eבאותה הצהרה הכריז גנץ גם על השקת קמפיין בחירות ארצי תחת הסיסמה \\\"בוחרים אחדות, מצילים את המדינה\\\", שהיה אמור להימשך עד הבחירות. כעת, פחות משבועיים לאחר השקת הקמפיין והצהרתו כי יתמודד עד הסוף, הודיע גנץ על החלטתו שלא להתמודד.\u003c/p\u003e\",\"main_title\":\"רק לפני תשעה ימים: \\\"אני רץ עד הסוף\\\"\",\"media_description\":\"\",\"live_video_autoplay\":false}],\"seo_image\":{\"crop_values\":{\"1:1\":{\"crop_w\":0.667205,\"crop_x\":0.166397,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"1:1\"},\"3:4\":{\"crop_w\":0.500404,\"crop_x\":0.249798,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"3:4\"},\"4:3\":{\"crop_w\":0.889607,\"crop_x\":0.055197,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"4:3\"},\"16:9\":{\"crop_w\":1,\"crop_x\":0,\"crop_y\":0.078465,\"height\":0,\"aspect_ratio\":\"16:9\"},\"9:16\":{\"crop_w\":0.375303,\"crop_x\":0.312349,\"crop_y\":0,\"height\":0,\"aspect_ratio\":\"9:16\"}},\"id\":\"4103918\",\"media_type\":\"image\",\"mediaProvider\":\"ראובן קסטרו\",\"title\":\"בני גנץ, כנס ישראל בוחרת חקלאות, 23 בספטמבר 2026\",\"url\":\"https://img.wcdn.co.il/4/1/0/3/