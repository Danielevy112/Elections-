        if (grafbtn) grafbtn.style.display = "inline-block";
        if (tableDisplaybtn) tableDisplaybtn.style.display = "none";
    }
  
    function closeInfoBox(infoBoxId) {
        var infoBox = document.getElementById(infoBoxId);
        if (infoBox) {
            infoBox.classList.remove('noHide');
        }
    }
    document.querySelectorAll('.garph-bar').forEach(function (bar) {
        const element = document.getElementsByClassName("boxes-xx-outer")[0];
        var isMobile = window.getComputedStyle(element).display !== 'none';
        if(isMobile){
            bar.addEventListener('click', function () {
                var index = bar.getAttribute('data-index');
                showInfoBoxMobile(index); 
            });
        }
    });
    function showInfoBoxMobile(dataIndex) {
        var graphElement = document.querySelector(`[data-index='${dataIndex}']`);
        if (graphElement) {
            var partyTitle = graphElement.querySelector('#PartyTitle') ? graphElement.querySelector('#PartyTitle').innerText.trim() : ''; 
            var validVotes = graphElement.querySelector('#LegalVoted') ? graphElement.querySelector('#LegalVoted').innerText.trim() : ''; 
            var percent = graphElement.querySelector('#percent') ? graphElement.querySelector('#percent').innerText.trim() : ''; 
            var infoBox = document.getElementById('infoBox');
            if (infoBox) {
                infoBox.querySelector('.fw-bold.mt-min-3').innerText = partyTitle; // עדכון שם המפלגה
                infoBox.querySelector('.fs-5.fw-bold').innerText = validVotes; // עדכון קולות כשרים
                let percentElements = infoBox.querySelectorAll('.fs-5.fw-bold');
                if (percentElements.length > 1) {
                    percentElements[1].innerText = percent; // עדכון אחוז הקולות הכשרים
                }
                infoBox.classList.add('noHide');
            }
        } 
    }
    document.addEventListener('DOMContentLoaded', function () {
        const graphBars = document.querySelectorAll('.garph-bar');
        graphBars.forEach(function (graphBar) {
            graphBar.addEventListener('mouseenter', function (event) {
                showInfoBox(graphBar);
            });
            graphBar.addEventListener('focusin', function (event) {
                showInfoBox(graphBar);
            });

            graphBar.addEventListener('mouseleave', function () {
                hideInfoBox(graphBar)
            });
            graphBar.addEventListener('focusout', function () {
                hideInfoBox(graphBar);
            });
        });

        function showInfoBox(graphBar) {
            const graphBarRect = graphBar.getBoundingClientRect();
            const flexDiv = document.getElementById('d-flex-id');
            const flexDivRect = flexDiv.getBoundingClientRect();
            const spaceLeft = graphBarRect.left - flexDivRect.left;
            const infoBox = graphBar.querySelector('.info-box');
            if (500 > spaceLeft) {
                infoBox.style.left = '20px';
            } else {
                infoBox.style.right = '20px';
            }
            infoBox.style.display = 'block';
        }

        function hideInfoBox(graphBar) {
            const infoBox = graphBar.querySelector('.info-box');
            infoBox.style.display = 'none';
        }
    });
</script>

            
