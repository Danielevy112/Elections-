<script>
    function toggleDownloadFile() {
        var btn = document.getElementById("btnToggle");
        var icon = document.getElementById("toggleIcon");
        var popup = document.getElementById("downloadPopup");
        var isExpanded = btn.getAttribute("aria-expanded") === "true";

        if (isExpanded) {
            // סגירה - חזרה למצב הראשוני
            icon.src = "images/icn_301.svg";
            icon.alt = "מסמכים להורדה";
                btn.setAttribute("aria-label", "מסמכים להורדה");
                btn.setAttribute("aria-expanded", "false");
                popup.style.display = "none";
            } else {
                // פתיחה - מצב מורחב
                icon.src = "images/icn_303.svg";
                icon.alt = "סגירה";
                btn.setAttribute("aria-label", "סגירה");
            btn.setAttribute("aria-expanded", "true");
            popup.style.display = "block";
        }
        setTimeout(function () {
            var firstLink = popup.querySelector('a, .btn');
            if (firstLink) {
                firstLink.focus();
            }
        }, 100)
    }

