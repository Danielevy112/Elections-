        var graphButton = document.getElementById('ContentPlaceHolder1_PartyResults1_grafMobile');
        tableButton.classList.remove('btn-lg', 'fs-7', 'mb-3', 'px-4', 'pointer');
        tableButton.classList.add('btn-lg', 'fs-7', 'mb-3', 'px-4', 'btn-warning', 'rounded-pill', 'fw-bold', 'pointer');
        graphButton.classList.remove('btn-warning', 'rounded-pill', 'fw-bold');
        graphButton.classList.add('btn-lg', 'fs-7', 'mb-3', 'px-4', 'pointer');
