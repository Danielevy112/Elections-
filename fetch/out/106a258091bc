<script>
    function HideElement() {
        var element = document.getElementById("downloadFiles");
        element.style.setProperty("display", "none", "important");
    }
    function scrollToTopAndHide() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function handleKeyPress(event) {
        if (event.key === 'Enter' || event.key === ' ') {
            scrollToTopAndHide();
        }
    }
    function handleKeyPressLang(event, lang) {
        if (event.key === 'Enter' || event.key === ' ') {
            changeLanguage(lang);
        }
    }
    function handleKeyPressFontL(event) {
        if (event.key === 'Enter' || event.key === ' ') {
            fontsizedown();
        }
    }
    function handleKeyPressFontS(event) {
        if (event.key === 'Enter' || event.key === ' ') {
            fontsizeup();
        }
    }
    function changeLanguage(languageCode) {
        sessionStorage.setItem('lang', languageCode);
        var currentUrl = window.location.href;
        if (currentUrl.indexOf('lang=') === -1) {
            if (currentUrl.indexOf('?') !== -1) {
                currentUrl += '&lang=' + languageCode;
            } else {
                currentUrl += '?lang=' + languageCode;
            }
        } else {
            currentUrl = currentUrl.replace(/([?&])lang=[^&]*/, '$1lang=' + languageCode);
        }
        window.location.href = currentUrl;
    }

    function loadLanguageStyles() {
        const language = window.location.search.split('lang=')[1]?.split('&')[0];
        if (!language) {
            sessionStorage.setItem('lang', 'he');
        }
    }
    window.onload = loadLanguageStyles;

    function showMenuMobile() {
        var element = document.getElementById("menuMobile");
        element.style.setProperty("display", "block", "important");
    }
    function closeMenuMobile() {
        var element = document.getElementById("menuMobile");
        element.style.setProperty("display", "none", "important");
    }
</script>

