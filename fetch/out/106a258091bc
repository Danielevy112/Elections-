<script>
    const scrollableDiv = document.getElementById('scrollable-div');
    const leftButton = document.getElementById('ContentPlaceHolder1_PartyResults1_leftButton');
    const rightButton = document.getElementById('ContentPlaceHolder1_PartyResults1_rightButton');
    const leftButtonDis = document.getElementById('ContentPlaceHolder1_PartyResults1_leftButtonDis');
    const rightButtonDis = document.getElementById('ContentPlaceHolder1_PartyResults1_rightButtonDis');
    const rightButtonMobile = document.getElementById('ContentPlaceHolder1_PartyResults1_rightButtonMobile');
    const leftButtonMobile = document.getElementById('ContentPlaceHolder1_PartyResults1_leftButtonMobile');
    const rightButtonMobileDis = document.getElementById('ContentPlaceHolder1_PartyResults1_rightButtonMobileDis');
    const leftButtonMobileDis = document.getElementById('ContentPlaceHolder1_PartyResults1_leftButtonMobileDis');
    const scrollAmount = 100; 
    var lang = 'he';

    rightButton.addEventListener('click', () => {
        if (lang == 'en') {
            scrollableDiv.scrollLeft -= scrollAmount;
        }
        else {
            scrollableDiv.scrollLeft += scrollAmount;
        }
        updateButton();
    });
    leftButton.addEventListener('click', () => {
        if (lang == 'en') {
            scrollableDiv.scrollLeft += scrollAmount;
        }
        else {
            scrollableDiv.scrollLeft -= scrollAmount;
        }
        updateButton();
    });
    leftButtonMobile.addEventListener('click', () => {
        if (lang == 'en') {
            scrollableDiv.scrollLeft += scrollAmount;
        }
        else {
            scrollableDiv.scrollLeft -= scrollAmount;
        }
        updateButtonMobile();
    });
    rightButtonMobile.addEventListener('click', () => {
        if (lang == 'en') {
            scrollableDiv.scrollLeft -= scrollAmount;
        }
        else {
            scrollableDiv.scrollLeft += scrollAmount;
        }
        updateButtonMobile();
    });
    function updateButton() {
        if (scrollableDiv.scrollLeft == 0) {
            rightButtonDis.style.display = 'block';
            rightButton.style.display = 'none';
            leftButtonDis.style.display = 'none';
            leftButton.style.display = 'block';
        }

        else if ((Math.abs(scrollableDiv.scrollLeft)) + scrollableDiv.clientWidth + 2 >= scrollableDiv.scrollWidth) {
            rightButtonDis.style.display = 'none';
            rightButton.style.display = 'block';
            leftButtonDis.style.display = 'block';
            leftButton.style.display = 'none';
        }
        else {
            rightButtonDis.style.display = 'none';
            rightButton.style.display = 'block';
            leftButtonDis.style.display = 'none';
            leftButton.style.display = 'block';
        }
    }
    function updateButtonMobile() {
        if (scrollableDiv.scrollLeft == 0) {
            rightButtonMobileDis.style.display = 'block';
            rightButtonMobile.style.display = 'none';
            leftButtonMobileDis.style.display = 'none';
            leftButtonMobile.style.display = 'block';
        }
        else if ((Math.abs(scrollableDiv.scrollLeft)) + scrollableDiv.clientWidth + 2 >= scrollableDiv.scrollWidth) {
            rightButtonMobileDis.style.display = 'none';
            rightButtonMobile.style.display = 'block';
            leftButtonMobileDis.style.display = 'block';
            leftButtonMobile.style.display = 'none';
        }
        else {
            rightButtonMobileDis.style.display = 'none';
            rightButtonMobile.style.display = 'block';
            leftButtonMobileDis.style.display = 'none';
            leftButtonMobile.style.display = 'block';
        }
    }
    scrollableDiv.addEventListener('scroll', updateButtonMobile);
    window.addEventListener('load', updateButtonMobile);
    scrollableDiv.addEventListener('scroll', updateButton);
    window.addEventListener('load', updateButton);

