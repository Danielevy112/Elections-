3\",{\"section\":\"$38\"}],[\"$\",\"$L36\",\"4\",{\"section\":\"$39\"}],[\"$\",\"section\",\"5\",{\"id\":\"section-5\",\"className\":\"article-outbrain-section\",\"children\":[\"$\",\"$L1e\",null,{\"dataWidgetId\":\"AR_2\",\"dataWidgetIdMobile\":\"AR_2\",\"className\":\"article-body-outbrain-container\"}]}],[\"$\",\"$L36\",\"6\",{\"section\":\"$3a\"}],[\"$\",\"$L36\",\"7\",{\"section\":\"$3b\"}],[\"$\",\"section\",\"8\",{\"id\":\"section-8\",\"className\":\"article-outbrain-section\",\"children\":[\"$\",\"$L1e\",null,{\"dataWidgetId\":\"AR_3\",\"dataWidgetIdMobile\":\"AR_3\",\"className\":\"article-body-outbrain-container\"}]}],[\"$\",\"$L36\",\"9\",{\"section\":\"$3c\"}],[\"$\",\"p\",\"10\",{\"id\":\"section-10\",\"className\":\"article-paragraph-section\",\"children\":\"עוד עולה מסקר \\\"מעריב\\\" כי משקל המפלגות שאינן עוברות את אחוז החסימה מצטמצם השבוע ל־6.7%, השווים לכ־8 מנדטים. מדובר בבית ציוני - המילואימניקים (2.1%), המפלגה הכלכלית (1.7%), האחדות (1.1%), כחול לבן (0.6%), מקום לכולנו – שותפות יהודית־ערבית (0.7%) והציבור החרדי (0.4%).\"}],[\"$\",\"section\",\"11\",{\"id\":\"section-11\",\"className\":\"article-outbrain-section\",\"children\":[\"$\",\"$L1e\",null,{\"dataWidgetId\":\"AR_4\",\"dataWidgetIdMobile\":\"AR_4\",\"className\":\"article-body-outbrain-container\"}]}],[\"$\",\"$L36\",\"12\",{\"section\":\"$3d\"}],[\"$\",\"$L36\",\"13\",{\"section\":\"$3e\"}],[\"$\",\"section\",\"14\",{\"id\":\"section-14\",\"className\":\"article-outbrain-section\",\"children\":[\"$\",\"$L1e\",null,{\"dataWidgetId\":\"AR_5\",\"dataWidgetIdMobile\":\"AR_5\",\"className\":\"article-body-outbrain-container\"}]}],[\"$\",\"$L36\",\"15\",{\"section\":\"$3f\"}],[\"$\",\"$L36\",\"16\",{\"section\":\"$40\"}],[\"$\",\"section\",\"17\",{\"id\":\"section-17\",\"className\":\"article-outbrain-section\",\"children\":[\"$\",\"$L1e\",null,{\"dataWidgetId\":\"AR_6\",\"dataWidgetIdMobile\":\"AR_6\",\"className\":\"article-body-outbrain-container\"}]}],[\"$\",\"$L36\",\"18\",{\"section\":\"$41\"}],[\"$\",\"$L36\",\"19\",{\"section\":\"$42\"}],[\"$\",\"$L36\",\"20\",{\"section\":\"$43\"}],[\"$\",\"$L36\",\"21\",{\"section\":\"$44\"}],[\"$\",\"$L36\",\"22\",{\"section\":\"$45\"}],[\"$\",\"$L36\",\"23\",{\"section\":\"$46\"}],[\"$\",\"p\",\"24\",{\"id\":\"section-24\",\"className\":\"article-paragraph-section\",\"children\":\"עוד עולה מסקר \\\"מעריב\\\" כי רוב הישראלים (55%) חוששים מהתלקחות מלחמה נוספת בין ישראל לאיראן בזמן הקרוב. לעומתם, 39% מהישראלים לא חוששים מכך, ועוד 6% אינם יודעים.\"}],[\"$\",\"$L36\",\"25\",{\"section\":\"$47\"}],[\"$\",\"$L36\",\"26\",{\"section\":\"$48\"}],[\"$\",\"p\",\"27\",{\"id\":\"section-27\",\"className\":\"article-paragraph-section\",\"children\":\"מהסקר גם עולה כי הציבור הישראלי חלוק בדעתו בין 44% שאינם מאמינים שהייתה \\\"בגידה מבפנים\\\" ב־7 באוקטובר ל־40% שמאמינים שאכן הייתה בגידה כזו (16% אינם יודעים).\"}],[\"$\",\"$L36\",\"28\",{\"section\":\"$49\"}],[\"$\",\"$L36\",\"29\",{\"section\":\"$4a\"}],[\"$\",\"p\",\"30\",{\"id\":\"section-30\",\"className\":\"article-paragraph-section\",\"children\":\"בחלוקה למחנות הפוליטיים, נמצא שרוב מצביעי מפלגות הקואליציה (61%) מאמינים בכך, לעומת שיעור דומה (64%) ממצביעי האופוזיציה ורוב מצביעי מפלגות הגוש השלישי (56%) שלא מאמינים שהייתה בגידה מבפנים.\"}],[\"$\",\"p\",\"31\",{\"id\":\"section-31\",\"className\":\"article-paragraph-section\",\"children\":\"בנוסף, כמחצית (52%) ממצביעי מפלגות האופוזיציה הציונית סבורים שצריכים להיות עוד איחודים בגוש מפלגות האופוזיציה לפני הבחירות. 27% סבורים שעדיף שהמפלגות הנוכחיות ירוצו בנפרד, ועוד 21% מהם לא יודעים. תמיכה גבוהה מעט יותר באיחודים נמצאה בקרב מצביעי מפלגות הדמוקרטים (57%) וישראל ביתנו (55%).\"}],[\"$\",\"$L36\",\"32\",{\"section\":\"$4b\"}]]]}]}],[\"$\",\"$L4c\",null,{\"categoryId\":1}],\"\",[\"$\",\"section\",null,{\"className\":\"tags-section-container\",\"children\":[[\"$\",\"section\",null,{\"className\":\"tags-container\",\"children\":[[\"$\",\"$L19\",null,{\"prefetch\":false,\"href\":\"/tags\",\"className\":\"tags-link\",\"children\":\"