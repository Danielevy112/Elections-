nsertBefore(r,o)}}(document,\\\"script\\\",\\\"infogram-async\\\",\\\"https://e.infogram.com/js/dist/embed-loader-min.js\\\");\u003c/script\u003e\\r\\n\u003c/p\u003e\",\"section_object\":null},{\"id\":27,\"type\":1,\"text\":\"מהסקר גם עולה כי הציבור הישראלי חלוק בדעתו בין 44% שאינם מאמינים שהייתה \\\"בגידה מבפנים\\\" ב־7 באוקטובר ל־40% שמאמינים שאכן הייתה בגידה כזו (16% אינם יודעים).\",\"section_object\":null},{\"id\":28,\"type\":100,\"text\":\"\u003cdiv class=\\\"infogram-embed\\\" data-id=\\\"_/x36N0doXptBpFOOO3b9S\\\" data-type=\\\"interactive\\\" data-title=\\\"בגידה מבפנים 3.9.26\\\"\u003e\u003c/div\u003e\",\"section_object\":null},{\"id\":29,\"type\":100,\"text\":\"\u003cp\u003e\\r\\n\u003cscript\u003e!function(e,n,i,s){var d=\\\"InfogramEmbeds\\\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\\\"script\\\",\\\"infogram-async\\\",\\\"https://e.infogram.com/js/dist/embed-loader-min.js\\\");\u003c/script\u003e\\r\\n\u003c/p\u003e\",\"section_object\":null},{\"id\":30,\"type\":1,\"text\":\"בחלוקה למחנות הפוליטיים, נמצא שרוב מצביעי מפלגות הקואליציה (61%) מאמינים בכך, לעומת שיעור דומה (64%) ממצביעי האופוזיציה ורוב מצביעי מפלגות הגוש השלישי (56%) שלא מאמינים שהייתה בגידה מבפנים.\",\"section_object\":null},{\"id\":31,\"type\":1,\"text\":\"בנוסף, כמחצית (52%) ממצביעי מפלגות האופוזיציה הציונית סבורים שצריכים להיות עוד איחודים בגוש מפלגות האופוזיציה לפני הבחירות. 27% סבורים שעדיף שהמפלגות הנוכחיות ירוצו בנפרד, ועוד 21% מהם לא יודעים. תמיכה גבוהה מעט יותר באיחודים נמצאה בקרב מצביעי מפלגות הדמוקרטים (57%) וישראל ביתנו (55%).\",\"section_object\":null},{\"id\":32,\"type\":100,\"text\":\"\u003cp\u003e\u003cstrong\u003eבסקר, שנערך ב־2־3 בספטמבר, התבקשו להשתתף 4,102 אנשים, וענו עליו 600 משיבים (15%), המהווים מדגם מייצג של האוכלוסייה הבוגרת במדינת ישראל מגיל 18 ומעלה, יהודים וערבים. טעות הדגימה המרבית בסקר עומדת על 4%. \u003c/strong\u003e\u003c/p\u003e\",\"section_object\":null}],\"tags\":[{\"tagId\":50,\"tagName\":\"נפתלי בנט\",\"tagDescription\":\"\",\"tagUrl\":\"/tags/נפתלי-בנט\",\"tagImage\":null},{\"tagId\":10793,\"tagName\":\"ליברמן\",\"tagDescription\":\"\",\"tagUrl\":\"/tags/ליברמן\",\"tagImage\":null},{\"tagId\":17862,\"tagName\":\"גדי איזנקוט\",\"tagDescription\":\"\",\"tagUrl\":\"/tags/גדי-איזנקוט\",\"tagImage\":null},{\"tagId\":50016,\"tagName\":\"נתניהו\",\"tagDescription\":\"\",\"tagUrl\":\"/tags/נתניהו\",\"tagImage\":null},{\"tagId\":54710,\"tagName\":\"בחירות 2026\",\"tagDescription\":\"\",\"tagUrl\":\"/Tags/בחירות-2026\",\"tagImage\":null},{\"tagId\":55936,\"tagName\":\"סקר מעריב\",\"tagDescription\":\"\",\"tagUrl\":\"/Tags/סקר-מעריב\",\"tagImage\":null}],\"tagsNames\":\"נפתלי בנט#ליברמן#גדי איזנקוט#נתניהו#בחירות 2026#סקר מעריב\",\"reporters\":[{\"name\":\"משה כהן\",\"friendlyUrl\":\"journalists/moshe-cohen-3992\",\"image\":{\"imageId\":1064621,\"imageSrc\":\"https://images.maariv.co.il/image/upload/f_auto,fl_lossy/c_fill,g_faces:center,h_250,w_250/1064621\",\"imageAlt\":\"משה כהן\",\"imageCredit\":\"משה כהן צילום: אבשלום ששוני\",\"imageWidth\":250,\"imageHeight\":250,\"isCloudinary\":false}}],\"reporter\":null,\"reportersNames\":\"משה כהן\",\"reporterLocation\":\"\",\"areReportersPhotosShown\":true,\"displayedDateText\":\"06:01 | 04/09/2026\",\"publishedDateTimeUTC\":\"2026-09-04T06:01:21+03:00\",\"realUpdateDateUTC\":\"2026-09-04T09:17:53+03:00\",\"images\":[{\"imageId\":1132979,\"imageSrc\":\"https://images.maariv.co.il/image/upload/f_auto,fl_lossy/c_fill,g_faces:center,h_438,w_778/1132979\",\"imageAlt\":\"אביגדור ליברמן, בצלאל סמוטריץ', בנימין נתניהו, נפתלי בנט, גדי איזנקוט, משה פייגלין\",\"imageCredit\":\"צילום: פלאש 90,אבשלום שושני\",\"imageWidth\":778,\"imageHeight\":438,\"isCloudinary\":true}],\"publisher\":\"ayeletrota@gmail.com\",\"promoContent\":\"\",\"shiftManagerName\":\"לאורה אדרי\",\"uniqueContent\":fal