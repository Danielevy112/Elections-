cript\u003e!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\u003c/script\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eמהסקר גם עולה כי הציבור הישראלי חלוק בדעתו בין 44% שאינם מאמינים שהייתה \"בגידה מבפנים\" ב־7 באוקטובר ל־40% שמאמינים שאכן הייתה בגידה כזו (16% אינם יודעים).\u003c/p\u003e\r\n\u003cdiv class=\"infogram-embed\" data-id=\"_/x36N0doXptBpFOOO3b9S\" data-type=\"interactive\" data-title=\"בגידה מבפנים 3.9.26\"\u003e\u003c/div\u003e\r\n\u003cp\u003e\r\n\u003cscript\u003e!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\u003c/script\u003e\r\n\u003c/p\u003e\r\n\u003cp\u003eבחלוקה למחנות הפוליטיים, נמצא שרוב מצביעי מפלגות הקואליציה (61%) מאמינים בכך, לעומת שיעור דומה (64%) ממצביעי האופוזיציה ורוב מצביעי מפלגות הגוש השלישי (56%) שלא מאמינים שהייתה בגידה מבפנים.\u003c/p\u003e\r\n\u003cp\u003eבנוסף, כמחצית (52%) ממצביעי מפלגות האופוזיציה הציונית סבורים שצריכים להיות עוד איחודים בגוש מפלגות האופוזיציה לפני הבחירות. 27% סבורים שעדיף שהמפלגות הנוכחיות ירוצו בנפרד, ועוד 21% מהם לא יודעים. תמיכה גבוהה מעט יותר באיחודים נמצאה בקרב מצביעי מפלגות הדמוקרטים (57%) וישראל ביתנו (55%).\u003c/p\u003e\r\n\u003cp\u003e\u003cstrong\u003eבסקר, שנערך ב־2־3 בספטמבר, התבקשו להשתתף 4,102 אנשים, וענו עליו 600 משיבים (15%), המהווים מדגם מייצג של האוכלוסייה הבוגרת במדינת ישראל מגיל 18 ומעלה, יהודים וערבים. טעות הדגימה המרבית בסקר עומדת על 4%.\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e"])</script><script type="a8645471e9efd4063b9724aa-text/javascript">self.__next_f.push([1,"2d:T1b89,"])</script><script type="a8645471e9efd4063b9724aa-text/javascript">self.__next_f.push([1,"החיבור בין בצלאל סמוטריץ' למשה פייגלין יוצר דרמה במערכת הפוליטית. הרשימה המאוחדת שלהם עוברת את אחוז החסימה עם 5 מנדטים, בזמן שגם רשימת עמך ישראל עוברת את אחוז החסימה עם 4 מנדטים.\r\nבסיכום הכללי, קואליציית נתניהו מתחזקת ל־51 מנדטים לראשונה מאז חודש מאי. לעומת זאת, גוש מפלגות האופוזיציה הציונית יורד ב־2 מנדטים ל־57, בעקבות היחלשות של ישר! ב־2 מנדטים, והמפלגות הערביות יורדות במנדט. זאת על פי סקר \"מעריב\", שנערך על ידי לזר מחקרים בראשות ד\"ר מנחם לזר, בשיתוף Panel4ALL.\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\nהמשמעות היא שגוש מפלגות האופוזיציה הציונית מתרחק 4 מנדטים מרוב של 61 מנדטים, וספק רב אם ניתן יהיה להרכיב ממשלה חלופית ללא מפלגה נוספת. עם זאת, הציונות הדתית ועמך ישראל עדיין מצויות בטווח הסכנה של אי־מעבר אחוז החסימה, מה שעשוי לשנות את התמונה.הרשימה הערבית המאוחדת מאבדת מנדט ויורדת ל־7 מנדטים, כך שגוש המפלגות הערביות מגיע הפעם ל־12 מנדטים.\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\nעוד עולה מסקר \"מעריב\" כי משקל המפלגות שאינן עוברות את אחוז החסימה מצטמצם השבוע ל־6.7%, השווים לכ־8 מנדטים. מדובר בבית ציוני - המילואימניקים (2.1%), המפלגה הכלכלית (1.7%), האחדות (1.1%), כחול לבן (0.6%), מקום לכולנו \u0026ndash; שותפות יהודית־ערבית (0.7%) והציבור החרדי (0.4%).\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\nמהסקר גם עולה כי הפער בין גדי איזנקוט לבנימין נתניהו בשאלת ההתאמה לראשות הממשלה מצטמצם גם השבוע: איזנקוט מקבל 48% התאמה, מול 39% לנתניהו. גם נפתלי בנט מוביל על פני נתניהו עם 43% מול 39%, פער דומה לזה שבסקר הקודם.\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\nמול אביגדור ליברמן נשאר גם הפעם פער של 3%: נתניהו מקבל 42% לעומת 39% שחושבים שליברמן מתאים יותר.\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\nעוד עולה מסקר \"מעריב\" כי רוב הישראלים (55%) חוששים מהתלקחות מלחמה נוספת בין ישראל לאיראן בזמן הקרוב. לעומתם, 39% מהישראלים לא חוששים מכך, ועוד 6% אינם יודעים.\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\nמהסקר גם עולה כי הציבור הישראלי חלוק בדעתו בין 44% שאינם מאמינים שהייתה \"בגידה מבפנים\" ב־7 באוקטובר ל־40% שמאמינים שאכן הייתה בגידה כזו (16% אינם יודעים).\r\n\r\n\r\n!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]\u0026\u0026window[d].initialized)window[d].process\u0026\u0026window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");\r\n\r\nבחלוקה למחנות הפוליטיים, נמצא שרוב מצביעי מפלגות הקואליציה (61%) מאמינים בכך, לעומת שיעור דומה (64%) ממצביעי האופוזיציה ורוב מצביעי מפלגות הגוש השלישי (56%) שלא מאמינים שהייתה בגידה מבפנים.\r\nבנוסף, כמחצית (52%) ממצביעי מפלגות האופוזיציה הציונית סבורים שצריכים להיות עוד איחודים בגוש מפלגות האופוזיציה לפני הבחירות. 27% סבורים שעדיף שהמפלגות הנוכחיות ירוצו בנפרד, ועוד 21% מהם לא יודעים. תמיכה גבוהה מעט יותר באיחודים נמצאה בקרב מצביעי מפלגות הדמוקרטים (57%) וישראל ביתנו (55%).\r\nבסקר, שנערך ב־2־3 בספטמבר, התבקשו להשתתף 4,102 אנשים, וענו עליו 600 משיבים (15%), המהווים מדגם מייצג של האוכלוסייה הבוגרת במדינת ישראל מגיל 18 ומעלה, יהודים וערבים. טעות הדגימה המרבית בסקר עומדת על 4%.\u0026nbsp;"])</script><script type="a8645471e9efd4063b9724aa-text/javascript">self.__next_f.push([1,"32:{\"imageId\":1132979,\"imageSrc\":\"https://ima