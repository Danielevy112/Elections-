    {
      "BillID": 2225649,
      "KnessetNum": 25,
      "Name": "חוק רשות מקרקעי ישראל (תיקון מס' 16), התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5394,
      "CommitteeID": 4198,
      "StatusID": 118,
      "Number": 1191,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-07-21T00:00:00",
      "MagazineNumber": 3564,
      "PageNumber": 840,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי רשות מקומית המשתייכת לדירוג 1-5 במדד הפריפריאליות, אשר קיבלה מענק איזון ממשרד הפנים בכל אחת משלוש השנים שקדמו להגשת הבקשה, תהיה רשאית לבקש מרשות מקרקעי ישראל להקצות לה קרקע בתחומה לצורך הקמה והפעלה של מיזם לייצור חשמל מאנרגיה מתחדשת. עוד נקבע כי ההקצאה תיעשה בפטור ממכרז, וכי הקמת המיזם והפעלתו יבוצעו באמצעות יזם פרטי שייבחר במכרז פומבי.\nעוד קובע החוק כי רשות מקומית זכאית שאין בתחומה קרקע פנויה מתאימה למיזם תהיה רשאית, יחד עם רשות מקומית גובלת, לבקש שהקרקע תוקצה בתחום הרשות הגובלת, כאשר 80% מרווחי המיזם יועברו לרשות המקומית הזכאית. \nעוד נקבעו הוראות לעניין התשלום עבור הקרקע, היקף הקרקע שניתן להקצות ופרסום פרטי המיזם באתר האינטרנט.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1191 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-08-05T09:23:05.65"
    },
