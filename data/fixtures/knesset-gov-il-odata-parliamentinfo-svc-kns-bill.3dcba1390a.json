  "value": [
    {
      "BillID": 2068500,
      "KnessetNum": 20,
      "Name": "חוק בתי משפט לעניינים מינהליים (תיקון מס' 117), התשע\"ח-2018",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1222,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2745,
      "PageNumber": 912,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון לחוק מסמיך את בית המשפט המחוזי בירושלים, בשבתו כבית משפט לעניינים מינהליים, לדון בעתירות על החלטות של רשויות ישראליות הפועלות ביהודה ושומרון. בטרם תוקן החוק עתירות אלו נדונו ברובן בבית המשפט העליון בשבתו כבית דין גבוה לצדק, מה שהוסיף לעומס המוטל עליו.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-02-14T14:08:10.633"
    },
    {
      "BillID": 2068501,
      "KnessetNum": 20,
      "Name": "חוק העונשין (תיקון מס' 134), התשע\"ח-2018",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1223,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2742,
      "PageNumber": 887,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק העונשין (תיקון מס' 134), התשע\"ח-2018 מרחיב את האיסור על ירי מנשק חם שלא כדין כך שיחול בכל מקום, ולא רק באזור מגורים, כפי שקיים היום. במקרים אלו נקבע עונש מאסר של עד שנתיים. כן מורחב האיסור על ירי בנסיבות מסכנות ונכלל בהן ירי באזור מגורים, באזור אחר שיש בו כדי לסכן חיי אדם או באופן שיש בו לסכן חיי אדם – עם עונש מאסר של עד חמש שנים. נוכח ההרחבה מתייתר סעיף 338(ב), שעניינו ירי בחתונה או טקס, ולכן הוא בוטל.  ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-07-28T17:15:28.247"
    },
