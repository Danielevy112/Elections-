    {
      "BillID": 572568,
      "KnessetNum": 20,
      "Name": "חוק דמי מחלה (היעדרות בשל מחלת ילד) (תיקון מס' 15), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2557,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 655,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-08-16T00:00:00",
      "MagazineNumber": 2578,
      "PageNumber": 1211,
      "IsContinuationBill": null,
      "SummaryLaw": "לפי חוק דמי מחלה, התשל''ו–1976, הזכאות לדמי מחלה ביום השני והשלישי להיעדרות תהיה בשיעור של 50% משכר העבודה, ורק מהיום הרביעי ואילך תהיה זכאות לדמי מחלה בשיעור של 100%. כדי לאפשר להורים לחלק ביניהם את נטל ההיעדרות מהעבודה בשל מחלת ילדם, תוקן חוק דמי מחלה (היעדרות בשל מחלת ילד), התשנ\"ג–1993, כך שבמקרה של היעדרות לסירוגין של שני ההורים בשל מחלת ילד ימנו את ימי ההיעדרות לעניין חישוב הזכאות לדמי המחלה מהיום הראשון שבו אחד מההורים נעדר בשל מחלת הילד, בכפוף להגשת הצהרה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
