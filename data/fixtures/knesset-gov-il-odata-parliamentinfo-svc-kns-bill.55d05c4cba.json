    {
      "BillID": 576822,
      "KnessetNum": 20,
      "Name": "חוק להגדלת שיעור ההשתתפות בכוח העבודה ולצמצום פערים חברתיים (מס הכנסה שלילי) (תיקון מס' 8), התשע\"ו-2016 ",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 922,
      "StatusID": 118,
      "Number": 1022,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-03-21T00:00:00",
      "MagazineNumber": 2539,
      "PageNumber": 638,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק להגדלת שיעור ההשתתפות בכוח העבודה ולצמצום פערים חברתיים (מס הכנסה שלילי) (תיקון מס' 8), התשע\"ו-2016 (להלן - התיקון), התקבל בקריאה השנייה והשלישית ביום ד' באדר ב' התשע\"ו (14 במרס 2016). התיקון קבע שורה של הקלות לעניין מענק העבודה (מס הכנסה שלילי), כך בין היתר, הושווה בין עובד שכיר לבין עצמאי לעניין תשלום המענק, הוגדל טווח ההכנסה המקנה זכאות למענק במקרה של הורה יחיד ובמקרה של עובד שנקבע לו שכר מינימום מותאם (מופחת), כלומר עם מוגבלות. כמו כן, בוטלה הדרישה הקיימת לגבי עצמאים שלפיה הגשה מקוונת של הדוח השנתי לפי פקודת מס הכנסה תהיה תנאי לקבלת המענק. כך גם, נקבעו הוראות שימנעו את עיקול כספי המענק מרגע שיועברו לחשבון בנק של זכאי אשר חייב לנושים שונים עד שיחלפו 90 ימים. בנוסף, הוארכו פרקי הזמן להגשת תביעה למענק והוקדמו מועדי התשלום.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
