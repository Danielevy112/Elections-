    {
      "BillID": 2207735,
      "KnessetNum": 25,
      "Name": "חוק אומנה לילדים (תיקון מס' 3), התשפ\"ד-2024",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1636,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-02-20T00:00:00",
      "MagazineNumber": 3159,
      "PageNumber": 534,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע כי לאומן באומנת חירום תהיה סמכות לתת הסכמה לבדיקה רפואית ולטיפול רפואי, לרבות נטילת תרופות, ביצוע בדיקות דם וקבלת חיסונים הניתנים לכלל ילדי ישראל, ולמעט טיפולים רפואיים המנויים בתוספת הראשונה לחוק זכויות החולה, כגון ניתוחים ודיאליזה. עוד נקבע כי במקרה שבו ילד שהושם באומנת חירום אושפז בבית חולים מכוח סמכות האומן כאמור, עובד סוציאלי לפי חוק הנוער (טיפול והשגחה) או עובד סוציאלי לפי חוק הסעד (טיפול באנשים עם מוגבלות שכלית–התפתחותית), לפי העניין, יודיע על כך לבית המשפט הדן בעניינו של הילד, בסמוך לאחר אשפוזו. בנוסף נקבע כי בנוגע למתן רישיון לאומן באומנת חירום, לא תחול הגבלת גיל מרבי של 56 שנים, בשונה מאומנה רגילה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1636 ,מיום 16:00:00",
      "LastUpdatedDate": "2024-05-02T11:39:52.31"
    },
