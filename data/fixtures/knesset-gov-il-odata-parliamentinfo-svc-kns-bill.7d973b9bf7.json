    {
      "BillID": 572118,
      "KnessetNum": 20,
      "Name": "חוק התקשורת (בזק ושידורים) (תיקון מס' 65), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2703,
      "CommitteeID": 926,
      "StatusID": 118,
      "Number": 701,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-06-08T00:00:00",
      "MagazineNumber": 2642,
      "PageNumber": 982,
      "IsContinuationBill": null,
      "SummaryLaw": "מוצע לאפשר לבעל רישיון כללי לשידורי כבלים ולבעל רישיון לשידורי לווין לשדר גם שידורי חדשות כלליים באמצעות מי שקיבל מהמועצה לשידורי כבלים ולוויין רישיון לשדר ערוץ חדשות בין-לאומי שמקורו בישראל. משדר חדשות כאמור הוא מי ששידורי החדשות והתכניות שלו בענייני היום מיועדים בעיקר לציבור שמחוץ לישראל, שידוריו אינם בעברית והם אינם מלווים בכתוביות בעברית. על המשדר להיות תאגיד הרשום בישראל או ששידוריו הופקו ונערכו, כולם או לפחות חלק ניכר מהם, בישראל.\nנקבע, כי המועצה לשידורי כבלים ולשידורי לווין לא תיתן רישיון לשידור ערוץ חדשות כאמור אלא אם מצאה כי מירב הזיקות שלו אינן לישראל, וזאת בהתאם לכללים שהיא תקבע לעניין זה. כמו כן, נקבעו תנאים למתן רישיון לשידור ערוץ חדשות בין-לאומי כאמור, ובין היתר הוחלו על משדר החדשות הבין-לאומי חלק מההוראות החלות על מפיק חדשות עצמאי לפי סעיף 6כ2(ג)(5) לחוק לעניין איסור בעלות צולבת עם גופי תקשורת. \nלעניין תוכן השידורים, הוחלה על בעל רישיון לשידור ערוץ חדשות בין-לאומי ההוראה בסעיף 6כ2(ה) לחוק התקשורת לעניין החובה של מפיק חדשות עצמאי לקיים שידורי חדשות מדויקים, מהימנים ומאוזנים ושלא יבוטאו בהם עמדותיהם ודעותיהם הפרטיות של מנהליו, עובדיו ובעלי מניותיו של בעל הרישיון, עובדיו ובעלי מניותיו. לעניין זה נקבע כי המועצה תקבע כללים שיבטיחו את התקיימות החובה האמורה גם במקרה שלבעל הרישיון האמור יש בעלות צולבת עם בעל רישיון כללי לשידורי כבלים או בעל רישיון לשידורי לוויין. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
