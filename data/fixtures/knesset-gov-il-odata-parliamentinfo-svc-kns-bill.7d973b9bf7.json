    {
      "BillID": 574500,
      "KnessetNum": 20,
      "Name": "חוק התכנון והבנייה (תיקון מס' 108 - הוראת שעה), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2543,
      "CommitteeID": 952,
      "StatusID": 118,
      "Number": 650,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-08-07T00:00:00",
      "MagazineNumber": 2572,
      "PageNumber": 1149,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק התכנון והבנייה (תיקון מס' 108 – הוראת שעה), התשע\"ו–2016 (להלן – החוק) התקבל בכנסת בקריאה שניה ושלישית ביום י\"ט בתמוז התשע\"ו (25 ביולי 2016). החוק קובע בהוראת שעה התקפה לחמש שנים, חובה על ועדה מקומית לתת הקלה לתוספת דירות למגורים בשיעור של 10% מהמספר המרבי של דירות מגורים המותר לבנייה על פי הוראות התכנית החלה על המגרש, אף אם נקבע כי סטייה מהוראות התכנית כאמור תהיה סטייה ניכרת, בהתקיים התנאים והסייגים המפורטים בחוק. חובת מתן ההקלה כאמור, לא תחול על ועדה מקומית במחוז הצפון או הדרום או בתחום רשות מקומית ששר האוצר קבע לגביה כי אין צורך או הצדקה לחייב מתן הקלה כאמור. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 650 ,מיום 16:00:00",
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
