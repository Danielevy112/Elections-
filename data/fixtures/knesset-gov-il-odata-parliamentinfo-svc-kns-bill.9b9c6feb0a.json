    {
      "BillID": 2199560,
      "KnessetNum": 25,
      "Name": "חוק התקשורת (בזק ושידורים) (תיקון מס' 78), התשפ\"ד–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2994,
      "CommitteeID": 4198,
      "StatusID": 118,
      "Number": 1017,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-07-04T00:00:00",
      "MagazineNumber": 3238,
      "PageNumber": 1042,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע כי בעל דירה יהיה רשאי להתקין במקום סביר בגג הבית המשותף שהוא רכוש משותף מתקן של חובב רדיו, בתנאים המנוים בהצעת החוק ובתנאי שלא הובעה התנגדות בכתב מצד רוב הדיירים בבית המשותף להתקנה או בתנאי שהמפקח לא אסר את ההתקנה לאחר בחינת פנייה של אחד מדיירי הבניין. בהתאם לכך נקבע כי ההתקנה והתחזוקה תהיה על חשבונו של הדייר המתקין ויהיה עליו להסיר את המיתקן  בנסיבות הקבועות בחוק.  ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1017 ,מיום 11:00:00",
      "LastUpdatedDate": "2024-07-07T10:23:02.787"
    },
