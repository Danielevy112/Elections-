    {
      "BillID": 2213768,
      "KnessetNum": 25,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 251), התשפ\"ה–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4232,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1053,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-11-20T00:00:00",
      "MagazineNumber": 3316,
      "PageNumber": 72,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע, כי בתקופה שבה ילד שהורשע בעבירת ביטחון לפי סעיף 326(ג) לחוק הביטוח הלאומי, דהיינו בעבירת טרור חמורה לפי חוק המאבק בטרור, נמצא במאסר בשל הרשעתו, לא ישולמו להוריו גמלאות לפי פרק ג' לחוק הביטוח הלאומי, ובכלל זה קצבת ילדים ומענק לימודים וכן תוספות תלויים בעבור הילד – לעניין קצבת נפגעי עבודה, קצבת נכות, קצבת אזרח ותיק וקצבת שארים ותוספות בעד הילד לגמלת הבטחת הכנסה או לתשלום לפי חוק המזונות (הבטחת תשלום). כמו כן, בתקופת המאסר הילד לא יבוא במניין ילדיו של ההורה לצורך חישוב גמלאות כאמור. הוראות חוק זה יחולו לגבי מי שנמצא במאסר ביום תחילתו של חוק זה או לאחריו. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1053 ,מיום 10:00:00",
      "LastUpdatedDate": "2025-05-05T08:32:18.573"
    }
