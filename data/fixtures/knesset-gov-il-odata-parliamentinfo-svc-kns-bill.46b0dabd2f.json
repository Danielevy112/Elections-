    {
      "BillID": 566812,
      "KnessetNum": 20,
      "Name": "חוק הזכות לעבודה בישיבה (תיקון מס' 3), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2007,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 689,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-04-03T00:00:00",
      "MagazineNumber": 2628,
      "PageNumber": 596,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מחייב מעסיק של מאבטח, למעט חריגים שנקבעו בחוק, להעמיד לרשותו עמדה המספקת הגנה מגשם ומשמש ואמצעי חימום או קירור מתאימים, וכן לאפשר לו גישה לנקודת מים וחשמל ומקום להנחת חפציו האישיים. השהות בעמדה תתאפשר בלי לפגוע בדרישות האבטחה. בנוסף, מעסיק המחייב לבישת בגד מסוים, יספק למאבטח ביגוד מותאם. חובת העמדת עמדה ואמצעי חימום וקירור מוטלות על מעסיק בפועל ומזמין שירות לגבי מאבטח המועסק אצלם. נקבעו עיצומים כספיים בשל אי העמדת עמדה לרשות המאבטח וכן אפשרות לפסוק פיצויים לדוגמה בשל הפרה ואפשרות לתביעה ייצוגית.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
