    {
      "BillID": 2156346,
      "KnessetNum": 24,
      "Name": "חוק לתיקון פקודת מס הכנסה (מס' 262), התשפ״ב-2022",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 419,
      "CommitteeID": 2216,
      "StatusID": 118,
      "Number": 880,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-07-05T00:00:00",
      "MagazineNumber": 2994,
      "PageNumber": 1000,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מאריך בשנה את תקופת הזכאות לנקודות זיכוי בחישוב מס הכנסה לעולה חדש, מ-42 חודשים ל-54 חודשים. כמו כן, החוק קובע כי בשנה הראשונה לעלייה, עולה יהיה זכאי לנקודת זיכוי אחת. יתר נקודות הזיכוי הקבועות בפקודה נותרו ללא שינוי ויינתנו בתום השנה הראשונה. תחילתו של חוק זה ביום 1 בינואר 2022, והוא יחול לגבי הכנסה שהופקה או נצמחה למי שנעשה עולה לראשונה ביום התחילה ואילך. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 880 ,מיום 11:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
    },
