    {
      "BillID": 2088300,
      "KnessetNum": 23,
      "Name": "חוק לדחיית מועדי תשלומי מסים והוראות לעניין מענקים בשל נגיף הקורונה החדש (תיקוני חקיקה), התשפ\"א-2020",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1053,
      "CommitteeID": 2139,
      "StatusID": 118,
      "Number": 861,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2020-12-29T00:00:00",
      "MagazineNumber": 2892,
      "PageNumber": 262,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה קובע, בין היתר, כי אם שולם למעסיק מענק לפי חוק זה וכן נקבעה זכאותו למענק אחר לעניין עובדיו, יובא המענק ששולם למעסיק לפי חוק זה בחשבון לעניין המענק האחר והמעסיק לא יידרש להצהיר שלא קיבל מענק לפי חוק זה. כמו כן, בחישוב התקופות שנקבעו בהוראות חוק מיסוי מקרקעין המפורטות בחוק, התקופה שמיום 1 במרס 2020 עד יום 30 ביוני 2021, לא תבוא במניין, אם מועדי סיומן חלים באותה תקופה. בנוסף, נקבע כי מיום פרסומו של חוק זה ועד ליום 31 בדצמבר 2022 חוק הביטוח הלאומי יקרא כך שמי שהשתחרר משירות סדיר בתקופה שמיום 1 בינואר 2020 ועד יום 31 בדצמבר 2020, יראו חייל כזכאי לדמי אבטלה במשך שנתיים מיום שחרורו.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
