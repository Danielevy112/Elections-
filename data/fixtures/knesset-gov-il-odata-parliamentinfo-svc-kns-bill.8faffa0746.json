    {
      "BillID": 2021997,
      "KnessetNum": 20,
      "Name": "חוק הספורט (תיקון מס' 15), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4684,
      "CommitteeID": 933,
      "StatusID": 118,
      "Number": 774,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-01T00:00:00",
      "MagazineNumber": 2728,
      "PageNumber": 718,
      "IsContinuationBill": null,
      "SummaryLaw": "לפי סעיף 7 לחוק הספורט, על ספורטאי הנוטל חלק בתחרות ספורט להיות מבוטח על ידי אחד מגופי הספורט המארגנים את התחרות. התיקון קובע כי גם ספורטאי רשאי לבטח את עצמו, ואם עשה כן, או אם בוטח בביטוח אחר שמתקיימים בו התנאים לפי החוק, יהיו גופי הספורט פטורים מלבטח אותו. כמו כן, התיקון הוסיף לרשימת הספורטאים הפטורים מביטוח את הספורטאים המשתתפים בפעילות ספורט שאין בגינה תשלום שכר או כל תמורה אחרת.  ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
