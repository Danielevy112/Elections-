    {
      "BillID": 2021828,
      "KnessetNum": 20,
      "Name": "חוק יום ציון לאומי לתרומתה ולפועלה של העדה הדרוזית, התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4747,
      "CommitteeID": 933,
      "StatusID": 118,
      "Number": 769,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-05-31T00:00:00",
      "MagazineNumber": 2721,
      "PageNumber": 680,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק יום ציון לאומי לתרומתה ולפועלה של העדה הדרוזית, התשע\"ח-2018 קובע כי מדי שנה ביום 1 במרס, היום שבו החל בשנת 1956 גיוס החובה של בני העדה הדרוזית לצבא הגנה לישראל, יקוים יום לאומי לציון פועלה ותרומתה של העדה הדרוזית למדינת ישראל. מטרת החוק היא כאמור לקבוע יום לאומי לציון פועלה של העדה הדרוזית ותרומתה למדינת ישראל וזאת בבניין הארץ, בחיזוק הביטחון ובעיצוב פני החברה הישראלית כחברה שוויונית ומגוונת. היום הלאומי יצוין במספר דרכים: במחנות צה\"ל יוקדש זמן ללימוד הנושאים הקשורים למטרת החוק; יתקיים טקס מרכזי לרגל היום הלאומי שעל עריכתו יהיה מופקד משרד הביטחון; הכנסת תקיים ישיבה ממלכתית ובית הנשיא יציין את היום הלאומי.  ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
