    {
      "BillID": 568470,
      "KnessetNum": 20,
      "Name": "חוק שירות אזרחי, התשע\"ז-2017",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 947,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-04-05T00:00:00",
      "MagazineNumber": 2632,
      "PageNumber": 632,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מסדיר את המערך הקיים של השירות הלאומי, שיוכל להיקרא גם התנדבות קהילתית, (להלן- השירות) ובו רשאים להתנדב מי שקיבלו פטור משירות צבאי בכפוף לתנאים שבחוק. מוקמת רשות לשירות אזרחי האחראית גם לנושא השירות הלאומי-אזרחי של תלמידי הישיבות וכן תפעל מועצה ציבורית מייעצת. נקבעו תנאים לביצוע השירות, תנאי הזכאות להיות גוף מפעיל שבמסגרתו מבוצע השירות ותנאים לעניין הגופים המוכרים האחראים על הפעלת המתנדבים. כמו כן נקבעו הוראות לעניין פיקוח על ביצוע השירות לרבות באמצעות עיצומים כספיים על גופים מוכרים. בנוסף נקבע מנגנון השגה וממונה על פניות הציבור ונקבעו הוראות לעניין ייצוג הולם של אנשים עם מוגבלות וקידום שילוב של צעירים בסיכון כמתנדבים.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
