    {
      "BillID": 574489,
      "KnessetNum": 20,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 175), התשע\"ו-2016",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 1001,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-03-28T00:00:00",
      "MagazineNumber": 2540,
      "PageNumber": 647,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק הביטוח הלאומי קובע את זכאותו לגמלת סיעוד של מבוטח שהגיע לגיל הפרישה ותלוי במידה רבה בעזרת הזולת לביצוע רוב פעולות היום–יום, או הזקוק להשגחה. עד לתיקון זה, קבע החוק כי הזכאות לגמלת סיעוד תחל בתום 30 ימים מה-1 בחודש שבו הוגשה התביעה לגמלה. בשל הוראה זו, מי שהגיש את התביעה לגמלת סיעוד בתחילת החודש הקלנדרי, נאלץ לחכות כחודש עד לתחילת זכאותו לגמלת סיעוד, בעוד שמי שהגיש את התביעה בסוף החודש, זכאותו לגמלה החלה בתוך ימים ספורים, לאחר הגשת בקשתו. \nתיקון זה קובע כי הזכאות לגמלת סיעוד תתחיל באופן אחיד, בתום שבעה ימים מהיום שבו הוגשה התביעה לגמלה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
