    {
      "BillID": 488007,
      "KnessetNum": 20,
      "Name": "חוק חניה לנכים (תיקון מס' 6), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2021,
