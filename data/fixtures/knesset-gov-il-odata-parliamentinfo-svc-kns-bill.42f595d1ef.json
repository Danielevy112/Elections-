      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-03-28T00:00:00",
      "MagazineNumber": 2615,
      "PageNumber": 505,
      "IsContinuationBill": true,
      "SummaryLaw": "החוק קובע כי רשות תימרור מקומית תקצה מקומות חניה לכלי רכב הנושאים תג נכה בשטח פריקה וטעינה, במועדים שאינם מיועדים לפריקה וטעינה, ובלבד שלא מדובר בנתיב נסיעה. מספר מקומות החניה שיוקצו כאמור יהיה מספר המקומות שניתן לכלול במחצית משטח הפריקה והטעינה ובלבד שמדובר במקום חניה אחד לפחות.\nבמועדים שמיועדים לפריקה וטעינה החניה תהיה אסורה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
