    {
      "BillID": 2217149,
      "KnessetNum": 25,
      "Name": "חוק שירותי הדת היהודיים (תיקון מס' 27), התשפ\"ה–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4540,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1036,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-01-19T00:00:00",
      "MagazineNumber": 3353,
      "PageNumber": 216,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה מאפשר לממשלה לתקצב שכר ותקנים של בעלי תפקידים שונים במועצות הדתיות שמונו כדין (למשל רבנים שמונו או שנבחרו, לרבות רבנים אזוריים, רבני יישובים ורבנים וקייסים לעדה האתיופית, בלניות, וכן בעלי תפקידים נוספים), נוסף על סכומי ההשתתפות שמועצות דתיות מקבלות בהתאם להוראות החוק, ובלי שיהיה בכך כדי לחייב את הרשות המקומית בסכומי ההשתתפות מטעמה בשל הוצאות אלו. התקציב יועבר על פי אמות מידה שוויוניות שייקבעו על ידי השר לשירותי דת, בהתייעצות עם שר האוצר. בחוק נקבע שהוראה זו תחול גם ביחס לרשויות מקומיות (עיריות, מועצות מקומיות ומועצות אזוריות) שאין בתחומן מועצה דתית.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1036 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-09-03T10:19:29.12"
    },
    {
      "BillID": 2217187,
