    {
      "BillID": 2196934,
      "KnessetNum": 25,
      "Name": "חוק מבקר המדינה (תיקון מס' 50), התשפ''ג-2023",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 353,
      "CommitteeID": 4199,
      "StatusID": 118,
      "Number": 959,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2023-07-17T00:00:00",
      "MagazineNumber": 3064,
      "PageNumber": 544,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון מרחיב את סמכותו של מבקר המדינה, כנציב תלונות הציבור, המאפשרת לו להוציא צו כדי להגן על זכויות עובד, במטרה למנוע את פיטוריו בגין חשיפת שחיתויות ומקרים נוספים המנויים בחוק, כך שתחול גם על משטרת ישראל ועל שירות בתי הסוהר. עוד מוצע כי אם הוגשה תלונה לנציב תלונות הציבור, לא יתאפשר בירור מקביל שלה בידי נציב קבילות שוטרים וסוהרים.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 959 ,מיום 16:00:00",
      "LastUpdatedDate": "2023-09-28T14:20:31.107"
    },
