    {
      "BillID": 2196910,
      "KnessetNum": 25,
      "Name": "חוק יום לציון אירועי הפרהוד, התשפ\"ד–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 312,
      "CommitteeID": 4192,
      "StatusID": 118,
      "Number": 1014,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-07-07T00:00:00",
      "MagazineNumber": 3242,
      "PageNumber": 1060,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע בחוק יום לציון אירועי הפרהוד, הפרעות שהתחוללו ביהודי בגדד בחג השבועות של שנת 1941, אשר יחול מדי שנה ביום החול הראשון שלאחר חג השבועות ואסרו חג. יום זה יצויין בטקס מרכזי לפי החלטת השר לשוויון חברתי וקידום מעמד האישה ובהתייעצות עם שר המורשת, בדיון מיוחד במליאת הכנסת וכן במוסדות החינוך ככל שיחליט על כך שר החינוך.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1014 ,מיום 16:00:00",
      "LastUpdatedDate": "2024-08-06T13:35:14.167"
    },
