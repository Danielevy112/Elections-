    {
      "BillID": 2196997,
      "KnessetNum": 25,
      "Name": "חוק דיווח לכנסת על הטרדות מיניות בכוחות הביטחון והטיפול בהן (תיקוני חקיקה), התשפ\"ו-2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 605,
      "CommitteeID": 4187,
      "StatusID": 118,
      "Number": 978,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-12-14T00:00:00",
      "MagazineNumber": 3468,
      "PageNumber": 42,
      "IsContinuationBill": null,
      "SummaryLaw": "במסגרת החוק הוטלה על משטרת ישראל, שירות בתי הסוהר וצבא הגנה לישראל חובת דיווח שנתית לכנסת בנושא הטרדות מיניות והטיפול בהן. נקבע כי המפקח הכללי של המשטרה ונציב בתי הסוהר יגישו לוועדה לביטחון לאומי, ואילו ראש המטה הכללי של צה\"ל יגיש לוועדת החוץ והביטחון, דין וחשבון שנתי עד ל-31 במרץ בכל שנה. הדיווח יתייחס לשנה הקלנדרית שקדמה לו ויכלול פירוט של הפעולות שנקטו הגופים למניעת הטרדות מיניות בארגונים, את מספר הדיווחים שהוגשו לממונה על הטיפול בנושא ואת אופן הטיפול בהם. לשם הגנה על פרטיות המעורבים, נקבע איסור מפורש לכלול בדוח פרטי מידע שיאפשרו את זיהוי המדווחים, המתלוננים, הנילונים או אנשים אחרים המעורבים בדיווח.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 978 ,מיום 10:00:00",
      "LastUpdatedDate": "2026-04-21T10:11:54.387"
    }
