    {
      "BillID": 2211184,
      "KnessetNum": 25,
      "Name": "חוק איסור הכחשת אירועי טבח 7 באוקטובר 2023 (טבח שמיני עצרת), התשפ\"ה–2025",
      "SubTypeID": 54,
