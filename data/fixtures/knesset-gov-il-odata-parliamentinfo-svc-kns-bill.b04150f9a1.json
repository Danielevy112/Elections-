    {
      "BillID": 564961,
      "KnessetNum": 20,
      "Name": "חוק שוויון זכויות לאנשים עם מוגבלות (תיקון מס' 18), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1451,
      "CommitteeID": 922,
      "StatusID": 118,
      "Number": 693,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-08T00:00:00",
      "MagazineNumber": 2730,
      "PageNumber": 734,
      "IsContinuationBill": null,
      "SummaryLaw": "בחוק נקבע שאדם עם מוגבלות מקצרת חיים יהיה זכאי לקבל לדיור הלוואה מגוף פיננסי בסכום שלא יעלה על מיליון שקלים חדשים, אם הוא אדם עם מוגבלות מקצרת חיים שרכש ביטוח חיים לאדם עם מוגבלות מקצרת חיים למטרת הלוואה לדיור, והכיסוי הביטוחי לעניין זה לא יעלה על 500,000 שקלים חדשים. \nאדם עם מוגבלות מקצרת חיים הוא אדם שאקטואר ממונה קבע שהמוגבלות שיש לאדם היא כזו שמקצרת את תוחלת החיים הממוצעת מעל ל-3 שנים ושתוחלת החיים של האדם עם המוגבלות עולה על 5 שנים.\nאדם עם מוגבלות מקצרת חיים שרכש ביטוח לאדם עם מוגבלות מקצרת חיים יהיה זכאי לסיוע מהמדינה בסכום של 300 שקלים חדשים כל עוד הוא משלם את פרמיית ביטוח החיים האמור.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
