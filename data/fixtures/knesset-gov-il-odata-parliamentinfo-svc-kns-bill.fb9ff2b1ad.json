    {
      "BillID": 569443,
      "KnessetNum": 20,
      "Name": "חוק הכניסה לישראל (תיקון מס' 27), התשע\"ז–2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2240,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 664,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-02-13T00:00:00",
      "MagazineNumber": 2604,
      "PageNumber": 414,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק הכניסה לישראל (תיקון מס' 27), התשע\"ז–2017 התקבל בכנסת ביום ג' בשבט התשע\"ז (30 בינואר 2017). החוק קובע כי ניתן יהיה להאריך רישיון לישיבת ביקור לעובד זר גם אם התקיימו נסיבות מיוחדות של תרומתו לתרבות ולספורט ולא רק בשל תרומתו לכלכלה, למשק או לחברה. הארכת רישיונות של עובדים זרים כאמור תיעשה לאחר התייעצות עם שר האוצר ובהסכמת שר העבודה, הרווחה והשירותים החברתיים. בנוסף, החוק קובע כי שר הפנים יהיה רשאי, לאחר התייעצות עם שר האוצר, בהסכמת שר העבודה, הרווחה והשירותים החברתיים ובאישור ועדת הפנים והגנת הסביבה של הכנסת, לקבוע בתקנות נסיבות שיראו אותן כנסיבות מיוחדות וחריגות של תרומת עובד זר כאמור.\n   \n   ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
