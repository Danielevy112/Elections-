    {
      "BillID": 570482,
      "KnessetNum": 20,
      "Name": "חוק הדגל, הסמל והמנון המדינה (תיקון מס' 7), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2779,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 639,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-07-27T00:00:00",
      "MagazineNumber": 2567,
      "PageNumber": 1078,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק הדגל, הסמל והמנון המדינה (תיקון מס' 7), התשע\"ו–2016 התקבל בכנסת ביום י\"ב בתמוז התשע\"ו (18 ביולי 2016). החוק קובע כי העונש בגין עבירה של פגיעה בכבוד דגל המדינה או סמל המדינה יהיה מאסר עד שלוש שנים, במקום שנה אחת, וקנס עד 58,400 שקלים חדשים במקום קנס של עד 300 לירות.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
    {
      "BillID": 570495,
      "KnessetNum": 20,
      "Name": "חוק-יסוד: הכנסת (תיקון מס' 46)",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2266,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 675,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-03-28T00:00:00",
      "MagazineNumber": 2618,
      "PageNumber": 516,
      "IsContinuationBill": null,
      "SummaryLaw": "סעיף 7א לחוק-יסוד: הכנסת קובע כי רשימת מועמדים, וכן מועמד יחיד, לא ישתתפו בבחירות לכנסת \"אם יש במטרותיה או במעשיה של הרשימה או במעשיו של האדם, לפי הענין, במפורש או במשתמע\", כדי לשלול את קיומה של מדינת ישראל כמדינה יהודית ודמוקרטית, כדי להסית לגזענות או כדי לתמוך במאבק מזוין של מדינת אויב או ארגון טרור נגד מדינת ישראל. תיקון מס' 46 לחוק האמור מבהיר כי \"מעשיו של אדם\" כוללים גם התבטאויות, בהתאם לגישה המקובלת בפסיקה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
