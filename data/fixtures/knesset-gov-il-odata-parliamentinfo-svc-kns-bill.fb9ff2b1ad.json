    {
      "BillID": 569691,
      "KnessetNum": 20,
      "Name": "חוק הפיקוח על שירותים פיננסיים (קופות גמל) (תיקון מס' 20), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2425,
      "CommitteeID": 922,
      "StatusID": 118,
      "Number": 646,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-01-16T00:00:00",
      "MagazineNumber": 2597,
      "PageNumber": 336,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק הפיקוח על שירותים פיננסיים (קופות גמל) (תיקון מס' 20), התשע\"ז-2017 (להלן – התיקון), התקבל בקריאה השנייה והשלישית ביום י''א בטבת התשע''ז (9.1.2017). התיקון אסר על כך שעמלת ההפצה המשולמת לסוכן ביטוח תחושב בזיקה לדמי הניהול שייגבו מאדם שמצטרף לקופת גמל. בנוסף נקבע סעיף עונשי לפיו, מי שמפר את ההוראה ומחשב את עמלת ההפצה בזיקה לשיעור דמי הניהול צפוי לעונש של שנת מאסר קנס העומד כיום על סכום שנע בין 226,000 שקלים חדשים ל-3,616,000 שקלים חדשים, על פי זהות המפר. תחילתו של התיקון נקבע ליום ה' בניסן התשע\"ז (1 באפריל 2017).",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
