    {
      "BillID": 543895,
      "KnessetNum": 20,
      "Name": "חוק דמי מחלה (היעדרות בשל מחלת ילד) (תיקון מס' 13), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2028,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 575,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-03-01T00:00:00",
      "MagazineNumber": 2533,
      "PageNumber": 581,
      "IsContinuationBill": true,
      "SummaryLaw": "חוק דמי מחלה (היעדרות בשל מחלת ילד), התשנ\"ג–1993, תוקן כך שהורה יוכל לזקוף עד 90 ימי היעדרות בשנה, על חשבון תקופת המחלה הצבורה שלו, אם ההיעדרות היתה בשל מחלת ילדו המצריכה טיפול קבוע בדיאליזה, ולא רק בשל מחלה ממארת של הילד. כמו כן, הוסמך שר הכלכלה, בהתייעצות עם שר הבריאות ובאישור ועדת העבודה הרווחה והבריאות, לקבוע בצו מחלות קשות נוספות שההוראה תחול גם לגביהן.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
