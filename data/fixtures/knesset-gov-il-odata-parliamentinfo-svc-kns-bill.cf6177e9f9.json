    {
      "BillID": 578930,
      "KnessetNum": 20,
      "Name": "חוק פנייה לגופים ציבוריים באמצעי קשר דיגיטליים, התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3073,
      "CommitteeID": 931,
      "StatusID": 118,
      "Number": 770,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2744,
      "PageNumber": 902,
      "IsContinuationBill": null,
      "SummaryLaw": "בחוק נקבע שגוף ציבורי המפורט בתוספת יאפשר לאדם לפנות אליו באמצעי קשר דיגיטלי, אלא אם כן נקבע אחרת לפי כל דין, או שהגוף הציבורי החליט, מטעמים מיוחדים שיירשמו, שהפנייה אליו באותם עניינים תהיה בדרך מסוימת אחרת; אולם אם הגוף הציבורי מאפשר פניה אליו באמצעות פקסימיליה - הוא יהיה רשאי להחליט שהפניה אליו תהיה בדרך מסוימת אחרת. כן נקבע שגוף ציבורי כאמור יפרסם באתר האינטרנט שלו, לגבי יחידות בו שנותנות שירות לציבור, את עיקרי סוגי השירותים הניתנים ביחידות אלה, פריסתן הגאוגרפית, כתובותיהן ודרכי ההתקשרות עימן, ובכלל זה אמצעי קשר דיגיטלי שבאמצעותו ניתן לפנות לגוף הציבורי ולאותן יחידות. כמו כן נקבע שגוף ציבורי יפרסם דרכי התקשרות עם עובד הגוף הציבורי או היחידה שנותנים שירות לציבור אלא אם כן החליט מנהל הגוף הציבורי, מטעמים מיוחדים שיירשמו, שפרסום כאמור עלול לפגוע פגיעה ממשית ברמת השירות שניתן לציבור; כן יפורסמו דרכי התקשרות עם עובדים שמטפלים באופן מתמשך בפניות. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
