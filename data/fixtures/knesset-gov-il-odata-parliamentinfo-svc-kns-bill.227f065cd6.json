    {
      "BillID": 2203869,
      "KnessetNum": 25,
      "Name": "חוק סמכויות לשם שמירה על ביטחון הציבור (תיקון מס' 8), התשפ\"ד–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3326,
      "CommitteeID": 4187,
      "StatusID": 118,
      "Number": 1020,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-07-18T00:00:00",
      "MagazineNumber": 3248,
      "PageNumber": 1082,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק סמכויות לשם שמירה על ביטחון הציבור, התשס\"ה–2005, נועד להקנות סמכויות שונות לשוטרים, חיילים ומאבטחים לשם שמירה על ביטחון הציבור מפני פעילות חבלנית עוינת ומפני אלימות, וזאת במקום ובדרך שיבטיחו שמירה מרבית על כבוד האדם, פרטיותו וזכויותיו. \nבמסגרת תיקון מספר 8, נקבע כי לחייל שנתמנה לפי פקודות הצבא לשמור על מקום המוחזק על ידי צבא הגנה לישראל או המשמש למטרה ביטחונית, תהא סמכות חיפוש על גופו של אדם או בכלי תחבורה אם ישנו חשד סביר כי ניסה להיכנס או לחדור לאותו מקום ללא רשות כדין, על מנת לברר האם אותו אדם נושא עימו נשק שלא כדין או מחזיק בכלי התחבורה נשק שלא כדין. כמו כן, נקבע כי חייל כאמור יהיה רשאי לעכב אדם המנסה להיכנס או לחדור ללא רשות כדין למקום עליו הוא שומר, עד לבואו של שוטר. עוד נקבע כי ראש המטה הכללי, או מי שהסמיך לכך, יקבע הוראות לעניין סימון ומעקב אחר כלי נשק צבאי, אחריות קצין המפקד על בסיסי צבא הגנה לישראל לשמור על כלי נשק המוחזקים בו וסימון וגידור מתחמים המוחזקים על ידי צבא הגנה לישראל. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1020 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-08-05T11:04:21.583"
    },
