    {
      "BillID": 2163400,
      "KnessetNum": 24,
      "Name": "חוק לתיקון פקודת הראיות (מס' 19), התשפ\"ב–2022",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 2220,
      "StatusID": 118,
      "Number": 1453,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-07-05T00:00:00",
      "MagazineNumber": 2988,
      "PageNumber": 984,
      "IsContinuationBill": null,
      "SummaryLaw": "הוחלט שבית משפט הדן במשפט פלילי יהיה רשאי שלא לקבל ראיה שהושגה שלא כדין אם שוכנע שקבלתה תפגע באופן מהותי בזכות להליך הוגן, בשים לב למספר שיקולים המפורטים בסעיף.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1453 ,מיום 16:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
    },
    {
      "BillID": 2165125,
      "KnessetNum": 24,
      "Name": "חוק לתיקון פקודת מס הכנסה (מס' 259), התשפ\"ב-2022",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 2216,
      "StatusID": 118,
      "Number": 1468,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-02-08T00:00:00",
      "MagazineNumber": 2959,
      "PageNumber": 746,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע פטור ממס הכנסה על מענק ששולם לספורטאי בעד זכייה במקום הראשון, השני או השלישי בתחרות שהתקיימה במסגרת המשחקים האולימפיים, המשחקים הפאראלימפיים, משחקי העולם, או בעד זכייה כאמור בתחרות לבוגרים שהתקיימה במסגרת אליפות עולם, אליפות אירופה או אליפות מוכרת אחרת. הפטור יחול על מענק ששולם על ידי משרד התרבות והספורט, הוועד האולימפי בישראל, הוועד הפאראלימפי הישראלי  או התאחדות איל\"ת,  החל מיום 1 בינואר 2021 ואילך.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1468 ,מיום 16:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
    },
