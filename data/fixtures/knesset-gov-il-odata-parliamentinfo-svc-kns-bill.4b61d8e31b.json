    {
      "BillID": 2156444,
      "KnessetNum": 24,
      "Name": "חוק חסיון ראיות (טיפול נפשי בהליכים פליליים שעניינם עבירות מין או עבירות אלימות חמורה במשפחה) (תיקוני חקיקה), התשפ\"ב–2022",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 464,
      "CommitteeID": 2220,
      "StatusID": 118,
      "Number": 884,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-07-10T00:00:00",
      "MagazineNumber": 3003,
      "PageNumber": 1050,
      "IsContinuationBill": null,
      "SummaryLaw": "הוחלט לקבל תיקונים שנועדו לחזק את מעמד החיסיון על עדות של רופא בקשר לטיפול נפשי, או עדות של פסיכולוג או של עובד סוציאלי, שחל לגבי נפגע עבירה בעבירות מין או עבירות אלימות חמורה במשפחה. לצד זאת, הוחלט כי נפגע עבירה בעבירות מין מסוימות יהיה זכאי לקבל סיוע משפטי לפי חוק הסיוע המשפטי, התשל\"ב–1972, בכל הנוגע לוויתור על החיסיון ולהליכים הקשורים בגילוי החומר הטיפולי החסוי בעניינו.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 884 ,מיום 16:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
    },
