    {
      "BillID": 2008326,
      "KnessetNum": 20,
      "Name": "חוק לתיקון פקודת הבטיחות בעבודה (מס' 10), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3637,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 712,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-07-12T00:00:00",
      "MagazineNumber": 2648,
      "PageNumber": 1016,
      "IsContinuationBill": null,
      "SummaryLaw": "ההגדרה \"אדם כשיר\", לעניין פעולה במכונה או ממסרת שבתנועה, שבסעיף 38 לפקודת הבטיחות בעבודה, התייחסה לגבר בלבד. בתיקון לפקודה שונתה ההגדרה \"אדם כשיר\", כך שתחול לגבי כל אדם שמלאו לו 18 שנים ושמתקיימים לגביו התנאים הקבועים באותה הגדרה, ללא תלות במגדר שלו.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
