    {
      "BillID": 2011349,
      "KnessetNum": 20,
      "Name": "חוק חינוך ממלכתי (תיקון מס' 17), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3643,
      "CommitteeID": 933,
      "StatusID": 118,
      "Number": 763,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-24T00:00:00",
      "MagazineNumber": 2736,
      "PageNumber": 828,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מתקן את חוק חינוך ממלכתי כך שנוספה למטרות החינוך הממלכתי המטרה של חינוך לשירות משמעותי בצה\"ל או לשירות לאומי-אזרחי. עוד קובע החוק כי שר החינוך יקבע כללים לשם מניעת פעילות במוסד חינוך של אדם או של גוף חיצוני שאינו חלק ממערכת החינוך, שפעילותו עומדת בסתירה חמורה ומשמעותית למטרות החינוך הממלכתי, וכן כללים לשם מניעת פעילות במוסד חינוך של גורם חיצוני הפועל באופן יזום לנקיטת הליכים משפטיים או מדיניים מחוץ לישראל נגד חיילי צה\"ל בשל פעולה שביצעו במסגרת תפקידם או נגד מדינת ישראל.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
