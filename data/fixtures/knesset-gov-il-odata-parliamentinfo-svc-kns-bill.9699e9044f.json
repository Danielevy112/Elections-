    {
      "BillID": 2011617,
      "KnessetNum": 20,
      "Name": "חוק לתיקון פקודת התעבורה (מס' 122), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3828,
      "CommitteeID": 926,
      "StatusID": 118,
      "Number": 741,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-05-13T00:00:00",
      "MagazineNumber": 2717,
      "PageNumber": 661,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק התקבל בקריאה השנייה והשלישית ביום כ\"ב באייר התשע\"ח (7 במאי 2018). החוק קובע עבירה פלילית חדשה בפקודת התעבורה שעניינה איסור לחנות רכב באופן החוסם רכב אחר. האיסור יחול גם במקרים שבהם אדם מחנה את רכבו בשטח הממוקם לצד מקום חניה המיועד לפי דין לאדם עם מוגבלות ובכך אינו מאפשר לו להיכנס לרכבו הנושא תג נכה או לצאת ממנו. \nמאחר שהוראות פקודת התעבורה והתקנות לפיה חלות, ככלל, במקום פתוח שיש לציבור זכות לעבור בו, נקבע בחוק, למען הסר ספק, כי האיסור יחול גם במקומות חניה בבעלות פרטית.\nלעניין אכיפת החוק: ככל עבירה פלילית, המשטרה תהיה אחראית על אכיפת העבירה החדשה, ומאחר שמדובר בעבירת תעבורה - הרשויות המקומיות יהיו רשאיות, אם ירצו בכך, לעגן את העבירה בחוק עזר ולאכוף אותה באמצעות פקחים.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
