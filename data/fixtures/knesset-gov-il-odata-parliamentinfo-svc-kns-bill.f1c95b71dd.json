    {
      "BillID": 2008949,
      "KnessetNum": 20,
      "Name": "חוק העונשין (תיקון מס' 133 - הוראת שעה), התשע\"ח-2018",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1091,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2742,
      "PageNumber": 886,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון לחוק מאריך את תקופת המאסר שניתן להמיר לריצוי בדרך של עבודות שירות, מתקופה שאינה עולה על שישה חודשים לתקופה שאינה עולה על תשעה חודשי מאסר. עוד נקבע בחוק כי ככלל לעובד שירות כאמור, אשר נגזרו עליו יותר משישה חודשי עבודות שירות, תקבע תוכנית ליווי ושיקום. לעובד שירות כאמור, אשר עמד בתוכנית שנקבעה לו על ידי קצין המבחן ואשר קיבל אישור על כך שביצע את עבודות השירות כנדרש וברציפות, ניתן יהיה לקצר את התקופה שירצה במספר שבועות, כמפורט בתיקון. התיקון נקבע כהוראת שעה לתקופה של שנתיים. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2025-05-22T11:34:18.357"
    },
