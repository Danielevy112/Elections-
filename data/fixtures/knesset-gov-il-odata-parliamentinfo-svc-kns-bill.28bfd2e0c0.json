    {
      "BillID": 563773,
      "KnessetNum": 20,
      "Name": "חוק לתיקון פקודת העיריות (מס' 139), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1554,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 617,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-03-01T00:00:00",
      "MagazineNumber": 2533,
      "PageNumber": 580,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק לתיקון פקודת העיריות (מס' 139), התשע\"ו–2016 התקבל בקריאה שניה ושלישית ביום י\"ג באדר א' התשע\"ו (22 בפברואר 2016).\nהחוק קובע כי עירייה ומועצה מקומית יפרסמו באתר האינטרנט שלהן את כל הטפסים הנדרשים לקבלת השירותים שהן מספקות ובכל פרסום אחר שבו נכללים פרטים על דרכי פנייה או קבלת השירות מהן, יציינו את כתובות הדואר האלקטרוני שאליהן ניתן לשלוח פניות או טפסים, ויאפשרו לכל פונה אליהן בכתב לשלוח את פנייתו או טופס הנדרש לקבלת שירות באמצעות דואר אלקטורני לפי בחירתו, למעט במקרים בהם נדרשת נוכחותו האישית של הפונה או מבקש השירות.\n\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
