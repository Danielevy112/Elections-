    {
      "BillID": 2201652,
      "KnessetNum": 25,
      "Name": "חוק שירותי רווחה (זכויות נשים ששהו במקלט לנשים מוכות) (תיקון מס' 4), התשפ\"ד–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2908,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 967,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-02-22T00:00:00",
      "MagazineNumber": 3163,
      "PageNumber": 556,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה קובע כי סכום מענק ההסתגלות, שמשולם לאישה ששהתה במקלט לנשים מוכות בעת יציאתה מהמקלט, יעלה מ-8,000 שקלים חדשים ל-11,000 שקלים חדשים. בנוסף, בעת היציאה מהמקלט תקבל האישה תוספת סיוע למענק בגובה 1,000 שקלים חדשים, עבור כל אחד מילדיה הנמצא עימה, ולא רק עבור 2 ילדים כפי שהיה קבוע בחוק לפני תיקון זה. כמו כן חוק זה קובע כי מענק ההסתגלות ישולם לאישה בסמוך ליציאתה מהמקלט, וככל האפשר לפני יציאתה, ובכל מקרה לא יאוחר מ-30 יום ממועד שהוגשה הבקשה לתשלום המענק וזאת בשונה מהמצב שהיה עד תיקון זה לפיו המענק היה משולם לאחר יציאת האישה מהמקלט ועד 60 ימים לאחר שהוגשה הבקשה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 967 ,מיום 11:00:00",
      "LastUpdatedDate": "2024-02-26T16:45:24.543"
    },
