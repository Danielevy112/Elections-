    {
      "BillID": 572148,
      "KnessetNum": 20,
      "Name": "חוק הסדרים במשק המדינה (תיקוני חקיקה להשגת יעדי התקציב) (תיקון מס' 17), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2462,
      "CommitteeID": 922,
      "StatusID": 118,
      "Number": 785,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-25T00:00:00",
      "MagazineNumber": 2738,
      "PageNumber": 850,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק התקבל בקריאה השנייה והשלישית ביום ד' באב התשע\"ח (16 ביולי 2018) ונקבע כי אם רשות מקומית לא כללה בחישוב השטח של נכס המשמש למגורים שטח מצללה לשם הטלת ארנונה לפי צו הארנונה שלה ערב תחילתו של התיקון, היא לא תהיה רשאית לכלול אותו רק משום שהמצללה כוסתה בכיסוי שקוף העשוי מחומר פלסטי, ובלבד ששטח המצללה יוגבל לשימושים שניתן לעשותם בחצר, בגג או במרפסת של בית המגורים, למעט שימוש לצורכי חניה או אחסנה. תחילתו של חוק זה ביום 1 בינואר 2019.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
