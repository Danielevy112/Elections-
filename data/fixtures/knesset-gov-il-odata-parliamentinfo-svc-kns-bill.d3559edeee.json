    {
      "BillID": 571386,
      "KnessetNum": 20,
      "Name": "חוק שעות עבודה ומנוחה (תיקון מס' 18), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2372,
      "CommitteeID": 922,
      "StatusID": 118,
      "Number": 654,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-06-21T00:00:00",
      "MagazineNumber": 2725,
      "PageNumber": 698,
      "IsContinuationBill": null,
      "SummaryLaw": "החל מיום 1.1.2019 (יום תחילתו של החוק) עובד יוכל לסרב לעבוד ביום המנוחה השבועית שלו מכל טעם וסיבה, ולא רק בשל איסור שבמצוות דתו. האפשרות לסרב לעבוד ביום המנוחה לא תחול על עבודות הנוגעות לביטחון הציבור, בריאותו, או עבודות הקשורות בקיום ואספקת שירותים חיוניים, בדומה לאפשרות הסירוב לגבי עובד ששומר מצוות. זכות הסירוב כאמור לא תחול על מקומות עבודה שינתן לגביהם אישור של ועדת השרים המורכבת מראש הממשלה, שר העבודה, הרווחה והשירותים החברתיים והשר לשירותי דת.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
