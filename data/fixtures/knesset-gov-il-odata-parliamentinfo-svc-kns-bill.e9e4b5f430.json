    {
      "BillID": 2195706,
      "KnessetNum": 25,
      "Name": "חוק יישום תוכנית ההתנתקות (תיקון מס' 7), התשפ\"ג-2023",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 69,
      "CommitteeID": 4190,
      "StatusID": 118,
      "Number": 951,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2023-03-22T00:00:00",
      "MagazineNumber": 3030,
      "PageNumber": 70,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק יישום תכנית ההתנתקות (תיקון מס' 7), התשפ\"ג–2023 אושר בקריאה שניה ושלישית ביום 21/03/2023. \nהחוק קובע כי הסעיפים בחוק יישום ההתנתקות, התשס\"ה–2005, העוסקים בהגבלת כניסה ושהייה לשטח המפונה בצפון השומרון וכן במניעת הכנסת מיטלטלין על ידי ישראלים – יבטולו. כמו כן, נקבע כי הסעיף בחוק המבטל זכויות במקרקעין של ישראליים בצפון השומרון לא יחול על זכויות עתידיות שיתגבשו באזור זה, החל ממועד פרסום החוק. לבסוף, שם החוק שונה כך שייקרא \"חוק ההתנתקות והפיצויים לנפגעיה\".\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 951 ,מיום 16:00:00",
      "LastUpdatedDate": "2024-01-16T12:04:29.033"
    },
