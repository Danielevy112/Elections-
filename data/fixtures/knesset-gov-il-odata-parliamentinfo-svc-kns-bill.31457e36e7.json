    {
      "BillID": 2085944,
      "KnessetNum": 23,
      "Name": "חוק פנייה לגופים ציבוריים באמצעי קשר דיגיטליים (תיקון), התשפ\"א-2020",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 133,
      "CommitteeID": 2151,
      "StatusID": 118,
      "Number": 848,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2020-09-24T00:00:00",
      "MagazineNumber": 2856,
      "PageNumber": 16,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי מקום שגוף ציבורי מאפשר פנייה אליו באמצעות דואר אלקטרוני או באמצעי דיגיטלי אחר באופן שהשימוש בו זהה לפניה בדואר אלקטרוני- חובה עליו לאפשר פנייה אליו באותו עניין גם באמצעות פקסימיליה.\nכן קובע החוק כי הגופים הציבוריים עליהם הוא חל ידווחו על יישום החוק על ידיהם,  בהתאמה, לשרים השונים הממונים על פעילותם והשרים ירכזו את הדיווחים ויעבירו אותם לוועדת המדע והטכנולוגיה לא יאוחר מסוף הרבעון השני בשנים 2021, 2022, ו- 2024. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
