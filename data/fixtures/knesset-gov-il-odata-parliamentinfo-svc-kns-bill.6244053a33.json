    {
      "BillID": 2230366,
      "KnessetNum": 25,
      "Name": "חוק לתמיכה בפעולות לטובת נכים ונפגעי פעולות איבה (תיקוני חקיקה), התשפ\"ו–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5822,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1145,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-10-22T00:00:00",
      "MagazineNumber": 3456,
      "PageNumber": 12,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע כי תקציב שנתי לתמיכה במוסדות ציבור לשם קיום פעולות לטובת נכי צה\"ל לא יפחת מ-150 מיליון שקלים חדשים בשנה וכי תקציב שנתי לתמיכה במוסדות ציבור לשם קיום פעולות לטובת נפגעי פעולות איבה לא יפחת מ-10 מיליון שקלים חדשים בשנה. הסכום האמור ישמש גם לתמיכה במוסדות ציבור המקיימים פעולות לטובת קרובי משפחה של מי שפגיעת איבה גרמה למותו. התקציב יחולק בהתאם למבחני תמיכה שיקבעו שר הביטחון - לעניין נכי צה\"ל והשר שהמוסד לביטוח לאומי נמצא בתחום אחריותו או שר אחר שהסמיכה הממשלה – לעניין נפגעי פעולות איבה. כמו כן נקבעה חובת דיווח שנתית של המוסדות המקבלים תמיכה לשרים ושל השרים לוועדת העבודה והרווחה. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1145 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-05-05T09:31:03.517"
    },
