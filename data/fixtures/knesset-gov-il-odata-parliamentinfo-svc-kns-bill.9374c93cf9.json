    {
      "BillID": 544618,
      "KnessetNum": 20,
      "Name": "חוק זכויות החולה (תיקון מס' 9), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2042,
      "CommitteeID": 924,
      "StatusID": 118,
      "Number": 593,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-04-06T00:00:00",
      "MagazineNumber": 2544,
      "PageNumber": 695,
      "IsContinuationBill": true,
      "SummaryLaw": "החוק קובע כי אם הובא לידיעתו של מטפל כגון: רופא, אחות או פסיכולוג, כי הורה הורשע בביצוע עבירת מין או אלימות כלפי ילדו הקטין, או הוגש נגדו כתב אישום בשל ביצוע עבירה כאמור וכל עוד מתנהל ההליך הפלילי כנגדו, לא תידרש הסכמתו של אותו הורה לטיפול רפואי באותו ילד ולא יימסר לאותו הורה מידע לגבי טיפול רפואי באותו ילד. בית המשפט לענייני משפחה רשאי, לבקשת ההורה, להורות אחרת, אם מצא כי מתקיימות נסיבות מיוחדות המצדיקות זאת, וכי אין בכך כדי לפגוע בטובת הילד.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
