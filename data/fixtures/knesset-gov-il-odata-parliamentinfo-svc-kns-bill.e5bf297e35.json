    {
      "BillID": 2157265,
      "KnessetNum": 24,
      "Name": "חוק זכויות נפגעי עבירה (תיקון מס' 15), התשפ\"ב-2022",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 993,
