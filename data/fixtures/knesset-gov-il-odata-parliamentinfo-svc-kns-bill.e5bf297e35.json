      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-03-14T00:00:00",
      "MagazineNumber": 2966,
      "PageNumber": 764,
      "IsContinuationBill": null,
      "SummaryLaw": "הוחלט להסדיר את אופן נטילת ושמירת הדגימות הביולוגיות הנלקחות מנפגעי ונפגעות עבירות מין לצרכי זיהוי התוקף בחקירה משטרתית וגיבוש ראיות למשפט והכל כתלות בהסכמתו של הנפגע. עוד הוחלט כי כלל הדגימות יועברו למשטרת ישראל באופן דיסקרטי שישמור על פרטיותו של נפגע העבירה לצורך הפקת דנ\"א וישמרו שם לתקופה של 50 שנים לטובת הליכי חקירה ומשפט עתידיים.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
