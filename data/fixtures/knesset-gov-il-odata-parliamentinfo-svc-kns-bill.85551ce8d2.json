    {
      "BillID": 576953,
      "KnessetNum": 20,
      "Name": "חוק הטבות לניצולי שואה (תיקון מס' 8), התשע\"ז-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2751,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 656,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-11-02T00:00:00",
      "MagazineNumber": 2583,
      "PageNumber": 2,
      "IsContinuationBill": null,
      "SummaryLaw": "עד לתיקון זה, סעיף 3 לחוק הטבות לניצולי שואה קבע שמסכום הקצבה המגיעה לניצולי שואה לפי החוק ינוכה סכום הקצבה החודשית שהם מקבלים לפי ההסכם עם גרמניה משנת 1992 – קצבה המכונה \"קצבה לפי קרן סעיף 2\". \nהתיקון מבטל את חובת הניכוי לגבי ניצולי שואה שנקבעה להם דרגת נכות של יותר מ-25% ואין להם הכנסה נוספת. אלו הם אותם ניצולים שזכאים לתגמול לפי הכנסה ולתגמול מוגדל לפי הכנסה, לפי חוק נכי רדיפות הנאצים. \nבהתאמה, התיקון מבטל בהוראת השעה של תיקון מס' 5 לחוק הטבות לניצולי שואה, הוראה לפיה הקצבה שמשולמת לפי הסכם עם גרמניה תובא בחשבון לעניין חישוב הכנסה של מי שמשתלמת לו גמלת הבטחת הכנסה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
