    {
      "BillID": 577147,
      "KnessetNum": 20,
      "Name": "חוק לפיקוח על איכות המזון ולתזונה נכונה בצהרונים, התשע\"ז-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2914,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 657,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-11-27T00:00:00",
      "MagazineNumber": 2585,
      "PageNumber": 20,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע הוראות בעניין פיקוח על המזון שמסופק בצהרונים. במסגרת זו, החוק מטיל חובות על ספק מזון בצהרון, לרבות עמידה בתנאים שיקבע שר הבריאות לעניין הרכב המזון וערכו התזונתי. \nבנוסף, החוק כולל חובות גם על מפעילי הצהרונים, ובכלל זה חובת התקשרות עם ספק מזון מורשה בלבד, חובת פרסום הרכב המזון ופרטי ספק המזון, וחובת דיווח שנתית לממונה בדבר מכירה או הספקה של מזון בצהרון. \nלפי החוק, יוטלו עיצומים כספיים על ספק מזון או מפעיל צהרון שיפרו את החובות המוטלות עליהם.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
