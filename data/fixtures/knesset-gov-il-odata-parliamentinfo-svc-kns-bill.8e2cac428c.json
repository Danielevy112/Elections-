    {
      "BillID": 570408,
      "KnessetNum": 20,
      "Name": "חוק ההנדסאים והטכנאים המוסמכים (תיקון), התשע\"ו–2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2328,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 627,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-06-23T00:00:00",
      "MagazineNumber": 2557,
      "PageNumber": 935,
      "IsContinuationBill": null,
      "SummaryLaw": "בחוק ההנדסאים והטכנאים המוסמכים (תיקון), התשע''ו–2016, שונה הרכב מועצת ההנדסאים והטכנאים מ-13 נציגים ל-14. הנציג הנוסף יהיה נציגם של הסטודנטים במכללות הטכנולוגיות המוכרות, לפי המלצת התאחדות הסטודנטים. נקבע גם כי במקרה של דעות שקולות במועצה, תהיה ההכרעה נתונה ליושב הראש המועצה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
