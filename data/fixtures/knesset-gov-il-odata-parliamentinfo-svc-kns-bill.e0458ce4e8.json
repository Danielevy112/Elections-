    {
      "BillID": 2142675,
      "KnessetNum": 23,
      "Name": "חוק חובת המכרזים (תיקון מס' 24 - הוראת שעה) (תיקון), התש\"ף-2020",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 2148,
      "StatusID": 118,
      "Number": 1339,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2020-07-15T00:00:00",
      "MagazineNumber": 2827,
      "PageNumber": 228,
      "IsContinuationBill": null,
      "SummaryLaw": "במסגרת התיקון, הוחלט להאריך בשלוש שנים נוספות (עד ליולי 2023) את הוראת השעה שקבעה כי במכרזים לרכישת טקסטיל עבור מערכת הביטחון והמשרד לביטחון הפנים, תינתן העדפה לרכישה של טקסטיל מתוצרת הארץ. כמו כן, הוסכם להסמיך את שר האוצר להאריך בצו, באישור ועדת החוקה, את הוראת השעה בשנתיים נוספות.\t",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2022-09-21T14:24:36.583"
