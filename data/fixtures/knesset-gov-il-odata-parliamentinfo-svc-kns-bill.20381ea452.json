    {
      "BillID": 564843,
      "KnessetNum": 20,
      "Name": "חוק ההוצאה לפועל (תיקון מס' 49), התשע\"ו–2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1472,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 607,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-02-07T00:00:00",
      "MagazineNumber": 2527,
      "PageNumber": 533,
      "IsContinuationBill": null,
      "SummaryLaw": "סעיף 22 לחוק ההוצאה לפועל, התשכ\"ז–1967 (להלן – החוק), קובע רשימה של מיטלטלין שלא ניתן לעקלם במסגרת הליכי הוצאה לפועל. מדובר במיטלטלין הדרושים לשמירה על צרכי הקיום המינימאליים של החייב ולהבטחת יכולתו של החייב להתנייד ולפרנס עצמו. \nחוק ההוצאה לפועל (תיקון מס' 49), התשע\"ו–2016, מרחיב את המונח \"תשמישי קדושה\", ומבהיר שהוא כולל גם מיטלטלין בבית תפילה שנועדו לאפשר את קיום התפילה באופן סביר, כדוגמת מזגנים, ספסלים וכיוצא באלה.\nההגנה מפני עיקול המיטלטלין המנויים בסעיף 22(א) לחוק אינה מוחלטת. סעיף 22(ב) לחוק קובע, כי ההגנה מפני עיקול מיטלטלין לא תחול במקרה שבו הנושה שמבקש לעקל את הנכס הוא אותו הנושה שסיפק את הנכס, והוא מבקש לעקלו בגין החוב שהתחייב החייב ברכישת אותו הנכס. במקביל להרחבה של המונח \"תשמישי קדושה\", התיקון כאמור קובע שהסייג יחול גם לגבי תשמישי קדושה. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    }
  ]
