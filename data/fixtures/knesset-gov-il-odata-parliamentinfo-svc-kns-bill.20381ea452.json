    {
      "BillID": 564434,
      "KnessetNum": 20,
      "Name": "חוק עידוד מעורבות סטודנטים בפעילות חברתית וקהילתית, התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1207,
      "CommitteeID": 933,
      "StatusID": 118,
      "Number": 778,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-18T00:00:00",
      "MagazineNumber": 2733,
      "PageNumber": 756,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק עידוד מעורבות סטודנטים בפעילות חברתית וקהילתית, התשע\"ח-2018 התקבל בכנסת ביום כ\"ו בתמוז התשע\"ח (9 ביולי 2018). לפי החוק, מוסד להשכלה גבוהה יקבע, לאחר התייעצות עם ארגוני סטודנטים, תכנית להכרה בפעילות חברתית וקהילתית בהתנדבות המזכה בנקודות זכות. עוד קובע החוק כי מוסד כאמור יכיר בשירות מילואים בהיקף של 14 ימים בשנת לימודים כמזכה בשתי נקודות זכות. סטודנט יהיה זכאי לשתי נקודות זכות עבור אחד מהאמורים, פעם אחת במהלך לימודיו לתואר ראשון. מועד התחילה נקבע לשנת הלימודים התשע\"ט. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
