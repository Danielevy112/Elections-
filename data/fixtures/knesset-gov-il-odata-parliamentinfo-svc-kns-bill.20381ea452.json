    {
      "BillID": 564711,
      "KnessetNum": 20,
      "Name": "חוק העונשין (תיקון מס' 122), התשע\"ו–2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2059,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 628,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-04-07T00:00:00",
      "MagazineNumber": 2546,
      "PageNumber": 718,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק העונשין (תיקון מס' 122), התשע\"ה–2016 מוסיף לעבירות העוסקות ביחסים מיניים בהסכמה בין בגירים ונזכרות בחוק העונשין, התשל\"ז–1977, עבירות של בעילה אסורה, מעשה סדום ומעשים מגונים שנעשו כלפי בגירים במסגרת ייעוץ או הדרכה של כהן דת. \nמעשים אלו אסורים כאשר, לפי הנסיבות, ההסכמה למעשים הושגה תוך ניצול תלות נפשית ממשית של מקבל הייעוץ או ההדרכה, וכשמקור התלות האמורה הוא בייעוץ או בהדרכה שניתנו למקבל הייעוץ על ידי כהן דת. כהן דת הוגדר באופן רחב כך שהוא כולל גם את מי שמציג עצמו ככזה וכן אדם הידוע או המציג את עצמו כבעל סגולות רוחניות מיוחדות. העונש שנקבע לעבירות הוא ארבע שנות מאסר לעבירה של בעילה אסורה בהסכמה ושל מעשה סדום, ושלוש שנות מאסר לעבירה של מעשה מגונה באותן נסיבות. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
