    {
      "BillID": 2197231,
      "KnessetNum": 25,
      "Name": "חוק עבודת נשים (תיקון מס' 65), התשפ\"ה–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 622,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1054,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-01-15T00:00:00",
      "MagazineNumber": 3351,
      "PageNumber": 212,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה קובע כי עובד שהילד שבת זוגו ילדה אושפז בבית החולים לאחר הלידה לתקופה שעולה על שבועיים, יהיה זכאי להיעדר מעבודתו 20 ימים בתקופת האשפוז על חשבון ימי המחלה הצבורים שלו או על חשבון ימי חופשה, לפי בחירתו.  היעדרות כאמור יכולה להיות לא רצופה, ובנוסף העובד יוכל להיעדר מהעבודה חלקי ימים. כמו כן, ימי ההיעדרות של העובד על חשבון ימי המחלה יימנו ברצף מהיום הראשון שבו נעדר העובד על חשבון ימי המחלה שלו, אף אם ההיעדרות לא היתה רציפה, זאת גם ביחס להיעדרות על חשבון ימי מחלה לפי סעיף 7(ג3) לחוק עבודת נשים, התשי\"ד–1954, שקובע את הזכות של אב להיעדר אחרי הלידה. יובהר כי הסדר זה לא יגרע מזכותו של האב להיעדר 5 ימים לאחר הלידה לפי סעיף 7(ג3) האמור וכן לא תגרע מזכותו להיעדר לפי חוק דמי מחלה (היעדרות עקב היריון ולידה של בת הזוג), התש\"ס–2000. לסיום, נקבע כי עובד יוכל לממש את זכאותו לפי ההסדר המוצע אם הוא מסר למעסיקו אישור רפואי על אשפוז הילד והצהיר כי בימי ההיעדרות הוא שהה עם הילד שאושפז או עם ילדיו האחרים. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1054 ,מיום 10:00:00",
      "LastUpdatedDate": "2025-09-04T12:08:43.04"
    },
