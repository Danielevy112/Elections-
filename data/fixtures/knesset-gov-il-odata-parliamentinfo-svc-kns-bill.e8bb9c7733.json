    {
      "BillID": 2012821,
      "KnessetNum": 20,
      "Name": "חוק שינויים בהסדר תקופת הלידה וההורות (תיקוני חקיקה), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3781,
      "CommitteeID": 952,
      "StatusID": 118,
      "Number": 698,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-04-02T00:00:00",
      "MagazineNumber": 2624,
      "PageNumber": 572,
      "IsContinuationBill": null,
      "SummaryLaw": "מוצע לערוך מספר שינויים בהסדרים הנוגעים לתקופת לידה והורות. ראשית, מוצע להאריך את תקופת הלידה וההורות שמשולמים בעדה דמי לידה מ-14 ל-15 שבועות. כמו כן, מוצע לאפשר לגבר לקחת שבוע תקופת לידה והורות במהלך תקופת הלידה וההורות של בת זוגו ובמקביל אליה וזאת אם בת זוגו וויתרה על תשלום דמי הלידה בעד השבוע ה-15 לתקופת הלידה וההורות שלה. \nבנוסף מוצע לקבוע כי גבר יוכל להחליף את אשתו בתקופת הלידה וההורות לתקופה של שבוע אחד ומעלה, זאת בשונה מהמצב ערב חקיקת החוק לפיו גבר יכול היה להחליף את בת זוגו בתקופת לידה והורות לתקופה בת שלושה שבועות לפחות. עוד נקבע כי אפשרות הגבר להחליף את בת זוגו בתקופת הלידה וההורות תהיה רק בסוף תקופת הלידה וההורות שלה, ולאחר ששבה לעבודתה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
