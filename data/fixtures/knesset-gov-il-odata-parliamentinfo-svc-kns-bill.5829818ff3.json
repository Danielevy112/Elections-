    {
      "BillID": 564679,
      "KnessetNum": 20,
      "Name": "חוק עבודת נשים (תיקון מס' 54), התשע\"ו–2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2235,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 630,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-07-05T00:00:00",
      "MagazineNumber": 2560,
      "PageNumber": 950,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון קובע לראשונה חופשה לאב לאחר לידת ילדו. עד לתיקון זה, עובד היה רשאי להיעדר מעבודה ביום הלידה של בת זוגו על חשבון ימי המחלה הצבורים שלו. תיקון זה מאפשר לעובד להיעדר מעבודתו חמישה ימים נוספים, החל מהיום שלאחר יום הלידה.\n שלושת ימי ההיעדרות הראשונים יהיו ממכסת ימי החופשה השנתית של העובד, או על חשבון חופשה ללא תשלום אם אין לעובד ימי חופשה שנתית צבורים. \nהיומיים הנותרים יהיו ממכסת ימי המחלה של העובד. התיקון קובע כי ימי מחלה אלו הם המשך רציף ליום הלידה, שמוכר כבר היום כיום מחלה, ולפיכך העובד יהיה זכאי לתשלום מחצית דמי מחלה בעד כל יום משני ימי מחלה אלו.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
