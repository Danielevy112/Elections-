    {
      "BillID": 2018862,
      "KnessetNum": 20,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 207), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4433,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 779,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-06-27T00:00:00",
      "MagazineNumber": 2726,
      "PageNumber": 708,
      "IsContinuationBill": null,
      "SummaryLaw": "בחוק הביטוח הלאומי [נוסח משולב], התשנ''ה-1995, בוטלה ההוראה שקבעה כי ילד שנרשם במרשם האוכלוסין לאחר שחלפו 30 ימים מיום לידתו, תשולם בעדו קצבת ילדים רטרואקטיבית רק בעד תקופה שלא תעלה על 3 חודשים בתכוף למועד שבו הוגשה התביעה. ביטול ההוראה יאפשר תשלום קצבת ילדים רטרואקטיבית לתקופה של עד שנים עשר חודשים, בדומה לשאר הקצבאות שמשתלמות לפי חוק הביטוח הלאומי .",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
