    {
      "BillID": 565827,
      "KnessetNum": 20,
      "Name": "חוק העונשין (תיקון מס' 125), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1563,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 642,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-07-14T00:00:00",
      "MagazineNumber": 2561,
      "PageNumber": 966,
      "IsContinuationBill": null,
      "SummaryLaw": "סעיף 109 לחוק העונשין קובע כי מי שהסית או שידל אדם החייב בשירות בכוח מזויין שלא ישרת בו או שלא יתייצב לפעולה צבאית, דינו - מאסר חמש שנים. חוק העונשין (תיקון מס' 125) מבהיר כי עבירת ההסתה להשתמטות שבסעיף 109(ב) האמור, חלה גם על הסתה או שידול לערוק משירות כלפי מי שמשרת בצבא לאחר שהתנדב לפי סעיף 17 לחוק שירות ביטחון [נוסח משולב]. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 642 ,מיום 16:00:00",
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
