    {
      "BillID": 565678,
      "KnessetNum": 20,
      "Name": "חוק סדר הדין הפלילי (תיקון מס' 83), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1604,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 755,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2745,
      "PageNumber": 908,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק סדר הדין הפלילי [נוסח משולב] התשמ\"ב-1982 קובע כי על החלטה שלא להעמיד לדין תימסר הודעה בכתב לחשוד ולמתלונן. חוק סדר הדין הפלילי (תיקון מס' 83), התשע\"ח-2018 קובע כי בהודעה כאמור לא תצוין עילת סגירת התיק לחשוד או למתלונן. בהודעה יצוינו הדרכים בהן ניתן לברר את עילת הסגירה. ואולם, בעבירות מין או אלימות, בהודעת סגירת התיק כאמור תצוין עילת סגירת התיק, הן לחשוד והן למתלונן.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
