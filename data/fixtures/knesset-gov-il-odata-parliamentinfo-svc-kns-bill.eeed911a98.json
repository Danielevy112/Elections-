    {
      "BillID": 568456,
      "KnessetNum": 20,
      "Name": "חוק עבודת נשים (תיקון מס' 55), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2041,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 629,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-07-28T00:00:00",
      "MagazineNumber": 2569,
      "PageNumber": 1090,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון משנה את המונחים בחוק עבודת נשים ובחוק הביטוח הלאומי כך שבמקום \"חופשת לידה\" יבוא \"תקופת לידה והורות\". בנוסף, התיקון קובע כי עובד יכול להיעדר במשך שעת ההורות (המוכרת גם כ\"שעת הנקה\") לסירוגין עם בת זוגו או במקומה, כל עוד נתנה בת הזוג את הסכמתה לכך. בנוסף, המוסד לביטוח לאומי מחוייב למסור הודעה לשני ההורים, במכתב לכתובת מגוריהם, בעניין הזכויות ההוריות להן הם זכאים מכוח חוק עבודת נשים.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
