      "PostponementReasonDesc": null,
      "PublicationDate": "2023-06-07T00:00:00",
      "MagazineNumber": 3047,
      "PageNumber": 396,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון קובע כי בעל דירה רשאי להתקין על חשבונו מנגנון המאפשר הפעלה אוטומטית של משאבת מים בלא חילול שבת ברכוש המשותף והוא יישא בהוצאות החזקתו של המנגנון והפעלתו. עוד נקבע כי ההתקנה לא תותנה בקבלת הסכמת בעלי הדירות האחרים אך תעשה בכפוף לתנאים המנויים בתיקון. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 950 ,מיום 16:00:00",
      "LastUpdatedDate": "2023-09-28T14:26:53.093"
    },
