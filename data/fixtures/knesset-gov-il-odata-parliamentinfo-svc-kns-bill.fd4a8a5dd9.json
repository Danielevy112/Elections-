      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1029 ,מיום 11:00:00",
      "LastUpdatedDate": "2024-09-29T12:25:21.503"
