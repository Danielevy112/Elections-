    {
      "BillID": 2201602,
      "KnessetNum": 25,
      "Name": "חוק לפיצוי קורבנות טרור (פיצויים לדוגמה), התשפ\"ד-2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2967,
      "CommitteeID": 4190,
      "StatusID": 118,
      "Number": 975,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-03-12T00:00:00",
      "MagazineNumber": 3173,
      "PageNumber": 594,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מסדיר את זכאותם של נפגעי טרור ומשפחותיהם לפיצויים לדוגמה ממבצע מעשה טרור, מי שנתן תגמול בעד ביצוע מעשה טרור וכן מי שנקבעה חבותו לפי פקודת הנזיקין. נקבע כי סכום הפיצויים לדוגמה יהיה עשרה מיליון שקלים חדשים אם מעשה הטרור גרם למותו של אדם, וחמישה מיליון שקלים חדשים אם מעשה הטרור גרם לאדם נכות צמיתה. במסגרת זאת, מוצע שפיצויים אלו לא יהיו ניתנים לניכוי מכל סכום המשולם לנפגעי מעשה הטרור מטעם המדינה או מוסד ממוסדותיה. עוד נקבע כי נפגעי הטרור יוכלו לממש את פסק הדין מכל נכס של מתגמל הטרור; וביחס למתגמל טרור או מי שנקבעה חבותו לפי פקודת הנזיקין שהוא הרשות הפלסטינית גם מהכספים המוקפאים לפי חוק להקפאת כספים ששילמה הרשות הפלסטינית בזיקה לטרור המועברים אליה מממשלת ישראל, התשע\"ח-2018, למעט הכספים המועברים לרשות הפלסטינית מכוח חוקי היישום. בנוסף, נקבעה חזקה לפיה אם מדיניות מתמגל הטרור בעניין העברת תשלומים למבצעי מעשי טרור מיושמת בחקיקה ראשית, חקיקת משנה או הנחיות, הוא ייחשב מתמגל טרור לעניין מעשה טרור שגרם למוות או נכות, אלא אם הוכח אחרת.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 975 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-07-30T12:44:40.857"
    },
