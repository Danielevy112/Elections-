    {
      "BillID": 543974,
      "KnessetNum": 20,
      "Name": "חוק הדיור הציבורי (זכויות רכישה) (תיקון מס' 6), התשע\"ו-2015",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2020,
      "CommitteeID": 934,
      "StatusID": 118,
      "Number": 593,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2015-12-31T00:00:00",
      "MagazineNumber": 2519,
      "PageNumber": 324,
      "IsContinuationBill": true,
      "SummaryLaw": "חוק הדיור הציבורי (זכויות רכישה) (תיקון מס' 6), התשע\"ו–2015, קובע כי בחישוב תקופת המגורים בדירה הציבורית לצורך קביעת הזכאות לרכישת הדירה, יובאו בחשבון גם תקופות מגורים מחוץ לדירה הציבורית, אם במהלכן  הדיירת או הדיירת הממשיכה שהתה במקלט לנשים מוכות, או עזבה את הדירה בשל אלימות מצד בן הזוג. תנאי לחישוב התקופות כאמור הוא שניתנה החלטה שיפוטית המעידה על קיומה של אלימות, או שניתן אישור מיוחד מהמחלקה לשירותים חברתיים שהדיירת מטופלת במחלקה על רקע אלימות.\nעד התיקון האמור נשים אשר נאלצו לברוח מדירתן בדיור הציבורי, למקלט לנשים מוכות או לסידורים שונים שמצאו בקהילה ובשל כך לא השלימו את התנאי לזכאות לרכישת הדירה הציבורית, שהוא מגורים בדירה במשך חמש שנים רצופות, איבדו את זכאותן לקנות את הדירה במחיר מסובסד בתנאים שקבועים בחוק.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
