    {
      "BillID": 2197714,
      "KnessetNum": 25,
      "Name": "חוק החמרת ענישה בעבירות מין על רקע לאומני (תיקוני חקיקה), התשפ\"ג-2023",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 715,
      "CommitteeID": 4263,
      "StatusID": 118,
      "Number": 970,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2023-08-03T00:00:00",
      "MagazineNumber": 3083,
      "PageNumber": 666,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מבהיר כי הוראות ההחמרה בענישה בגין מעשה טרור חלות על עבירות מין, וכן מחיל את הוראות ההחמרה בענישה בגין עבירה ממניע גזענות או עוינות כלפי ציבור, כמשמעותה בחוק העונשין, על עבירות הטרדה מינית. בנוסף, בית המשפט רשאי לפסוק כפל הפיצוי הקבוע בחוק בגין עבירות הטרדה מינית שבוצעו ממניע של גזענות או עוינות כלפי ציבור. לצד זאת, נקבעה חובת דיווח שנתית לוועדה לביטחון לאומי של הכנסת אודות מספר כתבי האישום שהוגשו ומספר תיקי החקירה שנפתחו בגין עבירות מין ועבירות הטרדה מינית שבוצעו ממניע של גזענות או עוינות כלפי ציבור, או שהן מעשה טרור.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 970 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-04-09T13:51:24.087"
    },
