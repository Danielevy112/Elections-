    {
      "BillID": 2011818,
      "KnessetNum": 20,
      "Name": "חוק התגמולים לנפגעי פעולות איבה (תיקון מס' 34), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3708,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 695,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-03-30T00:00:00",
      "MagazineNumber": 2622,
      "PageNumber": 558,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מסמיך את הוועדה המאשרת שמונתה מכוח סעיף 10 לחוק התגמולים לנפגעי פעולות איבה, להכיר בפגיעת איבה שארעה מחוץ למדינת ישראל, אף אם מטרתה לא הייתה פגיעה בישראל או בעם היהודי. ההכרה תהיה אם פגיעת האיבה נעשתה על ידי ארגון שלפחות אחת ממטרותיו היא לפגוע בישראל, באזרחי ישראל או ביהודים. אדם לא יוכר כנפגע אם הפגיעה אירעה מחוץ לישראל במדינה שמנויה בסעיף 2א לחוק למניעת הסתננות (עבירות ושיפוט), התשי\"ד-1954, למעט מצרים או עבר הירדן.\nעוד קובע החוק כי במידה וישולמו לנפגע תשלומים לפי דין זר או ממדינת חוץ בעד אותה פעולת איבה, יופחתו תשלומים אלו מהתגמולים לפי חוק זה. \nשר העבודה, הרווחה והשירותים החברתיים, בהסכמת שר הביטחון, רשאי לקבוע תנאים נוספים לאישור פגיעת איבה שארעה מחוץ לישראל.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
