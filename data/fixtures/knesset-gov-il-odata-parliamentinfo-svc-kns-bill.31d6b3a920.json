    {
      "BillID": 2010691,
      "KnessetNum": 20,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 190), התשע\"ז-2017",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 1099,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-01-30T00:00:00",
      "MagazineNumber": 2600,
      "PageNumber": 362,
      "IsContinuationBill": null,
      "SummaryLaw": "גמלת סיעוד משולמת מהמוסד לביטוח לאומי למי שהגיע לגיל פרישה והוא מתגורר בביתו וזקוק לעזרת אדם אחר בביצוע פעולות יום יום.\nחוק הביטוח הלאומי קובע כי זכאי לגמלת סיעוד לא יהיה זכאי לגמלה בתקופה שבה הוא שוהה במוסד סיעודי. ואולם, מבוטח שאושפז בבית חולים ימשיך להיות זכאי לגמלת הסיעוד לתקופה שעמדה, עד לתיקון זה, על 14 ימים ממועד האשפוז. גמלת הסיעוד שמשולמת בתקופת האשפוז מאפשרת מתן טיפול סיעודי בזמן האשפוז.\nתיקון זה מאריך את התקופה וקובע כי גמלת הסיעוד תהיה משולמת למבוטח שמאושפז בבית חולים למשך 30 ימים.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
