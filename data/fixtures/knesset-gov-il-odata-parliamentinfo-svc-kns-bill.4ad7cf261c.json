    {
      "BillID": 2086004,
      "KnessetNum": 23,
      "Name": "חוק שיקים ללא כיסוי (תיקון מס' 14), התש\"ף-2020",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 410,
      "CommitteeID": 2148,
      "StatusID": 118,
      "Number": 845,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2020-08-18T00:00:00",
      "MagazineNumber": 2843,
      "PageNumber": 398,
      "IsContinuationBill": null,
      "SummaryLaw": "הוחלט לתקן את חוק שיקים ללא כיסוי ולקבוע כי כאשר מוצג שיק לפירעון ואין בחשבון הבנק יתרה מספקת שמאפשרת את פירעונו, הבנק יהיה חייב להודיע לבעל החשבון, מוקדם ככל הניתן, שעליו להפקיד כספים בחשבון עד שעתיים וחצי לפני תום יום העסקים כדי למנוע את סירוב השיק. כמו כן, הוחלט להוסיף עילות נוספות הנוגעות למסירת ההודעה כאמור לעילות המאפשרות ללקוח מוגבל וללקוח מוגבל חמור לבקש מבית המשפט לבטל הבאת שיק שסורב במניין השיקים שסורבו וכן, להסמיך את המפקח על הבנקים לקבוע הוראות ביצוע פרטניות בעניין פרטי ההודעה ושליחתה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2022-08-08T08:45:02.333"
    },
