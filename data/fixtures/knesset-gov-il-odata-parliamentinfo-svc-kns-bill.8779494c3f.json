    {
      "BillID": 579107,
      "KnessetNum": 20,
      "Name": "חוק התכנון והבנייה (תיקון מס' 117 - הוראת שעה), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3044,
      "CommitteeID": 952,
      "StatusID": 118,
      "Number": 673,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-08-07T00:00:00",
      "MagazineNumber": 2660,
      "PageNumber": 1152,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק התכנון והבניה (תיקון מס' 117 – הוראת שעה), התשע\"ז–2017 התקבל בכנסת ביום ג' באב התשע\"ז (26 ביולי 2017). החוק קובע כי ועדה מקומית תהיה חייבת לתת הקלה של תוספת דירות למגורים, בדרך של פיצול דירה צמודת קרקע לדירה אחת נוספת, בהתמלא תנאים המפורטים בחוק, בין היתר לעניין שטח הדירות שיתווספו עקב ההקלה. יחד עם זאת, נקבע כי ועדה מקומית תהיה רשאית לקבוע, לאחר שהוצגה לפניה חוות דעת בכתב של מהנדס הוועדה, את מספר דירות המגורים המרבי שהיא תתיר לפצל בתחום מרחב התכנון שלה כולו או חלקו, בהתחשב במוסדות הציבור, השטחים הפתוחים, התשתיות ושטחי החניה הקיימים בכל אזור במרחב התכנון, ובלבד שהמספר האמור לא יפחת מ-20% ממספר הדירות צמודות הקרקע שבתחומה. עוד נקבע, כי לעניין הפיצול יחול היטל השבחה מופחת, בשיעור של שני שלישים מהקבוע היום בחוק, כאשר מחציתו תשולם בעת מתן ההקלה והמחצית השניה תשולם רק בעת מימוש הזכויות בנכס, וכי לא ניתן יהיה לדרוש בניית ממ\"ד בדירה החדשה כתנאי למתן ההקלה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
