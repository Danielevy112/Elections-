    {
      "BillID": 566005,
      "KnessetNum": 20,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 169), התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1987,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 615,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-02-17T00:00:00",
      "MagazineNumber": 2532,
      "PageNumber": 577,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה מרחיב את מעגל הזכאים למענק לימודים כך שהוא יינתן בעד ילדים שגילם עד 18, ולא עד 14 כקבוע היום, ובשיעור אחיד של 11.6% מהסכום הבסיסי, במקום בשיעורים משתנים כקבוע היום. כמו כן, נקבע כי המועד לקביעת גיל הילדים יהיה ב-31 בדצמבר של שנת הלימודים שבעדה משולם המענק, כך שיותאם לחוק לימוד חובה, במקום לפי התאריך העברי כפי שקבוע היום. החוק יחול משנת הלימודים תשע\"ז ואילך. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
