    {
      "BillID": 2220329,
      "KnessetNum": 25,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 255), התשפ\"ה–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4821,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1091,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-03-06T00:00:00",
      "MagazineNumber": 3378,
      "PageNumber": 342,
      "IsContinuationBill": null,
      "SummaryLaw": "בתיקון זה לחוק הביטוח הלאומי נקבע כי אדם שלפני שירותו במילואים שוחרר משירות קבע, יחולו עליו הוראות פרק י\"ב לחוק הביטוח הלאומי והתקנות שנקבעו לפיו, לעניין חישוב תגמול המילואים, כאילו היה עובד בעת שירותו בשירות הקבע, אף שלא התקיימו לגביו יחסי עבודה, אלא אם כן לטובתו הוא שחישוב התגמול ייעשה ללא התייחסות לשירות הקבע. תחילתו של החוק היא ביום 1 ביוני 2025, והוא יחול על תגמול המגיע בעד שירות מילואים שהחל ביום 7 באוקטובר 2023 או אחריו. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1091 ,מיום 11:00:00",
      "LastUpdatedDate": "2025-08-11T09:59:06.72"
    },
