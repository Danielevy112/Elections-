    {
      "BillID": 2217042,
      "KnessetNum": 25,
      "Name": "חוק הכרה בתרומתם של כלבים ששירתו בגופים ביטחוניים, התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4647,
      "CommitteeID": 4190,
      "StatusID": 118,
      "Number": 1138,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-06-10T18:13:00",
      "MagazineNumber": 3536,
      "PageNumber": 624,
      "IsContinuationBill": null,
      "SummaryLaw": "במסגרת חוק הכרה בתרומתם של כלבים ששירתו בגופים ביטחוניים, התשפ\"ו–2026, נקבע כי בעליו של כלב (למעט תאגיד) ששירת בצבא הגנה לישראל, משטרת ישראל, שירות בתי הסוהר או משמר הכנסת, יהיה זכאי להחזר מהמדינה בעד ההוצאות הרפואיות הנדרשות לטיפול בכלבו, לרבות ביטוח רפואי. החזר ההוצאות לא יעלה על 5,000 שקלים חדשים בשנה, יותנה בהוכחת תשלום בפועל, וסכומו יעודכן מדי שנה, ב-16 בפברואר, בהתאם לשיעור עליית מדד המחירים לצרכן. בנוסף, נקבע כי שר הביטחון, השר לביטחון לאומי ויושב ראש הכנסת ימונו על ביצוע החוק בגופים שבאחריותם, והם רשאים להתקין תקנות המסדירות את אופן הגשת הבקשות להחזר רפואי ואת הטיפול בהן.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1138 ,מיום 11:00:00",
      "LastUpdatedDate": "2026-07-26T14:40:25.113"
    },
