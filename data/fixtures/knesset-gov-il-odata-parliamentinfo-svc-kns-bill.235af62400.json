    {
      "BillID": 2017411,
      "KnessetNum": 20,
      "Name": "חוק מס הכנסה (ניכוי הוצאות הנפקה) (הוראת שעה), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4275,
      "CommitteeID": 922,
      "StatusID": 118,
      "Number": 736,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-03-18T00:00:00",
      "MagazineNumber": 2709,
      "PageNumber": 426,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק התקבל בקריאה השנייה והשלישית ביום כ\"ו באדר התשע\"ח (13 במרץ 2018). בתיקון נקבע שחברה או שותפות תהיה זכאית לנכות הוצאות שהיו לה להנפקת מניות או יחידות השתתפות שהונפקו בבורסה בישראל בשנה שבה בוצעה ההנפקה. הסדר זה נקבע כהוראת שעה מיום 1.1.18 עד סוף שנת 2020, ושר האוצר רשאי להאריך את הוראת השעה, באישור ועדת הכספים של הכנסת, לתקופות נוספות, שלא יעלו על שלוש שנים כל אחת.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
