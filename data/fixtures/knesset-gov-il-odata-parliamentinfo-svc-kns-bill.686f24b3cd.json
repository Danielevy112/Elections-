    {
      "BillID": 2192117,
      "KnessetNum": 25,
      "Name": "חוק בתי המשפט (תיקון מס' 106), התשפ\"ו–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3786,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 917,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-12-03T14:02:00",
      "MagazineNumber": 3464,
      "PageNumber": 32,
      "IsContinuationBill": true,
      "SummaryLaw": "החוק נועד להבנות את שיקול הדעת של בית המשפט בנוגע לצילום ולפרסום תצלום של חשוד המוחזק במעצר לפני הגשת כתב אישום באולם בית המשפט, ומבהיר כי על בית המשפט לאשר זאת רק מטעמים מיוחדים שיירשמו ואם הוא שוכנע שיש בכך עניין ציבורי של ממש העולה על הפגיעה בכבוד החשוד. הוראה דומה תחול גם בבתי הדין הצבאיים. כמו כן, נקבע איסור על פרסום צילומים של חשודים כאמור שצולמו בתוך מבנה בית המשפט (מחוץ לאולם הדיונים), אלא אם לא ניתן לזהות את העצור, או שניתנה הסכמה של בית המשפט או של החשוד לפרסום.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 917 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-07-22T15:21:48.833"
    },
