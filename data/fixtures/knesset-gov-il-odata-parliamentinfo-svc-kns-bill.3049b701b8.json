    {
      "BillID": 2071784,
      "KnessetNum": 20,
      "Name": "חוק פעוטות בסיכון (הזכות למעון יום) (תיקון מס' 4), התשע\"ח-2018",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 924,
      "StatusID": 118,
      "Number": 1231,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2742,
      "PageNumber": 894,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה קובע כי הסמכות לדון בזכאותו של פעוט בסיכון למעון יום לפי חוק פעוטות בסיכון (הזכות למעון יום), התש\"ס–2000, תהיה בידי ועדת פעוטות לסיכון, ולא בידי ועדת תכנון טיפול והערכה. כמו כן קובע החוק כי ועדה זו רשאית לקבוע לגבי הפעוט ומשפחתו דרכי טיפול בקהילה. עם זאת, במקרים המפורטים בחוק שבהם קיים סיכון מוגבר לפעוט, הסמכות לדון בעניינו של הפעוט תהיה בידי ועדת תכנון טיפול והערכה. \nהחוק קובע כי ניתן להכיר בפעוט מוכה כפעוט בסיכון גם על סמך מידע רפואי שהתקבל מאחות או מרופא במקום הדרישה לחוות דעת רפואית מרופא, וכן הוא קובע כי ניתן להכיר בפעוט כפעוט בסיכון במצב שבו אחד מהורי הפעוט אינו מתפקד כראוי מחמת התמכרות להימורים ויש חשש ממשי להתפתחותו התקינה של הפעוט עקב כך. \n\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2020-01-28T20:09:07.837"
    },
