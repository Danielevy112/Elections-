    {
      "BillID": 2237751,
      "KnessetNum": 25,
      "Name": "חוק יום לציון מורשת יהדות מרוקו וצפון אפריקה, התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 6381,
      "CommitteeID": 4192,
      "StatusID": 118,
      "Number": 1193,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-07-20T00:00:00",
      "MagazineNumber": 3558,
      "PageNumber": 828,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי מדי שנה, ביום כ\"ג בטבת, יצוין יום מורשת יהדות מרוקו וצפון אפריקה. יום זה נקבע במועד שבו טבעה ספינת \"אגוז\", שנשאה כ־40 יהודים שביקשו לעלות לישראל ממרוקו. במסגרת היום יצוינו המסורת, התרבות, האמנות, הפיוט, נכסי הרוח ופסיקת החכמים של קהילות אלה, וזאת בין היתר באמצעות דיון שייערך בכנסת, כנס שיעסוק בנושא ופעילויות חינוכיות שיתקיימו במוסדות החינוך.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1193 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-07-29T15:29:10.427"
    },
