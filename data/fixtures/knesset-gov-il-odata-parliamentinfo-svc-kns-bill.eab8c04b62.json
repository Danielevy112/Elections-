    {
      "BillID": 2004961,
      "KnessetNum": 20,
      "Name": "חוק עבודת נשים (תיקון מס' 56), התשע\"ז–2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3278,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 688,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-03-30T00:00:00",
      "MagazineNumber": 2620,
      "PageNumber": 533,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע במפורש כי עבודה ב\"משרה מלאה\", הנדרשת לשם מימוש הזכות לשעת הורות, היא משרה מלאה לפי הנהוג במקום העבודה של העובדת. כמו כן, נקבע כי הזכות לשעת הורות תינתן גם לנשים או לגברים שהיקף המשרה שלהם הוא 174 שעות בחודש לפחות.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
