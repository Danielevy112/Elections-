    {
      "BillID": 2225412,
      "KnessetNum": 25,
      "Name": "חוק הכניסה לישראל (תיקון מס' 41), התשפ\"ה–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5255,
      "CommitteeID": 4198,
      "StatusID": 118,
      "Number": 1102,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-06-16T00:00:00",
      "MagazineNumber": 3425,
      "PageNumber": 668,
      "IsContinuationBill": null,
      "SummaryLaw": "מוצע לקבוע כי במקרים שבהם יקבע שר הפנים, בהתבסס על חוות דעת של מנהל רשות האוכלוסין וההגירה, כי מסתנן תומך בממשל מדינתו, תקום חזקה כי לא נשקפת סכנה המונעת את החזרתו למדינתו. במקרה כאמור, שר הפנים ייתן לאותו אדם הזדמנות להשמיע את טענותיו לעניין זה. כמו כן, ניתן יהיה לסתור את החזקה בתוך 30 ימים מיום ההודעה על קביעה כאמור. אם לא נסתרה החזקה בתוך התקופה האמורה, יבוטל רישיון הישיבה שניתן לאותו אדם, והוא יורחק מישראל למדינתו, בהתאם להוראות סעיף 13 לחוק הכניסה לישראל. עוד מוצע לקבוע כי בכל מקרה בו מסתנן הורשע בעבירה שדינה שלוש שנות מאסר ומעלה שר הפנים יבטל את רישיון הישיבה שניתן לו וירחיקו מישראל לאחר שהמסתנן ריצה את עונשו, אם מצא כי שהייתו מסכנת את בטחון המדינה או את שלום הציבור במדינת ישראל.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1102 ,מיום 11:00:00",
      "LastUpdatedDate": "2025-07-30T09:55:15.613"
    },
