    {
      "BillID": 2227749,
      "KnessetNum": 25,
      "Name": "חוק איסור אלימות בספורט (תיקון מס' 4), התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5460,
      "CommitteeID": 4187,
      "StatusID": 118,
      "Number": 1168,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-02-08T00:00:00",
      "MagazineNumber": 3496,
      "PageNumber": 282,
      "IsContinuationBill": null,
      "SummaryLaw": "במסגרת חוק זה נקבעה עבירה פלילית חדשה וייעודית האוסרת על יידוי אמצעים פירוטכניים באירועי ספורט. החוק מגדיר \"אמצעי פירוטכני\" ככזה הכולל מכלול אמצעים כימיים שהפעלתם גורמת לקולות נפץ, עשן או אור, ובכלל זה חזיזים. על פי החוק, חל איסור מוחלט ליידות אמצעים אלו בזמן קיומו של אירוע ספורט או בסמוך אליו, בין אם היידוי מתבצע בתוך המקום שבו מתקיים האירוע ובין אם הוא מכוון לעבר מקום כזה מבחוץ. נקבע כי אדם שיורשע ביידוי אמצעי פירוטכני באירוע ספורט או לעברו צפוי לעונש של שלוש שנות מאסר, זאת בשונה מהעונש שהיה קבוע עד כה בחוק בגין עבירה כללית של יידוי חפץ שהסתכם בקנס כספי בלבד.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1168 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-04-16T13:21:35.803"
    },
