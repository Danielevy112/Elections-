    {
      "BillID": 2223298,
      "KnessetNum": 25,
      "Name": "חוק-יסוד: הממשלה (תיקון מס' 13)",
      "SubTypeID": 55,
      "SubTypeDesc": "ועדה",
      "PrivateNumber": null,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1070,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-05-13T00:00:00",
      "MagazineNumber": 3411,
      "PageNumber": 634,
      "IsContinuationBill": null,
      "SummaryLaw": "ההסדר החוקתי של ממשלת חילופים נחקק בכנסת העשרים ושלוש, נוכח האתגרים השונים שהמדינה עמדה בהם באותה העת. עתה, נוכח הקשיים שהסדר ייחודי זה עורר, חוק היסוד מבטל את הסעיפים בחוק יסוד: הממשלה, הקובעים את ההסדר החוקתי האמור, ובמקביל עורך תיקוני התאמה בסעיפים השונים בחוק היסוד שמתייחסים להסדר האמור. על פי חוק היסוד ההסדר יבוטל החל מתחילת כהונת הכנסת ה–26.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1070 ,מיום 11:00:00",
      "LastUpdatedDate": "2025-09-28T14:47:12.42"
    },
