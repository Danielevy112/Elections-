    {
      "BillID": 2014720,
      "KnessetNum": 20,
      "Name": "חוק התקנת מצלמות לשם הגנה על פעוטות במעונות יום לפעוטות, התשע\"ט-2018 ",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4025,
      "CommitteeID": 924,
      "StatusID": 118,
      "Number": 815,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-12-27T00:00:00",
      "MagazineNumber": 2767,
      "PageNumber": 94,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מחייב מפעיל של מעון יום לפעוטות שבו שוהים 7 פעוטות לפחות, וכן מפעיל של מעון יום שיקומי, להתקין מצלמות שיתעדו את הנעשה במעון בכל השעות שבהן שוהים פעוטות במעון, בהקלטת וידיאו ללא קול. החוק אוסר על צפייה בצילומים, העתקתם, העברתם לאחר ועשיית כל שימוש בהם אלא לפי צו של בית משפט או על ידי משטרת ישראל, רשויות התביעה ובעלי תפקידים מסויימים במשרד העבודה, הרווחה והשירותים החברתיים, בכפוף לתנאים שנקבעו בחוק. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
