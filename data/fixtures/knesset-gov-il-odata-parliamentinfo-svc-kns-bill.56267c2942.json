    {
      "BillID": 2199188,
      "KnessetNum": 25,
      "Name": "חוק גיל פרישה (הורה שילדו נפטר) (הוראת שעה) (תיקון מס' 3), התשפ\"ה–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3708,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1094,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-04-02T00:00:00",
      "MagazineNumber": 3398,
      "PageNumber": 478,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון לחוק קובע כי החוק יהפוך מהוראת שעה להוראה קבועה. בנוסף, נקבע כי התקופה שעל עובד להיות מועסק במקום עבודתו בתכוף לגיל חובת הפרישה כתנאי לזכאותו תקוצר, והיא תעמוד על חמש שנים לפני גיל פרישת החובה, במקום שבע שנים. כמו כן, נקבע, כי רשימת החריגים שהחוק לא חל בעניינם תכלול גם את מאבטחי הרשות להגנה על עדים. עוד נקבע, כי השר לשוויון חברתי וקידום מעמד האישה יפעל להביא לידיעתם של הורים שילדם נפטר את זכויותיהם לפי חוק זה, וכי אם במסגרת סמכותו להתקין תקנות לביצוע החוק, יותקנו תקנות העוסקות ביחסי עבודה, הן יהיו טעונות גם את הסכמתו של שר העבודה.\n\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1094 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-04-08T09:16:48.093"
    },
