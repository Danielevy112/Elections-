  "value": [
    {
      "BillID": 2025746,
      "KnessetNum": 20,
      "Name": "חוק סדר הדין הפלילי (תיקון מס' 87), התשע\"ט-2019",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1183,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2019-01-10T00:00:00",
      "MagazineNumber": 2780,
      "PageNumber": 238,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון לחוק שינה את הסדר ההתיישנות הקבוע בהליכים פליליים, וכן קבע הוראות לעניין תקופות החקירה וההעמדה לדין בהליכים פליליים, ובתוך כך; קביעת תקופה מרבית להארכת תקופת ההתיישנות כתוצאה מביצוע פעולות חקירה, ביטול ההתיישנות בעבירת הרצח, הארכת תקופת ההתיישנות בפשעים חמורים, קביעת תקופות שלא יובאו בחשבון בחישוב תקופת ההתיישנות (כגון היעלמות החשוד וחסינות שמגנה על החשוד), והגבלת משך הליכי חקירה והעמדה לדין. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-02-14T14:09:10.967"
    },
    {
      "BillID": 2068441,
      "KnessetNum": 20,
      "Name": "חוק הבוררות (תיקון מס' 4), התשע\"ט-2018",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1219,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-11-28T00:00:00",
      "MagazineNumber": 2760,
      "PageNumber": 68,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון קובע כי הסמכות של בתי המשפט לגבי הליך בוררות תהיה בהתאם לכללי הסמכות העניינית הרגילים, קרי: בית המשפט אליו הייתה מוגשת התובענה אלמלא נדונה בהליך הבוררות, הוא גם בית המשפט שמוסמך לדון בהליכי הבוררות. התיקון שינה את המצב שנהג קודם לכן ולפיו בית המשפט המוסמך בענייני בוררות נקבע בהתאם ליוזם ההליך (הצדדים או בית המשפט). ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-02-14T13:48:27.443"
    },
