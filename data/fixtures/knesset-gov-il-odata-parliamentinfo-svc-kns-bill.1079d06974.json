    {
      "BillID": 1046320,
      "KnessetNum": 25,
      "Name": "חוק זיכרון הטבח והנצחת הגבורה ביום כ\"ב בתשרי (שמחת תורה) – 7 באוקטובר, התשפ\"ו–2026",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 4192,
      "StatusID": 118,
      "Number": 1906,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-07-22T00:00:00",
      "MagazineNumber": 3567,
      "PageNumber": 876,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק נועד לשמר את זיכרון הטבח ולהנציח את מעשי הגבורה שאירעו ב־7 באוקטובר ובימים הסמוכים. לשם כך נקבע יום זיכרון ממלכתי, ותוקם רשות זיכרון שתפעל להנצחת האירועים ולמימוש מטרות החוק. לצד הרשות תפעל מועצה ציבורית שבה ישתתפו, בין היתר, נציגי משפחות החטופים, המשפחות השכולות, שורדי הטבח והרשויות המקומיות. עוד יוקמו אתר הנצחה וזיכרון לאומי ומוזיאון בנגב המערבי, ויישמר ויתועד מידע על האירועים כדי להנגישו לציבור.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1906 ,מיום 11:00:00",
      "LastUpdatedDate": "2026-09-09T17:38:36.683"
    },
