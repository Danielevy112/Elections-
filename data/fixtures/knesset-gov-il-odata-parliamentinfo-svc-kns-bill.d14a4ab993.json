      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1070,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-11-17T00:00:00",
      "MagazineNumber": 2584,
      "PageNumber": 17,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע, כהוראת שעה, הסדרים מיוחדים לתשלום קנסות הנגבים בידי המרכז לגביית קנסות אגרות והוצאות. חייבים בתשלום קנסות, שנוספה להם תוספת פיגור לפי האמור בסעיף 67 לחוק העונשין, והוצאות לנקיטת הליכי גבייה, כמשמעותן בסעיף 4 לחוק המרכז לגביית קנסות אגרות והוצאות.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
