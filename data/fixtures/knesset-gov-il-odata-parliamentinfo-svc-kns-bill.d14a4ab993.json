    {
      "BillID": 2006914,
      "KnessetNum": 20,
      "Name": "חוק אימוץ ילדים (תיקון מס' 11 - הוראת שעה), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3499,
      "CommitteeID": 2024,
      "StatusID": 118,
      "Number": 788,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-12T00:00:00",
      "MagazineNumber": 2731,
      "PageNumber": 743,
      "IsContinuationBill": null,
      "SummaryLaw": "בתיקון מס' 11 לחוק אימוץ ילדים, שהתקבל בכנסת ביום כ' בתמוז התשע\"ח (3 ביולי 2018), נקבע, כהוראת שעה למשך 5 שנים, כי עובד סוציאלי ראשי רשאי להודיע לקרוב משפחה של יהודי בן למשפחה יוצאת תימן, המזרח או הבלקן, שנטען כי אומץ בין השנים 1948 ל-1954, אם יש לגביו רישום בפנקס האימוצים. עוד נקבע כי לעובד הסוציאלי הראשי יש שיקול הדעת האם למסור מידע כאמור גם לגבי מי שנטען כי אומץ לאחר 1954. אם נמצא רישום, יודיע על כך העובד הסוציאלי הראשי ליועץ המשפטי לממשלה או לנציגו, שיפנה לבית המשפט בבקשה שיתיר את הפרסום או הגילוי של פרטי הרישום. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
