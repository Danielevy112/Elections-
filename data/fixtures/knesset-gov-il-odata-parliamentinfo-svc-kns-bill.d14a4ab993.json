    {
      "BillID": 2006478,
      "KnessetNum": 20,
      "Name": "חוק לימוד חובה (תיקון מס' 35), התשע\"ו-2016",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 933,
      "StatusID": 118,
      "Number": 1068,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-08-11T00:00:00",
      "MagazineNumber": 2573,
      "PageNumber": 1157,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מבהיר כי חובת הורה לרשום את ילדו ברשות החינוך המקומית הקבועה כיום מגיל 5, חלה גם על הורים לילדים בגילאי 3 ו-4. כמו כן, נקבע שהתנאים לתקצוב מוסדות פטור, לרבות בנושא היקף תכנית הבסיס הנלמדת במוסדות אלה, לא ייקבעו בחקיקה הראשית, אלא ייקבעו על ידי שר החינוך בתקנות, בהתייעצות עם שר האוצר, ובכלל זה לעניין שיעור ההשתתפות בתקציב והפעלת המוסדות הפטורים, אם יחליט השר כי יש לתקצב מוסדות כאמור.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
