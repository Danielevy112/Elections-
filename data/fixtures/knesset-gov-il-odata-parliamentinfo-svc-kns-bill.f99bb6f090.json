      "KnessetNum": 20,
      "Name": "חוק התגמולים לנפגעי פעולות איבה (תיקון מס' 35), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5436,
      "CommitteeID": 922,
      "StatusID": 118,
