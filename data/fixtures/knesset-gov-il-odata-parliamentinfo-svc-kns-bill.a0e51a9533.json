    {
      "BillID": 2211439,
      "KnessetNum": 25,
      "Name": "חוק מניעת מימון לייצוג משפטי בידי מדינת ישראל (חשוד, נאשם או מורשע בעבירת ביטחון - חרבות ברזל), התשפ\"ה–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4154,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1047,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-12-16T00:00:00",
      "MagazineNumber": 3332,
      "PageNumber": 120,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע ששכרם של סניגורים שימונו או שמונו החל מה-7 באוקטובר 2023 על ידי בית המשפט למי שחשוד, נאשם או הורשע בעבירת ביטחון הקשורה לאירועי ה-7 באוקטובר או במסגרת מלחמת חרבות ברזל, יקוזז מהכספים אותם מעבירה ממשלת ישראל לרשות הפלסטינית.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1047 ,מיום 10:00:00",
      "LastUpdatedDate": "2025-09-28T14:43:38.407"
    },
