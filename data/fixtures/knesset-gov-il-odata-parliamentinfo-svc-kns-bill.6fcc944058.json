    {
      "BillID": 2007196,
      "KnessetNum": 20,
      "Name": "חוק סדר הדין הפלילי (תיקון מס' 82), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3772,
