    {
      "BillID": 576434,
      "KnessetNum": 20,
      "Name": "חוק שירות המדינה (גמלאות) (תיקון מס' 59), התשע\"ו-2016 ",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2663,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 636,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-08-04T00:00:00",
      "MagazineNumber": 2571,
      "PageNumber": 1143,
      "IsContinuationBill": null,
      "SummaryLaw": "עד לתיקון חוק זה, אדם שפרש משירות המדינה בפנסיה תקציבית, ועבר לעבוד בשירות המדינה או בגוף ציבורי אחר הנחשב \"קופה ציבורית\", הופחתה קצבת הפרישה שלו באופן חלקי. \nתיקון זה מצמצם את תחולתה של ההוראה המפחיתה את הקצבה, באופן שרק מי שחזר לאותו מקום עבודה שממנו פרש, יהיה כפוף להפחתת הקצבה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
