    {
      "BillID": 2202055,
      "KnessetNum": 25,
      "Name": "חוק ההתיישנות (תיקון מס' 10), התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2568,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1200,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-07-20T00:00:00",
      "MagazineNumber": 3555,
      "PageNumber": 822,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון דוחה את מועד תחילת תקופת ההתיישנות החלה על הזכות להגיש תובענה אזרחית בשל התעללות שבוצעה בקטין, או תקיפה מינית שבוצעה בבגיר שטרם הגיע לגיל 21, על ידי בן או בת דודו או דודתו שמלאו להם 15 שנים במועד הפגיעה. למעשה, באמצעות הכללת בני דודים כאמור בהגדרת \"בן משפחה\" בסעיף 18א(ב) לחוק, התיקון מאפשר לנפגעים אלו להגיש תביעה אזרחית עד הגיעם לגיל 35, בדומה לזכות הקיימת למי שנפגע באופן האמור מאחיו, מדודו או מגיסו.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1200 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-07-28T15:18:41.93"
    },
