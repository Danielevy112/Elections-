    {
      "BillID": 1046296,
      "KnessetNum": 25,
      "Name": "חוק העונשין (תיקון מס' 154), התשפ\"ו-2026",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 4190,
      "StatusID": 118,
      "Number": 1911,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-06-09T00:00:00",
      "MagazineNumber": 3532,
      "PageNumber": 610,
      "IsContinuationBill": null,
      "SummaryLaw": "תיקון מספר 154 לחוק העונשין מוסיף לחוק סימן חדש של פגיעה בריבונות המדינה באמצעות הכנסה או הוצאה של דבר בגבולות, וקובע בו עבירה של פגיעה בריבונות המדינה בגבולות, האוסרת על הכנסת דבר לישראל או הוצאתו ממנה שלא כדין ושלא דרך תחנת גבול, שעונשה יעמוד על 9 שנות מאסר. בנוסף, החוק מתקן את חוק סדר הדין הפלילי (מעצרים), כך שיחולו על עבירה זו הוראות המעצר הייעודיות לעבירות ביטחון.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1911 ,מיום 09:00:00",
      "LastUpdatedDate": "2026-07-22T14:40:02.31"
    },
