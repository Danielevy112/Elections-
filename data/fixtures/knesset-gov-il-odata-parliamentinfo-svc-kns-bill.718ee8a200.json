    {
      "BillID": 2143400,
      "KnessetNum": 23,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 222), התשפ\"א-2021",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1861,
      "CommitteeID": 2147,
      "StatusID": 118,
      "Number": 870,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2021-01-06T00:00:00",
      "MagazineNumber": 2894,
      "PageNumber": 268,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי הורה או בן משפחה אחר שנקבע בתקנות, של מי שנפטר עקב הושטת עזרה להצלת חיי אדם אחר באירוע פתאומי,  יהיו זכאים  למענק, תגמול או הטבות שיקבעו בתקנות שאותן יש להתקין עד סוף שנת 2021, וזאת אף אם ההורה או בן המשפחה אינו זכאי לתגמול אחר למתנדבים. החוק מסמיך לקבוע בתקנות האמורות את התנאים לזכאות של הורה או בן משפחה כאמור. כמו כן החוק מאפשר לקבוע בתקנות כללים לזכאות למענק, תגמול או הטבות למתנדב שרק נפגע עקב הושטת עזרה כאמור. ניתן יהיה גם לקבוע בתקנות כי אותם מענקים, תגמולים או הטבות לא יהוו הכנסה לעניינים מסוימים או כי קבלתם לא תמנע קבלת גמלה אחרת. החוק יחול גם על מתנדבים שנפטרו או נפגעו החל מ1.1.2018, אך לא תהיה זכאות לתשלום מכוחם עבור התקופה שלפני יום התחילה. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 870 ,מיום 16:00:00",
      "LastUpdatedDate": "2022-07-26T13:16:01.99"
    },
