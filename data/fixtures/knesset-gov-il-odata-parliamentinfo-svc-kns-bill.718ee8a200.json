    {
      "BillID": 2144925,
      "KnessetNum": 23,
      "Name": "חוק ההוצאה לפועל (הקפאת הגבלת רישיונות נהיגה) (נגיף הקורונה החדש - הוראת שעה), התש\"ף-2020",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 2148,
      "StatusID": 118,
      "Number": 1358,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2020-08-27T00:00:00",
      "MagazineNumber": 2847,
      "PageNumber": 426,
      "IsContinuationBill": null,
      "SummaryLaw": "על רקע התפשטות מגפת הקורונה, צומצם היקף התחבורה הציבורית כך שאנשים ללא רישיון נהיגה התקשו לנסוע לעבודתם. לכן, החוק הקפיא לתקופה של חצי שנה את ההגבלות המוטלות על קבלה, החזקה וחידוש רישיון נהיגה של חייבים בהוצאה לפועל, כך שהחייבים יוכלו לנסוע לעבודתם בכלי הרכב שברשותם, להימנע מהדבקה בתחבורה הציבורית וכן לא להיפגע כלכלית, וכך גם להחזיר את חובם. חריג לכך הוא חוב שנפתח בשל בקשה לביצוע פסק דין למזונות, בגינו עדיין ניתן להטיל מגבלות על רישיון הנהיגה. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-08-08T16:17:08.503"
    },
