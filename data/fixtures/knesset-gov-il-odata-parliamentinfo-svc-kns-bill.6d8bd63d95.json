    {
      "BillID": 566817,
      "KnessetNum": 20,
      "Name": "חוק יום העלייה, התשע\"ו-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1738,
      "CommitteeID": 936,
      "StatusID": 118,
      "Number": 632,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-06-23T00:00:00",
      "MagazineNumber": 2557,
      "PageNumber": 934,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק יום העלייה, התשע\"ו-2016, התקבל בקריאה השנייה ובקריאה השלישית ביום ט\"ו בסיוון התשע\"ו (21 ביוני 2016). מטרת חוק יום העלייה, התשע\"ו–2016 לקבוע יום ציון שנתי שייקרא יום העלייה והוא יצוין מדי שנה ביום ז' בחשוון (להלן – יום העלייה). חל יום העלייה ביום שישי, יצוין היום ביום רביעי שלפניו, שכן זהו יום בו הכנסת מתכנסת.\nיום העלייה יצוין בדיון מיוחד במליאת הכנסת ובוועדת העלייה, הקליטה והתפוצות, באירוע מיוחד בישיבת הממשלה, בבית הנשיא ובפעולות חינוכיות במערכת החינוך, בצבא הגנה לישראל ובמשטרת ישראל. כמו כן, שר העלייה והקליטה רשאי לקבוע פעולות נוספות לציון יום העלייה, ובכלל זה פעולות שיתקיימו בשיתוף פעולה עם הסוכנות היהודית לארץ ישראל וההסתדרות הציונית העולמית.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
