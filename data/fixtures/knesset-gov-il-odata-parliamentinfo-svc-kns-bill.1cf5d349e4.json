    {
      "BillID": 568258,
      "KnessetNum": 20,
      "Name": "חוק צער בעלי חיים (הגנה על בעלי חיים) (תיקון מס' 10), התשע\"ו-2015",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 933,
      "StatusID": 118,
      "Number": 944,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2015-12-23T00:00:00",
      "MagazineNumber": 2516,
      "PageNumber": 296,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק צער בעלי חיים (הגנה על בעלי חיים) (תיקון מס' 10), התשע\"ו–2015, מתקן כמה נושאים הנוגעים לאופן יישום חוק צער בעלי חיים (הגנה על בעלי חיים), התשנ\"ד–1994 ואכיפתו לרבות: הטלת חובה על בעלים או מחזיק של בעל חיים למנוע התעללות בו ולספק לו את צורכי מחייתו, שיפור ועדכון ההוראות בעניין תפיסה של בעלי חיים והתנאים להחזרתם לבעליהם, תשלום הוצאות בשל תפיסת בעל חיים ובשל הטיפול בו, החמרת הענישה על עבירות שנעברו בנסיבות מחמירות, אחריות נושאי משרה בתאגיד שעיסוקו בבעלי חיים לפקח ולפעול למניעת עבירות מסויימות לפי החוק בידי התאגיד והוראה בעניין שקילת שיקולי הגנה על בעלי חיים בעת הפעלת סמכויות לפי דינים אחרים הנוגעים לגידול, החזקה וטיפול בבעלי חיים ובתוצרתם.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
