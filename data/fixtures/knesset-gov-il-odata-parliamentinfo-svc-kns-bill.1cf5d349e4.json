    {
      "BillID": 568469,
      "KnessetNum": 20,
      "Name": "חוק גיל פרישה (הורה שילדו נפטר) (הוראת שעה), התשע\"ח-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2203,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 654,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-12-14T00:00:00",
      "MagazineNumber": 2674,
      "PageNumber": 64,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק גיל פרישה (הורה שילדו נפטר) (הוראת שעה), התשע''ח–2017, קובע כי מעסיק לא יחייב עובד שהוא הורה שילדו נפטר ושהגיע לגיל 67 לפרוש מעבודתו בשל גילו, עד הגיעו לגיל 71. החוק חל רק על עובד שעבד במקום עבודתו 7 שנים לפחות, לפני הגיעו לגיל 67, ועל מעסיק המעסיק 25 עובדים לפחות, והוא אינו עובד בעבודות המנויות בחוק. \nנוסף על כך, נקבע כי המשרד לשוויון חברתי יערוך מחקר לבחינת יישומו והשפעתו של החוק. המשרד לשוויון חברתי יגיש את ממצאי המחקר והמלצותיו, לוועדת העבודה, הרווחה והבריאות של הכנסת, לא יאוחר משנה לפני תום תקופת החוק.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2023-06-19T17:26:24.803"
    },
