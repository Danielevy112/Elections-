    {
      "BillID": 2216827,
      "KnessetNum": 25,
      "Name": "חוק מגבלות על חזרתו של עבריין מין לסביבת נפגע העבירה (תיקון מס' 10), התשפ\"ה–2024 ",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4510,
      "CommitteeID": 4187,
      "StatusID": 118,
      "Number": 1045,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-11-24T00:00:00",
      "MagazineNumber": 3319,
      "PageNumber": 78,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק מגבלות על חזרתו של עבריין מין לסביבת נפגע העבירה, התשס\"ה-2004, נועד לאפשר לבית המשפט להטיל מגבלות על מי שהורשע בביצוע עבירת מין, במטרה למנוע מפגש בינו לבין נפגע העבירה בסביבת חייו השגרתית. החוק קבע כי ניתן להטיל את המגבלות רק אם בית המשפט השתכנע כי חזרת העבריין לסביבת הנפגע עלולה לגרום לו לנזק נפשי של ממש. כעת, במסגרת תיקון מס' 10 לחוק, התשפ\"ה-2024, נמחקו המילים \"של ממש\" כדי להקל על דרישה זו, כך שבית המשפט מוסמך להורות על הטלת המגבלות אם סבר שמפגש כזה עלול לגרום לנפגע נזק נפשי, וזאת בלא צורך להוכיח רף מחמיר של נזק נפשי של ממש.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1045 ,מיום 11:00:00",
      "LastUpdatedDate": "2026-04-16T11:11:11.023"
    },
