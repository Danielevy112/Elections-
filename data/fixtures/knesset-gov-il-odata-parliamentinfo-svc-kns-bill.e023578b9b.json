    {
      "BillID": 2218542,
      "KnessetNum": 25,
      "Name": "חוק הנוטריונים (תיקון מס' 11), התשפ\"ה-2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4753,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1088,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-06-12T00:00:00",
      "MagazineNumber": 3424,
      "PageNumber": 664,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מאפשר לנוטריון להתלות את רישיון הנוטריון שלו באופן יזום. החוק מבהיר מה הן התוצאות של התליית רישיון וחידוש רישיון לאחר התלייה – הן באופן יזום, הן אגב הגבלת חברות בלשכת עורכי הדין והן בעקבות השעיה או התליה משמעתיות. נקבע כי תחילת החוק תהיה מיום ה-1 בינואר 2026, ואולם, נוטריון שלא שימש כנוטריון בשנת 2025 ויבקש להתלות את רישיונו גם ביחס לשנה זו, יוכל להודיע על כך, באופן רטרואקטיבי החל ממועד התחילה ועד ליום 31 במרץ 2026.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1088 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-09-03T10:22:00.993"
    },
