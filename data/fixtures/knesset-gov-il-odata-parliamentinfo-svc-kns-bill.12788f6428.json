    {
      "BillID": 577435,
      "KnessetNum": 20,
      "Name": "חוק למניעת אלימות במשפחה (תיקון מס' 16), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2870,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 669,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-02-27T00:00:00",
      "MagazineNumber": 2606,
      "PageNumber": 431,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק למניעת אלימות במשפחה, התשנ\"א–1991 מסמיך את בית המשפט לתת צו הגנה המרחיק אדם מבני משפחתו או מתקיימת אחת העילות הקבועות בסעיף 3 לחוק שעניינן מצבים בהם אדם מהווה סכנה לבן משפחתו. סעיף 7 לחוק קובע כי ניתן לעצור מי שהפר צו הגנה כאמור אם הצו כולל איסור כניסה לדירת בן המשפחה. תיקון מס' 16 קובע שהחלטה שלא לעצור תוכל להתקבל רק על ידי הקצין הממונה על החקירות וכי תוטל עליו החובה לנמק את החלטתו.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
