    {
      "BillID": 2159065,
      "KnessetNum": 24,
      "Name": "חוק דמי מחלה (תיקון מס' 6), התשפ\"ב-2022",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1606,
      "CommitteeID": 2217,
      "StatusID": 118,
      "Number": 883,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-05-11T00:00:00",
      "MagazineNumber": 2970,
      "PageNumber": 840,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע כי עובד שחלה במחלה ממארת או במחלה שמצריכה טיפול בדיאליזה, ונעדר מעבודתו לשם טיפול תקופתי או בדיקה תקופתית, זכאי לקבל ממעסיקו תשלום דמי מחלה כבר מהיום הראשון להיעדרותו כאמור, ואף בעד חלק מיום שבו נעדר לשם כך, עד למכסת תקופת הזכאות המקסימלית שצבורה לו ובתנאי שמסר למעסיקו אישור רפואי בכתב כי הטיפול או הבדיקה נדרשים בשל אותה מחלה. זכאות זו תחול גם לאחר החלמתו ככל שהוא עדיין נדרש לטיפול או בדיקה. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 883 ,מיום 11:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
    },
    {
