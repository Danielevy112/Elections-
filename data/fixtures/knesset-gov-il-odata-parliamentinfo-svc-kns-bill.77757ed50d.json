    {
      "BillID": 2019181,
      "KnessetNum": 20,
      "Name": "חוק בנימין זאב הרצל (הנצחת זכרו ופועלו) (תיקון מס' 2), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4414,
      "CommitteeID": 933,
      "StatusID": 118,
      "Number": 731,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-08-07T00:00:00",
      "MagazineNumber": 2657,
      "PageNumber": 1117,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע במפורש כי השתתפות אוצר המדינה בהפעלתו של חוק בנימין זאב הרצל (הנצחת זכרו ופועלו), התשס\"ד–2004, תכלול גם תקציב להשתתפות במימון הפעילות השוטפת להנצחת זכרו, פועלו ומורשתו של בנימין זאב הרצל שמקיימת ההסתדרות הציונית העולמית בהר הרצל בירושלים, ובכלל זה פעולות הדרכה וחינוך, וכן פעולות נוספות בהר הרצל שהממשלה תחליט עליהן, שתקיים ההסתדרות הציונית העולמית, והכול בהתקשרות למימוש מטרות ציבוריות בהתאם להוראות סעיף 11א לחוק מעמדן של ההסתדרות הציונית העולמית ושל הסוכנות היהודית לארץ ישראל, התשי\"ג–1952.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
