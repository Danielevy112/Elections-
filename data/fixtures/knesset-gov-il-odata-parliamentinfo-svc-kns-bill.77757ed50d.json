    {
      "BillID": 2019809,
      "KnessetNum": 20,
      "Name": "חוק ההוצאה לפועל (תיקון מס' 57), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4426,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 760,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-03-11T00:00:00",
      "MagazineNumber": 2698,
      "PageNumber": 224,
      "IsContinuationBill": null,
      "SummaryLaw": "תיקון מס' 38 לחוק ההוצאה לפעול שהתקבל ביום י\"ט באדר התשע\"ח-06/03/2018, מאריך בשנה את תוקף הוראת השעה להליך קבלת הפטר. בנוסף, החוק מגמיש ומשנה את תנאי קבלת ההפטר,ובכלל זה מבטל את \"התקרה, לכניסה להליך שהייתה קבועה קודם לכן על 800 אלף שקלים חדשים, ומאפשר הפטר לאדם שקרן החוב המקורי שלו לא עולה על 400 אלף שקלים חדשים ובלבד שסך חובותיו אינו עולה על שני מיליון שקלים חדשים; עוד נקבע כי  ההפטר יינתן לאדם ששילם לפחות 18 תשלומים בשלוש השנים שקדמו למועד הגשת בקשת ההפטר ובאותו מועד שילם את יתרת התשלומים שנותרו לתשלום. \nבמקרים של אי-מתן הפטר, החוק אף מאפשר לרשם ליידע את הצדדים על אפשרותם להגיע להסדר מוסכם אם סבר רשם ההוצאה לפועל כי על אף שלא מתקיימים התנאים למתן צו הפטר ניתן, על סמך בקשת ההפטר, לגבש הסדר תשלומים לפירעון החוב בהסכמת החייב והנושים.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
