    {
      "BillID": 2019092,
      "KnessetNum": 20,
      "Name": "חוק הגבלות על משך השעיה של עובד גוף ציבורי עקב הליכים פליליים, התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4378,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 800,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2744,
      "PageNumber": 905,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי התקופה המרבית שניתן להשעות עובד של גוף ציבורי שנמצא תחת חקירה פלילית לא תעלה על 45 ימים, אלא אם כן בית הדין האזורי לעבודה אישר להאריך תקופה זו בהתאם לבקשת המעסיק. החוק קובע הסדרים לעניין תקופת הביניים שבין הגשת הבקשה לבית הדין לעבודה להחלטת בין הדין, ולעניין סמכות בית הדין לקבוע את שכרו של העובד בתקופה זו.\nהחוק אינו חל על כלל עובדי הציבור אלא רק על עובדים בחברה ממשלתית, חברת בת ממשלתית או תאגיד סטטוטורי.  \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
    {
      "BillID": 2019135,
