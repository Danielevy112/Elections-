    {
      "BillID": 2197787,
      "KnessetNum": 25,
      "Name": "חוק אומנה לילדים (תיקון מס' 7), התשפ\"ו-2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 992,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1074,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-01-26T00:00:00",
      "MagazineNumber": 3489,
      "PageNumber": 256,
      "IsContinuationBill": null,
      "SummaryLaw": "תיקון זה לחוק אומנה לילדים מחיל הוראות הקבועות בחוק לעניין הזכות לחינוך והזכות לשירותים ולהטבות, גם לגבי ילדים השוהים במסגרות השמה חוץ־ביתיות שאינן אומנה. במסגרת התיקון נקבע, בין היתר, כי זכותו של ילד שלא להיות מופלה במוסד חינוך, לרבות בכל הנוגע לרישומו למוסד חינוך או קבלתו למוסד חינוך, תחול גם לגבי ילד במסגרת השמה חוץ-ביתית שאינה אומנה. כמו כן, נקבע כי גם ילד המושם במסגרת השמה חוץ-ביתית שאינה אומנה, יהיה זכאי לכל הזכויות, השירותים וההטבות שזכאי להם ילד שהוא תושב הרשות המקומית שבה נמצאת מסגרת ההשמה החוץ-ביתית שבה הושם, לרבות בכל הנוגע לשיוכו למוסדות חינוכיים ברשות המקומית האמורה, בדומה לילד שהושם באומנה. נוסף על כך, תוקן סעיף 3(ב) לחוק, כך שגם ילד שנמצא במסגרת השמה חוץ-ביתית שאינה אומנה או בתהליך השמה במסגרת כאמור, זכאי לכל הזכויות שזכאי להן כל ילד בישראל",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1074 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-04-28T08:46:21.237"
    },
