    {
      "BillID": 2025015,
      "KnessetNum": 20,
      "Name": "חוק תאגידי מים וביוב (תיקון מס' 11), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3523,
      "CommitteeID": 2025,
      "StatusID": 118,
      "Number": 747,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-01-07T00:00:00",
      "MagazineNumber": 2680,
      "PageNumber": 94,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק התקבל בקריאה השנייה והשלישית ביום י\"ד בטבת התשע\"ח (1 בינואר 2018), והוא מתקן את חוק תאגידי מים וביוב, התשס\"א-2001. כנוסחו היום, מחייב את מועצת הרשות הממשלתית למים וביוב (להלן – הרשות), להורות לרשויות מקומיות שלא העבירו את הפעלת שירותי המים והביוב שלהן לידי תאגיד כאמור עד ל-31 ביולי 2013, לעשות זאת עד ל-30 בדצמבר 2017, ומסמיך את הרשות להטיל סנקציות על רשויות מקומיות כאמור. כמו כן, החוק קובע מועדים מחייבים, האמורים לחול בשנים 2018 ו-2019, לעניין חובתן של הרשויות המקומיות להעביר את שירותי המים והביוב שבתחומיהן לידי תאגידים אזוריים, שיספקו שירותי מים וביוב למספר רשויות מקומיות.\nהחוק שהתקבל דוחה בשנה וחצי את המועדים כאמור.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
