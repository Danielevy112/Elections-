    {
      "BillID": 562559,
      "KnessetNum": 20,
      "Name": "חוק השמות (תיקון מס' 8), התשע\"ט–2019",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 201,
      "CommitteeID": 932,
      "StatusID": 118,
