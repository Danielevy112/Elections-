    {
      "BillID": 2023141,
      "KnessetNum": 20,
      "Name": "חוק הרשויות המקומיות (מימון בחירות) (תיקון מס' 14), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4796,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 786,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-01T00:00:00",
      "MagazineNumber": 2728,
      "PageNumber": 718,
      "IsContinuationBill": null,
      "SummaryLaw": "תיקון זה קובע הארכה של חודשיים למועד להגשת הדוחות הכספיים שסיעות נדרשות להגיש לאחר הבחירות לרשויות המקומיות, ובהתאמה הארכה בחודשיים למועד שבו על מבקר המדינה למסור דין וחשבון בדבר חשבונות הסיעות ליושב ראש הכנסת. עוד הוארך בחודשיים תוקף כתב הערבות הבנקאית הנמסרת על ידי הסיעות כאמור. בנוסף נקבע כי סיעת-אם תוכל להגיש רשימת-בת מטעמה אף אם מתמודדת באותה רשות מקומית סיעת-בת מטעמה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
