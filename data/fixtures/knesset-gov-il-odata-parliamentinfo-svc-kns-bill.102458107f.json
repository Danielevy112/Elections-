  "value": [
    {
      "BillID": 573610,
      "KnessetNum": 20,
      "Name": "חוק זכות השגה על החלטה בעניין רישוי מקצועות בתחום הרפואה והבריאות (תיקוני חקיקה), התשע\"ז–2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2589,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 696,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-04-03T00:00:00",
      "MagazineNumber": 2625,
      "PageNumber": 576,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי שר הבריאות ימנה ועדות השגה לעניין רישוי רופאים, רופאי שיניים, רוקחים והעוסקים במקצועות הבריאות ויקבע את סדרי עבודתן.\nמבקש רישיון לעסוק באחד ממקצועות הבריאות האמורים רשאי להגיש השגה מנומקת בכתב על ההחלטה בבקשתו בתוך שלושים ימים היום שבו נמסרה לו החלטת המנהל בבקשתו. היועץ המשפטי למשרד הבריאות או נציגו רשאים להאריך מועד זה בשלושים ימים נוספים מטעמים מיוחדים שיירשמו.\nבוועדות ההשגה יהיו שלושה חברים:\n1.\tמנכ\"ל משרד הבריאות או משנהו או עובד משרד הבריאות שהוא רופא או בעל מקצוע בתחום שבו עוסקת הוועדה (רופא שיניים, רוקח או עוסק במקצועות הבריאות) ודרגתו היא לכל הפחות כדרגת מי שקיבל את ההחלטה נשוא ההשגה והוא אינו עובד באגף שבו עובד מי שקיבל את ההחלטה כאמור;\n2.\tהיועץ המשפטי למשרד הבריאות או נציגו;\n3.\tנציג ציבור שהוא רופא, רופא שיניים, רוקח או עוסק במקצועות הבריאות לפי התחום שבו עוסקת הוועדה ובעל ניסיון של 15 שנים לפחות בתחום זה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
