    {
      "BillID": 2208737,
      "KnessetNum": 25,
      "Name": "חוק תקשורת דיגיטלית עם גופים ציבוריים (תיקון מס' 5), התשפ\"ו-2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3886,
      "CommitteeID": 4195,
      "StatusID": 118,
      "Number": 1156,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-07-20T00:00:00",
      "MagazineNumber": 3560,
      "PageNumber": 832,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי הביטוח הלאומי, רשות המיסים בישראל, ורשות האוכלוסין וההגירה בעת  מתן שירות דיגיטלי נפוץ לציבור, יחויבו במשלוח מסר קולי מוקלט לטלפונים שאינם יכולים לקבל מסרונים. כמו כן יחויבו גופים אלה לאסוף מידע בדבר שירותים ‏דיגיטלים שהם נותנים לציבור בשפות ערבית רוסית ואמהרית. מידע זה ייכלל בדיווח המועבר לכנסת על ידי מערך הדיגיטל הלאומי לפי החוק. החוק יוחל בהדרגה בשלוש השנים מיום תחילתו",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1156 ,מיום 12:00:00",
      "LastUpdatedDate": "2026-07-26T10:20:03.58"
    },
