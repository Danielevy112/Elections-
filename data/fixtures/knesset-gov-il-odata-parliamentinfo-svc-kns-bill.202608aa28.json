    {
      "BillID": 563604,
      "KnessetNum": 20,
      "Name": "חוק שירותי הדת היהודיים (תיקון מס' 22), התשע\"ז-2016",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1339,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 658,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2016-12-11T00:00:00",
      "MagazineNumber": 2586,
      "PageNumber": 29,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון אוסר על מי שעוסק בהעברת נפטרים למכור ולהציע למכירה מוצר או שירות הקשורים בפטירה, בעת העברת הנפטר או בעת התקשרות בהסכם להעברת נפטר, אלא אם תנאי הרישיון מתירים לו לעשות כן. לעניין זה, מוצר או שירות כוללים, בין היתר, לוויה וסידוריה, קבורה והקמת מצבה.\nבנוסף, התיקון מחייב את מי שעוסק בהעברת נפטרים ואינו בעל רישיון לעסוק בקבורה, להודיע לאדם שעמו הוא מתקשר לשם העברת נפטר כי הוא זכאי לקבל את שירות ההעברה ללא תשלום, מגוף שהוא בעל רישיון לעסוק בקבורה הפועל במקום המגורים של הנפטר או במקום פטירתו. נטל ההוכחה כי הודעה כזו אכן נמסרה מוטל על מי שעוסק בהעברת הנפטר.\nדינו של מי שמפר את ההוראות האמורות הוא קנס כאמור בסעיף 61(א)(1) לחוק העונשין.\nכמו כן, התיקון אוסר על התקשרות עם קרוב של נפטר לשם העברתו תוך הפעלת לחץ על הקרוב, הטרדתו או ניצול מצוקתו. אם הופר איסור זה, בית המשפט יהיה רשאי לפסוק פיצויים שאינם תלויים בנזק בסכום של 5,000 שקלים חדשים. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
