    {
      "BillID": 2193012,
      "KnessetNum": 24,
      "Name": "חוק המכר (דירות) (תיקון מס' 9), התשפ\"ב-2022",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 2216,
      "StatusID": 118,
      "Number": 1548,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-06-30T00:00:00",
      "MagazineNumber": 2983,
      "PageNumber": 914,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע תיקונים שונים לעניין רכישת דירה חדשה – תיקון בנושא פיצוי בגין איחור במסירת דירה לרוכשים, ותיקון בנושא הצמדת מחיר הדירה למדד תשומות הבניה. לעניין פיצוי בגין איחור במסירה החוק קובע כי במידה והמוכר לא העביר את הדירה לרשות הקונה לאחר חודש מתום מועד המסירה הקבוע בחוזה המכר, ישלם המוכר לקונה פיצויים ללא הוכחת נזק בשל איחור במסירה – פיצויים שהוסכם עליהם בחוזה או פיצויים בשיעור הבא: בחודשים השני עד הרביעי - סכום השווה לדמי שכירות של דירה דומה בגודלה ובמיקומה; בחודשים החמישי עד העשירי – הסכום האמור כשהוא מוכפל ב-1.25; בחודש ה-11 ואילך – הסכום האמור כשהוא מוכפל ב-1.5. החריג לכך הוא כי המוכר לא יצטרך לשלם פיצויים לקונה אם האיחור במסירת הדירה נגרם כתוצאה ממחדל של הקונה או במקרה שהאיחור הוא תוצאה של פטור בשל אונס או סיכול החוזה כמשמעותם בחוק החוזים (תרופות בשל הפרת חוזה), התשל\"א–1970. לעניין הצמדת מחיר הדירה למדד תשומות הבניה,  החוק קובע כי תשלום בעד רכישת דירה לא יוצמד למדד כלשהו ולא תתווסף עליו ריבית (למעט בשל איחור בתשלום). עם זאת, הצדדים לחוזה המכר רשאים להסכים ביניהם כי עד מחצית מכל תשלום יוצמד למדד תשומות הבנייה, ובלבד ש-20% מהמחיר החוזי המשולמים לא יוצמדו למדד כלשהו, וכי ההצמדה תחול עד למועד שלא יאוחר ממועד המסירה כפי שנקבע בחוזה. תחילתו של החוק שבעה ימים מיום פרסומו, והוא לא יחול על דירה שחוזה המכר לגביה נכרת לפני תחילתו.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1548 ,מיום 16:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
