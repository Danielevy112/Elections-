    {
      "BillID": 2231609,
      "KnessetNum": 25,
      "Name": "חוק חובת המכרזים (תיקון מס' 24 – הוראת שעה) (תיקון מס' 2), התשפ\"ה–2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5866,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1147,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-07-15T00:00:00",
      "MagazineNumber": 3443,
      "PageNumber": 748,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מאריך בשלוש שנים נוספות, עד ל-15 ביולי 2028, את הוראת השעה המסמיכה את הממשלה לקבוע בתקנות, באישור ועדת החוקה של הכנסת, הוראות לעניין העדפה של תוצרת הארץ ברכישת טקסטיל בעבור מערכת הביטחון והמשרד לביטחון הפנים. מכוח הוראה שקיימת בהוראת השעה המקורית, שר האוצר יהיה מוסמך להאריך תקופה זו, בצו, באישור ועדת החוקה של הכנסת, לפרק זמן של שנתיים נוספות.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1147 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-09-03T13:23:03.007"
    },
