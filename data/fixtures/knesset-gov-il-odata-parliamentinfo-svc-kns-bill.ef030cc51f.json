    {
      "BillID": 2197571,
      "KnessetNum": 25,
      "Name": "חוק לתיקון פקודת התעבורה (מס' 136), התשפ\"ה–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 234,
      "CommitteeID": 4193,
      "StatusID": 118,
      "Number": 989,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-12-02T00:00:00",
      "MagazineNumber": 3326,
      "PageNumber": 104,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה קובע שמפעיל חניון יגבה דמי חנייה בחניון לפי זמן החנייה המחושב לפי מספר הדקות שחנה הרכב החל מהשעה הראשונה. בכך, החוק משנה את ההסדר שהיה קבוע בפקודה, לפיו בשעת החנייה הראשונה נגבו דמי חנייה על כל השעה, ללא תלות במשך הזמן שהרכב חנה בחניון, והחל משעת החנייה השנייה דמי החנייה נגבו לפי זמן החנייה, המחושב לפי כמות פרקי זמן של 15 דקות שהרכב חנה בחניון.\nבנוסף, החוק מסמיך את שר הפנים, בהסכמת שר התחבורה והבטיחות בדרכים ובאישור ועדת הכלכלה של הכנסת, לקבוע כי ההוראה האמורה לא תחול לגבי חניונים שגובים דמי חנייה הנמוכים מסכום שיקבע בתקנות.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 989 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-04-09T15:26:45.047"
    },
