    {
      "BillID": 2023546,
      "KnessetNum": 20,
      "Name": "חוק הבטחת הכנסה (תיקון מס' 50), התשע\"ח-2017",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 1168,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-12-28T00:00:00",
      "MagazineNumber": 2675,
      "PageNumber": 73,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק הבטחת הכנסה, התשמ\"א-1980, קבע כי מקבל גמלת הבטחת הכנסה בעד אחד מהחודשים אוקטובר, נובמבר או דצמבר, שהגיע לגיל פרישה, זכאי למענק חימום שנתי חד־פעמי, בשיעור של 6.4% מהסכום הבסיסי כהגדרתו בחוק האמור, בתנאי שהוא מתגורר באזור קר שקבע שר העבודה הרווחה והשירותים החברתיים בצו. חוק הבטחת הכנסה (תיקון מס' 50), התשע\"ח-2017 ביטל את התנאי לפיו המענק ישולם רק לאלו הגרים באזורים קרים.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2020-01-26T12:26:08.553"
    },
