    {
      "BillID": 2198087,
      "KnessetNum": 25,
      "Name": "חוק הרשויות המקומיות (בחירות) (תיקון מס' 58), התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 1011,
      "CommitteeID": 4198,
      "StatusID": 118,
      "Number": 1118,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-01-18T00:00:00",
      "MagazineNumber": 3485,
      "PageNumber": 226,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי ניתן למנוע את השתתפותה של רשימת מועמדים בבחירות לרשויות המקומיות אם יש במטרותיה או במעשיה תמיכה במאבק מזוין של מדינת אויב או של ארגון טרור נגד מדינת ישראל. כמו כן, החוק מאפשר למנוע את השתתפותם של מועמדים מסוימים מתוך רשימת המועמדים. בנוסף, החוק קובע כי הן לעניין רשימה מנועה והן לעניין מועמד מנוע, רשאית ועדת הבחירות של הרשות המקומית, או היועץ המשפטי לממשלה או אחד ממשניו, להגיש עתירה ליושב ראש ועדת הבחירות האזורית וכי לעניין רשימה מנועה, יידרש רוב מחבריי ועדת הבחירות, ולעניין מועמד מנוע, שני שליש. לבסוף, החוק קובע כי על החלטה כאמור ניתן יהיה לערור לפני יושב ראש ועדת הבחירות המרכזית לכנסת, ולאחר מכן לבית המשפט העליון בשאלה משפטית בלבד.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1118 ,מיום 09:00:00",
      "LastUpdatedDate": "2026-06-14T10:49:59.687"
    },
