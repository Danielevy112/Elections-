    {
      "BillID": 2006776,
      "KnessetNum": 20,
      "Name": "חוק השכירות והשאילה (תיקון), התשע\"ז-2017",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1073,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-07-19T00:00:00",
      "MagazineNumber": 2649,
      "PageNumber": 1028,
      "IsContinuationBill": null,
      "SummaryLaw": "התיקון לחוק קובע הסדר ייחודי הנוגע לחוזה שכירות למגורים, ובו הוראות לעניין חובת מסירת דירה ראויה למגורים, עריכת החוזה ותוכנו, אפשרות קביעת חוזה מצוי שישמש מקור להשלמה, חובות הצדדים לעניין תיקון פגמים בדירה, תשלומי השוכר, הארכת תקופת השכירות, ביטול החוזה ועוד. בנוסף, מוצעים תיקונים בנוגע לדיני השכירות הכלליים, כגון הוראות לגבי אי התאמה או פגם במושכר ואחריות הצדדים בנוגע לכך, ביצוע שינויים במושכר, וזכויות השוכר כלפי צד ג'.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-04-28T19:40:50.377"
    },
