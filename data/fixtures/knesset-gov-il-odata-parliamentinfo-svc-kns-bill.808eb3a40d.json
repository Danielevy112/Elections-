    {
      "BillID": 2141248,
      "KnessetNum": 23,
      "Name": "חוק קליטת חיילים משוחררים (נגיף הקורונה החדש – הוראת שעה – תיקון מס' 20) (מימוש חלק מהפיקדון לכל מטרה), התש\"ף–2020",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 2153,
      "StatusID": 118,
      "Number": 1326,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2020-07-07T00:00:00",
      "MagazineNumber": 2824,
      "PageNumber": 220,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק זה מתקן בהוראת שעה את חוק קליטת חיילים משוחררים, התשנ\"ד-1994 וקובע כי חייל משוחרר זכאי, במשך שלושה חודשים שתחילתם ביום 20/07/2020 ועד ליום 20/10/2020, לפנות לקרן לחיילים משוחררים בבקשה לקבל מיתרת הפיקדון שנזקפה לזכותו, למימוש לכל מטרה, סכום כמפורט להלן: חייל משוחרר שביום התחילה טרם חלפו 18 חודשים ממועד שחרורו יהיה זכאי למשוך סכום של 5,300 שקלים חדשים וחייל משוחרר שחלפו 18 חודשים ממועד שחרורו יהיה זכאי למשוך סכום של 3,500 שקלים חדשים. שר הביטחון, בהסכמת שר האוצר, ובאישור ועדת העלייה, הקליטה והתפוצות, רשאי להאריך את הוראת השעה בתקופה אחת נוספת של שלושה חודשים.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-04-03T23:23:01.167"
    },
