    {
      "BillID": 2194705,
      "KnessetNum": 24,
      "Name": "חוק משפחות חיילים שנספו במערכה (תגמולים ושיקום) (תיקון מס' 40), התשפ\"ב-2022 ",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 2217,
      "StatusID": 118,
      "Number": 1569,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-07-05T00:00:00",
      "MagazineNumber": 2992,
      "PageNumber": 994,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע כי אח של אדם שנספה בעת שירותו בכוחות הביטחון או שנפטר כתוצאה מפגיעת איבה יוכר כחלק מהמשפחה השכולה של הנספה או של האדם שנפטר, לפי העניין. הורחב סל ההטבות לאחי הנספה ונקבע כי מימון שכר לימוד במוסד אקדמי יינתן ישירות לאחי הנספה, ולא באמצעות ההורה השכול, והזכאות תורחב כך שהמימון יינתן בעבור כל שנת לימודים שהחלה בטרם מלאו לאח 40 שנים. בנוסף נקבע כי גם אחי הנספה זכאי לסיוע במימון התערבויות לרווחה רגשית במקום לסיוע במימון טיפול נפשי. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1569 ,מיום 16:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
    },
