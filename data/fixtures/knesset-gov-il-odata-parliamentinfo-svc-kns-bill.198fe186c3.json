    {
      "BillID": 2218723,
      "KnessetNum": 25,
      "Name": "חוק הנכים (תגמולים ושיקום) (תיקון מס' 35), התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4709,
      "CommitteeID": 4194,
      "StatusID": 118,
      "Number": 1210,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-07-19T00:00:00",
      "MagazineNumber": 3549,
      "PageNumber": 798,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מוסיף לחוק הנכים (תגמולים ושיקום) את ההגדרות \"הלם קרב\" ו\"נפגע הלם קרב\" וקובע כי לנפגעי הלם קרב ינתן טיפול רפואי מותאם. כמו כן החוק קובע כי שר הביטחון יקים ועדה מתן סיוע לפנים משורת הדין לנכים ולבני משפחה של נכים עם מאפיינים מיוחדים, כלומר נכים שיש להם דרגת נכות של 35% לפחות בשל פגימת ראש או פגימה נפשית ובכלל זה הפרעה בתר-חבלתית, דרגת נכות 100% או דרגת נכות מיוחדת, אם בן המשפחה נקלע למצוקה קשה בקשר לנכותו של הנכה. ההוראות לעניין הוועדה למתן סיוע לפנים משורת הדין הוחלו גם על נפגעי פעולות איבה. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1210 ,מיום 12:00:00",
      "LastUpdatedDate": "2026-09-22T09:05:48.14"
    },
