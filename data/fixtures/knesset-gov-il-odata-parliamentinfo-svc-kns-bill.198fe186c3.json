  "value": [
    {
      "BillID": 2196772,
      "KnessetNum": 25,
      "Name": "חוק הביטוח הלאומי (תיקון מס' 262  – הוראת שעה), התשפ\"ו–2026",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 592,
      "CommitteeID": 4196,
      "StatusID": 118,
      "Number": 1023,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2026-03-01T18:24:00",
      "MagazineNumber": 3501,
      "PageNumber": 312,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע בהוראת שעה שתחול מיום י\"ב בטבת התשפ\"ו (1 בינואר 2026) ועד יום ל' בכסלו התשצ\"ו (31 בדצמבר 2035), כי תושב ישראל שהוא עולה חדש ממדינה המנויה בלוח ט\"ז לחוק יהיה פטור מתשלום דמי ביטוח לאומי בעד הכנסה מעבודה או ממשלח יד שהוא משלם בעדה דמי ביטוח סוציאלי במדינה שממנה עלה, וזאת למשך חמש שנים מהעלייה. בלוח ט\"ז נקבע כי הפטור האמור חל על העולים מארה\"ב ושר העבודה, בהסכמת שר האוצר ובהתייעצות עם שר העלייה והקליטה ובאישור ועדת העבודה והרווחה, מוסמך לקבוע כי ההסדר יחול על עולים ממדינות נוספות לאחר ששוכנע כי הדבר יסייע לעידוד עליה ולאחר שהביא בחשבון את גובה דמי הביטוח הסוציאלי באותה מדינה ואת קיומה של אמנה לביטחון סוציאלי עימה. כמו כן, השר מוסמך כאמור להאריך בצו את הוראת השעה בשתי תקופות נוספות שכל אחת מהן לא תעלה על חמש שנים.\nהפטור האמור לא ישפיע על הזכאות לגמלה או לתוספת לגמלה המותנית בתשלום דמי ביטוח לאומי ולא יחול לגבי החיוב בדמי ביטוח בריאות. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 1023 ,מיום 16:00:00",
      "LastUpdatedDate": "2026-05-05T10:26:45.247"
    },
