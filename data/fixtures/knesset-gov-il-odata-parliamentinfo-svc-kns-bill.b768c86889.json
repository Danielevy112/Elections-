    {
      "BillID": 2160742,
      "KnessetNum": 24,
      "Name": "חוק שמירת הניקיון (תיקון מס' 24), התשפ\"ב-2022",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 2000,
      "CommitteeID": 2225,
      "StatusID": 118,
      "Number": 876,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2022-06-22T00:00:00",
      "MagazineNumber": 2979,
      "PageNumber": 868,
      "IsContinuationBill": null,
      "SummaryLaw": "על מנת להקל במצוקת החניה, ולמנוע מצב של ריבוי רכבים נטושים שמושארים במרחב הציבורי ומהווים מפגע, נקבעו בחוק שמירת הניקיון, התשמ\"ד-1984, כמה הסדרים שייעלו את הטיפול בתופעה זו. \nבין ההסדרים שנקבעו בתיקון זה: קביעת מבחנים ברורים יותר לזיהוי רכב כרכב שנחזה להיות רכב נטוש; קיצור פרק הזמן עד למתן הודעת התראה על גרירת רכב כאמור שהושאר ברשות הרבים מ-60 יום ל-30 יום מיום מתן הודעת האזהרה על זיהוי הרכב כנטוש וכן קיצור פרק הזמן שבו על הרשות לשמור את הרכב לאחר גרירתו מ-60 יום ל-45 יום. \nכמו כן נקבע כי הודעות ההתראה על זיהוי רכב כנטוש ועל גרירתו ישלחו לבעל הרכב גם בדרך מקוונת במידה והדבר אפשרי, בנוסף להדבקת ההודעה על הרכב ושליחתה בדואר רשום כפי שהיה מקובל עד לתיקון זה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 876 ,מיום 13:00:00",
      "LastUpdatedDate": "2022-11-10T10:51:59.303"
    },
