    {
      "BillID": 2020419,
      "KnessetNum": 20,
      "Name": "חוק שירות ביטחון (תיקון מס' 23), התשע\"ט-2019",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4579,
      "CommitteeID": 929,
      "StatusID": 118,
      "Number": 766,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2019-01-07T00:00:00",
      "MagazineNumber": 2775,
      "PageNumber": 158,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי חייל שנמצא בלתי כשר ארעית לשירות יוכל, בתקופה שלא תעלה על 180 ימים, להמשיך בשירותו הסדיר אלא אם ביקש מיוזמתו לקבל את הטיפול במערכת הבריאות האזרחית. \nעוד נקבע כי בתום תקופה זו או במהלכה, אם יקבע הצבא כי החייל אינו כשיר לשירות יוכל החייל להתנדב לצורך השלמת התקופה  ולשם המשך הטיפול הרפואי בו, בהתאם להסדר ההתנדבות הקיים היום בסעיף 17א לחוק שירות ביטחון.  כמו כן, החוק קובע כי במקרה של חייל שחזר לכשירות יידרש צבא הגנה לישראל לפעול לשילובו של החייל בתפקיד שבו שירת טרם אבחון מחלתו או פציעתו, והכל בכפוף לצורכי כוח האדם בצבא ובהתאם למצבו הרפואי.\nתחילת החוק תהיה שנה מיום פרסומו וזאת על מנת לאפשר לצבא תקופת היערכות והתארגנות ליישום החוק.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
