    {
      "BillID": 2020000,
      "KnessetNum": 20,
      "Name": "חוק למניעת מפגעים סביבתיים (תביעות אזרחיות) (תיקון מס' 10), התשע\"ט-2019",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4594,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 815,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2019-01-08T00:00:00",
      "MagazineNumber": 2776,
      "PageNumber": 179,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק למניעת מפגעים סביבתיים (תביעות אזרחיות), התשנ\"ב-1992 קובע כי לבקשת מי שנפגע או שעלול להפגע ממפגע סביבתי מסוים, יהיה ניתן לפנות לבית המשפט שמחזיק בסמכות להוציא צו לגורם הפוגע שתכליתו להמנע או להפסיק לבצע את הפעולה הפוגעת, לתקן את הפגיעה שנגרמה, להחזיר את המצב לקדמותו, ולעשות כל מה שדרוש על מנת להמנע מפגיעה שכזו. הצעת חוק למניעת מפגעים סביבתיים (תביעות אזרחיות) (תיקון מס' 10), התשע\"ט-2019, שהתקבלה בכנסת בכ\"ד בטבת התשע\"ט (1 בינואר 2019), מרחיבה את המקרים בהם ניתן יהיה לקבוע שהייתה פגיעה סביבתית. נקבע כי גם פגיעות באזור מוגן ייחשבו כמפגע סביבתי על ידי ביצוע פעולת בנייה או פעולה אחרת שיש בה לסכל את ייעודו של שטח שנקבע בתכנית שאושרה כגן לאומי. בנוסף נקבע כי פגיעה בערך טבע מוגן תוגדר גם כמפגע סביבתי כאשר אדם פגע בערך זה ללא היתר לאחר שהשר להגנת הסביבה הכריז על ערך מסוים כערך טבע מוגן שיש לשמור ולהגן עליו ושיש ערך בשמירתו. בין היתר נקבע כי גם פגיעה באילן מוגן או בעץ בוגר או ביערות תחשב כמפגע סביבתי על ידי כריתתם בניגוד להוראות פקודת היערות, והבערת פסולת באש פתוחה או לא מבוקרת, לרבות בתוך כלי קיבול או מיכל שאינו אטום, תוגדר כזיהום ועל כן כמפגע סביבתי. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
