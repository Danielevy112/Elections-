    {
      "BillID": 2074555,
      "KnessetNum": 20,
      "Name": "חוק איסור צריכת זנות (הוראת שעה ותיקון חקיקה), התשע\"ט-2019",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1258,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2019-01-10T00:00:00",
      "MagazineNumber": 2779,
      "PageNumber": 235,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק איסור צריכת זנות (הוראת שעה ותיקון חקיקה), התשע\"ט-2019 קובע לראשונה איסור על צריכת מעשה זנות, לרבות על ניסיון לצרוך מעשה כזה. אכיפת האיסור תיעשה ככלל בדרך מינהלית, של קנס מינהלי בסכום של עד 2,000 ₪ לעבירה ראשונה. זאת, בנוסף לאפשרות להגיש כתב אישום בנסיבות שיקבעו בנהלים אז ניתן יהיה להטיל קנס מרבי של 75,000 ₪.  בנוסף, בחוק סעיפי מטרה ודיווח לכנסת וכן חובת מחקר. \nהחוק נקבע כהוראת שעה לחמש שנים והוא עתיד להיכנס לתוקף שנה וחצי מיום פרסומו. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-07-28T17:20:08.95"
    },
