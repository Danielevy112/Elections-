    {
      "BillID": 562425,
      "KnessetNum": 20,
      "Name": "חוק ההתיישנות (תיקון מס' 5), התשע\"ה–2015",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 460,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 600,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2015-08-03T00:00:00",
      "MagazineNumber": 2497,
      "PageNumber": 217,
      "IsContinuationBill": null,
      "SummaryLaw": "כיום קובע סעיף 7 לחוק ההתיישנות, התשי\"ח–1958, כי \"היתה עילת התובענה תרמית או אונאה מצד הנתבע, תתחיל תקופת ההתיישנות ביום שבו נודעה לתובע התרמית או האונאה.\" בעילת השעיה זו לא נכללות נסיבות שבהן התובע נמנע מהגשת תביעתו בשל התנהגות פסולה אחרת של הנתבע.\nהוחלט להוסיף לרשימת הנסיבות המצדיקות השעיה של מרוץ תקופת ההתיישנות על פי החוק, עילות השעיה נוספות: מקרים שבהם הנתבע או מי מטעמו גרם לעיכוב כאמור על ידי הטעיית התובע, הפעלת כוח נגדו, איום עליו או ניצול מצוקתו. הגדרת \"הטעיה\" נועדה להבהיר כי אם הנתבע גרם ביודעין לכך שהתובע לא יהיה מודע לעובדות המהוות את עילת התובענה יושעה מרוץ תקופת ההתיישנות, גם אם הדבר נעשה בדרך של אי־גילוי. \n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
