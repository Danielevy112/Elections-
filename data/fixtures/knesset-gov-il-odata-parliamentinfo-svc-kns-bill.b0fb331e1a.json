    {
      "BillID": 562446,
      "KnessetNum": 20,
      "Name": "חוק הבטחת הכנסה (תיקון מס' 49), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 62,
