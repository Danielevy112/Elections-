    {
      "BillID": 2196942,
      "KnessetNum": 25,
      "Name": "חוק לביטול אזרחותו או תושבותו של פעיל טרור שמקבל תגמול עבור ביצוע מעשה הטרור (תיקוני חקיקה), התשפ\"ג-2023",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 373,
      "CommitteeID": 4213,
      "StatusID": 118,
      "Number": 946,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2023-02-19T00:00:00",
      "MagazineNumber": 3024,
      "PageNumber": 54,
      "IsContinuationBill": null,
      "SummaryLaw": "נקבע כי אזרח או תושב ישראלי שהורשע בביצוע עבירה שהיא הפרת אמונים למדינת ישראל, נגזר עליו מאסר בפועל בגינה, והוכח כי הרשות הפלסטינית מתגמלת אותו על כך, ניתן יהיה לבטל את אזרחותו או את רישיונו לישיבת הקבע לפי העניין, ולהרחיקו לשטחי הרשות הפלסטינית או לרצועת עזה. רישיון ישיבת קבע יבוטל על ידי שר הפנים, לאחר היוועצות בוועדה מייעצת ובהסכמת שר המשפטים, וביטול אזרחות יהיה על ידי בית המשפט, לבקשת שר הפנים, לאחר היוועצות בוועדה מייעצת ובהסכמת שר המשפטים. החוק תוחם את לוח הזמנים להליך ביטול התושבות או האזרחות וקובע חזקה לפיה אדם שקיבל כספים כאמור,  זכאי למעמד ברשות הפלסטינית. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 946 ,מיום 16:00:00",
      "LastUpdatedDate": "2023-02-22T10:04:33.347"
    },
