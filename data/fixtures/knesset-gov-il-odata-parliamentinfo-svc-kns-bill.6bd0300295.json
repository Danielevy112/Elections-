    {
      "BillID": 562984,
      "KnessetNum": 20,
      "Name": "חוק חובת המכרזים (תיקון מס' 24 - הוראת שעה), התשע\"ה-2015",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 488,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 598,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2015-07-15T00:00:00",
      "MagazineNumber": 2495,
      "PageNumber": 197,
      "IsContinuationBill": null,
      "SummaryLaw": "הוחלט לחוקק מחדש, לתקופה של חמש שנים נוספות, את הוראת השעה שקבעה כי במכרזים לרכישת טקסטיל עבור מערכת הביטחון והמשרד לביטחון הפנים, תינתן העדפה לרכישה של טקסטיל מתוצרת הארץ. כן נקבע שבתוך 30 ימים מיום שהוראת השעה תיחקק מחדש, תביא הממשלה תקנות חדשות מכוחה לאישורה של ועדת החוקה, חוק ומשפט, ועד להתקנת התקנות החדשות יראו את התקנות שהותקנו מכוח הוראת השעה הקודמת ופקעו כאילו הן עומדות בתוקף. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2025-07-16T10:45:47.037"
    },
