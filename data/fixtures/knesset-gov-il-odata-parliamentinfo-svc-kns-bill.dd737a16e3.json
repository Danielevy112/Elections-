    {
      "BillID": 2003348,
      "KnessetNum": 20,
      "Name": "חוק שירותי רווחה (מענק הסתגלות לנשים ששהו במקלט לנשים מוכות) (תיקון מס' 2), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3118,
      "CommitteeID": 928,
      "StatusID": 118,
      "Number": 708,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-07-03T00:00:00",
      "MagazineNumber": 2647,
      "PageNumber": 1009,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק שירותי רווחה (מענק הסתגלות לנשים ששהו במקלט לנשים מוכות) התשע''ב–2012, תוקן כך שאישה ששהתה במקלט לנשים מוכות 60 ימים לפחות, או שהתה בדירת מעבר שישה חודשים לפחות, תהיה זכאית, בסמוך לאחר יציאתה מהמקלט, לסל שירותים שיותאם לה על ידי עובד סוציאלי ויכלול, בין היתר, ליווי על ידי עובד סוציאלי ומלווה משפחתי וסיוע במיצוי זכויות, וכן ליווי תעסוקתי, זאת במטרה לסייע לה במעבר לניהול חיים עצמאיים.\nעוד נקבע כי אישה ששהתה במקלט לנשים מוכות תהיה זכאית שתבחן התאמתה לטיפול ולשיקום במסגרת חוץ ביתית, ובכלל זה בדירת מעבר. כמו כן, נוספה הגנה על כספי מענק ההסתגלות ששולמו לאישה, כך שיהיו מוגנים מפני העברה, ערבות, שיעבוד או עיקול.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
