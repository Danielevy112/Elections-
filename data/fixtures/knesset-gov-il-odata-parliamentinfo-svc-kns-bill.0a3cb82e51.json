    {
      "BillID": 2019860,
      "KnessetNum": 20,
      "Name": "חוק חסימת מספר טלפון לשם מניעת ביצוע עבירות, התשע\"ח-2018",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1147,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-03-19T00:00:00",
      "MagazineNumber": 2711,
      "PageNumber": 444,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק התקבל בקריאה השניה והשלישית בכ' באדר התשע\"ח (7 במרץ 2018). החוק מאפשר לקצין המשטרה ולבית המשפט להורות על חסימת טלפונים המשמשים לפרסום של שירותי זנות או למסירת מידע אודות זנות של קטין; לעבירות שונות הקשורות בסמים מסוכנים ובהן סחר, אספקה ותיווך של סמים; ולעבירות הקשורות לשימוש בחומרים מסכנים ובהם הפצת חומרים אסורים או הדחת קטין לצריכתם. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-07-11T13:37:33.213"
    },
