    {
      "BillID": 2214546,
      "KnessetNum": 25,
      "Name": "חוק לתיקון פקודת מס הכנסה (מס' 273), התשפ\"ד–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 4392,
      "CommitteeID": 4186,
      "StatusID": 118,
      "Number": 1039,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-07-25T00:00:00",
      "MagazineNumber": 3262,
      "PageNumber": 1124,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי יחיד, שהוא או בן זוגו שירת שירות מילואים בתקופה שמיום 7 באוקטובר 2023 ועד סוף שנת המס 2023, יהיה רשאי לבקש לראות לעניין הטבות מס, סכומים ששילם לקופת גמל לקצבה או לקרן השתלמות לעצמאיים, כאילו שולמו בשנת המס 2023, אף אם שולמו בשנת 2024.",
      "PublicationSeriesID": 6071,
