    {
      "BillID": 2066456,
      "KnessetNum": 20,
      "Name": "חוק המרכז לגביית קנסות, אגרות והוצאות (תיקון מס' 19 והוראת שעה), התשע\"ח-2018 ",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 1209,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-06-06T00:00:00",
      "MagazineNumber": 2722,
      "PageNumber": 684,
      "IsContinuationBill": null,
      "SummaryLaw": "בתיקון שהתקבל בכנסת ביום כ\"א בסיוון התשע\"ח (4 ביוני 2018) נערכו מספר תיקונים בחוק המרכז לגביית אגרות, קנסות והוצאות, התשנ\"ה-1995, כאשר המרכזי  בו הוא הסמכת המרכז, בהוראת שעה התקפה לארבע שנים, לגבות קנסות בעבור רשויות מקומיות המעוניינות בכך. כמו-כן, הוגדרה רשות האכיפה והגבייה כיחידה האירגונית המופקדת על ביצועו של חוק המרכז לגביית אגרות, קנסות והוצאות, וכן אושרו שינויים נוספים אשר נועדו לייעל ולשפר את עבודת המרכז.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2019-07-10T17:51:40.607"
    },
