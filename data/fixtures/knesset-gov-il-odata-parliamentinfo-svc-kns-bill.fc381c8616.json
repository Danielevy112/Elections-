    {
      "BillID": 2071034,
      "KnessetNum": 20,
      "Name": "חוק התכנון והבנייה (תיקון מס' 125), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5452,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 792,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-16T00:00:00",
      "MagazineNumber": 2732,
      "PageNumber": 749,
      "IsContinuationBill": null,
      "SummaryLaw": "תיקון זה קובע כי שר האוצר יהיה רשאי להאריך תקפו של צו המכריז על מרחב תכנון מיוחד בתקופה נוספת שנייה שלא תעלה על שלוש שנים. עוד נקבעו נציגים נוספים שיהיו חברים בוועדה המיוחדת בתקופה הנוספת השנייה, ודרישה להזמנת שני נציגי רשויות מקומיות הסמוכות למרחב התכנון המיוחד שימנה שר האוצר.\nבנוסף, נקבע כי האיסור על מתן וחידוש היתר לשימוש חורג ביחידת דיור לשימוש שאינו למגורים - יחול רק לגבי היתר חדש לשימוש חורג, ולא לגבי היתר קיים. באשר להיתר לשימוש חורג שפקע, תהא הוועדה המקומית לתכנון ובנייה מוסמכת לחדשו, ובלבד שהבקשה לחידוש תוגש בתוך שנה ממועד הפקיעה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
