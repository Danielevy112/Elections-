  "value": [
    {
      "BillID": 562516,
      "KnessetNum": 20,
      "Name": "חוק מגבלות על חזרתו של עבריין מין לסביבת נפגע העבירה (תיקון מס' 8), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 211,
      "CommitteeID": 932,
      "StatusID": 118,
      "Number": 781,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-18T00:00:00",
      "MagazineNumber": 2733,
      "PageNumber": 757,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק מגבלות על חזרתו של עבריין מין לסביבת נפגע העבירה (תיקון מס' 8), התשע\"ח-2018 הרחיב את ההגדרה של \"עבריין מין\" כך שתכלול גם מי שביצע עבירת מין בהיותו קטין והורשע בביצועה, אם נידון למאסר בפועל או אם בית המשפט ציווה על החזקתו במעון נעול או על אשפוזו, והוא שוחרר מהם לאחר גיל 19. עוד נקבע כי בית המשפט יימנע, ככל האפשר, מפגיעה בצרכים הייחודיים הנוגעים לשיקומו של עבריין מין כאמור. ההסדר יחול לגבי עבריין שביום פרסומו של חוק זה טרם שוחרר ממאסר, מהחזקה במעון או מאשפוז שציווה עליהם בית המשפט. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
    {
