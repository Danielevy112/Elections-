    {
      "BillID": 2070556,
      "KnessetNum": 20,
      "Name": "חוק לתיקון פקודת מס הכנסה (מס' 249), התשע\"ח-2018",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 5431,
      "CommitteeID": 922,
      "StatusID": 118,
      "Number": 790,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2018-07-26T00:00:00",
      "MagazineNumber": 2748,
      "PageNumber": 940,
      "IsContinuationBill": null,
      "SummaryLaw": "מספר תיקונים לפקודת מס הכנסה לעניין הטבות מס ביישובים- הגדלת מספר התושבים המירבי הנדרש ליישוב מוטב ל-85,000, קביעת תוספת לזיכוי ממס גם לתושבים ביישוב עירוני\nסמוך לגבול עימות בצפון השוכן עד למרחק של 9 קילומטרים מגבול ישראל עם לבנון, הגדלת הניקוד באשכול 4 למדד הפריפריאליות מ־50 ל־55, והגדלת התוספת לזיכוי ממס ליישובים צמודים לגבול עימות בצפון ב-1% נוסף.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
