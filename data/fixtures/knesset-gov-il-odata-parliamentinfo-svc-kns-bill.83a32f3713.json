    {
      "BillID": 2219131,
      "KnessetNum": 25,
      "Name": "חוק הכשרות המשפטית והאפוטרופסות (תיקון מס' 21), התשפ\"ד-2024",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1763,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-08-08T00:00:00",
      "MagazineNumber": 3284,
      "PageNumber": 1394,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק מסמיך את האפוטרופוס הכללי לאשר בקשות של אפוטרופוס, מיופה כוח או הורה לקטין, אשר בעבר נדרש בהן אישור מראש מבית המשפט כתנאי לביצוע הפעולה. החוק קובע כי ככל שיהיה מדובר בבירור מורכב, שתתעורר התנגדות לבקשה או שהאפוטרופוס הכללי לא ימצא לנכון לאשר את הבקשה, היא תועבר להכרעה של בית המשפט. בנוסף, נקבע כי השר, באישור ועדת החוקה, חוק ומשפט של הכנסת, יוכל לקבוע סוגי נכסים ופעולות שבעניינם האפוטרופוס יהיה מוסמך לעשות פעולה או לייצג את הקטין גם בלי אישור מראש.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1763 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-02-23T13:25:41.273"
    },
