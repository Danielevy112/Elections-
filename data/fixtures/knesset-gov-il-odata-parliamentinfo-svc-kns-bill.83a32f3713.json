    {
      "BillID": 2169199,
      "KnessetNum": 25,
      "Name": "חוק הסיוע המשפטי (תיקון מס' 26 והוראת שעה), התשפ\"ד-2024",
      "SubTypeID": 53,
      "SubTypeDesc": "ממשלתית",
      "PrivateNumber": null,
      "CommitteeID": 4191,
      "StatusID": 118,
      "Number": 1505,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-07-30T00:00:00",
      "MagazineNumber": 3274,
      "PageNumber": 1192,
      "IsContinuationBill": true,
      "SummaryLaw": "החוק מעגן סיוע משפטי למשפחותיהם של נפגעי עבירות המתה לרבות ליווי וקבלת ייעוץ וסיוע במימוש זכויותיהם בהליכים המשפטיים. החוק מרחיב את רשימת עבירות המין שבעניינן ניתן לקבל סיוע משפטי. בנוסף, החוק קובע הוראת שעה לפיה יורחב הסיוע המשפטי הניתן לנפגעי עבירות מין ועבירות של סחר בבני אדם, כך שיחול כבר משלב החקירה וגם על הליכים אזרחיים הנובעים מהעבירה.",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הממשלה - 1505 ,מיום 11:00:00",
