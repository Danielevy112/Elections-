    {
      "BillID": 2013512,
      "KnessetNum": 20,
      "Name": "חוק הדרכונים (תיקון מס' 9), התשע\"ז-2017",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 3830,
      "CommitteeID": 935,
      "StatusID": 118,
      "Number": 709,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2017-06-28T00:00:00",
      "MagazineNumber": 2646,
      "PageNumber": 1004,
      "IsContinuationBill": null,
      "SummaryLaw": "חוק הדרכונים (תיקון מס' 9), התשע\"ז-2017 התקבל בכנסת ביום ב' בתמוז התשע\"ז (26 ביוני 2017). החוק קובע כי שר הפנים לא יוכל לסרב לבקשתו של עולה, אשר הוענקה לו אזרחות מכוח חוק השבות, לקבל דרכון ראשון רק משום שטרם השתקע בישראל. עוד נקבע, כי התיקון ייכנס לתוקף בחלוף 30 ימים מיום פרסומו, ויחול גם לעניין מי שקיבל את אזרחותו כאמור לפני תחילתו.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": null,
      "LastUpdatedDate": "2021-06-29T07:48:03.727"
    },
