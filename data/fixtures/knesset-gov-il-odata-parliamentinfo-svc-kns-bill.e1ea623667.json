    {
      "BillID": 2197217,
      "KnessetNum": 25,
      "Name": "חוק יום משפחות היתומים בישראל, התשפ\"ד–2024",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 287,
      "CommitteeID": 4192,
      "StatusID": 118,
      "Number": 982,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2024-03-21T00:00:00",
      "MagazineNumber": 3186,
      "PageNumber": 642,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע כי ביום כ\"ה בכסלו יקוים יום ציון שנתי למשפחות היתומים שיצויין בדיון מיוחד במליאת הכנסת ובאחת מוועדות הכנסת, בדיון מיוחד אצל האפוטרופוס הכללי בהשתתפות משרדי ממשלה וגורמים אחרים העוסקים בקידום זכויותיהם וצורכיהם של משפחות היתומים, וכן בבית נשיא המדינה כפי שיחליט הנשיא. עוד נקבע כי שר התרבות והספורט רשאי להורות על דרכי ציון נוספות בתחומי פעילות משרדו בכפוף לתקציב ייעודי מאוצר המדינה.\n",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 982 ,מיום 16:00:00",
      "LastUpdatedDate": "2024-04-08T11:26:58.057"
    },
    {
