    {
      "BillID": 2196547,
      "KnessetNum": 25,
      "Name": "חוק להנצחת זכרו של מרן הרב עובדיה יוסף, התשפ\"ה-2025",
      "SubTypeID": 54,
      "SubTypeDesc": "פרטית",
      "PrivateNumber": 452,
      "CommitteeID": 4192,
      "StatusID": 118,
      "Number": 980,
      "PostponementReasonID": null,
      "PostponementReasonDesc": null,
      "PublicationDate": "2025-01-29T00:00:00",
      "MagazineNumber": 3362,
      "PageNumber": 256,
      "IsContinuationBill": null,
      "SummaryLaw": "החוק קובע הוראות לעניין הנצחת זכרו של מרן הרב עובדיה יוסף זצ\"ל, בין השאר בקביעת יום ציון לזכרו, בקיום פעילויות חינוכיות-ערכיות וטקסים במוסדות המדינה וכן קיום לימוד ופעילויות כאמור בבתי הספר, ככל שיחליט על כך שר החינוך; עוד מאפשר החוק מתן מלגות למחקר ומתן תמיכות למוסדות ציבור הפועלים להגשמת מטרותיו. תוקם מועצה ציבורית אשר תייעץ לשר לשירותי דת הממונה על החוק, בכל הנוגע ליישומו. עיריית ירושלים רשאית להקים בתחומה תאגיד עירוני שישמש מרכז הנצחה לפועלו ולמורשתו של הרב עובדיה יוסף. ",
      "PublicationSeriesID": 6071,
      "PublicationSeriesDesc": "ספר החוקים",
      "PublicationSeriesFirstCall": "הצעות חוק הכנסת - 980 ,מיום 16:00:00",
      "LastUpdatedDate": "2025-04-01T14:55:01.073"
    },
